function F.getCellBoss()
    local monsters =
        F.findMonstersFolder
        and F.findMonstersFolder()
        or workspace:FindFirstChild("Monsters")

    if not monsters then
        return nil
    end

    local direct =
        monsters:FindFirstChild(
            "The Cell Of Life"
        )

    if direct
        and direct:IsA("Model")
        and (
            not F.isMonsterAlive
            or F.isMonsterAlive(direct)
        )
    then
        return direct
    end

    for _, object in ipairs(monsters:GetChildren()) do
        if object:IsA("Model")
            and tostring(object.Name) == "The Cell Of Life"
            and (
                not F.isMonsterAlive
                or F.isMonsterAlive(object)
            )
        then
            return object
        end
    end

    return nil
end

