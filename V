function F.normalizeFarmStrategy(value)
    value = tostring(value or "Balanced")

    if value == "Smart"
        or value == "Nearest"
        or value == "Priority"
        or value == "Balanced"
    then
        return value
    end

    return "Smart"
end

function F.getSmartFarmScore(drop, metadata, distance, rarityOrder, explicitPriority)
    local failureCount =
        math.max(
            0,
            tonumber(State.farmFailureHistory[drop]) or 0
        )

    local farmScale =
        F.getEffectiveMovementScale
        and F.getEffectiveMovementScale("Farm")
        or State.farmFlightSpeed
        or Config.LOOT_FLY_SPEED

    local studsPerSecond =
        math.max(
            1,
            farmScale * Config.LOOT_FLY_SPEED_SCALE
        )

    local travelTime =
        distance / studsPerSecond

    -- Priority acts as user-defined item value. Rarity adds intrinsic value,
    -- while distance, estimated travel time, and recent failures reduce value.
    local score =
        explicitPriority * 25
        + rarityOrder * 12
        - distance * 0.025
        - travelTime * 6
        - failureCount * 18

    return score, travelTime, failureCount
end

function F.getBestFarmDrop()
    local root =
        F.getCharacterRoot()

    local strategy =
        F.normalizeFarmStrategy(
            State.farmStrategy
        )

    local bestDrop = nil
    local bestExplicitPriority = -math.huge
    local bestRarityOrder = -math.huge
    local bestDistance = math.huge
    local bestBalancedScore = -math.huge
    local bestSmartScore = -math.huge
    local bestTravelTime = 0

    for drop, metadata in pairs(
        State.dropCache
    ) do
        if drop
            and drop.Parent
            and not F.isDropTemporarilyBlocked(
                drop
            )
            and F.isFarmNameAllowed(drop)
            and F.isFarmRarityAllowed(drop)
        then
            local rarityInfo =
                metadata.rarity
                or F.getDropRarity(drop)

            local rarityOrder =
                tonumber(rarityInfo.Order) or 0

            local explicitPriority =
                tonumber(
                    State.itemPriority[
                        metadata.normalizedName
                        or string.lower(tostring(drop.Name))
                    ]
                ) or 0

            local standCFrame =
                F.getDropStandCFrame(
                    drop
                )

            if standCFrame then
                local distance = 0

                if root then
                    distance =
                        (
                            root.Position
                            - standCFrame.Position
                        ).Magnitude
                end

                local better = false
                local smartScore = nil
                local smartTravel = nil

                if strategy == "Nearest" then
                    better =
                        distance < bestDistance
                elseif strategy == "Smart" then
                    smartScore,
                    smartTravel =
                        F.getSmartFarmScore(
                            drop,
                            metadata,
                            distance,
                            rarityOrder,
                            explicitPriority
                        )

                    better =
                        smartScore > bestSmartScore
                        or (
                            smartScore == bestSmartScore
                            and distance < bestDistance
                        )
                elseif strategy == "Balanced" then
                    local score =
                        explicitPriority * 25
                        + rarityOrder * 12
                        - distance * 0.08

                    better =
                        score > bestBalancedScore
                        or (
                            score == bestBalancedScore
                            and distance < bestDistance
                        )

                    if better then
                        bestBalancedScore = score
                    end
                else
                    better =
                        explicitPriority > bestExplicitPriority
                        or (
                            explicitPriority == bestExplicitPriority
                            and (
                                rarityOrder > bestRarityOrder
                                or (
                                    rarityOrder == bestRarityOrder
                                    and distance < bestDistance
                                )
                            )
                        )
                end

                if better then
                    bestExplicitPriority =
                        explicitPriority

                    bestRarityOrder =
                        rarityOrder

                    bestDistance =
                        distance

                    if smartScore then
                        bestSmartScore = smartScore
                        bestTravelTime = smartTravel or 0
                    end

                    bestDrop =
                        drop
                end
            end
        end
    end

    State.plannerLastChoice =
        bestDrop
        and tostring(bestDrop.Name)
        or "None"

    State.plannerLastDistance =
        bestDrop and bestDistance or 0

    State.plannerLastScore =
        strategy == "Smart"
        and (bestSmartScore > -math.huge and bestSmartScore or 0)
        or 0

    State.plannerLastETA =
        strategy == "Smart"
        and bestTravelTime
        or (
            bestDrop
            and bestDistance
                / math.max(
                    1,
                    (State.farmFlightSpeed or Config.LOOT_FLY_SPEED)
                        * Config.LOOT_FLY_SPEED_SCALE
                )
            or 0
        )

    return bestDrop
end

function F.isDropPresent(drop)
    if not drop or not drop.Parent then
        return false
    end

    local dropsFolder =
        State.dropsFolder

    if dropsFolder
        and dropsFolder.Parent
    then
        return drop:IsDescendantOf(
            dropsFolder
        )
    end

    return true
end


