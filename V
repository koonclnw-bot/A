function F.getGoalMonsterName(monster)
    if not monster then
        return ""
    end
    return F.trimText(monster.Name)
end

function F.isGoalMonsterCandidate(monsterName)
    monsterName = string.lower(F.trimText(monsterName))
    if monsterName == "" then
        return false
    end

    local goal = State.goalFarm
    if not goal.enabled or next(goal.monsterTargets) == nil then
        return false
    end

    return goal.monsterTargets[monsterName] == true
end

function F.getGoalDropField(dropFolder, fieldName)
    if not dropFolder then
        return nil
    end

    local valueObject = dropFolder:FindFirstChild(fieldName)
    if valueObject
        and (
            valueObject:IsA("NumberValue")
            or valueObject:IsA("IntValue")
            or valueObject:IsA("StringValue")
            or valueObject:IsA("BoolValue")
        )
    then
        return valueObject.Value
    end

    local attribute = nil
    pcall(function()
        attribute = dropFolder:GetAttribute(fieldName)
    end)
    return attribute
end

function F.buildGoalDropIndex()
    local goal = State.goalFarm
    goal.dropIndex = {}
    goal.monsterDrops = {}

    if not State.monstersFolder
        or not State.monstersFolder.Parent
    then
        State.monstersFolder = F.findMonstersFolder()
    end

    local models = {}
    if State.monstersFolder then
        models = F.collectMonsterModels(State.monstersFolder)
    end

    local seenMonsterNames = {}
    local processed = 0

    for _, monster in ipairs(models) do
        local monsterName = F.getGoalMonsterName(monster)
        local lowerMonster = string.lower(monsterName)

        if monsterName ~= ""
            and lowerMonster ~= "training dummy"
            and not seenMonsterNames[lowerMonster]
        then
            local knownBestiary =
                F.getGameDBMonster(monsterName) ~= nil

            local stats = monster:FindFirstChild("Stats")
            local drops = stats and stats:FindFirstChild("Drops")

            if drops and (knownBestiary or drops:IsA("Folder")) then
                seenMonsterNames[lowerMonster] = true

                local monsterRecord = {
                    Name = monsterName,
                    Instance = monster,
                    Drops = {},
                }
                goal.monsterDrops[lowerMonster] = monsterRecord

                for _, dropFolder in ipairs(drops:GetChildren()) do
                    local itemName = F.trimText(dropFolder.Name)

                    if itemName ~= "" then
                        local record = {
                            Item = itemName,
                            Monster = monsterName,
                            MonsterInstance = monster,
                            Chance = F.getGoalDropField(dropFolder, "Chance"),
                            Range = F.getGoalDropField(dropFolder, "Range"),
                            Path = dropFolder:GetFullName(),
                        }

                        table.insert(monsterRecord.Drops, record)

                        local itemKey = string.lower(itemName)
                        local itemRecord = goal.dropIndex[itemKey]
                        if not itemRecord then
                            itemRecord = {
                                Name = itemName,
                                Sources = {},
                            }
                            goal.dropIndex[itemKey] = itemRecord
                        end
                        table.insert(itemRecord.Sources, record)
                    end
                end
            end
        end

        processed = processed + 1
        if processed % Config.GOAL_DROP_SCAN_YIELD_EVERY == 0 then
            task.wait()
        end
    end

    local sourceCount = 0
    for _, itemRecord in pairs(goal.dropIndex) do
        sourceCount = sourceCount + #(itemRecord.Sources or {})
        table.sort(itemRecord.Sources, function(a, b)
            return tostring(a.Monster) < tostring(b.Monster)
        end)
    end

    goal.lastSourceCount = sourceCount
    return true
end

function F.getGoalSummary()
    local goal = State.goalFarm
    local monsterCount = F.getGameDBCount(State.gameDB.monsters)
    local itemCount = F.getGameDBCount(goal.dropIndex)
    local sourceCount = tonumber(goal.lastSourceCount) or 0
    local selectedText = "None"

    if goal.selected then
        selectedText =
            tostring(goal.selected.Kind or "?")
            .. ": "
            .. tostring(goal.selected.Name or "Unknown")
    elseif goal.pendingName ~= "" then
        selectedText =
            tostring(goal.pendingKind or "?")
            .. ": "
            .. tostring(goal.pendingName)
            .. " (pending)"
    end

    return table.concat({
        "Status: " .. tostring(goal.status),
        "Goal Farm: " .. (goal.enabled and "ON" or "OFF")
            .. " | Selected: " .. selectedText,
        "Bestiary Monsters: " .. tostring(monsterCount)
            .. " | Live Drop Items: " .. tostring(itemCount)
            .. " | Monster->Item Sources: " .. tostring(sourceCount),
        "Active Monster Targets: " .. tostring(F.getGameDBCount(goal.monsterTargets)),
        "Coordination: Monster Lock hunts while Auto Farm is idle; loot flight preempts combat only when a matching drop is being collected.",
    }, "\n")
end

function F.formatGoalRecord(record)
    if type(record) ~= "table" then
        return "Select an item or monster from the results."
    end

    if record.Kind == "Monster" then
        local config = record.Config or {}
        local mastery = type(config.MasteryQuests) == "table" and config.MasteryQuests or {}
        local masteryLines = {}

        for _, quest in ipairs(mastery) do
            table.insert(
                masteryLines,
                tostring(quest.KillsRequired or "?")
                    .. " kills: "
                    .. tostring(quest.Title or "Mastery")
                    .. " (+" .. tostring(quest.Bonus or 0) .. ")"
            )
        end

        local liveDrops = State.goalFarm.monsterDrops[
            string.lower(tostring(record.Name or ""))
        ]
        local dropNames = {}

        if liveDrops then
            for _, drop in ipairs(liveDrops.Drops or {}) do
                local extra = ""
                if drop.Chance ~= nil then
                    extra = " [Chance=" .. tostring(drop.Chance) .. "]"
                elseif drop.Range ~= nil then
                    extra = " [Range=" .. tostring(drop.Range) .. "]"
                end
                table.insert(dropNames, tostring(drop.Item) .. extra)
                if #dropNames >= 12 then
                    break
                end
            end
        end

        return table.concat({
            "[MONSTER] " .. tostring(record.Name),
            "Tier: " .. tostring(config.Tier or "Unknown"),
            "Description: " .. tostring(config.Description or "No description"),
            "Mastery: " .. (#masteryLines > 0 and table.concat(masteryLines, " | ") or "No mastery data"),
            "Live Drops: " .. (#dropNames > 0 and table.concat(dropNames, ", ") or "No live drop table in this server snapshot"),
        }, "\n")
    end

    local item = record.ItemRecord or {}
    local sourceLines = {}

    for _, source in ipairs(item.Sources or {}) do
        local meta = {}
        if source.Chance ~= nil then
            table.insert(meta, "Chance=" .. tostring(source.Chance))
        end
        if source.Range ~= nil then
            table.insert(meta, "Range=" .. tostring(source.Range))
        end

        table.insert(
            sourceLines,
            tostring(source.Monster)
                .. (#meta > 0 and (" [" .. table.concat(meta, ", ") .. "]") or "")
        )
    end

    return table.concat({
        "[ITEM] " .. tostring(record.Name),
        "Live source monsters: " .. tostring(#(item.Sources or {})),
        #sourceLines > 0 and table.concat(sourceLines, "\n") or "No source monster is currently exposing this drop table.",
        "Start Goal will exact-match this item in Auto Farm. Source monsters are targeted when available.",
    }, "\n")
end

