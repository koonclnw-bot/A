        "Cell Stats: Loot " .. tostring(State.cellFarm.lootCollected)
            .. " | Reward Chests " .. tostring(State.cellFarm.rewardChestsOpened or 0)
            .. "/" .. tostring(State.cellFarm.rewardChestsFound or 0)
            .. " | Bundles " .. tostring(State.cellFarm.bundlesOpened)
            .. " | Sold " .. tostring(State.cellFarm.itemsSold)
