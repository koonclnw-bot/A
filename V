function F.selectDropsSubPage(name)
    if not State.dropsSubPages[name] then
        return
    end

    State.dropsSubPage = name

    for subName, panel in pairs(
        State.dropsSubPages
    ) do
        panel.Visible = subName == name

        if subName == name then
            panel.CanvasPosition =
                Vector2.new(0, 0)
        end
    end

    for subName, button in pairs(
        State.dropsSubButtons
    ) do
        local active = subName == name

        button.BackgroundColor3 =
            active
            and Config.THEME.SidebarButtonActive
            or Config.THEME.Card2

        button.TextColor3 =
            active
            and Config.THEME.Text
            or Config.THEME.SubText
    end
end

