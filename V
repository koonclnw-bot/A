    State.gachaStatus =
        State.gachaEnabled
        and "Resumed"
        or "OFF"

    State.nightCallEnabled =
        decoded.nightCallEnabled == true

    State.nightCallUsedJobId =
        tostring(
            decoded.nightCallUsedJobId
            or ""
        )

    State.nightCallLastUseAtUnix =
        math.max(
            0,
            tonumber(
                decoded.nightCallLastUseAtUnix
