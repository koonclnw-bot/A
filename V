function F.findCellSpawnProtectionMarker()
    local character =
        LocalPlayer.Character

    if not character
        or not character.Parent
    then
        return nil
    end

    -- Roblox's normal spawn protection is represented by a ForceField and
    -- visually appears as a blue-ish bubble. Prefer that exact signal.
    local forceField =
        character:FindFirstChildWhichIsA(
            "ForceField",
            true
        )

    if forceField then
        return forceField
    end

    -- Conservative fallback for a custom game-side bubble. Avoid generic
    -- combat StatusEffects (e.g. OceanShield) so the farm cannot deadlock on
    -- a legitimate buff.
    for _, object in ipairs(
        character:GetDescendants()
    ) do
        local parent =
            object.Parent

        local insideStatusEffects =
            false

        while parent
            and parent ~= character
        do
            if parent.Name == "StatusEffects" then
                insideStatusEffects = true
                break
            end

            parent = parent.Parent
        end

        if not insideStatusEffects then
            local lowered =
                string.lower(
                    tostring(
                        object.Name
                    )
                )

            if string.find(
                lowered,
                "spawnprotection",
                1,
                true
            )
                or string.find(
                    lowered,
                    "spawn protection",
                    1,
                    true
                )
                or string.find(
                    lowered,
                    "protectionbubble",
                    1,
                    true
                )
                or string.find(
                    lowered,
                    "spawnshield",
                    1,
                    true
                )
            then
                return object
            end
        end
    end

    return nil
end

function F.wakeCellCharacterFromSpawnProtection(token)
    if not F.isCellFarmActive(token) then
        return false
    end

    F.setCellFarmStage(
        "SPAWN PROTECTION",
        "Sending normal movement input"
    )

    local moved =
        F.pressVirtualKey(
            Enum.KeyCode.W,
            0x57,
            Config.CELL_SPAWN_PROTECTION_WAKE_HOLD,
            "Spawn protection wake: W"
        )

    if not moved then
        local humanoid =
            F.getHumanoid()

        if humanoid then
            pcall(function()
                humanoid:Move(
                    Vector3.new(
                        0,
                        0,
                        -1
                    ),
                    true
                )
            end)

            task.wait(
                Config.CELL_SPAWN_PROTECTION_WAKE_HOLD
            )

            pcall(function()
                humanoid:Move(
                    Vector3.zero,
                    false
                )
            end)

            moved = true
        end
    end

    return moved
end

function F.waitForCellSpawnProtectionClear(token)
    if not F.isCellFarmActive(token) then
        return false
    end

    -- v6.4.12: the live game can keep the visible blue ForceField after
    -- interactions are otherwise possible. Do not use the ForceField as a
    -- readiness gate. This helper is retained only for compatibility.
    F.setCellFarmStage(
        "SPAWN SETTLE",
        "Fixed settle; ForceField is informational only"
    )

    return F.cellFarmWait(
        token,
        1.00
    )
end

function F.startCellCradleTravelInput(token)
    State.cellFarm.cradleTravelInput =
        "WASD ACTIVE"

    local pulseToken =
        (State.cellFarm.cradleTravelInputToken or 0)
        + 1

    State.cellFarm.cradleTravelInputToken =
        pulseToken

    task.spawn(function()
        local keys = {
            {
                code = Enum.KeyCode.W,
                vk = 0x57,
                name = "W",
            },
            {
                code = Enum.KeyCode.A,
                vk = 0x41,
                name = "A",
            },
            {
                code = Enum.KeyCode.S,
                vk = 0x53,
                name = "S",
            },
            {
                code = Enum.KeyCode.D,
                vk = 0x44,
                name = "D",
            },
        }

        local index = 1

        while F.isCellFarmActive(token)
            and State.cellFarm.cradleTravelInputToken
                == pulseToken
            and State.cellFarm.cradleTravelInput
                == "WASD ACTIVE"
        do
            local key =
                keys[index]

            State.movementTelemetry.lastAction =
                "Cradle flight input: "
                .. key.name

            F.pressVirtualKey(
                key.code,
                key.vk,
                Config.CELL_CRADLE_TRAVEL_INPUT_HOLD,
                "Cradle flight: " .. key.name
            )

            index =
                (index % #keys) + 1

            if not F.cellFarmWait(
                token,
                Config.CELL_CRADLE_TRAVEL_INPUT_GAP
            ) then
                break
            end
        end
    end)

    return pulseToken
end

function F.stopCellCradleTravelInput(pulseToken)
    if pulseToken
        and State.cellFarm.cradleTravelInputToken
            ~= pulseToken
    then
        return false
    end

    State.cellFarm.cradleTravelInput =
        "OFF"

    State.cellFarm.cradleTravelInputToken =
        (State.cellFarm.cradleTravelInputToken or 0)
        + 1

    return true
end

function F.flyCellToCFrameWithWASD(
    token,
    target,
    arrivalDistance,
    maxTravelTime
)
    if not F.isCellFarmActive(token) then
        return false
    end

    local pulseToken =
        F.startCellCradleTravelInput(
            token
        )

    local reached =
        F.flyToCFrame(
            target,
            "CELL",
            arrivalDistance,
            maxTravelTime,
            "Cell"
        )

    F.stopCellCradleTravelInput(
        pulseToken
    )

    return reached
end

function F.flyToCellCradle(token)
    if not F.isCellFarmActive(token) then
        return false
    end

    F.setCellFarmStage(
        "TRAVEL TO CRADLE",
        "Locating The Cradle"
    )

    local cradle =
        F.findCellCradle()

    if not cradle then
        F.requestCellCradleStreaming()

        local reachedFallback =
            F.flyCellToCFrameWithWASD(
                token,
                Config.CELL_CRADLE_FALLBACK_CFRAME,
                Config.CELL_CRADLE_ARRIVAL_DISTANCE,
                Config.CELL_TRAVEL_MAX_TIME
            )

        if not reachedFallback
            or not F.isCellFarmActive(token)
        then
            return false
        end

        local deadline =
            os.clock() + 8

        repeat
            cradle =
                F.findCellCradle()

            if cradle then
                break
            end

            F.requestCellCradleStreaming()
            task.wait(0.25)
        until
            not F.isCellFarmActive(token)
            or os.clock() >= deadline
    end

    if not cradle
        or not cradle.Parent
    then
        return false
    end

    local part =
        F.getCellCradlePart(
            cradle
        )

    if not part then
        return false
    end

    F.setCellFarmStage(
        "TRAVEL TO CRADLE",
        "Flying to The Cradle"
    )

    local targetPosition =
        part.Position
        + part.CFrame.LookVector * 4

    local target =
        CFrame.lookAt(
            targetPosition,
            part.Position
        )

    local reached =
        F.flyCellToCFrameWithWASD(
            token,
            target,
            Config.CELL_CRADLE_ARRIVAL_DISTANCE,
            Config.CELL_TRAVEL_MAX_TIME
        )

    return reached == true
        and F.isCellFarmActive(token)
end

