    State.movementTelemetry.lastAction =
        "Stone Accord"

    local success, err =
        pcall(function()

            ConsumableEvent:FireServer(
                "Stone Accord",
                target
            )
        end)

    if not success then
        warn(
            "[The Veil Hub] Stone Accord Error:",
            err
        )
    end
