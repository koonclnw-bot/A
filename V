function F.rememberAtmosphere(atmosphere)
    if not atmosphere
        or not atmosphere:IsA("Atmosphere") then

        return
    end

    if atmosphereOriginals[atmosphere] then
        return
    end

    atmosphereOriginals[atmosphere] = {
        Density = atmosphere.Density,
        Haze = atmosphere.Haze,
        Glare = atmosphere.Glare
    }
end

function F.applyNoFog()
    Lighting.FogStart = 0
    Lighting.FogEnd = Config.NOFOG_END

    for _, object in ipairs(
        Lighting:GetDescendants()
    ) do
        if object:IsA("Atmosphere") then
            F.rememberAtmosphere(object)

            object.Density = 0
            object.Haze = 0
            object.Glare = 0
        end
    end
end

function F.restoreNoFog()
    Lighting.FogStart =
        originalLighting.FogStart

    Lighting.FogEnd =
        originalLighting.FogEnd

    for atmosphere, original in pairs(
        atmosphereOriginals
    ) do
        if atmosphere and atmosphere.Parent then
            pcall(function()
                atmosphere.Density =
                    original.Density

                atmosphere.Haze =
                    original.Haze

                atmosphere.Glare =
                    original.Glare
            end)
        end
    end
end

function F.applyLowGraphicsObject(object)
    if not State.lowGraphicsEnabled
        or not object
        or not object.Parent
    then
        return
    end

    local original =
        State.lowGraphicsOriginals[
            object
        ]

    if not original then
        original = {}
        State.lowGraphicsOriginals[
            object
        ] = original
    end

    pcall(function()
        if object:IsA("BasePart") then
            if original.CastShadow == nil then
                original.CastShadow =
                    object.CastShadow
            end

            object.CastShadow = false
        end

        if object:IsA("MeshPart") then
            if original.RenderFidelity == nil then
                original.RenderFidelity =
                    object.RenderFidelity
            end

            object.RenderFidelity =
                Enum.RenderFidelity.Performance
        end

        if object:IsA("ParticleEmitter")
            or object:IsA("Trail")
            or object:IsA("Beam")
            or object:IsA("Smoke")
            or object:IsA("Fire")
            or object:IsA("Sparkles")
            or object:IsA("BloomEffect")
            or object:IsA("BlurEffect")
            or object:IsA("DepthOfFieldEffect")
            or object:IsA("SunRaysEffect")
        then
            if original.Enabled == nil then
                original.Enabled =
                    object.Enabled
            end

            object.Enabled = false
        end
    end)
end

function F.applyLowGraphics()
    if not State.lowGraphicsEnabled then
        return
    end

    pcall(function()
        if type(getfpscap) == "function"
            and State.lowGraphicsFpsOriginal == nil
        then
            State.lowGraphicsFpsOriginal =
                getfpscap()
        end
    end)

    pcall(function()
        if type(setfpscap) == "function" then
            setfpscap(
                Config.LOW_GRAPHICS_FPS_CAP
            )
        end
    end)

    pcall(function()
        local userGameSettings =
            UserSettings():GetService(
                "UserGameSettings"
            )

        if State.lowGraphicsQualityOriginal
            == nil
        then
            State.lowGraphicsQualityOriginal =
                userGameSettings.SavedQualityLevel
        end

        userGameSettings.SavedQualityLevel =
            Enum.SavedQualitySetting.QualityLevel1
    end)

    pcall(function()
        Lighting.GlobalShadows = false
    end)

    for _, object in ipairs(
        Lighting:GetDescendants()
    ) do
        F.applyLowGraphicsObject(
            object
        )
    end

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do
        F.applyLowGraphicsObject(
            object
        )
    end

    if State.lowGraphicsConnection then
        pcall(function()
            State.lowGraphicsConnection:Disconnect()
        end)
    end

    State.lowGraphicsConnection =
        workspace.DescendantAdded:Connect(function(object)
            if State.lowGraphicsEnabled then
                task.defer(
                    F.applyLowGraphicsObject,
                    object
                )
            end
        end)
end

function F.restoreLowGraphics()
    if State.lowGraphicsConnection then
        pcall(function()
            State.lowGraphicsConnection:Disconnect()
        end)

        State.lowGraphicsConnection = nil
    end

    for object, original in pairs(
        State.lowGraphicsOriginals
    ) do
        if object
            and object.Parent
            and type(original) == "table"
        then
            pcall(function()
                if original.CastShadow ~= nil
                    and object:IsA("BasePart")
                then
                    object.CastShadow =
                        original.CastShadow
                end

                if original.RenderFidelity ~= nil
                    and object:IsA("MeshPart")
                then
                    object.RenderFidelity =
                        original.RenderFidelity
                end

                if original.Enabled ~= nil then
                    object.Enabled =
                        original.Enabled
                end
            end)
        end
    end

    State.lowGraphicsOriginals =
        setmetatable(
            {},
            {__mode = "k"}
        )

    pcall(function()
        if type(setfpscap) == "function" then
            setfpscap(
                tonumber(
                    State.lowGraphicsFpsOriginal
                ) or 60
            )
        end
    end)

    pcall(function()
        local userGameSettings =
            UserSettings():GetService(
                "UserGameSettings"
            )

        if State.lowGraphicsQualityOriginal
            ~= nil
        then
            userGameSettings.SavedQualityLevel =
                State.lowGraphicsQualityOriginal
        end
    end)

    State.lowGraphicsFpsOriginal = nil
    State.lowGraphicsQualityOriginal = nil

    if State.fullBrightEnabled then
        F.applyFullBright()
    else
        pcall(function()
            Lighting.GlobalShadows =
                originalLighting.GlobalShadows
        end)
    end
end

-- =========================================================
-- FULLBRIGHT - ANTI FLICKER
--
-- Instead of blindly rewriting Lighting every 0.25s, this
-- version only writes values when they actually differ and
-- listens for Lighting changes while FullBright is enabled.
-- This prevents the visible dark/bright pulse caused when the
-- game and the old polling loop fight over the same values.
-- =========================================================

function F.applyFullBright()
    if not State.fullBrightEnabled then
        return
    end

    if State.fullBrightApplying then
        return
    end

    State.fullBrightApplying = true

    pcall(function()
        if Lighting.Brightness ~= Config.FULLBRIGHT_BRIGHTNESS then
            Lighting.Brightness = Config.FULLBRIGHT_BRIGHTNESS
        end

        if Lighting.ClockTime ~= Config.FULLBRIGHT_CLOCK_TIME then
            Lighting.ClockTime = Config.FULLBRIGHT_CLOCK_TIME
        end

        if Lighting.GlobalShadows ~= false then
            Lighting.GlobalShadows = false
        end

        local fullBrightColor = Color3.fromRGB(255, 255, 255)

        if Lighting.Ambient ~= fullBrightColor then
            Lighting.Ambient = fullBrightColor
        end

        if Lighting.OutdoorAmbient ~= fullBrightColor then
            Lighting.OutdoorAmbient = fullBrightColor
        end

        if Lighting.ExposureCompensation ~= Config.FULLBRIGHT_EXPOSURE then
            Lighting.ExposureCompensation = Config.FULLBRIGHT_EXPOSURE
        end
    end)

    State.fullBrightApplying = false
end

function F.stopFullBrightGuard()
    for _, connection in ipairs(State.fullBrightConnections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(State.fullBrightConnections)
    State.fullBrightGuardStarted = false
end

function F.startFullBrightGuard()
    if State.fullBrightGuardStarted then
        F.applyFullBright()
        return
    end

    State.fullBrightGuardStarted = true

    local watchedProperties = {
        "Brightness",
        "ClockTime",
        "GlobalShadows",
        "Ambient",
        "OutdoorAmbient",
        "ExposureCompensation",
    }

    for _, propertyName in ipairs(watchedProperties) do
        local connection =
            Lighting:GetPropertyChangedSignal(propertyName):Connect(function()
                if State.fullBrightEnabled
                    and not State.fullBrightApplying then

                    F.applyFullBright()
                end
            end)

        table.insert(State.fullBrightConnections, connection)
    end

    F.applyFullBright()
end

function F.restoreFullBright()
    F.stopFullBrightGuard()

    State.fullBrightApplying = true

    pcall(function()
        if Lighting.Brightness ~= originalLighting.Brightness then
            Lighting.Brightness = originalLighting.Brightness
        end

        if Lighting.ClockTime ~= originalLighting.ClockTime then
            Lighting.ClockTime = originalLighting.ClockTime
        end

        local targetShadows =
            State.lowGraphicsEnabled
            and false
            or originalLighting.GlobalShadows

        if Lighting.GlobalShadows ~= targetShadows then
            Lighting.GlobalShadows = targetShadows
        end

        if Lighting.Ambient ~= originalLighting.Ambient then
            Lighting.Ambient = originalLighting.Ambient
        end

        if Lighting.OutdoorAmbient ~= originalLighting.OutdoorAmbient then
            Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
        end

        if Lighting.ExposureCompensation ~= originalLighting.ExposureCompensation then
            Lighting.ExposureCompensation = originalLighting.ExposureCompensation
        end
    end)

    State.fullBrightApplying = false
end

