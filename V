        State.cellFarm.bossLastSpawnEvent = "None"
        State.cellFarm.startedAt = os.clock()
    end

    State.cellFarm.token =
        State.cellFarm.token + 1

    local token =
        State.cellFarm.token

    State.cellFarm.enabled = true
    State.cellFarm.running = true

    -- Teleport-resumed runs also stay hidden automatically.
    F.setCellFarmHubHidden(
        true
    )

    F.setCellResumeFlag(true)
    State.cellFarm.stage =
        resumed
        and "RESUME"
        or "STARTING"
    State.cellFarm.status =
        resumed
        and "Resuming after server hop"
        or "Starting full auto Cell Farm"

    State.cellFarm.weaponStatus =
        State.cellFarm.selectedWeaponName ~= ""
        and ("Selected: " .. State.cellFarm.selectedWeaponName)
        or "AUTO / not selected"

    State.cellFarm.menuPhase =
        (
            resumed
            or State.cellFarm.launchFromMenu
        )
        and "Waiting for menu"
        or "Gameplay"

    State.movementSpeeds.Cell =
        State.cellFarm.travelSpeed

    if State.cellFarmToggle then
        State.cellFarmToggle:SetSilent(true)
    end

    F.updateCellFarmUI()
    F.recordDiagnosticEvent(
        "CellFarm",
        resumed
        and "Teleport resume started"
        or "Full Auto Cell Farm started"
    )

    task.spawn(function()
        local success, result =
            xpcall(
                function()
                    return F.runCellFarm(
                        token,
                        resumed
                    )
                end,
                function(message)
                    return tostring(message)
                end
            )

        if not success then
            F.recordError(
                "CellFarm",
                result
            )
            F.recordCellFailure(
                "Unhandled Cell Farm error: "
                    .. tostring(result)
            )
        end

        if F.isCellFarmActive(token)
            and not State.serverHopBusy
        then
            State.cellFarm.running = false

            if not success then
                F.setCellFarmStage(
                    "ERROR",
                    "Unhandled error"
                )
            elseif result ~= true then
                F.setCellFarmStage(
                    "IDLE",
                    "Stopped before hop"
                )
            end
        end
    end)

    return true
end

