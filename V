-- v6.1 GAMEDB INTELLIGENCE CORE
-- =========================================================

function F.getGameDBCount(value)
    if type(value) ~= "table" then
        return 0
    end

    local count = 0
    for _ in pairs(value) do
        count = count + 1
    end
    return count
end

function F.findGameDBModule(moduleName)
    moduleName = tostring(moduleName or "")
    if moduleName == "" then
        return nil
    end

    local assets = ReplicatedStorage:FindFirstChild("Assets")
    local scripts = assets and assets:FindFirstChild("Scripts")

    if scripts then
        local direct = scripts:FindFirstChild(moduleName)
        if direct and direct:IsA("ModuleScript") then
            return direct
        end

        for _, descendant in ipairs(scripts:GetDescendants()) do
            if descendant:IsA("ModuleScript")
                and descendant.Name == moduleName
            then
                return descendant
            end
        end
    end

    for _, descendant in ipairs(ReplicatedStorage:GetDescendants()) do
        if descendant:IsA("ModuleScript")
            and descendant.Name == moduleName
        then
            return descendant
        end
    end

    return nil
end

function F.requireGameDBModule(moduleScript)
    if not moduleScript
        or not moduleScript:IsA("ModuleScript")
    then
        return false, nil, "invalid ModuleScript"
    end

    local finished = false
    local success = false
    local result = nil

    task.spawn(function()
        success, result = pcall(require, moduleScript)
        finished = true
    end)

    local deadline = os.clock() + Config.GAME_DB_REQUIRE_TIMEOUT
    while State.loopRunning
        and not finished
        and os.clock() < deadline
    do
        task.wait(0.03)
    end

    if not finished then
        return false, nil, "require timeout"
    end

    if not success then
        return false, nil, tostring(result)
    end

    if type(result) ~= "table" then
        return false, nil, "module returned " .. type(result)
    end

    return true, result, nil
end

function F.extractGameDBDialogueEvents(value, npcName, modulePath, output, seen, depth)
    if type(value) ~= "table" then
        return
    end

    seen = seen or {}
    depth = tonumber(depth) or 0
    if depth > 16 or seen[value] then
        return
    end
    seen[value] = true

    local eventValue = rawget(value, "event")
    if eventValue ~= nil then
        local eventName = nil
        local argument = nil

        if type(eventValue) == "string" then
            eventName = eventValue
        elseif type(eventValue) == "table" then
            eventName = eventValue.name or eventValue.Name
            argument = eventValue.argument or eventValue.Argument
        end

        if eventName then
            eventName = tostring(eventName)
            argument = argument ~= nil and tostring(argument) or ""
            local key = tostring(npcName) .. "|" .. eventName .. "|" .. argument

            if not State.gameDB.dialogueEventKeys[key] then
                State.gameDB.dialogueEventKeys[key] = true
                table.insert(output, {
                    NPC = tostring(npcName or "Unknown"),
                    Event = eventName,
                    Argument = argument,
                    Path = tostring(modulePath or ""),
                })
            end
        end
    end

    for _, child in pairs(value) do
        if type(child) == "table" then
            F.extractGameDBDialogueEvents(
                child,
                npcName,
                modulePath,
                output,
                seen,
                depth + 1
            )
        end
    end
end

function F.collectGameDBDialogueModules()
    local modules = {}
    local seen = {}

    local function scanRoot(root)
        if not root then
            return
        end

        local descendants = root:GetDescendants()
        for index, descendant in ipairs(descendants) do
            if descendant:IsA("ModuleScript")
                and descendant.Name == "NPCDialogueConfig"
                and not seen[descendant]
            then
                seen[descendant] = true
                table.insert(modules, descendant)
                if #modules >= Config.GAME_DB_DIALOGUE_MAX then
                    return
                end
            end

            if index % 600 == 0 then
                task.wait()
            end
        end
    end

    scanRoot(Workspace:FindFirstChild("NPCs"))
    if #modules < Config.GAME_DB_DIALOGUE_MAX then
        scanRoot(Workspace:FindFirstChild("Systems"))
    end

    table.sort(modules, function(a, b)
        return a:GetFullName() < b:GetFullName()
    end)

    return modules
end

function F.buildGameDBIndexes()
    local db = State.gameDB
    local modules = db.modules

    local bestiary = type(modules.BeastiaryConfig) == "table" and modules.BeastiaryConfig or {}
    local notable = type(modules.NotablePeopleConfig) == "table" and modules.NotablePeopleConfig or {}
    local characterInfo = type(modules.CharacterInfoConfig) == "table" and modules.CharacterInfoConfig or {}

    db.monsters = type(bestiary.Monsters) == "table" and bestiary.Monsters or {}
    db.notableNPCs = type(notable.NPCs) == "table" and notable.NPCs or {}
    db.enhancements = type(modules.EnhancementConfig) == "table" and modules.EnhancementConfig or {}
    db.races = type(modules.RaceConfigClient) == "table" and modules.RaceConfigClient or {}
    db.classes = type(characterInfo.Classes) == "table" and characterInfo.Classes or {}
    db.abilities = type(characterInfo.Abilities) == "table" and characterInfo.Abilities or {}
    db.dashes = type(characterInfo.Dashes) == "table" and characterInfo.Dashes or {}
    db.auras = type(characterInfo.Auras) == "table" and characterInfo.Auras or {}
    db.enchants = type(characterInfo.Enchants) == "table" and characterInfo.Enchants or {}
    db.areas = type(modules.EventAreas) == "table" and modules.EventAreas or {}

    db.statusEffects = {}
    local statusConfig = modules.StatusEffectConfig
    if type(statusConfig) == "table" then
        for key, value in pairs(statusConfig) do
            if type(value) == "table" then
                db.statusEffects[key] = value
            end
        end
    end

    local gameConfig = modules.GameConfig
    if type(gameConfig) == "table" then
        db.gameVersion = tostring(gameConfig.Version or "Unknown")
        db.gameStage = tostring(gameConfig.Stage or "Unknown")
    else
        db.gameVersion = "Unknown"
        db.gameStage = "Unknown"
    end

    db.versionMismatch =
        db.gameVersion ~= "Unknown"
        and tostring(db.referenceVersion) ~= ""
        and db.gameVersion ~= tostring(db.referenceVersion)

    local uniqueAreas = {}
    for _, areaSet in pairs(db.areas) do
        if type(areaSet) == "table" then
            for areaName, enabled in pairs(areaSet) do
                if enabled == true then
                    uniqueAreas[tostring(areaName)] = true
                end
            end
        end
    end

    db.counts = {
        Modules = F.getGameDBCount(db.modules),
        Monsters = F.getGameDBCount(db.monsters),
        NotableNPCs = F.getGameDBCount(db.notableNPCs),
        StatusEffects = F.getGameDBCount(db.statusEffects),
        Races = F.getGameDBCount(db.races),
        Classes = F.getGameDBCount(db.classes),
        Abilities = F.getGameDBCount(db.abilities),
        Dashes = F.getGameDBCount(db.dashes),
        Auras = F.getGameDBCount(db.auras),
        Enchants = F.getGameDBCount(db.enchants),
        Areas = F.getGameDBCount(uniqueAreas),
        Dialogues = F.getGameDBCount(db.dialogueByNPC),
        DialogueEvents = #db.dialogueEvents,
    }
end

function F.getGameDBSummary()
    local db = State.gameDB
    local counts = db.counts or {}
    local versionState = db.versionMismatch and "MISMATCH" or "OK"

    return table.concat({
        "=== The Veil Hub GameDB ===",
        "Status: " .. tostring(db.status)
            .. " | Loaded: " .. tostring(db.loaded)
            .. " | Loading: " .. tostring(db.loading),
        "Game: " .. tostring(db.gameVersion)
            .. " [" .. tostring(db.gameStage) .. "]"
            .. " | Reference: " .. tostring(db.referenceVersion)
            .. " | Guard: " .. versionState,
        "Modules: " .. tostring(counts.Modules or 0)
            .. " | Dialogue Configs: " .. tostring(counts.Dialogues or 0)
            .. " | Dialogue Events: " .. tostring(counts.DialogueEvents or 0),
        "Monsters: " .. tostring(counts.Monsters or 0)
            .. " | Notable NPCs: " .. tostring(counts.NotableNPCs or 0)
            .. " | Status Effects: " .. tostring(counts.StatusEffects or 0),
        "Races: " .. tostring(counts.Races or 0)
            .. " | Classes: " .. tostring(counts.Classes or 0)
            .. " | Abilities: " .. tostring(counts.Abilities or 0),
        "Dashes: " .. tostring(counts.Dashes or 0)
            .. " | Auras: " .. tostring(counts.Auras or 0)
            .. " | Enchants: " .. tostring(counts.Enchants or 0),
        "Known Areas: " .. tostring(counts.Areas or 0)
            .. " | Module Errors: " .. tostring(#db.moduleErrors),
        "Last Refresh: "
            .. (db.lastRefreshAt > 0 and os.date("%H:%M:%S", db.lastRefreshAt) or "Never"),
