            .. " | Failures " .. tostring(State.cellFarm.failures)
            .. " | Last " .. tostring(State.cellFarm.lastFailure),
        "Route: " .. tostring(#State.routePoints) .. " points | " .. tostring(State.routeStatus)
            .. " | Waypoints: " .. tostring(#State.waypointOrder),
        "Conflicts: " .. tostring(State.movement.conflicts)
            .. " | Preemptions: " .. tostring(State.movement.preemptions)
            .. " | Last Conflict: " .. tostring(State.movement.lastConflict),
        "Drop Cache: " .. tostring(F.countTableKeys(State.dropCache))
            .. " | Monster Cache: " .. tostring(F.countTableKeys(State.monsterCache)),
        "Errors: " .. tostring(State.errors.count)
            .. " | Last Source: " .. tostring(State.errors.lastSource),
        "Last Error: " .. tostring(State.errors.lastMessage),
        "Recent Events: " .. (#eventLines > 0 and table.concat(eventLines, " || ") or "None"),
    }, "\n")
end

function F.copyDiagnosticsReport()
    local report = F.buildDiagnosticsReport()
    State.diagnosticsReport = report

    local clipboard = nil
    if type(setclipboard) == "function" then
        clipboard = setclipboard
    elseif type(toclipboard) == "function" then
        clipboard = toclipboard
    end

    if clipboard then
        local success = pcall(clipboard, report)
        if success then
            F.notify("Diagnostics", "Report copied to clipboard.", "success", 2.0)
            return true
        end
    end

    print(report)
    F.notify("Diagnostics", "Clipboard unavailable; report printed to console.", "info", 2.5)
    return false
end

function F.resetSessionDiagnostics()
    local startedAt = State.sessionStats.startedAt
    local startedUnix = State.sessionStats.startedUnix

    for key, value in pairs(State.sessionStats) do
        if type(value) == "number" then
            State.sessionStats[key] = 0
        end
    end

    State.sessionStats.startedAt = startedAt
    State.sessionStats.startedUnix = startedUnix
    State.movementTelemetry.serverCorrections = 0
    State.diagnosticsEvents = {}
    State.errors.count = 0
    State.errors.lastSource = "None"
    State.errors.lastMessage = "None"
    State.errors.lastTime = 0
    F.resetAdaptiveMovement()
    F.updateDiagnostics()
end

function F.updateDiagnostics()
    local elapsed = math.max(0, os.clock() - State.sessionStats.startedAt)
    local lootPerMinute = elapsed > 0 and (State.sessionStats.lootConfirmed * 60 / elapsed) or 0
    local report = F.buildDiagnosticsReport()
    State.diagnosticsReport = report

    if State.diagnosticsLabel and State.diagnosticsLabel.Parent then
        State.diagnosticsLabel.Text = report
    end

    if State.statsLabel and State.statsLabel.Parent then
        State.statsLabel.Text = table.concat({
            "Session Started: " .. os.date("%Y-%m-%d %H:%M:%S", State.sessionStats.startedUnix),
            "Session Time: " .. string.format("%02d:%02d:%02d", math.floor(elapsed / 3600), math.floor(elapsed / 60) % 60, math.floor(elapsed) % 60),
            "Inventory: " .. tostring(State.inventoryCapacityCurrent) .. "/" .. tostring(State.inventoryCapacityMax),
            "Loot Confirmed: " .. tostring(State.sessionStats.lootConfirmed) .. " | Loot/min: " .. string.format("%.2f", lootPerMinute),
            "Pickup Attempts: " .. tostring(State.sessionStats.pickupAttempts) .. " | Failures: " .. tostring(State.sessionStats.pickupFailures),
            "Sold Confirmed: " .. tostring(State.sessionStats.soldConfirmed) .. " | Sell Runs: " .. tostring(State.sessionStats.sellRuns),
            "Farm Recoveries: " .. tostring(State.sessionStats.farmRecoveries) .. " | Hop Attempts: " .. tostring(State.sessionStats.serverHopAttempts),
            "Successful Server Changes: " .. tostring(State.sessionStats.successfulServerChanges) .. " | Servers Visited: " .. tostring(State.serversVisitedCount),
            "Gacha Attempts: " .. tostring(State.sessionStats.gachaAttempts) .. " | Cycles: " .. tostring(State.gachaPurchaseCycles),
            "Nightcall Uses: " .. tostring(State.sessionStats.nightCallConfirmedUses),
            "Finisher Local Attempts: " .. tostring(State.sessionStats.finisherLocalAttempts),
        }, "\n")
    end

    F.updateMovementStatus()
    F.updateWaypointStatus()
    F.updateGameDBUI()
    F.updateNPCIntelUI()
    if F.updateGoalUI then
        F.updateGoalUI()
    end
    if F.updateCellFarmUI then
        F.updateCellFarmUI()
    end
end

