function F.getQueueOnTeleport()
    local queueFunction = nil

    pcall(function()
        if type(queue_on_teleport)
            == "function"
        then
            queueFunction =
                queue_on_teleport
        end
    end)

    if queueFunction then
        return queueFunction
    end

    pcall(function()
        if syn
            and type(
                syn.queue_on_teleport
            ) == "function"
        then
            queueFunction =
                syn.queue_on_teleport
        end
    end)

    if queueFunction then
        return queueFunction
    end

    pcall(function()
        if fluxus
            and type(
                fluxus.queue_on_teleport
            ) == "function"
        then
            queueFunction =
                fluxus.queue_on_teleport
        end
    end)

    return queueFunction
end

function F.queueHubReload()
    if not State.persistentHopEnabled then
        return true, "Persistence disabled"
    end

    local url =
        F.trimText(
            State.hubReloadUrl
        )

    if url == "" then
        return false, "Raw URL not configured"
    end

    if not string.match(url, "^https://") then
        return false, "Reload URL must use HTTPS"
    end

    if type(loadstring) ~= "function" then
        return false, "Dynamic loading is unsupported in this environment"
    end

    local queueFunction =
        F.getQueueOnTeleport()

    if not queueFunction then
        return false, "queue_on_teleport unsupported"
    end

    local queuedCode =
        "task.wait(2); "
        .. "local ok,src=pcall(function() return game:HttpGet("
        .. string.format("%q", url)
        .. ") end); "
        .. "if ok and src then "
        .. "local fn=loadstring(src); "
        .. "if fn then fn() end end"

    local success, err =
        pcall(
            queueFunction,
            queuedCode
        )

    return success, err
end


