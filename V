function F.playLoadingSequence()
    task.spawn(function()
        local steps = {
            {0.20, "Preparing interface"},
            {0.48, "Loading components"},
            {0.74, "Applying theme"},
            {1.00, "Finalizing"}
        }

        for _, step in ipairs(steps) do
            if not State.loopRunning or not loadingFrame.Parent then
                return
            end

            loadingStatus.Text = step[2]
            loadingPercent.Text = tostring(math.floor(step[1] * 100)) .. "%"
            F.tweenObject(loadingFill, 0.38, {Size = UDim2.new(step[1], 0, 1, 0)}, Enum.EasingStyle.Quart)
            task.wait(State.reduceMotion and 0.05 or 0.42)
        end

        if not State.loopRunning then
            return
        end

        loadingFrame.Visible = false
        mainFrame.Visible = true
        shadowFrame.Visible = false

        local revealScale = Instance.new("UIScale")
        revealScale.Scale = State.reduceMotion and 1 or 0.97
        revealScale.Parent = mainFrame

        if not State.reduceMotion then
            F.tweenObject(revealScale, 0.30, {Scale = 1}, Enum.EasingStyle.Quart)
            task.delay(0.34, function()
                if revealScale.Parent then
                    revealScale:Destroy()
                end
            end)
        else
            revealScale:Destroy()
        end

        F.notify("Interface ready", "The Veil Hub is ready to use.", "success", 2.5)
    end)
end

