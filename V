function F.cellFarmHop(token, reason)
    if not F.isCellFarmActive(token) then
        return false
    end

    F.setCellResumeFlag(true)

    F.setCellFarmStage(
        "SERVER HOP",
        tostring(reason or "Searching next server")
    )

    F.stopLootLock("CELL")
    F.stopMovementFlight("CELL")
    F.stopMovementFlight("MONSTER_LOCK")
    F.releaseMovement("CELL")
    F.releaseMovement("MONSTER_LOCK")

    State.cellFarm.hops =
        State.cellFarm.hops + 1
    F.markConfigDirty()
    F.saveFarmConfig(true)

    local success =
        F.serverHop(
            reason or "Cell Farm",
            {
                skipSell = true,
                cellResume = true,
                requirePersistence = true,
            }
        )

    if not success then
        F.recordCellFailure(
            "Server hop could not start"
        )
    end

    return success
end

function F.runCellFarm(token, resumed)
    local needsMenuBootstrap =
        resumed
        or State.cellFarm.launchFromMenu
        or (
            F.isAnyCellMenuStageVisible
            and F.isAnyCellMenuStageVisible()
        )
        or not F.isCellGameplayReady()

    if needsMenuBootstrap then
        local bootstrapped =
            F.bootstrapCellMenu(
                token
            )

        if not bootstrapped then
            F.recordCellFailure(
                "Menu bootstrap timeout"
            )
            F.setCellFarmStage(
                "ERROR",
                "Could not enter gameplay"
            )

            F.setCellMenuHubHidden(
                false
            )

            return false
        end
    end

    State.cellFarm.launchFromMenu =
        false

    if not F.isCellFarmActive(token) then
        return false
    end

    -- Daily Rewards may appear a moment after Current Server completes.
    -- Keep a short local watcher so it never covers later automation.
    F.startCellDailyRewardAutoClose(
        token
    )

    F.setCellFarmStage(
        "WORLD READY",
        "Waiting for map/remotes"
    )

    if not F.ensureWorldReady(
        Config.WORLD_READY_TIMEOUT
    ) then
        F.recordCellFailure(
            "World readiness timeout"
        )
        return F.cellFarmHop(
            token,
            "World readiness timeout"
        )
    end

    F.setCellFarmStage(
        "WORLD READY",
        "Cradle interaction will settle at target"
    )

    State.cellFarm.runs =
        State.cellFarm.runs + 1
    F.markConfigDirty()

    local boss =
        F.getCellBoss()

    while F.isCellFarmActive(token)
        and not boss
    do
        local reached =
            F.flyToCellCradle(
                token
            )

        if not reached then
            F.recordCellFailure(
                "Could not reach The Cradle; retrying same server"
            )

            F.setCellFarmStage(
                "CRADLE RETRY",
                "Cradle unavailable temporarily - NO SERVER HOP"
            )

            if not F.cellFarmWait(
                token,
                Config.CELL_CRADLE_SAME_SERVER_RETRY
            ) then
                return false
            end
        else
            local summonOk,
                summonedBoss =
                    F.summonCellBoss(
                        token
                    )

            if summonOk
                and summonedBoss
            then
                boss =
                    summonedBoss
                break
            end

            if Config.CELL_DIALOG_CHECKPOINT_ONLY
                and State.cellFarm.dialogCheckpointConfirmed
            then
                F.setCellFarmStage(
                    "DIALOG CHECKPOINT HOLD",
                    "Dialog stage complete. Pipeline intentionally paused here."
                )

                while F.isCellFarmActive(token)
                    and Config.CELL_DIALOG_CHECKPOINT_ONLY
                do
                    task.wait(0.25)
                end

                return false
            end

            F.recordCellFailure(
                "Cell summon not confirmed; retrying same server instead of hopping"
            )

            F.setCellFarmStage(
                "SUMMON RETRY",
                "Conversation/boss not confirmed - staying in this server"
            )

            if not F.cellFarmWait(
                token,
                Config.CELL_CRADLE_SAME_SERVER_RETRY
            ) then
                return false
            end

            boss =
                F.getCellBoss()
        end
    end

    if not F.isCellFarmActive(token) then
        return false
    end

    local dropSnapshot =
        F.captureCellDropSnapshot()

    local rewardChestSnapshot =
        F.captureCellRewardChestSnapshot()

    State.cellFarm.rewardChestsFound = 0
    State.cellFarm.rewardChestsOpened = 0
    State.cellFarm.rewardChestRemoteCalls = 0
    State.cellFarm.rewardLastChestDebugId = "None"
    State.cellFarm.rewardDropWaves = 0
    State.cellFarm.rewardDropCount = 0
    State.cellFarm.lootMoveTarget = "None"
    State.cellFarm.lootMoveDistance = -1
    State.cellFarm.lootMoveAttempts = 0
    State.cellFarm.lootMoveConfirmed = false
    State.cellFarm.lootKnownRemaining = 0
    State.cellFarm.bossDefeatEventConfirmed = false
    State.cellFarm.bossDefeatEvents = 0
    State.cellFarm.bossDefeatLast = "None"
    State.cellFarm.itemNotifyEvents = 0
    State.cellFarm.itemNotifyItems = 0
    State.cellFarm.itemNotifyLast = "None"
    State.cellFarm.nearbyBossPlayerName = "None"
    State.cellFarm.nearbyBossPlayerDistance = -1
    State.cellFarm.nearbyBossPlayerEvidence = "None"
    State.cellFarm.playerAvoidHopTriggered = false
    State.cellFarm.playerAvoidHopAttempts = 0

    local rewardEventObserver =
        F.startCellRewardEventObserver(
            token
        )

    local fought =
        F.fightCellBoss(
            token,
            boss
        )

    if not F.isCellFarmActive(token) then
        F.stopCellRewardEventObserver(
            rewardEventObserver
        )

        return false
    end

    if not fought
        and State.cellFarm.playerAvoidHopTriggered
    then
        F.setCellFarmStage(
            "PLAYER HOP ACTIVE",
            "Other player detected near The Cell Of Life - normal fight recovery is blocked"
        )

        while F.isCellFarmActive(token)
            and State.cellFarm.playerAvoidHopTriggered
        do
            if State.serverHopBusy then
                task.wait(0.25)
            else
                -- The avoidance helper normally handles retries. This guard
                -- prevents accidental same-server recovery if a future edit
                -- returns from it early.
                local avoidStillActive =
                    F.handleCellBossPlayerAvoidance(
                        token,
                        boss
                    )

                if not avoidStillActive then
                    State.cellFarm.playerAvoidHopTriggered =
                        false
                    break
                end
            end
        end

        if State.cellFarm.playerAvoidHopTriggered then
            return false
        end
    end

    if not fought then
        F.recordCellFailure(
            "Cell fight recovery interrupted; staying in the same server"
        )

        F.setCellFarmStage(
            "FIGHT RECOVERY",
            "Fight interrupted - waiting/reacquiring The Cell Of Life; NO HOP"
        )

        while F.isCellFarmActive(token)
            and not fought
        do
            local liveBoss =
                F.getCellBoss()

            if liveBoss then
                boss =
                    liveBoss

                fought =
                    F.fightCellBoss(
                        token,
                        boss
                    )
            elseif State.cellFarm.lastBossHealthState
                    == "DEFEATED"
                or (
                    tonumber(
                        State.cellFarm.lastBossMaxHealth
                    )
                    or 0
                ) > 0
                and (
                    tonumber(
                        State.cellFarm.lastBossHealth
                    )
                    or 0
                ) <= 0
            then
                fought = true
                break
            else
                local rewardCandidates =
                    F.collectCellRewardChestCandidates(
                        rewardChestSnapshot
                    )

                if #rewardCandidates > 0 then
                    fought = true
                    break
                end

                State.cellFarm.status =
                    "Waiting for boss/reward evidence - staying in this server"

                if not F.cellFarmWait(
                    token,
                    1.00
                ) then
                    return false
                end
            end
        end

        if not F.isCellFarmActive(token) then
            return false
        end
    end

    State.cellFarm.kills =
        State.cellFarm.kills + 1
    State.cellFarm.lastBossHealth = 0
    State.cellFarm.lastBossHealthPercent = 0
    State.cellFarm.lastBossHealthState = "DEFEATED"
    F.markConfigDirty()

    if F.updateCellFarmUI then
        F.updateCellFarmUI()
    end

    F.setCellFarmStage(
        "BOSS DEATH / REWARD WATCH",
        State.cellFarm.bossDefeatEventConfirmed
            and "CONFIRMED CREATION UNDONE - watching for all 5 reward chests"
            or "Boss death detected - waiting for BossDefeatLabel and all 5 reward chests"
    )

    local rewardsReady =
        F.processCellRewardChests(
            token,
            rewardChestSnapshot,
            dropSnapshot
        )

    if not F.isCellFarmActive(token) then
        F.stopCellRewardEventObserver(
            rewardEventObserver
        )

        return false
    end

    if not rewardsReady then
        -- processCellRewardChests only returns false on cancellation.
        -- Keeping this guard prevents accidental hop if future edits add
        -- another failure path.
        F.setCellFarmStage(
            "REWARD WAIT",
            "Reward sequence incomplete - hop blocked"
        )

        F.stopCellRewardEventObserver(
            rewardEventObserver
        )

        return false
    end

    F.stopCellRewardEventObserver(
        rewardEventObserver
    )

    local collectedLoot,
        lootComplete =
            F.collectCellBossLoot(
                token,
                dropSnapshot
            )

    if not F.isCellFarmActive(token) then
        return false
    end

    if not lootComplete then
        F.setCellFarmStage(
            "LOOT INCOMPLETE",
            "Known post-chest drops remain - Bundle/Sell/Hop blocked"
        )

        return false
    end

    State.cellFarm.status =
        "All post-chest loot collected: "
        .. tostring(collectedLoot)
        .. " item(s)"

    F.setCellFarmStage(
        "LOOT SETTLE",
        "Waiting for collected drops to finish syncing"
    )

    if not F.cellFarmWait(
        token,
        Config.CELL_POST_LOOT_SETTLE
    ) then
        return false
    end

    F.openCellBundles(
        token
    )

    if not F.isCellFarmActive(token) then
        return false
    end

    F.setCellFarmStage(
        "BUNDLE SETTLE",
        "Waiting for bundle rewards to finish syncing"
    )

    F.waitForCellInventoryStable(
        token,
        Config.CELL_INVENTORY_STABLE_WINDOW,
        Config.CELL_POST_BUNDLE_SETTLE + 4
    )

    if not F.isCellFarmActive(token) then
        return false
    end

    local soldAll =
        F.sellCellInventory(
            token
        )

    if not soldAll then
        F.recordCellFailure(
            "Some lower-rarity items could not be sold; carrying them to next server"
        )
    end

    if not F.isCellFarmActive(token) then
        return false
    end

    F.setCellFarmStage(
        "VERIFY INVENTORY",
        "Waiting for sell/filter changes to settle"
    )

    F.waitForCellInventoryStable(
        token,
        Config.CELL_INVENTORY_STABLE_WINDOW,
        Config.CELL_POST_SELL_SETTLE + 5
    )

    if not F.isCellFarmActive(token) then
        return false
    end

    local remainingSellable =
        F.collectCellSellCandidates()

    if #remainingSellable > 0 then
        F.setCellFarmStage(
            "SELL VERIFY RETRY",
            "Found remaining sellable items"
        )

        F.sellCellInventory(
            token
        )

        if not F.isCellFarmActive(token) then
            return false
        end

        F.waitForCellInventoryStable(
            token,
            Config.CELL_INVENTORY_STABLE_WINDOW,
            Config.CELL_POST_SELL_SETTLE + 4
        )
    end

    if not F.isCellFarmActive(token) then
        return false
    end

    F.setCellFarmStage(
        "READY TO HOP",
        "Loot, bundles, filtering and selling complete"
    )

    if not F.cellFarmWait(
        token,
        Config.CELL_PRE_HOP_DELAY
    ) then
        return false
    end

    return F.cellFarmHop(
        token,
        "Cell run complete"
    )
end

function F.stopCellFarm(restorePrevious, reason)
    F.setCellResumeFlag(false)

    local wasEnabled =
        State.cellFarm.enabled
        or State.cellFarm.running

    State.cellFarm.enabled = false
    State.cellFarm.running = false
    State.cellFarm.token =
        State.cellFarm.token + 1
    State.cellFarm.boss = nil
    State.cellFarm.stage = "OFF"
    State.cellFarm.status =
        tostring(reason or "Stopped")

    F.stopLootLock("CELL")
    F.stopMovementFlight("CELL")
    F.stopMovementFlight("MONSTER_LOCK")
    F.releaseMovement("CELL")
    F.releaseMovement("MONSTER_LOCK")

    if restorePrevious ~= false then
        F.restoreCellPreviousState()
    else
        State.cellFarm.restore = nil
    end

    if State.cellFarmToggle then
        State.cellFarmToggle:SetSilent(false)
    end

    State.cellFarm.launchFromMenu =
        false

    F.setCellFarmHubHidden(
        false
    )

    F.updateCellFarmUI()
    F.markConfigDirty()

    if wasEnabled then
        F.recordDiagnosticEvent(
            "CellFarm",
            "Stopped: "
                .. tostring(reason or "Stopped")
        )
    end

    return true
end

function F.startCellFarm(resumed)
