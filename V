function F.getDropRarity(drop)
    if not drop then
        return Config.DROP_RARITY_BY_KEY.unknown
    end

    local rawRarity = nil

    pcall(function()
        rawRarity =
            drop:GetAttribute(
                "Rarity"
            )
    end)

    if rawRarity == nil then
        local valueObject =
            drop:FindFirstChild(
                "Rarity"
            )

        if valueObject
            and valueObject:IsA(
                "StringValue"
            )
        then
            rawRarity =
                valueObject.Value
        end
    end

    return F.normalizeDropRarity(
        rawRarity
    )
end

function F.isDropCandidate(object)
    if not object
        or not object.Parent
    then
        return false
    end

    if object:IsA("Model")
        or object:IsA("BasePart")
        or object:IsA("Tool")
    then
        return true
    end

    local hasRarity = false

    pcall(function()
        hasRarity =
            object:GetAttribute(
                "Rarity"
            )
            ~= nil
    end)

    return hasRarity
end

function F.collectDropObjects(folder)
    local result = {}
    local seen = {}

    if not folder then
        return result
    end

    local function walk(container)
        for _, child in ipairs(
            container:GetChildren()
        ) do
            if child:IsA("Folder") then
                local folderHasRarity = false

                pcall(function()
                    folderHasRarity =
                        child:GetAttribute(
                            "Rarity"
                        )
                        ~= nil
                end)

                if folderHasRarity then
                    if not seen[child] then
                        seen[child] = true
                        table.insert(
                            result,
                            child
                        )
                    end
                else
                    walk(child)
                end
            elseif F.isDropCandidate(
                child
            ) then
                if not seen[child] then
                    seen[child] = true
                    table.insert(
                        result,
                        child
                    )
                end
            elseif #child:GetChildren() > 0 then
                walk(child)
            end
        end
    end

    walk(folder)

    return result
end

