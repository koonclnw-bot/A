function F.findBestVisibleGuiButtonByText(expectedText, root)
    root =
        root
        or LocalPlayer:FindFirstChildOfClass(
            "PlayerGui"
        )

    if not root then
        return nil
    end

    local wanted =
        string.lower(
            F.trimText(expectedText)
        )

    local best = nil
    local bestScore = -math.huge

    local function buttonMatches(button)
        if button:IsA("TextButton") then
            local own =
                string.lower(
                    F.trimText(
                        button.Text
                    )
                )

            if own == wanted then
                return true
            end
        end

        for _, child in ipairs(
            button:GetDescendants()
        ) do
            if (
                child:IsA("TextLabel")
                or child:IsA("TextButton")
            )
                and F.isGuiObjectActuallyVisible(child)
                and string.lower(
                    F.trimText(child.Text)
                ) == wanted
            then
                return true
            end
        end

        return false
    end

    local candidates = {}

    if root:IsA("GuiButton") then
        table.insert(
            candidates,
            root
        )
    end

    for _, object in ipairs(
        root:GetDescendants()
    ) do
        if object:IsA("GuiButton") then
            table.insert(
                candidates,
                object
            )
        end
    end

    for _, button in ipairs(
        candidates
    ) do
        if F.isGuiObjectActuallyVisible(button)
            and buttonMatches(button)
        then
            local size =
                button.AbsoluteSize

            local area =
                math.max(1, size.X)
                * math.max(1, size.Y)

            local score =
                area
                + (tonumber(button.ZIndex) or 0)
                    * 1000

            if score > bestScore then
                bestScore = score
                best = button
            end
        end
    end

    return best
end

function F.findSlotOneButton()
    local saveGui =
        F.getCellMenuRoot(
            "SaveSlotsGui"
        )

    local direct =
        F.findBestVisibleGuiButtonByText(
            "Slot 1",
            saveGui
        )

    if direct then
        return direct
    end

    local slotText =
        F.findVisibleGuiTextObject(
            "Slot 1"
        )

    if not slotText then
        return nil
    end

    local current = slotText

    for _ = 1, 8 do
        if not current then
            break
        end

        if current:IsA("GuiButton") then
            return current
        end

        current = current.Parent
    end

    -- Some versions place the Slot 1 label and the clickable overlay as
    -- siblings. Find a visible button whose rectangle contains the label.
    local center =
        slotText.AbsolutePosition
        + slotText.AbsoluteSize / 2

    local container = slotText.Parent

    for _ = 1, 7 do
        if not container then
            break
        end

        for _, object in ipairs(
            container:GetDescendants()
        ) do
            if object:IsA("GuiButton")
                and F.isGuiObjectActuallyVisible(object)
            then
                local pos = object.AbsolutePosition
                local size = object.AbsoluteSize

                if center.X >= pos.X
                    and center.X <= pos.X + size.X
                    and center.Y >= pos.Y
                    and center.Y <= pos.Y + size.Y
                then
                    return object
                end
            end
        end

        container = container.Parent
    end

    return nil
end

