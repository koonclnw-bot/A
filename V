local draggingWindow = false
local dragInput = nil
local dragStart = nil
local startPosition = nil

function F.syncShadowPosition()
    shadowFrame.Position = UDim2.new(
        mainFrame.Position.X.Scale,
        mainFrame.Position.X.Offset + 5,
        mainFrame.Position.Y.Scale,
        mainFrame.Position.Y.Offset + 7
    )
end

topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        draggingWindow = true
        dragStart = input.Position
        startPosition = mainFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                draggingWindow = false
            end
        end)
    end
end)

topBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingWindow and input == dragInput then
        local delta = input.Position - dragStart
        local viewport = camera.ViewportSize
        local scaledWidth = Config.WINDOW_WIDTH * mainScale.Scale
        local scaledHeight = Config.WINDOW_HEIGHT * mainScale.Scale

        local absoluteX = startPosition.X.Scale * viewport.X + startPosition.X.Offset + delta.X
        local absoluteY = startPosition.Y.Scale * viewport.Y + startPosition.Y.Offset + delta.Y

        absoluteX = math.clamp(absoluteX, 6, math.max(6, viewport.X - scaledWidth - 6))
        absoluteY = math.clamp(absoluteY, 6, math.max(6, viewport.Y - scaledHeight - 6))

        mainFrame.Position = UDim2.new(
            startPosition.X.Scale,
            absoluteX - (startPosition.X.Scale * viewport.X),
            startPosition.Y.Scale,
            absoluteY - (startPosition.Y.Scale * viewport.Y)
        )
        F.syncShadowPosition()
    end
end)

-- =========================================================
-- PAGE SWITCH WITH FADE + SLIDE
-- =========================================================

function F.selectPage(name)
    local newPage = State.pages[name]
    if not newPage then
        return
    end

    if State.currentPageName == name and newPage.Visible then
        return
    end

    local oldPage = State.pages[State.currentPageName]
    State.currentPageName = name
    statusText.Text = name .. " | Ready"

    if oldPage and oldPage ~= newPage then
        if State.reduceMotion then
            oldPage.Visible = false
        else
            local oldTween = F.tweenObject(oldPage, 0.16, {
                GroupTransparency = 1,
                Position = UDim2.new(0, -8, 0, 0)
            })
            if oldTween then
                oldTween.Completed:Connect(function()
                    if oldPage ~= State.pages[State.currentPageName] then
                        oldPage.Visible = false
                    end
                end)
            end
        end
    end

    newPage.Visible = true
    if State.reduceMotion then
        newPage.GroupTransparency = 0
        newPage.Position = UDim2.new(0, 0, 0, 0)
    else
        newPage.GroupTransparency = 1
        newPage.Position = UDim2.new(0, 10, 0, 0)
        F.tweenObject(newPage, 0.22, {
            GroupTransparency = 0,
            Position = UDim2.new(0, 0, 0, 0)
        }, Enum.EasingStyle.Quart)
    end

    for pageName, button in pairs(State.pageButtons) do
        local active = pageName == name
        local indicator = pageIndicators[pageName]

        F.tweenObject(button, 0.16, {
            BackgroundColor3 = active and Config.THEME.SidebarButtonActive or Config.THEME.SidebarButton,
            TextColor3 = active and Config.THEME.Text or Config.THEME.SubText
        })

        if indicator then
            F.tweenObject(indicator, 0.16, {
                BackgroundTransparency = active and 0 or 1
            })
        end
    end
end

