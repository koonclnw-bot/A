        UDim2.new(),
        Enum.Font.GothamSemibold,
        15,
        Config.THEME.Text,
        Enum.TextXAlignment.Left
    )
    titleLabel.AutomaticSize = Enum.AutomaticSize.X
    titleLabel.LayoutOrder = 1

    local stateText = F.createTextLabel(
        row,
        "OFF",
        UDim2.new(0, 28, 0, 18),
        UDim2.new(),
        Enum.Font.GothamBold,
        10,
        Config.THEME.Disabled,
        Enum.TextXAlignment.Center
    )
    stateText.LayoutOrder = 2

    local track = Instance.new("Frame")
    track.Size = UDim2.new(0, 46, 0, 24)
    track.BackgroundColor3 = Config.THEME.Stroke
    track.BorderSizePixel = 0
    track.LayoutOrder = 3
    track.Parent = row
    F.createCorner(track, 12)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 20, 0, 20)
    knob.Position = UDim2.new(0, 2, 0, 2)
    knob.BackgroundColor3 = Config.THEME.White
    knob.BorderSizePixel = 0
    knob.Parent = track
    F.createCorner(knob, 10)

    local click = Instance.new("TextButton")
    click.Size = UDim2.new(1, 0, 1, 0)
    click.BackgroundTransparency = 1
    click.Text = ""
    click.ZIndex = 10
    click.Parent = card

    local state = initialValue == true
    local callback = nil
    local disabled = false
    local lastClick = 0
    local toggle = {}

    local function render(animated)
        local trackColor = state and Config.THEME.Accent or Config.THEME.Stroke
        local knobPosition =
            state
            and UDim2.new(1, -22, 0, 2)
            or UDim2.new(0, 2, 0, 2)

        stateText.Text = state and "ON" or "OFF"
        stateText.TextColor3 =
            state and Config.THEME.Green or Config.THEME.Disabled

        if animated then
            F.tweenObject(track, 0.16, {BackgroundColor3 = trackColor})
            F.tweenObject(knob, 0.16, {Position = knobPosition})
        else
            track.BackgroundColor3 = trackColor
            knob.Position = knobPosition
        end
    end

    function toggle:Set(value, fireCallback)
        if disabled then
            return
        end

        state = value == true
        render(true)

        if fireCallback and callback then
            callback(state)
        end
    end

    function toggle:SetSilent(value)
        state = value == true
        render(true)
    end

    function toggle:Get()
        return state
    end

    function toggle:SetDisabled(value)
        disabled = value == true
        click.Active = not disabled
        card.BackgroundTransparency = disabled and 0.35 or 0

        stateText.TextColor3 =
            disabled
            and Config.THEME.Disabled
            or (
                state
                and Config.THEME.Green
                or Config.THEME.Disabled
            )
    end

    function toggle:OnChanged(func)
        callback = func
    end

    click.MouseButton1Click:Connect(function()
        local now = os.clock()

        if disabled
            or (now - lastClick) < 0.12
        then
            return
        end

        lastClick = now
        toggle:Set(not state, true)
    end)

    render(false)
    return toggle, card
end

function F.createSlider(parent, title, minimum, maximum, default, suffix, step)
    local card = F.createCard(parent, 72)
    step = math.max(step or 1, 0.001)

    local header = Instance.new("Frame")
    header.Size = UDim2.new(1, -32, 0, 28)
    header.Position = UDim2.new(0, 16, 0, 4)
    header.BackgroundTransparency = 1
    header.Parent = card

    local headerLayout = Instance.new("UIListLayout")
    headerLayout.FillDirection = Enum.FillDirection.Horizontal
    headerLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
    headerLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    headerLayout.Padding = UDim.new(0, 8)
    headerLayout.SortOrder = Enum.SortOrder.LayoutOrder
    headerLayout.Parent = header

    local titleLabel = F.createTextLabel(
        header,
        title,
        UDim2.new(0, 0, 0, 22),
        UDim2.new(),
        Enum.Font.GothamSemibold,
        15,
        Config.THEME.Text,
        Enum.TextXAlignment.Left
    )
    titleLabel.AutomaticSize = Enum.AutomaticSize.X
    titleLabel.LayoutOrder = 1

    local valueLabel = F.createTextLabel(
        header,
        tostring(default) .. (suffix or ""),
        UDim2.new(0, 78, 0, 22),
        UDim2.new(),
        Enum.Font.GothamBold,
        12,
        Config.THEME.SubText,
        Enum.TextXAlignment.Left
    )
    valueLabel.LayoutOrder = 2

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -32, 0, 7)
    track.Position = UDim2.new(0, 16, 0, 47)
    track.BackgroundColor3 = Config.THEME.Card2
    track.BorderSizePixel = 0
    track.Parent = card
    F.createCorner(track, 4)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Config.THEME.Accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    F.createCorner(fill, 4)

    local thumb = Instance.new("Frame")
    thumb.Size = UDim2.new(0, 18, 0, 18)
    thumb.AnchorPoint = Vector2.new(0.5, 0.5)
    thumb.Position = UDim2.new(0, 0, 0.5, 0)
    thumb.BackgroundColor3 = Config.THEME.White
    thumb.BorderSizePixel = 0
    thumb.ZIndex = 5
    thumb.Parent = track
    F.createCorner(thumb, 9)
    F.createStroke(thumb, Config.THEME.Accent, 0.25, 1)

    local hitbox = Instance.new("TextButton")
    hitbox.Size = UDim2.new(1, 0, 0, 34)
    hitbox.Position = UDim2.new(0, 0, 0.5, -17)
    hitbox.BackgroundTransparency = 1
    hitbox.Text = ""
    hitbox.ZIndex = 10
    hitbox.Parent = track

    local dragging = false
    local value = default
    local callback = nil
    local slider = {}
    local lastCallback = 0

    local function snap(raw)
        local snapped = minimum + math.floor(((raw - minimum) / step) + 0.5) * step
        return math.clamp(snapped, minimum, maximum)
    end

    local function updateVisual(animated)
        local percent = (value - minimum) / (maximum - minimum)
        percent = math.clamp(percent, 0, 1)

        local fillGoal = UDim2.new(percent, 0, 1, 0)
        local thumbGoal = UDim2.new(percent, 0, 0.5, 0)

        if animated and not dragging then
            F.tweenObject(fill, 0.12, {Size = fillGoal})
            F.tweenObject(thumb, 0.12, {Position = thumbGoal})
        else
            fill.Size = fillGoal
            thumb.Position = thumbGoal
        end

        valueLabel.Text = tostring(value) .. (suffix or "")
    end

    local function dispatch()
        if not callback then
            return
        end

        local now = os.clock()
        if dragging and (now - lastCallback) < 0.03 then
            return
        end
        lastCallback = now
        callback(value)
    end

    local function setFromX(x)
        local width = track.AbsoluteSize.X
        if width <= 0 then
            return
        end

        local percent = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
        value = snap(minimum + ((maximum - minimum) * percent))
        updateVisual(false)
        dispatch()
    end

    function slider:Get()
        return value
    end

    function slider:Set(newValue)
        value = snap(newValue)
        updateVisual(true)
        dispatch()
    end

    function slider:SetSilent(newValue)
        value = snap(newValue)
        updateVisual(false)
    end

    function slider:OnChanged(func)
        callback = func
    end

    hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            setFromX(input.Position.X)
            F.tweenObject(thumb, 0.10, {Size = UDim2.new(0, 22, 0, 22)})
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            setFromX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            if dragging then
                dragging = false
                F.tweenObject(thumb, 0.12, {Size = UDim2.new(0, 18, 0, 18)})
                updateVisual(true)
                dispatch()
            end
        end
    end)

    updateVisual(false)
    return slider, card
end

