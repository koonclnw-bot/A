function F.applyResponsiveScale()
    local currentCamera = F.getCurrentCamera()
    local viewport =
        currentCamera and currentCamera.ViewportSize
        or Vector2.new(1366, 768)

    local widthScale = viewport.X / 900
    local heightScale = viewport.Y / 620
    local responsive = math.clamp(math.min(widthScale, heightScale), 0.70, 1)
    local finalScale = responsive * State.userUiScale

    mainScale.Scale = finalScale
    shadowScale.Scale = finalScale

    shadowFrame.Position = UDim2.new(
        mainFrame.Position.X.Scale,
        mainFrame.Position.X.Offset + 5,
        mainFrame.Position.Y.Scale,
        mainFrame.Position.Y.Offset + 7
    )
end

local viewportConnection = nil

function F.bindViewportCamera()
    if viewportConnection then
        viewportConnection:Disconnect()
        viewportConnection = nil
    end

    local currentCamera = F.getCurrentCamera()

    if currentCamera then
        viewportConnection =
            currentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(
                F.applyResponsiveScale
            )
    end

    F.applyResponsiveScale()
end

workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(F.bindViewportCamera)
