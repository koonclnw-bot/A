            and type(debug.info) == "function"
        then
            name =
                tostring(
                    debug.info(
                        fn,
                        "n"
                    )
                    or ""
                )
        elseif debug
            and type(debug.getinfo) == "function"
        then
            local info =
                debug.getinfo(
                    fn
                )

            name =
                tostring(
                    info
                    and info.name
                    or ""
                )
        end
    end)

    return name
end

function F.getCellFunctionDebugSource(fn)
    if type(fn) ~= "function" then
