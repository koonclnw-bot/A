function F.learnItemName(itemName, rarityInfo)
    local cleaned = F.trimText(itemName)

    if cleaned == "" then
        return
    end

    local key = string.lower(cleaned)
    local changed = false

    if not State.itemNameCatalog[key] then
        State.itemNameCatalog[key] =
            cleaned

        changed = true
    end

    if rarityInfo
        and rarityInfo.Key
        and rarityInfo.Key ~= "unknown"
        and State.itemRarityCatalog[key]
            ~= rarityInfo.Key
    then
        State.itemRarityCatalog[key] =
            rarityInfo.Key

        changed = true
    end

    if changed
        and F.markConfigDirty
    then
        F.markConfigDirty()
    end
end

function F.findItemSuggestion(query)
    local cleaned = F.trimText(query)

    if cleaned == "" then
        return nil
    end

    local needle = string.lower(cleaned)
    local exact =
        State.itemNameCatalog[needle]

    if exact then
        return exact
    end

    local bestPrefix = nil
    local bestContains = nil

    for key, displayName in pairs(
        State.itemNameCatalog
    ) do
        if string.sub(
            key,
            1,
            #needle
        ) == needle
        then
            if not bestPrefix
                or #displayName < #bestPrefix
                or (
                    #displayName == #bestPrefix
                    and displayName < bestPrefix
                )
            then
                bestPrefix = displayName
            end

        elseif string.find(
            key,
            needle,
            1,
            true
        )
        then
            if not bestContains
                or #displayName < #bestContains
                or (
                    #displayName == #bestContains
                    and displayName < bestContains
                )
            then
                bestContains = displayName
            end
        end
    end

    return bestPrefix or bestContains
end

