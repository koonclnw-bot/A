function F.waitForCellResumeBootState(token)
    local graceDeadline =
        os.clock()
        + Config.CELL_MENU_BOOT_GRACE

    State.cellFarm.menuPhase =
        "Waiting for menu to appear"

    State.cellFarm.menuLastMethod =
        "Resume menu wait"

    while F.isCellFarmActive(token)
        and os.clock() < graceDeadline
    do
        if F.isAnyCellMenuStageVisible() then
            State.cellFarm.menuPhase =
                "Menu detected"

            return "menu"
        end

        task.wait(0.05)
    end

    if F.isAnyCellMenuStageVisible() then
        return "menu"
    end

    -- Only after the full menu grace window has elapsed may we consider a
    -- direct-to-gameplay resume. Require a stable gameplay state as well.
    local stableSince = nil

    local deadline =
        os.clock()
        + Config.CELL_GAMEPLAY_READY_STABLE
        + 3.0

    while F.isCellFarmActive(token)
        and os.clock() < deadline
    do
        if F.isAnyCellMenuStageVisible() then
            return "menu"
        end

        if F.isCellGameplayReady() then
            stableSince =
                stableSince
                or os.clock()

            if os.clock() - stableSince
                >= Config.CELL_GAMEPLAY_READY_STABLE
            then
                return "gameplay"
            end
        else
            stableSince = nil
        end

        task.wait(0.05)
    end

    if F.isAnyCellMenuStageVisible() then
        return "menu"
    end

    return "unknown"
end

function F.runVerifiedCellMenuStep(
    token,
    button,
    signalName,
    sourceNeedle,
    verifyCallback,
    verifyTimeout,
    statusText
)
    if not F.isCellFarmActive(token)
        or not button
        or not button.Parent
    then
        return false
    end

    local timeout =
        math.max(
            0.35,
            tonumber(verifyTimeout) or 1
        )

    State.cellFarm.menuPhase =
        tostring(statusText or "Menu step")

    State.cellFarm.menuLastMethod =
        "Waiting game menu handler"

    F.waitForExactGuiConnection(
        token,
        button,
        signalName,
        sourceNeedle,
        Config.CELL_MENU_CONNECTION_WAIT
    )

    if not F.isCellFarmActive(token)
        or not button.Parent
    then
        return false
    end

    -- Attempt 1: invoke the exact game callback found by the tracer.
    local callbackFired, callbackSource =
        F.fireExactGuiConnection(
            button,
            signalName,
            sourceNeedle
        )

    if callbackFired then
        State.cellFarm.menuLastMethod =
            "Direct callback"

        State.cellFarm.menuLastCallback =
            tostring(callbackSource or sourceNeedle)

        if F.waitCellMenuCondition(
            token,
            verifyCallback,
            timeout
        ) then
            return true
        end
    end

    if not F.isCellFarmActive(token) then
        return false
    end

    -- Attempt 2: actual VirtualInput mouse click on the exact traced button.
    State.cellFarm.menuInputAttempts =
        (State.cellFarm.menuInputAttempts or 0)
        + 1

    State.cellFarm.menuLastMethod =
        "VirtualInput physical click"

    F.clickGuiButtonPhysical(
        button
    )

    if F.waitCellMenuCondition(
        token,
        verifyCallback,
        timeout
    ) then
        return true
    end

    if not F.isCellFarmActive(token)
        or not button.Parent
    then
        return false
    end

    -- Attempt 3: full signal + input compatibility path.
    State.cellFarm.menuInputAttempts =
        (State.cellFarm.menuInputAttempts or 0)
        + 1

    State.cellFarm.menuLastMethod =
        "Signal/input fallback"

    F.activateGuiButton(
        button,
        verifyCallback
    )

    return F.waitCellMenuCondition(
        token,
        verifyCallback,
        timeout
    )
end

function F.tryCellMenuRemoteProtocol()
    local remotes =
        F.getCellRemotes()

    if not remotes
        or not remotes.ServerList
        or not remotes.MenuExit
    then
        return false
    end

    State.cellFarm.menuProtocolAttempts =
        (State.cellFarm.menuProtocolAttempts or 0)
        + 1

    local ok =
        pcall(function()
            if remotes.Analytics then
                remotes.Analytics:FireServer(
                    "PressedPlay",
                    "Desktop"
                )
            end

            task.wait(0.08)

            if remotes.Analytics then
                remotes.Analytics:FireServer(
                    "SlotMenuOpened",
                    "Desktop"
                )
            end

            task.wait(0.08)

            remotes.ServerList:FireServer()

            task.wait(0.32)

            remotes.MenuExit:FireServer(
                "MenuExit"
            )
        end)

    if ok then
        State.movementTelemetry.lastRemote =
            "PressedPlay -> SlotMenuOpened -> RequestServerList -> TeleportEvent(MenuExit)"
    end

    return ok
end

