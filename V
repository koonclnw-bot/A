F.Controllers = State.controllers

function F.recordDiagnosticEvent(source, message)
    local entry = {
        Time = os.time(),
        Source = tostring(source or "System"),
        Message = tostring(message or ""),
    }

    table.insert(State.diagnosticsEvents, entry)

    while #State.diagnosticsEvents > 12 do
        table.remove(State.diagnosticsEvents, 1)
    end
end

function F.recordError(source, message)
    State.errors.count = State.errors.count + 1
    State.errors.lastSource = tostring(source or "Unknown")
    State.errors.lastMessage = tostring(message or "Unknown error")
    State.errors.lastTime = os.time()
    F.recordDiagnosticEvent(State.errors.lastSource, State.errors.lastMessage)
    warn("[The Veil Hub][" .. State.errors.lastSource .. "]", State.errors.lastMessage)
end

function F.runBoundary(source, callback, ...)
    local arguments = table.pack(...)
    local results = table.pack(xpcall(function()
        return callback(table.unpack(arguments, 1, arguments.n))
    end, function(message)
        F.recordError(source, message)
        return message
    end))

    if not results[1] then
        return false, results[2]
    end

    return true, table.unpack(results, 2, results.n)
end

function F.getMovementOwner()
    if State.movement.owner and os.clock() >= State.movement.leaseUntil then
        State.movement.owner = nil
        State.movement.leaseUntil = 0
    end
    return State.movement.owner
end

function F.acquireMovement(owner, leaseSeconds)
    owner = tostring(owner or "")
    if not Config.MOVEMENT_PRIORITIES[owner] then
        F.recordError("Coordinator", "Unknown movement owner: " .. owner)
        return false
    end

    local current = F.getMovementOwner()
    local requestedPriority = Config.MOVEMENT_PRIORITIES[owner]
    local currentPriority = current and Config.MOVEMENT_PRIORITIES[current] or -math.huge

    if current and current ~= owner and requestedPriority < currentPriority then
        State.movement.conflicts = State.movement.conflicts + 1
        State.movement.lastConflict = owner .. " blocked by " .. current
        return false
    end

    if current and current ~= owner then
        State.movement.preemptions = State.movement.preemptions + 1
        State.movement.lastConflict = owner .. " preempted " .. current
    end

    State.movement.owner = owner
    State.movement.leaseUntil = os.clock() + math.max(0.1, tonumber(leaseSeconds) or Config.MOVEMENT_LEASE_SECONDS)
    return true
end

function F.renewMovement(owner, leaseSeconds)
    if F.getMovementOwner() ~= owner then
        return false
    end
    State.movement.leaseUntil = os.clock() + math.max(0.1, tonumber(leaseSeconds) or Config.MOVEMENT_LEASE_SECONDS)
    return true
end

function F.releaseMovement(owner)
    if F.getMovementOwner() == owner then
        State.movement.owner = nil
        State.movement.leaseUntil = 0
        return true
    end
    return false
end

function F.setFarmState(newState, detail)
    newState = tostring(newState or "IDLE")
    if not Config.FARM_STATES[newState] then
        F.recordError("FarmState", "Invalid state: " .. newState)
        newState = "BACKOFF"
    end
    State.farmMachine.state = newState
    State.farmMachine.enteredAt = os.clock()
    if detail then
        State.farmStatus = tostring(detail)
    end
end

function F.requestRecovery(source, reason)
    source = tostring(source or "Unknown")
    local now = os.clock()
    local allowedAt = State.recovery.nextAllowed[source] or 0
    if now < allowedAt then
        return false, allowedAt - now
    end

    local attempt = (State.recovery.attempts[source] or 0) + 1
    local delaySeconds = math.min(Config.RECOVERY_MAX_DELAY, Config.RECOVERY_BASE_DELAY * (2 ^ math.min(attempt - 1, 5)))
    State.recovery.attempts[source] = attempt
    State.recovery.nextAllowed[source] = now + delaySeconds
    State.recovery.lastSource = source
    State.recovery.lastReason = tostring(reason or "Unspecified")
    State.sessionStats.farmRecoveries = State.sessionStats.farmRecoveries + 1
    F.setFarmState("RECOVERING", source .. ": " .. State.recovery.lastReason)
    return true, delaySeconds
end

