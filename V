function F.getCellCradlePart(cradle)
    if not cradle or not cradle.Parent then
        return nil
    end

    local dialogPart =
        cradle:FindFirstChild(
            "DialogPart",
            true
        )

    if dialogPart
        and dialogPart:IsA("BasePart")
    then
        return dialogPart
    end

    if cradle:IsA("Model")
        and cradle.PrimaryPart
    then
