-- MONSTER HELPERS
-- =========================================================

function F.getMonsterPart(monster)
    if not monster or not monster.Parent then
        return nil
    end

    local root = monster:FindFirstChild(
        "HumanoidRootPart",
        true
    )

    if root and root:IsA("BasePart") then
        return root
    end

    local head = monster:FindFirstChild(
        "Head",
        true
    )

    if head and head:IsA("BasePart") then
        return head
    end

    if monster:IsA("Model")
        and monster.PrimaryPart then

        return monster.PrimaryPart
    end

    return monster:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end

function F.getMonsterAimPosition(monster)
    local part = F.getMonsterPart(monster)

    if part then
        return part.Position
    end

    return nil
end

function F.collectMonsterModels(folder)
    local result = {}
    local seen = {}

    if not folder then
        return result
    end

    local character = F.getPlayerCharacter()

    local function addCandidate(model)
        if not model
            or not model:IsA("Model")
            or seen[model]
            or not model:IsDescendantOf(folder)
            or not F.getMonsterPart(model) then

            return
        end

        if character
            and (
                model == character
                or model:IsDescendantOf(character)
                or character:IsDescendantOf(model)
            ) then

            return
        end

        seen[model] = true
        table.insert(result, model)
    end

    -- Standard layout: Workspace.Monster -> MonsterModel
    for _, child in ipairs(folder:GetChildren()) do
        if child:IsA("Model") then
            addCandidate(child)
        end
    end

    -- Nested layouts: Folder/Model -> MonsterModel -> Humanoid
    for _, object in ipairs(folder:GetDescendants()) do
        if object:IsA("Humanoid") then
            addCandidate(object:FindFirstAncestorOfClass("Model"))
        elseif object:IsA("Model")
            and object.Parent
            and object.Parent:IsA("Folder") then

            addCandidate(object)
        end
    end

    return result
end

function F.isIgnoredMonster(monster)
    if not monster then
        return true
    end

    local normalized =
        string.lower(
            tostring(monster.Name or "")
        ):gsub(
            "[%s_%-]",
            ""
        )

    if normalized == "trainingdummy" then
        return true
    end

    local lowerName = string.lower(tostring(monster.Name or ""))

    if State.monsterBlacklist[lowerName] == true then
        return true
    end

    if State.goalFarm
        and State.goalFarm.enabled
        and F.trimText(State.goalFarm.selectedKind) ~= ""
    then
        -- An active goal is an explicit temporary target request. It replaces
        -- normal whitelist/boss-only filtering without mutating those settings.
        -- If an item goal currently has no known source monster, reject all
        -- monsters instead of falling back to unrelated normal targets.
        if next(State.goalFarm.monsterTargets or {}) == nil
            or State.goalFarm.monsterTargets[lowerName] ~= true
        then
            return true
        end
    else
        if next(State.monsterWhitelist) ~= nil
            and State.monsterWhitelist[lowerName] ~= true
        then
            return true
        end

        if State.bossOnly then
            local metadata = State.monsterCache[monster]
            if not metadata or metadata.isBoss ~= true then
                return true
            end
        end
    end

    return false
end

function F.getNearestMonster()
    if not State.monstersFolder
        or not State.monstersFolder.Parent then

        State.monstersFolder = F.findMonstersFolder()
    end

    local root = F.getCharacterRoot()

    if not root or not State.monstersFolder then
        return nil
    end

    local nearest = nil
    local nearestDistance = math.huge

    for monster in pairs(State.monsterCache) do
        local alive = true

        if F.isMonsterAlive then
            alive =
                F.isMonsterAlive(
                    monster
                )
        end

        if alive
            and not F.isIgnoredMonster(
                monster
            )
        then
            local part =
                F.getMonsterPart(
                    monster
                )

            if part then
                local distance =
                    (
                        part.Position
                        - root.Position
                    ).Magnitude

                if distance < nearestDistance then
                    nearestDistance =
                        distance

                    nearest =
                        monster
                end
            end
        end
    end

    return nearest
end

