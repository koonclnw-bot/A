            button.AutoButtonColor = false
            button.LayoutOrder = rarityInfo.Order
            button.Parent = row

            F.createCorner(button, 8)
            local stroke = F.createStroke(button, Config.THEME.Stroke, 0.10, 1)

            local function render()
                local enabled = selectedSet[rarityKey] == true

                button.BackgroundColor3 =
                    enabled and Config.THEME.Hover or Config.THEME.Card2

                button.TextColor3 =
                    enabled and rarityInfo.Color or Config.THEME.Disabled

                stroke.Color =
                    enabled and rarityInfo.Color or Config.THEME.Stroke

                stroke.Transparency =
                    enabled and 0.08 or 0.45
            end

            button.MouseButton1Click:Connect(function()
                selectedSet[rarityKey] =
                    not (selectedSet[rarityKey] == true)

                render()

                if onChanged then
                    onChanged(
                        rarityKey,
                        selectedSet[rarityKey]
                    )
                end
            end)

            buttonStore[rarityKey] = button
            render()
        end
    end

    return card
