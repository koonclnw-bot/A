function F.getPlayerFeetPosition()
    local character = F.getPlayerCharacter()

    if not character then
        return nil
    end

    local root = character:FindFirstChild(
        "HumanoidRootPart"
    )

    if not root
        or not root:IsA("BasePart") then

        return nil
    end

    local leftFoot =
        character:FindFirstChild("LeftFoot")
        or character:FindFirstChild("Left Leg")

    local rightFoot =
        character:FindFirstChild("RightFoot")
        or character:FindFirstChild("Right Leg")

    local feetPosition = nil

    if leftFoot
        and leftFoot:IsA("BasePart")
        and rightFoot
        and rightFoot:IsA("BasePart") then

        local leftBottom =
            leftFoot.Position
            - Vector3.new(
                0,
                leftFoot.Size.Y / 2,
                0
            )

        local rightBottom =
            rightFoot.Position
            - Vector3.new(
                0,
                rightFoot.Size.Y / 2,
                0
            )

        feetPosition =
            (leftBottom + rightBottom) / 2

    elseif leftFoot
        and leftFoot:IsA("BasePart") then

        feetPosition =
            leftFoot.Position
            - Vector3.new(
                0,
                leftFoot.Size.Y / 2,
                0
            )

    elseif rightFoot
        and rightFoot:IsA("BasePart") then

        feetPosition =
            rightFoot.Position
            - Vector3.new(
                0,
                rightFoot.Size.Y / 2,
                0
            )
    end

    if not feetPosition then
        local humanoid =
            character:FindFirstChildOfClass(
                "Humanoid"
            )

        local down =
            root.Size.Y / 2

        if humanoid then
            down =
                down + humanoid.HipHeight
        else
            down =
                down + 2
        end

        feetPosition =
            root.Position
            - Vector3.new(
                0,
                down,
                0
            )
    end

    return
        feetPosition
        - Vector3.new(
            0,
            Config.WEAPON_UNDER_FEET_OFFSET,
            0
        )
end

function F.getWeaponAttackCFrame()
    local feet = F.getPlayerFeetPosition()

    if not feet then
        return nil
    end

    if Config.WEAPON_AIM_AT_MONSTER
        and State.lockedMonster
        and State.lockedMonster.Parent then

        local target =
            F.getMonsterAimPosition(
                State.lockedMonster
            )

        if target then
            local direction =
                target - feet

            if direction.Magnitude > 0.05 then
                return CFrame.lookAt(
                    feet,
                    target
                )
            end
        end
    end

    local root = F.getCharacterRoot()

    if root then
        local rotation =
            root.CFrame
            - root.Position

        return
            CFrame.new(feet)
            * rotation
    end

    return CFrame.new(feet)
end

