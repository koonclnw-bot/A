-- =========================================================

function F.loadUnnamedESP()
    if State.espLoaded then
        return true
    end

    if type(loadstring) ~= "function" then
        warn("[The Veil Hub] ESP Load Error: loadstring unavailable")
        return false
    end

    local source, fetchError =
        F.httpGetText(
            "https://raw.githubusercontent.com/ic3w0lf22/Unnamed-ESP/master/UnnamedESP.lua"
        )

    if type(source) ~= "string" or source == "" then
        warn("[The Veil Hub] ESP Load Error:", fetchError or "empty response")
        return false
    end

    local compileOk, compiled =
        pcall(loadstring, source)

    if not compileOk or type(compiled) ~= "function" then
        warn("[The Veil Hub] ESP Compile Error:", compiled)
        return false
    end

    local success, err = pcall(compiled)

    if success then
        State.espLoaded = true
        print("[The Veil Hub] Unnamed ESP Loaded")
        return true
    end

    warn("[The Veil Hub] ESP Load Error:", err)
    return false
end

