    )
    titleLabel.AutomaticSize = Enum.AutomaticSize.X
    titleLabel.LayoutOrder = 1

    local clearButton = F.createButton(
        header,
        "CLEAR",
        UDim2.new(0, 72, 0, 26),
        UDim2.new(),
        Config.THEME.Card2,
        Config.THEME.SubText,
        Enum.Font.GothamBold,
        10
    )
    clearButton.LayoutOrder = 2

    local inputShell = Instance.new("Frame")
    inputShell.Size = UDim2.new(1, -32, 0, 34)
    inputShell.Position = UDim2.new(0, 16, 0, 39)
    inputShell.BackgroundColor3 = Config.THEME.Card2
    inputShell.BorderSizePixel = 0
    inputShell.Parent = card
    F.createCorner(inputShell, 8)

    local inputStroke =
        F.createStroke(
            inputShell,
            Config.THEME.Stroke,
            0.15,
            1
        )

    local ghost = F.createTextLabel(
        inputShell,
        "",
        UDim2.new(1, -24, 1, 0),
        UDim2.new(0, 12, 0, 0),
        Enum.Font.Gotham,
        13,
        Config.THEME.Disabled,
        Enum.TextXAlignment.Left
    )
    ghost.TextTransparency = 0.18
    ghost.ZIndex = 2

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -24, 1, 0)
    box.Position = UDim2.new(0, 12, 0, 0)
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Text = ""
    box.PlaceholderText = placeholder or "Type an item name..."
    box.PlaceholderColor3 = Config.THEME.Disabled
    box.TextColor3 = Config.THEME.Text
    box.Font = Enum.Font.Gotham
    box.TextSize = 13
    box.ClearTextOnFocus = false
    box.MultiLine = false
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.ZIndex = 3
    box.Parent = inputShell

    local tagScroller = Instance.new("ScrollingFrame")
    tagScroller.Size = UDim2.new(1, -32, 0, 30)
    tagScroller.Position = UDim2.new(0, 16, 0, 80)
    tagScroller.BackgroundTransparency = 1
    tagScroller.BorderSizePixel = 0
    tagScroller.CanvasSize = UDim2.new(0, 0, 0, 0)
    tagScroller.AutomaticCanvasSize = Enum.AutomaticSize.X
    tagScroller.ScrollingDirection = Enum.ScrollingDirection.X
    tagScroller.ScrollBarThickness = 2
    tagScroller.ScrollBarImageColor3 = Config.THEME.Stroke
    tagScroller.Parent = card

    local tagLayout = Instance.new("UIListLayout")
    tagLayout.FillDirection = Enum.FillDirection.Horizontal
    tagLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    tagLayout.Padding = UDim.new(0, 6)
    tagLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tagLayout.Parent = tagScroller

    local api = {
        Box = box,
        Ghost = ghost,
        Tags = {},
        Order = {},
        CurrentSuggestion = nil,
    }

    local function trim(value)
        return tostring(value or ""):gsub(
            "^%s*(.-)%s*$",
            "%1"
        )
    end

    local function notifyChanged()
        if onTagsChanged then
            onTagsChanged(
                api:GetTags()
            )
        end
    end

    local function rebuildTags()
        for _, child in ipairs(
            tagScroller:GetChildren()
        ) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end

        for index, displayName in ipairs(
            api.Order
        ) do
            local key = string.lower(displayName)
            local width =
                math.clamp(
                    38 + (#displayName * 7),
                    94,
                    210
                )

            local tag = F.createButton(
                tagScroller,
                displayName .. "  X",
                UDim2.new(0, width, 0, 28),
                UDim2.new(0, 0, 0, 0),
                Config.THEME.Hover,
                Config.THEME.Text,
                Enum.Font.GothamSemibold,
                11
            )

            tag.LayoutOrder = index

            tag.MouseButton1Click:Connect(function()
                api.Tags[key] = nil

                for i = #api.Order, 1, -1 do
                    if string.lower(
                        api.Order[i]
                    ) == key then

                        table.remove(
                            api.Order,
                            i
                        )
                    end
                end

                rebuildTags()
                notifyChanged()
            end)
        end
    end

    function api:GetTags()
        local result = {}

        for _, value in ipairs(
            self.Order
        ) do
            table.insert(
                result,
                value
            )
        end

        return result
    end

    function api:Add(value, silent)
        local cleaned = trim(value)

        if cleaned == "" then
            return false
        end

        local suggestion = nil

        if suggestionProvider then
            suggestion =
                suggestionProvider(
                    cleaned
                )
        end

        if suggestion
            and suggestion ~= "" then

            cleaned = suggestion
        end

        local key = string.lower(cleaned)

        if self.Tags[key] then
            box.Text = ""
            ghost.Text = ""
            self.CurrentSuggestion = nil
            return false
        end

        self.Tags[key] = true

        table.insert(
            self.Order,
            cleaned
        )

        box.Text = ""
        ghost.Text = ""
        self.CurrentSuggestion = nil

        rebuildTags()

        if not silent then
            notifyChanged()
        end

        return true
    end

    function api:Remove(value, silent)
        local key =
            string.lower(
                trim(value)
            )

        if not self.Tags[key] then
            return
        end

        self.Tags[key] = nil

        for i = #self.Order, 1, -1 do
            if string.lower(
                self.Order[i]
            ) == key then

                table.remove(
                    self.Order,
                    i
                )
            end
        end

        rebuildTags()

        if not silent then
            notifyChanged()
        end
    end

    function api:Clear(silent)
        self.Tags = {}
        self.Order = {}
        box.Text = ""
        ghost.Text = ""
        self.CurrentSuggestion = nil
        rebuildTags()

        if not silent then
            notifyChanged()
        end
    end

    function api:SetTags(values, silent)
        self.Tags = {}
        self.Order = {}

        for _, value in ipairs(
            values or {}
        ) do
            local cleaned = trim(value)

            if cleaned ~= "" then
                local key =
                    string.lower(
                        cleaned
                    )

                if not self.Tags[key] then
                    self.Tags[key] = true

                    table.insert(
                        self.Order,
                        cleaned
                    )
                end
            end
        end

        rebuildTags()

        if not silent then
            notifyChanged()
        end
    end

    local function refreshGhost()
        local query = trim(box.Text)

        if query == "" then
            ghost.Text = ""
            api.CurrentSuggestion = nil
            return
        end

        local suggestion = nil

        if suggestionProvider then
            suggestion =
                suggestionProvider(
                    query
                )
        end

        api.CurrentSuggestion =
            suggestion

        if suggestion
            and string.sub(
                string.lower(suggestion),
                1,
                #query
            ) == string.lower(query)
        then
            ghost.Text = suggestion
        else
            ghost.Text = ""
        end
    end

    box:GetPropertyChangedSignal(
        "Text"
    ):Connect(refreshGhost)

    box.Focused:Connect(function()
        F.tweenObject(
            inputStroke,
            0.14,
            {
                Color = Config.THEME.Accent,
                Transparency = 0,
            }
        )

        refreshGhost()
    end)

    box.FocusLost:Connect(function(enterPressed)
        F.tweenObject(
            inputStroke,
            0.14,
            {
                Color = Config.THEME.Stroke,
                Transparency = 0.15,
            }
        )

        if enterPressed then
            local value =
                api.CurrentSuggestion
                or box.Text

            api:Add(value)
        end
    end)

    clearButton.MouseButton1Click:Connect(function()
        api:Clear()
    end)

    return api, card
end

