LocalPlayer.CharacterAdded:Connect(function(character)
    -- Destroy any flight controller tied to the previous character. Auto Farm
    -- remains enabled and can select/restart a Drop after respawn is ready.
    F.stopLootLock()
    F.stopMovementFlight()
    State.routeRunning = false
    State.routeRunToken = State.routeRunToken + 1
    F.releaseMovement(State.movement.owner)

    task.wait(1)

    State.currentWeaponTool = nil
    State.recovery.attempts.Character = 0
    State.recovery.nextAllowed.Character = 0

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    local currentCamera = F.getCurrentCamera()

    if humanoid then
        if currentCamera then
            currentCamera.CameraSubject = humanoid
        end

        humanoid.AutoRotate =
            not State.monsterLockEnabled
    end

    State.isSpectating = false
    State.spectatingTarget = nil

    if State.monsterLockEnabled then
        task.wait(0.4)

        if not State.lockedMonster
            or not State.lockedMonster.Parent
        then
            State.lockedMonster =
                F.getNearestMonster()

            State.monsterLockManualSelection =
                false
        end

        State.monsterLockWaiting =
            not (
                State.lockedMonster
                and State.lockedMonster.Parent
            )

        if not State.monsterLockWaiting then
            State.applyMonsterLockPosition()
        end
    end

    State.updateCombatStatus()

end)

