end

function F.updateGameDBUI()
    local summary = F.getGameDBSummary()

    if State.gameDBStatusLabel
        and State.gameDBStatusLabel.Parent
    then
        State.gameDBStatusLabel.Text = summary
    end

    if State.gameDBResultsLabel
        and State.gameDBResultsLabel.Parent
        and State.gameDB.lastSearchText == ""
    then
        State.gameDBResultsLabel.Text =
            summary
            .. "\n\nSearch examples: Hiveling Titan, Briar, Poison, Glade, BuyItem, Legendary"
    end
end

function F.refreshGameDB(force)
    local db = State.gameDB
    if db.loading then
        return false
    end

    if db.loaded and not force then
        F.updateGameDBUI()
        return true
    end

    db.loading = true
    db.status = "Loading runtime config modules"
    db.moduleErrors = {}
    db.modules = {}
    db.modulePaths = {}
    db.dialogueByNPC = {}
    db.dialogueEvents = {}
    db.dialogueEventKeys = {}
    db.lastSearchText = ""
    F.updateGameDBUI()

    local loadedModules = 0
    for _, moduleName in ipairs(Config.GAME_DB_MODULE_NAMES) do
        local moduleScript = F.findGameDBModule(moduleName)
        if moduleScript then
            local ok, data, err = F.requireGameDBModule(moduleScript)
            if ok then
                db.modules[moduleName] = data
                db.modulePaths[moduleName] = moduleScript:GetFullName()
                loadedModules = loadedModules + 1
            else
                table.insert(db.moduleErrors, moduleName .. ": " .. tostring(err))
            end
        else
            table.insert(db.moduleErrors, moduleName .. ": missing")
        end
        task.wait()
    end

    db.status = "Loading NPC dialogue configs"
    F.updateGameDBUI()

    local dialogueModules = F.collectGameDBDialogueModules()
    for index, moduleScript in ipairs(dialogueModules) do
        local ok, data, err = F.requireGameDBModule(moduleScript)
        local npcName = moduleScript.Parent and moduleScript.Parent.Name or "Unknown"
        local path = moduleScript:GetFullName()

        if ok then
            db.dialogueByNPC[path] = {
                Name = tostring(npcName),
                Path = path,
                Data = data,
                Module = moduleScript,
                Instance = moduleScript.Parent,
            }
            F.extractGameDBDialogueEvents(
                data,
                npcName,
                path,
                db.dialogueEvents,
                nil,
                0
            )
        else
            table.insert(db.moduleErrors, path .. ": " .. tostring(err))
        end

        if index % 8 == 0 then
            task.wait()
        end
    end

    F.buildGameDBIndexes()
    db.loaded = loadedModules > 0
    db.loading = false
    db.lastRefreshAt = os.time()
    db.status = db.loaded and "Ready" or "Partial / unavailable"

    if db.versionMismatch then
        F.recordDiagnosticEvent(
            "GameDB",
            "Game version " .. tostring(db.gameVersion)
                .. " differs from reference " .. tostring(db.referenceVersion)
        )
    end

    F.recordDiagnosticEvent(
        "GameDB",
        "Loaded " .. tostring(loadedModules)
            .. "/" .. tostring(#Config.GAME_DB_MODULE_NAMES)
            .. " core modules, " .. tostring(F.getGameDBCount(db.dialogueByNPC))
            .. " dialogue configs, " .. tostring(#db.dialogueEvents)
            .. " dialogue events"
    )

    F.updateGameDBUI()

    if F.refreshNPCIntelligence then
        F.refreshNPCIntelligence(false, true)
    end

    if F.refreshGoalIntelligence then
        F.refreshGoalIntelligence(false, true)
    end

    if State.updateDiagnostics then
        State.updateDiagnostics()
    end
    return db.loaded
end

function F.getGameDBMonster(name)
    name = string.lower(F.trimText(name))
    if name == "" then
        return nil
    end

    for key, value in pairs(State.gameDB.monsters) do
        local display = type(value) == "table" and (value.Name or value.DisplayName) or nil
        if string.lower(tostring(key)) == name
            or (display and string.lower(tostring(display)) == name)
        then
            return value, key
        end
    end
    return nil
end

function F.getGameDBNPC(name)
    name = string.lower(F.trimText(name))
    if name == "" then
        return nil
    end

    for key, value in pairs(State.gameDB.notableNPCs) do
        local display = type(value) == "table" and (value.Name or value.DisplayName) or nil
        if string.lower(tostring(key)) == name
            or (display and string.lower(tostring(display)) == name)
        then
            return value, key
        end
    end
    return nil
end

function F.searchGameDB(query)
    local db = State.gameDB
    query = string.lower(F.trimText(query))
    db.lastQuery = query

    if not db.loaded and not db.loading then
        task.spawn(F.refreshGameDB, false)
    end

    if query == "" then
        db.lastSearchText = ""
        F.updateGameDBUI()
        return F.getGameDBSummary()
    end

    local results = {}
    local seen = {}

    local function matches(value)
        return string.find(string.lower(tostring(value or "")), query, 1, true) ~= nil
    end

    local function add(category, name, detail)
        if #results >= Config.GAME_DB_SEARCH_MAX_RESULTS then
            return
        end
        local key = tostring(category) .. "|" .. tostring(name) .. "|" .. tostring(detail or "")
        if seen[key] then
            return
        end
        seen[key] = true
        table.insert(
            results,
            "[" .. tostring(category) .. "] " .. tostring(name)
                .. (detail and detail ~= "" and (" - " .. tostring(detail)) or "")
        )
    end

    for name, info in pairs(db.monsters) do
        if #results >= Config.GAME_DB_SEARCH_MAX_RESULTS then break end
        local display = type(info) == "table" and (info.Name or name) or name
        local tier = type(info) == "table" and info.Tier or ""
        local description = type(info) == "table" and info.Description or ""
        if matches(name) or matches(display) or matches(tier) or matches(description) then
            local mastery = type(info) == "table" and info.MasteryQuests or nil
            add("Monster", display, tostring(tier or "") .. (type(mastery) == "table" and (" | Mastery " .. tostring(#mastery) .. " tiers") or ""))
        end
    end

    for name, info in pairs(db.notableNPCs) do
        if #results >= Config.GAME_DB_SEARCH_MAX_RESULTS then break end
        local display = type(info) == "table" and (info.Name or name) or name
        local tier = type(info) == "table" and info.Tier or ""
        local description = type(info) == "table" and info.Description or ""
        if matches(name) or matches(display) or matches(tier) or matches(description) then
            add("NPC", display, tostring(tier or ""))
        end
    end

    for name, info in pairs(db.statusEffects) do
        if #results >= Config.GAME_DB_SEARCH_MAX_RESULTS then break end
        local display = type(info) == "table" and (info.displayName or name) or name
        local description = type(info) == "table" and info.description or ""
        if matches(name) or matches(display) or matches(description) then
            local duration = type(info) == "table" and info.duration or nil
            add("Status", display, duration and ("Duration " .. tostring(duration) .. "s") or description)
        end
    end

    local simpleGroups = {
        {"Race", db.races},
        {"Class", db.classes},
        {"Ability", db.abilities},
        {"Dash", db.dashes},
        {"Aura", db.auras},
        {"Enchant", db.enchants},
    }

    for _, group in ipairs(simpleGroups) do
        for name, info in pairs(group[2]) do
            if #results >= Config.GAME_DB_SEARCH_MAX_RESULTS then break end
            local display = type(info) == "table" and (info.Name or info.displayName or name) or name
            local description = type(info) == "table" and (info.Description or info.description or "") or ""
            local rarity = type(info) == "table" and (info.rarity or info.Rarity or "") or ""
            if matches(name) or matches(display) or matches(description) or matches(rarity) then
                add(group[1], display, rarity ~= "" and tostring(rarity) or description)
            end
        end
    end

    for areaGroup, areaSet in pairs(db.areas) do
        if #results >= Config.GAME_DB_SEARCH_MAX_RESULTS then break end
        if type(areaSet) == "table" then
            for areaName, enabled in pairs(areaSet) do
                if #results >= Config.GAME_DB_SEARCH_MAX_RESULTS then break end
                if enabled == true and (matches(areaName) or matches(areaGroup)) then
                    add("Area", areaName, tostring(areaGroup))
                end
            end
        end
    end

    for _, event in ipairs(db.dialogueEvents) do
        if #results >= Config.GAME_DB_SEARCH_MAX_RESULTS then break end
        if matches(event.NPC) or matches(event.Event) or matches(event.Argument) then
            local detail = tostring(event.Event)
            if tostring(event.Argument or "") ~= "" then
                detail = detail .. "(" .. tostring(event.Argument) .. ")"
            end
            add("Dialogue", event.NPC, detail)
        end
    end

    if #results == 0 then
        table.insert(results, "No GameDB matches for: " .. query)
    end

    db.lastSearchText = table.concat(results, "\n")
    if State.gameDBResultsLabel and State.gameDBResultsLabel.Parent then
        State.gameDBResultsLabel.Text = db.lastSearchText
    end

    return db.lastSearchText
end

function F.copyGameDBSummary()
    local textToCopy = F.getGameDBSummary()
    if State.gameDB.lastSearchText ~= "" then
        textToCopy = textToCopy .. "\n\n=== Last Search ===\n" .. State.gameDB.lastSearchText
    end

    local clipboard = nil
    if type(setclipboard) == "function" then
        clipboard = setclipboard
    elseif type(toclipboard) == "function" then
        clipboard = toclipboard
    end

    if clipboard and pcall(clipboard, textToCopy) then
        F.notify("GameDB", "Summary copied to clipboard.", "success", 2.0)
        return true
    end

    print(textToCopy)
    F.notify("GameDB", "Clipboard unavailable; summary printed to console.", "info", 2.5)
    return false
end

