function F.getCellMenuClickPoint(button, attempt)
    if not button
        or not button.Parent
    then
        return nil
    end

    local position =
        button.AbsolutePosition

    local size =
        button.AbsoluteSize

    local offsets =
        Config.CELL_MENU_MOUSE_Y_OFFSETS

    local offsetY = 0

    if type(offsets) == "table"
        and #offsets > 0
    then
        local index =
            math.clamp(
                tonumber(attempt) or 1,
                1,
                #offsets
            )

        offsetY =
            tonumber(offsets[index])
            or 0
    end

    -- Roblox mouse/input coordinates can be offset from GuiObject
    -- AbsolutePosition by the CoreGui/top-bar inset. The user's live
    -- screenshots show the cursor consistently landing too high, so include
    -- the real client inset instead of relying on a fixed guess only.
    local guiInsetY = 0

    pcall(function()
        local guiService =
            game:GetService(
                "GuiService"
            )

        local topLeftInset =
            guiService:GetGuiInset()

        if typeof(topLeftInset) == "Vector2" then
            guiInsetY =
                topLeftInset.Y
        elseif typeof(topLeftInset) == "Tuple" then
            -- Defensive fallback; current Roblox normally returns Vector2s.
            guiInsetY = 0
        end
    end)

    local x =
        position.X
        + size.X * 0.5

    local y =
        position.Y
        + size.Y * 0.5
        + guiInsetY
        + offsetY

    return Vector2.new(
        x,
        y
    )
end

function F.getCellMenuHitInfo(button, attempt)
    if not button
        or not button.Parent
    then
        return "Button missing"
    end

    local center =
        F.getCellMenuClickPoint(
            button,
            attempt
        )

    if not center then
        return "No click point"
    end

    local playerGui =
        LocalPlayer:FindFirstChildOfClass(
            "PlayerGui"
        )

    if not playerGui then
        return "PlayerGui missing"
    end

    local ok, objects =
        pcall(function()
            return playerGui:GetGuiObjectsAtPosition(
                center.X,
                center.Y
            )
        end)

    if not ok
        or type(objects) ~= "table"
        or #objects == 0
    then
        return
            "No GUI hit @ "
            .. tostring(math.floor(center.X))
            .. ","
            .. tostring(math.floor(center.Y))
    end

    local top = objects[1]

    local guiInsetY = 0

    pcall(function()
        local guiService =
            game:GetService(
                "GuiService"
            )

        local topLeftInset =
            guiService:GetGuiInset()

        if typeof(topLeftInset) == "Vector2" then
            guiInsetY =
                topLeftInset.Y
        end
    end)

    local configuredShift =
        Config.CELL_MENU_MOUSE_Y_OFFSETS[
            math.clamp(
                tonumber(attempt) or 1,
                1,
                #Config.CELL_MENU_MOUSE_Y_OFFSETS
            )
        ]
        or 0

    return
        tostring(top.ClassName)
        .. ":"
        .. tostring(top.Name)
        .. " @ "
        .. tostring(math.floor(center.X))
        .. ","
        .. tostring(math.floor(center.Y))
        .. " | InsetY="
        .. tostring(
            math.floor(guiInsetY)
        )
        .. " ExtraY="
        .. tostring(configuredShift)
        .. " TotalY="
        .. tostring(
            math.floor(
                guiInsetY
                + configuredShift
            )
        )
end

function F.waitForCellMenuButtonSettle(token, button, seconds)
    local required =
        math.max(
            0.10,
            tonumber(seconds) or 0.5
        )

    local deadline =
        os.clock()
        + required
        + 8.0

    local stableSince = nil
    local lastPosition = nil
    local lastSize = nil

    while F.isCellFarmActive(token)
        and button
        and button.Parent
        and os.clock() < deadline
    do
        if not F.isGuiObjectActuallyVisible(
            button
        ) then
            stableSince = nil
        else
            local position =
                button.AbsolutePosition

            local size =
                button.AbsoluteSize

            local stableLayout =
                size.X > 8
                and size.Y > 8

            if lastPosition
                and lastSize
            then
                stableLayout =
                    stableLayout
                    and (
                        position
                        - lastPosition
                    ).Magnitude <= 2.5
                    and (
                        size
                        - lastSize
                    ).Magnitude <= 2.5
            end

            if stableLayout then
                stableSince =
                    stableSince
                    or os.clock()

                if os.clock()
                    - stableSince
                    >= required
                then
                    return true
                end
            else
                stableSince = nil
            end

            lastPosition = position
            lastSize = size
        end

        task.wait(0.05)
    end

    return
        button
        and button.Parent
        and F.isGuiObjectActuallyVisible(
            button
        )
end

function F.clickGuiButtonExecutorMouse(button, attempt)
    if not button
        or not button.Parent
        or not F.isGuiObjectActuallyVisible(button)
    then
        return false
    end

    local center =
        F.getCellMenuClickPoint(
            button,
            attempt
        )

    if not center then
        return false
    end

    local moved = false

    if type(mousemoveabs) == "function" then
        moved = pcall(
            mousemoveabs,
            center.X,
            center.Y
        )
    elseif type(mousemoverel) == "function" then
        local userInput = game:GetService("UserInputService")
        local current = userInput:GetMouseLocation()
        moved = pcall(
            mousemoverel,
            center.X - current.X,
            center.Y - current.Y
        )
    end

    if moved then
        task.wait(0.30)
    end

    if type(mouse1press) == "function"
        and type(mouse1release) == "function"
    then
        local ok = pcall(function()
            mouse1press()
            task.wait(0.11)
            mouse1release()
        end)

        if ok then
            return true
        end
    end

    if type(mouse1click) == "function" then
        return pcall(mouse1click)
    end

    return false
end

function F.clickGuiButtonVirtualUser(button, attempt)
    if not button
        or not button.Parent
        or not F.isGuiObjectActuallyVisible(button)
    then
        return false
    end

    local center =
        F.getCellMenuClickPoint(
            button,
            attempt
        )

    if not center then
        return false
    end

    local sent = false

    pcall(function()
        local virtualUser = game:GetService("VirtualUser")
        virtualUser:CaptureController()
        virtualUser:ClickButton1(center)
        sent = true
    end)

    return sent
end

function F.runPhysicalCellMenuStep(
    token,
    button,
    signalName,
    sourceNeedle,
    verifyCallback,
    statusText
)
    if not F.isCellFarmActive(token)
        or not button
        or not button.Parent
    then
        return false
    end

    local name =
        tostring(
            statusText
            or "Menu"
        )

    local settleSeconds =
        Config.CELL_MENU_SLOT_SETTLE

    if name == "Main Endure" then
        settleSeconds =
            Config.CELL_MENU_MAIN_SETTLE
    elseif name == "Current Server" then
        settleSeconds =
            Config.CELL_MENU_SERVER_SETTLE
    end

    State.cellFarm.menuPhase =
        name

    State.cellFarm.menuLastMethod =
        "Waiting game handler"

    F.waitForExactGuiConnection(
        token,
        button,
        signalName,
        sourceNeedle,
        Config.CELL_MENU_CONNECTION_WAIT
    )

    if not F.isCellFarmActive(token)
        or not button.Parent
    then
        return false
    end

    State.cellFarm.menuLastMethod =
        "Waiting button settle"

    F.waitForCellMenuButtonSettle(
        token,
        button,
        settleSeconds
    )

    for attempt = 1,
        Config.CELL_MENU_PHYSICAL_RETRIES
    do
        if not F.isCellFarmActive(token)
            or not button.Parent
        then
            return false
        end

        State.cellFarm.menuInputAttempts =
            (State.cellFarm.menuInputAttempts or 0)
            + 1

        State.cellFarm.menuLastHit =
            F.getCellMenuHitInfo(
                button,
                attempt
            )

        -- 1) Executor-native mouse functions, when exposed.
        State.cellFarm.menuLastMethod =
            name
            .. " native mouse "
            .. tostring(attempt)

        local nativeSent =
            F.clickGuiButtonExecutorMouse(
                button,
                attempt
            )

        if nativeSent
            and F.waitCellMenuCondition(
                token,
                verifyCallback,
                Config.CELL_MENU_PHYSICAL_VERIFY
            )
        then
            return true
        end

        if not F.isCellFarmActive(token)
            or not button.Parent
        then
            return false
        end

        -- 2) VirtualInputManager real mouse path.
        State.cellFarm.menuLastMethod =
            name
            .. " VIM mouse "
            .. tostring(attempt)

        local vimSent =
            F.clickGuiButtonPhysical(
                button,
                attempt
            )

        if vimSent
            and F.waitCellMenuCondition(
                token,
                verifyCallback,
                Config.CELL_MENU_PHYSICAL_VERIFY
            )
        then
            return true
        end

        if not F.isCellFarmActive(token)
            or not button.Parent
        then
            return false
        end

        -- 3) VirtualUser fallback.
        State.cellFarm.menuLastMethod =
            name
            .. " VirtualUser "
            .. tostring(attempt)

        local userSent =
            F.clickGuiButtonVirtualUser(
                button,
                attempt
            )

        if userSent
            and F.waitCellMenuCondition(
                token,
                verifyCallback,
                Config.CELL_MENU_PHYSICAL_VERIFY
            )
        then
            return true
        end

        if not F.cellFarmWait(
            token,
            Config.CELL_MENU_PHYSICAL_RETRY_DELAY
        ) then
            return false
        end
    end

    return false
end

function F.isCellServerMenuVisible()
    return
        F.findVisibleGuiTextObject(
            "Server Menu"
        ) ~= nil
end

function F.closeCellDailyRewardsOnce()
    local playerGui =
        LocalPlayer:FindFirstChildOfClass(
            "PlayerGui"
        )

    if not playerGui then
        return false
    end

    local dailyGui =
        playerGui:FindFirstChild(
            "DailyRewardsGui"
        )

    if not dailyGui then
        return false
    end

    local mainFrame =
        dailyGui:FindFirstChild(
            "MainFrame"
        )

    local wasVisible =
        false

    pcall(function()
        if dailyGui:IsA("ScreenGui") then
            wasVisible =
                dailyGui.Enabled
                and (
                    not mainFrame
                    or not mainFrame:IsA("GuiObject")
                    or mainFrame.Visible
                )
        elseif mainFrame
            and mainFrame:IsA("GuiObject")
        then
            wasVisible =
                mainFrame.Visible
        end
    end)

    if not wasVisible then
        return false
    end

    -- The purpose here is only to dismiss the local popup so it cannot cover
    -- automated input. Do not claim/alter the Daily Reward itself.
    pcall(function()
        if mainFrame
            and mainFrame:IsA("GuiObject")
        then
            mainFrame.Visible =
                false
        end

        if dailyGui:IsA("ScreenGui") then
            dailyGui.Enabled =
                false
        end
    end)

    State.cellFarm.dailyRewardStatus =
        "Closed"

    State.movementTelemetry.lastAction =
        "Closed Daily Rewards popup"

    return true
end

function F.startCellDailyRewardAutoClose(token)
    State.cellFarm.dailyRewardStatus =
        "Watching"

    task.spawn(function()
        local deadline =
            os.clock()
            + Config.CELL_DAILY_REWARD_CLOSE_WINDOW

        while F.isCellFarmActive(token)
            and os.clock() < deadline
        do
            F.closeCellDailyRewardsOnce()

            task.wait(
                Config.CELL_DAILY_REWARD_CLOSE_INTERVAL
            )
        end

        if F.isCellFarmActive(token)
            and State.cellFarm.dailyRewardStatus
                == "Watching"
        then
            State.cellFarm.dailyRewardStatus =
                "Not shown"
        end
    end)

    return true
end

function F.isCellGameplayReady()
    local root =
        F.getCharacterRoot()

    if not root
        or not root.Parent
    then
        return false
    end

    if F.isCellServerMenuVisible()
        or F.findVisibleGuiTextObject("Slot 1")
        or F.findVisibleGuiButtonByText("Endure")
    then
        return false
    end

    return
        workspace:FindFirstChild("Systems")
        ~= nil
end

function F.bootstrapCellMenu(token)
    State.cellFarm.menuProtocolAttempts = 0
    State.cellFarm.menuCallbackAttempts = 0
    State.cellFarm.menuInputAttempts = 0
    State.cellFarm.menuLastCallback = "Physical-only"
    State.cellFarm.menuLastMethod = "None"

    F.setCellMenuHubHidden(
        true
    )

    local function finish(result, method)
        if method then
            State.cellFarm.menuLastMethod =
                method
        end

        F.setCellMenuHubHidden(
            false
        )

        return result
    end

    F.setCellFarmStage(
        "MENU BOOTSTRAP",
        "Waiting for menu controllers to initialize"
    )

    local bootState =
        F.waitForCellResumeBootState(
            token
        )

    if bootState == "gameplay" then
        State.cellFarm.menuPhase =
            "Gameplay"

        return finish(
            true,
            "Boot guard confirmed gameplay"
        )
    end

    if not F.isCellFarmActive(token) then
        return finish(
            false,
            "Cancelled"
        )
    end

    F.setCellFarmStage(
        "MENU BOOTSTRAP",
        "Physical menu input only"
    )

    local deadline =
        os.clock()
        + Config.CELL_MENU_BOOTSTRAP_TIMEOUT

    local lastServerListRequest = 0

    while F.isCellFarmActive(token)
        and os.clock() < deadline
    do
        -- Once bootstrap has seen a menu, do not use root + workspace.Systems
        -- as a shortcut here. Those objects remain replicated while the menu
        -- transitions and caused false "gameplay complete" results.

        -- STEP 1: Main THE VEIL Endure.
        local mainEndure =
            F.getMainMenuEndureButton()

        if mainEndure then
            F.setCellFarmStage(
                "MENU BOOTSTRAP",
                "Physical click: Main Endure"
            )

            local changed =
                F.runPhysicalCellMenuStep(
                    token,
                    mainEndure,
                    "MouseButton1Click",
                    "mainmenugui.handler",
                    function()
                        return
                            F.getMainMenuEndureButton()
                                == nil
                            and F.getSlotOneEndureButtonExact()
                                ~= nil
                    end,
                    "Main Endure"
                )

            if not changed then
                State.cellFarm.menuLastMethod =
                    "Main Endure physical click did not transition"

                task.wait(0.25)
            end

            continue
        end

        -- STEP 2: Slot 1's own Endure button.
        local slotEndure =
            F.getSlotOneEndureButtonExact()

        if slotEndure then
            F.setCellFarmStage(
                "MENU BOOTSTRAP",
                "Physical click: Slot 1 Endure"
            )

            local changed =
                F.runPhysicalCellMenuStep(
                    token,
                    slotEndure,
                    "MouseButton1Click",
                    "saveslotmenu.slotcard",
                    function()
                        return
                            F.getSlotOneEndureButtonExact()
                                == nil
                            and F.isCellServerMenuVisible()
                    end,
                    "Slot 1 Endure"
                )

            if not changed then
                State.cellFarm.menuLastMethod =
                    "Slot 1 Endure physical click did not transition"

                task.wait(0.25)
            end

            continue
        end

        -- STEP 3: click the Current Server card with real input.
        if F.isCellServerMenuVisible() then
            local currentServer =
                F.getCurrentServerMenuButton()

            if not currentServer then
                if os.clock()
                    - lastServerListRequest
                    >= 0.80
                then
                    local cellRemotes =
                        F.getCellRemotes()

                    if cellRemotes
                        and cellRemotes.ServerList
                    then
                        pcall(function()
                            cellRemotes.ServerList:FireServer()
                        end)

                        State.movementTelemetry.lastRemote =
                            "RequestServerList (populate cards)"
                    end

                    lastServerListRequest =
                        os.clock()
                end

                State.cellFarm.menuPhase =
                    "Waiting Current Server card"

                task.wait(0.12)
                continue
            end

            F.setCellFarmStage(
                "MENU BOOTSTRAP",
                "Physical click: Current Server"
            )

            local changed =
                F.runPhysicalCellMenuStep(
                    token,
                    currentServer,
                    "Activated",
                    "assets.scripts.servermenu",
                    function()
                        return
                            F.isCellGameplayReady()
                    end,
                    "Current Server"
                )

            if changed then
                State.cellFarm.menuPhase =
                    "Gameplay"

                return finish(
                    true,
                    "Physical Current Server complete"
                )
            end

            State.cellFarm.menuLastMethod =
                "Current Server physical click did not transition"

            task.wait(0.25)
            continue
        end

        State.cellFarm.menuPhase =
            "Waiting menu transition"

        task.wait(0.12)
    end

    State.cellFarm.menuPhase =
        "Timeout"

    local timeoutReady =
        not F.isAnyCellMenuStageVisible()
        and F.isCellGameplayReady()

    return finish(
        timeoutReady,
        timeoutReady
            and "Gameplay confirmed after menu timeout"
            or "Menu bootstrap timeout"
    )
end

function F.getCellBossHealth(boss)
    if not boss
        or not boss.Parent
        or not F.getMonsterHealthInfo
    then
        return 0, 0
    end

    local info =
        F.getMonsterHealthInfo(
            boss
        )

    if not info then
        return 0, 0
    end

    return
        tonumber(info.Current) or 0,
        tonumber(info.Maximum) or 0
end

function F.updateCellBossHealthSnapshot(boss)
    local hp = 0
    local maxHp = 0
    local stateText = "WAITING"

    if boss
        and boss.Parent
    then
        hp, maxHp =
            F.getCellBossHealth(
                boss
            )

        hp =
            math.max(
                0,
                tonumber(hp) or 0
            )

        maxHp =
            math.max(
                0,
                tonumber(maxHp) or 0
            )

        if maxHp > 0 then
            if hp > 0 then
                stateText = "ALIVE"
            else
                stateText = "DEFEATED"
            end
        else
            stateText = "DETECTED"
        end
    elseif (State.cellFarm.lastBossMaxHealth or 0) > 0
        and (State.cellFarm.lastBossHealth or 0) <= 0
    then
        hp = 0
        maxHp =
            State.cellFarm.lastBossMaxHealth
        stateText = "DEFEATED"
    end

    local percent = 0

    if maxHp > 0 then
        percent =
            math.clamp(
                (hp / maxHp) * 100,
                0,
                100
            )
    end

    State.cellFarm.lastBossHealth = hp
    State.cellFarm.lastBossMaxHealth = maxHp
    State.cellFarm.lastBossHealthPercent = percent
    State.cellFarm.lastBossHealthState = stateText

    return hp, maxHp, percent, stateText
end


function F.getCellDropFolders()
    local result = {}
    local seen = {}

    local wantedNames = {
        drops = true,
        drop = true,
        loot = true,
        lootdrops = true,
        worlddrops = true,
        worldloot = true,
    }

    local function add(object)
        if not object
            or not object.Parent
            or seen[object]
        then
            return
        end

        if not (
            object:IsA("Folder")
            or object:IsA("Model")
        ) then
            return
        end

        seen[object] = true

        table.insert(
            result,
            object
        )
    end

    add(State.dropsFolder)
    add(workspace:FindFirstChild("Drops"))
    add(workspace:FindFirstChild("Drop"))

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do
        if object:IsA("Folder")
            or object:IsA("Model")
        then
            local key =
                string.lower(
                    tostring(
                        object.Name
                        or ""
                    )
                ):gsub(
                    "%s+",
                    ""
                )

            if wantedNames[key] then
                add(object)
            end
        end
    end

    return result
end

function F.collectCellLootCandidates(beforeSnapshot)
    local result = {}
    local seen = {}

    for _, folder in ipairs(
        F.getCellDropFolders()
    ) do
        for _, drop in ipairs(
            F.collectDropObjects(folder)
        ) do
            if not seen[drop]
                and not (
                    beforeSnapshot
                    and beforeSnapshot[drop]
                )
                and F.isDropPresent(drop)
            then
                local include = true

                local dropCFrame =
                    F.getDropCFrame(drop)

                if State.cellFarm.lastBossPosition
                    and dropCFrame
                then
                    include =
                        (
                            dropCFrame.Position
                            - State.cellFarm.lastBossPosition
                        ).Magnitude
                        <= Config.CELL_DROP_RADIUS
                end

                if include then
                    seen[drop] = true
                    table.insert(result, drop)
                end
            end
        end
    end

    return result
end

function F.captureCellDropSnapshot()
    local snapshot = {}

    for _, folder in ipairs(
        F.getCellDropFolders()
    ) do
        for _, drop in ipairs(
            F.collectDropObjects(folder)
        ) do
            snapshot[drop] = true
        end
    end

    return snapshot
end

function F.isCellWeaponTool(tool)
    if not tool
        or not tool.Parent
        or not tool:IsA("Tool")
    then
        return false
    end

    local sword =
        tool:FindFirstChild(
            "IsSword"
        )

    local cast =
        tool:FindFirstChild(
            "IsCastWeapon"
        )

    return
        sword
        and sword:IsA("BoolValue")
        and sword.Value == true
        or cast
        and cast:IsA("BoolValue")
        and cast.Value == true
end

function F.getCellWeaponCandidates()
    local result = {}
    local seen = {}

    local character =
        F.getPlayerCharacter()

    local backpack =
        LocalPlayer:FindFirstChildOfClass(
            "Backpack"
        )

    local function scan(container)
        if not container then
            return
        end

        for _, tool in ipairs(
            container:GetChildren()
        ) do
            if F.isCellWeaponTool(tool)
                and not seen[tool]
            then
                seen[tool] = true
                table.insert(
                    result,
                    tool
                )
            end
        end
    end

    scan(character)
    scan(backpack)

    table.sort(
        result,
        function(a, b)
            return
                string.lower(a.Name)
                < string.lower(b.Name)
        end
    )

    return result
end

function F.findCellWeaponSuggestion(query)
    local cleaned =
        F.trimText(query)

    if cleaned == "" then
        return nil
    end

    local needle =
        string.lower(cleaned)

    local prefix = nil
    local contains = nil

    for _, tool in ipairs(
        F.getCellWeaponCandidates()
    ) do
        local display =
            tostring(tool.Name)

        local key =
            string.lower(display)

        if key == needle then
            return display
        end

        if string.sub(
            key,
            1,
            #needle
        ) == needle
        then
            prefix =
                prefix
                or display
        elseif string.find(
            key,
            needle,
            1,
            true
        ) then
            contains =
                contains
                or display
        end
    end

    return prefix or contains
end

function F.findCellWeaponByName(itemName)
    local wanted =
        string.lower(
            F.trimText(itemName)
        )

    if wanted == "" then
        return nil
    end

    for _, tool in ipairs(
        F.getCellWeaponCandidates()
    ) do
        if string.lower(
            tostring(tool.Name)
        ) == wanted
        then
            return tool
        end
    end

    return nil
end

function F.getBestCellWeapon()
    local equipped =
        F.getEquippedWeaponTool()

    if F.isCellWeaponTool(
        equipped
    ) then
        return equipped
    end

    local best = nil
    local bestOrder = -1

    for _, tool in ipairs(
        F.getCellWeaponCandidates()
    ) do
        local rarity =
            F.getInventoryItemRarity(
                tool
            )

        local order =
            tonumber(rarity.Order)
            or 0

        if not best
            or order > bestOrder
        then
            best = tool
            bestOrder = order
        end
    end

    return best
end

function F.getRequestedCellWeapon()
    local selected =
        F.trimText(
            State.cellFarm.selectedWeaponName
        )

    if selected ~= "" then
        return
            F.findCellWeaponByName(
                selected
            ),
            true
    end

    return
        F.getBestCellWeapon(),
        false
end

function F.equipCellFarmWeapon(token)
    local selected =
        F.trimText(
            State.cellFarm.selectedWeaponName
        )

    local deadline =
        os.clock()
        + Config.CELL_WEAPON_WAIT_TIMEOUT

    repeat
        if token
            and not F.isCellFarmActive(token)
        then
            return false
        end

        local tool,
            required =
                F.getRequestedCellWeapon()

        if tool then
            local character =
                F.getPlayerCharacter()

            if character
                and tool.Parent == character
            then
                State.currentWeaponTool = tool
                State.cellFarm.weaponStatus =
                    "Equipped: "
                    .. tostring(tool.Name)

                return true
            end

            local humanoid =
                F.getHumanoid()

            if humanoid then
                local ok =
                    pcall(function()
                        humanoid:EquipTool(
                            tool
                        )
                    end)

                if ok then
                    task.wait(0.10)

                    character =
                        F.getPlayerCharacter()

                    if character
                        and tool.Parent == character
                    then
                        State.currentWeaponTool = tool
                        State.cellFarm.weaponStatus =
                            "Equipped: "
                            .. tostring(tool.Name)

                        return true
                    end
                end
            end

            if not required then
                return false
            end
        end

        State.cellFarm.weaponStatus =
            selected ~= ""
            and (
                "Waiting for selected weapon: "
                .. selected
            )
            or "Waiting for a usable weapon"

        if F.updateCellFarmUI then
            F.updateCellFarmUI()
        end

        task.wait(0.18)
    until
        os.clock() >= deadline

    State.cellFarm.weaponStatus =
        selected ~= ""
        and (
            "Selected weapon unavailable: "
            .. selected
        )
        or "No usable weapon found"

    return false
end

function F.equipBestCellWeapon()
    return F.equipCellFarmWeapon(nil)
end

function F.captureCellRestoreState()
    if State.cellFarm.restore then
        return
    end

    State.cellFarm.restore = {
        farmEnabled = State.farmEnabled,
        monsterLockEnabled = State.monsterLockEnabled,
        lockedMonster = State.lockedMonster,
        monsterLockManualSelection = State.monsterLockManualSelection,
        weaponAutoAttackEnabled = State.weaponAutoAttackEnabled,
        finisherEnabled = State.finisherEnabled,
        sellEnabled = State.sellEnabled,
        nightCallEnabled = State.nightCallEnabled,
        stoneAccordEnabled = State.stoneAccordEnabled,
    }
end

function F.applyCellExclusiveMode()
    State.farmEnabled = false
    State.farmBusy = false
    State.farmNoMatchSince = nil
    State.sellEnabled = false
    State.nightCallEnabled = false
    State.stoneAccordEnabled = false
    F.stopLootLock("FARM")
    F.releaseMovement("FARM")

    if State.farmToggle then
        State.farmToggle:SetSilent(false)
    end

    if State.sellToggle then
        State.sellToggle:SetSilent(false)
    end

    if State.nightCallToggle then
        State.nightCallToggle:SetSilent(false)
    end

    if stoneToggle then
        stoneToggle:SetSilent(false)
    end

    F.updateFarmStatus()
    F.updateSellStatus()
    F.updateNightCallStatus()
end

function F.restoreCellPreviousState()
    local restore =
        State.cellFarm.restore

    State.cellFarm.restore = nil

    if type(restore) ~= "table" then
        return
    end

    State.farmEnabled =
        restore.farmEnabled == true

    State.monsterLockEnabled =
        restore.monsterLockEnabled == true

    State.lockedMonster =
        restore.lockedMonster
        and restore.lockedMonster.Parent
        and restore.lockedMonster
        or nil

    State.monsterLockManualSelection =
        restore.monsterLockManualSelection == true

    State.weaponAutoAttackEnabled =
        restore.weaponAutoAttackEnabled == true

    State.finisherEnabled =
        restore.finisherEnabled == true

    State.sellEnabled =
        restore.sellEnabled == true

    State.nightCallEnabled =
        restore.nightCallEnabled == true

    State.stoneAccordEnabled =
        restore.stoneAccordEnabled == true

    F.applyFarmConfigToUI()
    F.setMonsterLock(
        State.monsterLockEnabled
    )

    if weaponToggle then
        weaponToggle:SetSilent(
            State.weaponAutoAttackEnabled
        )
    end

    if finisherToggle then
        finisherToggle:SetSilent(
            State.finisherEnabled
        )
    end

    if State.sellToggle then
        State.sellToggle:SetSilent(
            State.sellEnabled
        )
    end

    if State.nightCallToggle then
        State.nightCallToggle:SetSilent(
            State.nightCallEnabled
        )
    end

    if stoneToggle then
        stoneToggle:SetSilent(
            State.stoneAccordEnabled
        )
    end

    State.updateCombatStatus()
    F.updateSellStatus()
    F.updateNightCallStatus()
end


function F.getNearbyCellBossPlayer(boss)
    if not boss
        or not boss.Parent
    then
        return nil
    end

    local bossPart =
        F.getMonsterPart(
            boss
        )

    if not bossPart then
        return nil
    end

    local nearestPlayer = nil
    local nearestDistance = math.huge
    local nearestEvidence = "None"

    for _, player in ipairs(
        Players:GetPlayers()
    ) do
        if player ~= LocalPlayer then
            local character =
                player.Character

            local root =
                character
                and (
                    character:FindFirstChild(
                        "HumanoidRootPart"
                    )
                    or character.PrimaryPart
                )

            local humanoid =
                character
                and character:FindFirstChildOfClass(
                    "Humanoid"
                )

            if root
                and root:IsA("BasePart")
                and humanoid
                and humanoid.Health > 0
            then
                local distance =
                    (
                        root.Position
                        - bossPart.Position
                    ).Magnitude

                if distance
                    <= Config.CELL_PLAYER_NEAR_BOSS_HOP_RADIUS
                    and distance
                    < nearestDistance
                then
                    local evidence =
                        "NEAR CELL BOSS"

                    -- The game can expose an `enemy` object on a character /
                    -- humanoid. If it points at The Cell Of Life, record the
                    -- stronger evidence. Proximity alone still triggers the
                    -- requested privacy hop so a player does not need to land
                    -- a hit before we leave.
                    local enemyObject =
                        humanoid:FindFirstChild(
                            "enemy"
                        )
                        or character:FindFirstChild(
                            "enemy",
                            true
                        )

                    if enemyObject
                        and enemyObject:IsA(
                            "ObjectValue"
                        )
                        and enemyObject.Value
                            == boss
                    then
                        evidence =
                            "TARGETING THE CELL OF LIFE"
                    end

                    nearestPlayer =
                        player

                    nearestDistance =
                        distance

                    nearestEvidence =
                        evidence
                end
            end
        end
    end

    if nearestPlayer then
        return
            nearestPlayer,
            nearestDistance,
            nearestEvidence
    end

    return nil
end

function F.stopCellCombatForPlayerHop()
    State.monsterLockEnabled = false
    State.weaponAutoAttackEnabled = false
    State.finisherEnabled = false
    State.lockedMonster = nil

    F.stopMovementFlight(
        "MONSTER_LOCK"
    )

    F.releaseMovement(
        "MONSTER_LOCK"
    )

    if monsterLockToggle then
        monsterLockToggle:SetSilent(
            false
        )
    end

    if weaponToggle then
        weaponToggle:SetSilent(
            false
        )
    end

    if finisherToggle then
        finisherToggle:SetSilent(
            false
        )
    end

    State.updateMonsterButtons()
    State.updateCombatStatus()
end

function F.handleCellBossPlayerAvoidance(
    token,
    boss
)
    local player,
        distance,
        evidence =
            F.getNearbyCellBossPlayer(
                boss
            )

    if not player then
        return false
    end

    State.cellFarm.nearbyBossPlayerName =
        tostring(
            player.Name
        )

    State.cellFarm.nearbyBossPlayerDistance =
        tonumber(distance)
        or -1

    State.cellFarm.nearbyBossPlayerEvidence =
        tostring(
            evidence
            or "NEAR CELL BOSS"
        )

    State.cellFarm.playerAvoidHopTriggered =
        true

    F.stopCellCombatForPlayerHop()

    while F.isCellFarmActive(token) do
        local currentPlayer,
            currentDistance,
            currentEvidence =
                F.getNearbyCellBossPlayer(
                    boss
                )

        if not currentPlayer then
            -- If hop could not start and the player left before the next
            -- attempt, resume the fight rather than abandoning the run.
            State.cellFarm.nearbyBossPlayerName =
                "None"

            State.cellFarm.nearbyBossPlayerDistance =
                -1

            State.cellFarm.nearbyBossPlayerEvidence =
                "Player left before hop"

            State.cellFarm.playerAvoidHopTriggered =
                false

            F.setCellFarmStage(
                "FIGHTING",
                "Nearby player left before hop - resuming Cell fight"
            )

            F.prepareCellFight(
                boss,
                token
            )

            return false
        end

        State.cellFarm.nearbyBossPlayerName =
            tostring(
                currentPlayer.Name
            )

        State.cellFarm.nearbyBossPlayerDistance =
            tonumber(currentDistance)
            or -1

        State.cellFarm.nearbyBossPlayerEvidence =
            tostring(
                currentEvidence
                or "NEAR CELL BOSS"
            )

        F.setCellFarmStage(
            "PLAYER NEAR BOSS - HOP",
            tostring(
                currentPlayer.Name
            )
                .. " @ "
                .. string.format(
                    "%.1f",
                    tonumber(currentDistance)
                    or -1
                )
                .. " studs | "
                .. tostring(
                    currentEvidence
                    or "NEAR CELL BOSS"
                )
                .. " | finding a new server now"
        )

        if F.updateCellFarmUI then
            F.updateCellFarmUI()
        end

        if not State.serverHopBusy then
            State.cellFarm.playerAvoidHopAttempts =
                (
                    State.cellFarm.playerAvoidHopAttempts
                    or 0
                )
                + 1

            local hopStarted =
                F.cellFarmHop(
                    token,
                    "Other player near The Cell Of Life: "
                        .. tostring(
                            currentPlayer.Name
                        )
                        .. " ("
                        .. string.format(
                            "%.1f",
                            tonumber(currentDistance)
                            or -1
                        )
                        .. " studs)"
                )

            if not hopStarted then
                F.setCellFarmStage(
                    "PLAYER HOP RETRY",
                    "Could not start server hop yet - retrying while player remains near boss"
                )
            end
        end

        -- If TeleportToPlaceInstance succeeds this runtime is replaced.
        -- If it fails/times out, serverHopBusy clears and the loop retries
        -- another server while the other player is still nearby.
        if not F.cellFarmWait(
            token,
            State.serverHopBusy
            and 0.25
            or Config.CELL_PLAYER_NEAR_BOSS_HOP_RETRY
        ) then
            return true
        end
    end

    return true
end

function F.prepareCellFight(boss, token)
    if not boss
        or not boss.Parent
    then
        return false
    end

    if not F.equipCellFarmWeapon(
        token
    ) then
        F.recordCellFailure(
            "Selected Cell weapon could not be equipped: "
                .. tostring(
                    State.cellFarm.selectedWeaponName ~= ""
                    and State.cellFarm.selectedWeaponName
                    or "AUTO"
                )
        )

        return false
    end

    State.cellFarm.boss = boss
    State.lockedMonster = boss
    State.monsterLockManualSelection = true
    State.monsterLockWaiting = false
    State.monsterLockEnabled = true
    State.weaponAutoAttackEnabled = true
    State.finisherEnabled = true

    if monsterLockToggle then
        monsterLockToggle:SetSilent(true)
    end

    if weaponToggle then
        weaponToggle:SetSilent(true)
    end

    if finisherToggle then
        finisherToggle:SetSilent(true)
    end

    State.updateMonsterButtons()
    State.updateCombatStatus()

    return true
end

function F.fightCellBoss(token, boss)
    -- Do not even engage if another live player is already close to the boss.
    if F.handleCellBossPlayerAvoidance(
        token,
        boss
    ) then
        return false
    end

    if not F.prepareCellFight(
        boss,
        token
    ) then
        return false
    end

    F.setCellFarmStage(
        "FIGHTING",
        "The Cell Of Life"
    )

    local fightStartedAt =
        os.clock()

    local timeoutNoticeSent =
        false

    while F.isCellFarmActive(token) do
        if not boss
            or not boss.Parent
            or (
                F.isMonsterAlive
                and not F.isMonsterAlive(boss)
            )
        then
            return true
        end

        local nearbyPlayer,
            nearbyDistance,
            nearbyEvidence =
                F.getNearbyCellBossPlayer(
                    boss
                )

        if nearbyPlayer then
            State.cellFarm.nearbyBossPlayerName =
                tostring(
                    nearbyPlayer.Name
                )

            State.cellFarm.nearbyBossPlayerDistance =
                tonumber(
                    nearbyDistance
                )
                or -1

            State.cellFarm.nearbyBossPlayerEvidence =
                tostring(
                    nearbyEvidence
                    or "NEAR CELL BOSS"
                )

            if F.handleCellBossPlayerAvoidance(
                token,
                boss
            ) then
                return false
            end
        end

        local part =
            F.getMonsterPart(
                boss
            )

        if part then
            State.cellFarm.lastBossPosition =
                part.Position
        end

        local currentHealth,
            maxHealth =
                F.getCellBossHealth(
                    boss
                )

        State.cellFarm.lastBossHealth =
            currentHealth
        State.cellFarm.lastBossMaxHealth =
            maxHealth

        local healthPercent = 0

        if maxHealth > 0 then
            healthPercent =
                math.clamp(
                    (currentHealth / maxHealth) * 100,
                    0,
                    100
                )
        end

        State.cellFarm.lastBossHealthPercent =
            healthPercent
        State.cellFarm.lastBossHealthState =
            currentHealth > 0
            and "ALIVE"
            or "DEFEATED"

        if os.clock()
            - (State.cellFarm.lastBossHealthUIAt or 0)
            >= Config.CELL_BOSS_HP_UI_INTERVAL
        then
            State.cellFarm.lastBossHealthUIAt =
                os.clock()

            if F.updateCellFarmUI then
                F.updateCellFarmUI()
            end
        end

        if currentHealth <= 0
            and maxHealth > 0
        then
            State.cellFarm.lastBossHealth = 0
            State.cellFarm.lastBossHealthPercent = 0
            State.cellFarm.lastBossHealthState = "DEFEATED"

            if F.updateCellFarmUI then
                F.updateCellFarmUI()
            end

            return true
        end

        if not F.getCharacterRoot() then
            F.setCellFarmStage(
                "RECOVERING",
                "Waiting for character respawn"
            )

            local respawnDeadline =
                os.clock()
                + Config.CELL_RESPAWN_WAIT

            repeat
                task.wait(0.20)
            until
                not F.isCellFarmActive(token)
                or F.getCharacterRoot()
                or os.clock()
                    >= respawnDeadline

            if not F.getCharacterRoot() then
                return false
            end

            F.setCellFarmStage(
                "RESPAWN SETTLE",
                "Waiting for character controller"
            )

            if not F.cellFarmWait(
                token,
                1.25
            ) then
                return false
            end

            if not F.equipCellFarmWeapon(
                token
            ) then
                return false
            end

            State.lockedMonster = boss
            State.monsterLockEnabled = true

            F.setCellFarmStage(
                "FIGHTING",
                "Resumed after respawn"
            )
        end

        if not timeoutNoticeSent
            and os.clock() - fightStartedAt
                >= Config.CELL_FIGHT_TIMEOUT
        then
            timeoutNoticeSent = true

            F.recordDiagnosticEvent(
                "CellFarm",
                "Fight exceeded timeout notice threshold; continuing instead of server hopping."
            )

            State.cellFarm.status =
                "Long fight - continuing until The Cell Of Life is actually defeated"
        end

        task.wait(
            Config.CELL_PLAYER_NEAR_BOSS_CHECK_INTERVAL
        )
    end

    return false
end

function F.collectCellDropConfirmed(drop, token)
    if not F.isCellFarmActive(token) then
        return false
    end

    if not F.isDropPresent(drop) then
        return true
    end

    if State.isSpectating then
        F.resetCamera()
    end

    F.stopMovementFlight("MONSTER_LOCK")
    F.releaseMovement("MONSTER_LOCK")
    F.stopLootLock("CELL")

    for moveAttempt = 1,
        Config.CELL_LOOT_MOVE_RETRIES
    do
        if not F.isCellFarmActive(token) then
            return false
        end

        if not F.isDropPresent(drop) then
            return true
        end

        local target =
            F.getDropStandCFrame(drop)

        local root =
            F.getCharacterRoot()

        if not target
            or not root
        then
            State.cellFarm.status =
                "LOOT MOVE: target/root unavailable"

            if not F.cellFarmWait(
                token,
                Config.CELL_LOOT_STUCK_RETRY_DELAY
            ) then
                return false
            end

            continue
        end

        local distance =
            (
                target.Position
                - root.Position
            ).Magnitude

        State.cellFarm.lootMoveTarget =
            tostring(drop.Name)

        State.cellFarm.lootMoveDistance =
            distance

        State.cellFarm.lootMoveAttempts =
            (State.cellFarm.lootMoveAttempts or 0)
            + 1

        State.cellFarm.lootMoveConfirmed =
            false

        F.setCellFarmStage(
            "LOOT MOVE",
            "Flying to "
                .. tostring(drop.Name)
                .. " | "
                .. string.format("%.1f", distance)
                .. " studs | attempt "
                .. tostring(moveAttempt)
                .. "/"
                .. tostring(
                    Config.CELL_LOOT_MOVE_RETRIES
                )
        )

        local arrived =
            F.flyToCFrame(
                target,
                "CELL",
                F.getLootArrivalDistance(drop),
                Config.CELL_LOOT_DIRECT_MOVE_TIMEOUT,
                "Cell"
            )

        if not F.isCellFarmActive(token) then
            return false
        end

        if not F.isDropPresent(drop) then
            State.cellFarm.lootMoveConfirmed =
                true

            return true
        end

        if not arrived then
            if F.acquireMovement(
                "CELL",
                4
            ) then
                local lockToken =
                    F.startLootLock(
                        drop,
                        "CELL"
                    )

                if lockToken then
                    arrived =
                        F.waitForLootFlightArrival(
                            drop,
                            "CELL",
                            lockToken
                        )

                    F.stopLootLock(
                        "CELL",
                        lockToken
                    )
                else
                    F.releaseMovement("CELL")
                end
            end
        end

        if not arrived then
            State.cellFarm.status =
                "LOOT MOVE FAILED: "
                .. tostring(drop.Name)
                .. " - retrying"

            if not F.cellFarmWait(
                token,
                Config.CELL_LOOT_STUCK_RETRY_DELAY
            ) then
                return false
            end

            continue
        end

        State.cellFarm.lootMoveConfirmed =
            true

        local currentRoot =
            F.getCharacterRoot()

        local currentTarget =
            F.getDropStandCFrame(drop)

        if currentRoot
            and currentTarget
        then
            State.cellFarm.lootMoveDistance =
                (
                    currentTarget.Position
                    - currentRoot.Position
                ).Magnitude
        end

        F.setCellFarmStage(
            "LOOT ARRIVED",
            "Reached "
                .. tostring(drop.Name)
                .. " - requesting pickup"
        )

        for pickupAttempt = 1,
            Config.LOOT_RETRY_COUNT
        do
            if not F.isCellFarmActive(token) then
                return false
            end

            if not F.isDropPresent(drop) then
                return true
            end

            F.setCellFarmStage(
                "LOOT PICKUP",
                tostring(drop.Name)
                    .. " | pickup "
                    .. tostring(pickupAttempt)
                    .. "/"
                    .. tostring(
                        Config.LOOT_RETRY_COUNT
                    )
            )

            task.wait(
                Config.LOOT_INTERACT_DELAY
            )

            F.fireDirectDropPickup(drop)

            local remoteDeadline =
                os.clock()
                + Config.LOOT_REMOTE_CONFIRM_TIMEOUT

            while F.isCellFarmActive(token)
                and os.clock() < remoteDeadline
                and F.isDropPresent(drop)
            do
                task.wait(
                    Config.LOOT_CONFIRM_POLL
                )
            end

            if not F.isDropPresent(drop) then
                State.cellFarm.status =
                    "CONFIRMED loot collected: "
                    .. tostring(drop.Name)

                return true
            end

            F.pressLootInteractKey()

            local confirmDeadline =
                os.clock()
                + Config.LOOT_CONFIRM_TIMEOUT

            while F.isCellFarmActive(token)
                and os.clock() < confirmDeadline
                and F.isDropPresent(drop)
            do
                task.wait(
                    Config.LOOT_CONFIRM_POLL
                )
            end

            if not F.isDropPresent(drop) then
                State.cellFarm.status =
                    "CONFIRMED loot collected after interact: "
                    .. tostring(drop.Name)

                return true
            end
        end

        if not F.cellFarmWait(
            token,
            Config.CELL_LOOT_STUCK_RETRY_DELAY
        ) then
            return false
        end
    end

    State.cellFarm.status =
        "LOOT STILL PRESENT: "
        .. tostring(drop.Name)
        .. " - collection incomplete"

    return false
end

function F.formatCellRewardItemList(payload)
    if type(payload) ~= "table" then
        return nil, 0
    end

    local names = {}
    local count = 0

    for _, entry in pairs(payload) do
        if type(entry) == "table" then
            local itemName =
                entry.n
                or entry.Name
                or entry.name

            local rarity =
                entry.r
                or entry.Rarity
                or entry.rarity

            if itemName then
                count = count + 1

                if #names < 8 then
                    table.insert(
                        names,
                        tostring(itemName)
                            .. (
                                rarity
                                and (
                                    " ["
                                    .. tostring(rarity)
                                    .. "]"
                                )
                                or ""
                            )
                    )
                end
            end
        end
    end

    if count <= 0 then
        return nil, 0
    end

    return
        table.concat(
            names,
            ", "
        ),
        count
end

function F.startCellRewardEventObserver(token)
    local remotes =
        F.getCellRemotes()

    local observer = {
        connections = {},
    }

    local function addConnection(connection)
        if connection then
            table.insert(
                observer.connections,
                connection
            )
        end
    end

    local defeatRemote =
        remotes
        and remotes.BossDefeatLabel

    if defeatRemote
        and defeatRemote:IsA(
            "RemoteEvent"
        )
    then
        local ok,
            connection =
                pcall(function()
                    return defeatRemote.OnClientEvent:Connect(
                        function(...)
                            if not F.isCellFarmActive(token) then
                                return
                            end

                            State.cellFarm.bossDefeatEvents =
                                (
                                    State.cellFarm.bossDefeatEvents
                                    or 0
                                )
                                + 1

                            local args = {...}
                            local matched = false
                            local parts = {}

                            for index,
                                value in ipairs(args)
                            do
                                local textValue =
                                    tostring(value)

                                if #parts < 4 then
                                    table.insert(
                                        parts,
                                        textValue
                                    )
                                end

                                if string.find(
                                    string.upper(
                                        textValue
                                    ),
                                    "CREATION UNDONE",
                                    1,
                                    true
                                ) then
                                    matched = true
                                end
                            end

                            State.cellFarm.bossDefeatLast =
                                #parts > 0
                                and table.concat(
                                    parts,
                                    " | "
                                )
                                or "(no args)"

                            if matched then
                                State.cellFarm.bossDefeatEventConfirmed =
                                    true

                                State.cellFarm.lastBossHealthState =
                                    "DEFEATED"

                                State.cellFarm.status =
                                    "CONFIRMED BossDefeatLabel: CREATION UNDONE"
                            end

                            if F.updateCellFarmUI then
                                F.updateCellFarmUI()
                            end
                        end
                    )
                end)

        if ok then
            addConnection(
                connection
            )
        end
    end

    local itemRemote =
        remotes
        and remotes.ItemNotify

    if itemRemote
        and itemRemote:IsA(
            "RemoteEvent"
        )
    then
        local ok,
            connection =
                pcall(function()
                    return itemRemote.OnClientEvent:Connect(
                        function(...)
                            if not F.isCellFarmActive(token) then
                                return
                            end

                            State.cellFarm.itemNotifyEvents =
                                (
                                    State.cellFarm.itemNotifyEvents
                                    or 0
                                )
                                + 1

                            local args = {...}
                            local bestText = nil
                            local bestCount = 0

                            for _,
                                value in ipairs(args)
                            do
                                local textValue,
                                    itemCount =
                                        F.formatCellRewardItemList(
                                            value
                                        )

                                if itemCount > bestCount then
                                    bestCount =
                                        itemCount

                                    bestText =
                                        textValue
                                end
                            end

                            if bestCount > 0 then
                                State.cellFarm.itemNotifyItems =
                                    (
                                        State.cellFarm.itemNotifyItems
                                        or 0
                                    )
                                    + bestCount

                                State.cellFarm.itemNotifyLast =
                                    bestText
                                    or (
                                        tostring(bestCount)
                                        .. " item(s)"
                                    )

                                State.cellFarm.status =
                                    "CONFIRMED ItemNotifyEvent: "
                                    .. tostring(
                                        State.cellFarm.itemNotifyLast
                                    )
                            else
                                State.cellFarm.itemNotifyLast =
                                    F.describeCellEventArgs(
                                        ...
                                    )
                            end

                            if F.updateCellFarmUI then
                                F.updateCellFarmUI()
                            end
                        end
                    )
                end)

        if ok then
            addConnection(
                connection
            )
        end
    end

    return observer
end

function F.stopCellRewardEventObserver(observer)
    if not observer
        or type(observer.connections)
            ~= "table"
    then
        return
    end

    for _,
        connection in ipairs(
            observer.connections
        )
    do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(
        observer.connections
    )
end

function F.getCellInstanceDebugId(object)
    if typeof(object) ~= "Instance" then
        return "None"
    end

    local debugId =
        "Unavailable"

    pcall(function()
        debugId =
            object:GetDebugId()
    end)

    return tostring(debugId)
end

function F.isCellNilRewardChestCandidate(object)
    if typeof(object) ~= "Instance" then
        return false
    end

    if object.Parent then
        return false
    end

    if not (
        object:IsA("Model")
        or object:IsA("BasePart")
    ) then
        return false
    end

    local lowered =
        string.lower(
            F.trimText(
                tostring(
                    object.Name
                    or ""
                )
            )
        )

    return
        lowered == "chest"
        or string.find(
            lowered,
            "chest",
            1,
            true
        ) ~= nil
        or string.find(
            lowered,
            "world boss",
            1,
            true
        ) ~= nil
end

function F.getCellRewardChestRoot(object)
    if not object then
        return nil
    end

    if not object.Parent
        and F.isCellNilRewardChestCandidate(
            object
        )
    then
        return object
    end

    if not object.Parent then
        return nil
    end

    local function textLooksLikeChest(text)
        local lowered =
            string.lower(
                F.trimText(
                    tostring(text or "")
                )
            )

        return
            string.find(
                lowered,
                "chest",
                1,
                true
            ) ~= nil
            or string.find(
                lowered,
                "crate",
                1,
                true
            ) ~= nil
            or string.find(
                lowered,
                "reward box",
                1,
                true
            ) ~= nil
            or string.find(
                lowered,
                "loot box",
                1,
                true
            ) ~= nil
            or string.find(
                lowered,
                "world boss",
                1,
                true
            ) ~= nil
    end

    if (
        object:IsA("Model")
        or object:IsA("BasePart")
    )
        and textLooksLikeChest(
            object.Name
        )
    then
        return object
    end

    if object:IsA("ProximityPrompt") then
        local promptLooksRight =
            textLooksLikeChest(
                object.ObjectText
            )
            or textLooksLikeChest(
                object.ActionText
            )
            or string.find(
                string.lower(
                    tostring(
                        object.ActionText
                        or ""
                    )
                ),
                "open",
                1,
                true
            ) ~= nil

        if promptLooksRight then
            local current =
                object.Parent

            for _ = 1, 6 do
                if not current
                    or current == workspace
                then
                    break
                end

                if current:IsA("Model") then
                    return current
                end

                if current:IsA("BasePart")
                    and current.Parent == workspace
                then
                    return current
                end

                current = current.Parent
            end
        end
    end

    if object:IsA("ClickDetector") then
        local parent =
            object.Parent

        if parent
            and (
                parent:IsA("BasePart")
                or parent:IsA("Model")
            )
        then
            return parent
        end
    end

    return nil
end

function F.isCellRewardChestNearBoss(chest)
    if not chest
        or not chest.Parent
        or not chest:IsDescendantOf(workspace)
    then
        return false
    end

    local chestCFrame =
        F.getDropCFrame(
            chest
        )

    if not chestCFrame then
        return false
    end

    local bossPosition =
        State.cellFarm.lastBossPosition

    if not bossPosition then
        return true
    end

    return
        (
            chestCFrame.Position
            - bossPosition
        ).Magnitude
        <= Config.CELL_REWARD_CHEST_RADIUS
end

function F.collectCellRewardChestCandidates(beforeSnapshot)
    local result = {}
    local seen = {}

    local function consider(object)
        local chest =
            F.getCellRewardChestRoot(
                object
            )

        if not chest
            or seen[chest]
            or (
                beforeSnapshot
                and beforeSnapshot[chest]
            )
        then
            return
        end

        local nearBoss =
            true

        if State.cellFarm.lastBossPosition then
            nearBoss =
                F.isCellRewardChestNearBoss(
                    chest
                )
        end

        if not nearBoss then
            return
        end

        seen[chest] = true

        table.insert(
            result,
            chest
        )
    end

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do
        consider(
            object
        )
    end

    -- Cobalt showed OpenChest receiving a nil-parent Chest instance.
    -- Do not hard-code its DebugId; scan the live nil-instance set and keep
    -- the actual Instance reference for this server/run.
    if type(getnilinstances) == "function" then
        local ok,
            objects =
                pcall(
                    getnilinstances
                )

        if ok
            and type(objects) == "table"
        then
            for _, object in ipairs(
                objects
            ) do
                if F.isCellNilRewardChestCandidate(
                    object
                ) then
                    consider(
                        object
                    )
                end
            end
        end
    end

    return result
end

function F.captureCellRewardChestSnapshot()
    local snapshot = {}

    for _, chest in ipairs(
        F.collectCellRewardChestCandidates(
            nil
        )
    ) do
        snapshot[chest] = true
    end

    return snapshot
end

function F.countCellRewardDrops(beforeSnapshot)
    return #F.collectCellLootCandidates(
        beforeSnapshot
    )
end

function F.isCellRewardChestOpened(chest)
    if not chest then
        return true
    end

    for _, attributeName in ipairs({
        "Opened",
        "Open",
        "IsOpened",
        "Claimed",
        "Used",
    }) do
        local ok, value =
            pcall(function()
                return chest:GetAttribute(
                    attributeName
                )
            end)

        if ok and value == true then
            return true
        end
    end

    for _, valueName in ipairs({
        "Opened",
        "Open",
        "IsOpened",
        "Claimed",
        "Used",
    }) do
        local value =
            chest:FindFirstChild(
                valueName,
                true
            )

        if value
            and value:IsA("BoolValue")
            and value.Value == true
        then
            return true
        end
    end

    local prompt =
        chest:FindFirstChildWhichIsA(
            "ProximityPrompt",
            true
        )

    if prompt
        and prompt.Enabled == false
    then
        return true
    end

    return false
end

function F.stopCellRewardMovement()
    F.stopLootLock(
        "CELL"
    )
    F.stopMovementFlight(
        "CELL"
    )
    F.stopMovementFlight(
        "MONSTER_LOCK"
    )
    F.releaseMovement(
        "CELL"
    )
    F.releaseMovement(
        "MONSTER_LOCK"
    )

    local root =
        F.getCharacterRoot()

    if root then
        pcall(function()
            root.AssemblyLinearVelocity =
                Vector3.zero

            root.AssemblyAngularVelocity =
                Vector3.zero
        end)
    end
end

function F.openCellRewardChest(chest, token, beforeDropSnapshot)
    if not F.isCellFarmActive(token) then
        return false
    end

    if not chest
        or typeof(chest) ~= "Instance"
    then
        return false
    end

    local initialParent =
        chest.Parent

    local debugId =
        F.getCellInstanceDebugId(
            chest
        )

    State.cellFarm.rewardLastChestDebugId =
        debugId

    local chestCFrame =
        F.getDropCFrame(
            chest
        )

    if chestCFrame then
        F.setCellFarmStage(
            "OPENING REWARD CHEST",
            "Moving to Chest "
                .. tostring(debugId)
        )

        local reached =
            F.flyToCFrame(
                chestCFrame,
                "CELL",
                Config.CELL_REWARD_CHEST_OPEN_DISTANCE,
                45,
                "Cell"
            )

        if not reached
            and not F.isCellFarmActive(token)
        then
            return false
        end
    end

    F.stopCellRewardMovement()

    local remotes =
        F.getCellRemotes()

    local interactPrompt =
        remotes
        and remotes.InteractPrompt

    if not interactPrompt
        or not interactPrompt:IsA(
            "RemoteEvent"
        )
    then
        F.recordCellFailure(
            "InteractPromptEvent unavailable for Cell reward chest"
        )

        return false
    end

    for attempt = 1,
        Config.CELL_REWARD_CHEST_OPEN_RETRIES
    do
        if not F.isCellFarmActive(token) then
            return false
        end

        if F.isCellRewardChestOpened(
            chest
        ) then
            return true
        end

        local dropsBefore =
            F.countCellRewardDrops(
                beforeDropSnapshot
            )

        local itemNotifyBefore =
            State.cellFarm.itemNotifyEvents
            or 0

        local itemCountBefore =
            State.cellFarm.itemNotifyItems
            or 0

        F.setCellFarmStage(
            "OPENING REWARD CHEST",
            "Exact OpenChest remote "
                .. tostring(attempt)
                .. "/"
                .. tostring(
                    Config.CELL_REWARD_CHEST_OPEN_RETRIES
                )
                .. " | DebugId="
                .. tostring(debugId)
        )

        local sent =
            pcall(function()
                local Event =
                    game:GetService(
                        "ReplicatedStorage"
                    ).Remotes.InteractPromptEvent

                Event:FireServer(
                    "OpenChest",
                    chest
                )
            end)

        if sent then
            State.cellFarm.rewardChestRemoteCalls =
                (
                    State.cellFarm.rewardChestRemoteCalls
                    or 0
                )
                + 1

            State.movementTelemetry.lastRemote =
                'InteractPromptEvent:FireServer("OpenChest", Chest)'
        else
            F.recordCellFailure(
                "Exact OpenChest remote call failed"
            )
        end

        if not F.cellFarmWait(
            token,
            Config.CELL_REWARD_CHEST_REMOTE_SETTLE
        ) then
            return false
        end

        local deadline =
            os.clock()
            + Config.CELL_REWARD_CHEST_OPEN_CONFIRM

        while F.isCellFarmActive(token)
            and os.clock() < deadline
        do
            if F.isCellRewardChestOpened(
                chest
            ) then
                State.cellFarm.status =
                    "CONFIRMED chest opened by state flag/prompt"

                return true
            end

            if initialParent
                and not chest.Parent
            then
                State.cellFarm.status =
                    "CONFIRMED chest opened: parent removed"

                return true
            end

            local dropsNow =
                F.countCellRewardDrops(
                    beforeDropSnapshot
                )

            if dropsNow > dropsBefore then
                State.cellFarm.status =
                    "CONFIRMED chest opened: new world drops"

                return true
            end

            local itemNotifyNow =
                State.cellFarm.itemNotifyEvents
                or 0

            local itemCountNow =
                State.cellFarm.itemNotifyItems
                or 0

            if itemNotifyNow > itemNotifyBefore
                or itemCountNow > itemCountBefore
            then
                State.cellFarm.status =
                    "CONFIRMED chest opened: ItemNotifyEvent received"

                return true
            end

            task.wait(0.10)
        end

        if not F.cellFarmWait(
            token,
            0.35
        ) then
            return false
        end
    end

    return false
end

function F.waitForCellRewardDropsStable(token, beforeDropSnapshot)
    F.setCellFarmStage(
        "WAITING REWARD DROP WAVES",
        "Waiting for every chest-loot layer to finish spawning"
    )

    local lastCount =
        F.countCellRewardDrops(
            beforeDropSnapshot
        )

    State.cellFarm.rewardDropCount =
        lastCount

    State.cellFarm.rewardDropWaves =
        lastCount > 0
        and 1
        or 0

    local stableSince =
        os.clock()

    local guardSince = nil

    local lastNotice =
        os.clock()

    while F.isCellFarmActive(token) do
        task.wait(0.15)

        local currentCount =
            F.countCellRewardDrops(
                beforeDropSnapshot
            )

        State.cellFarm.rewardDropCount =
            currentCount

        if currentCount ~= lastCount then
            lastCount =
                currentCount

            stableSince =
                os.clock()

            guardSince =
                nil

            State.cellFarm.rewardDropWaves =
                (State.cellFarm.rewardDropWaves or 0)
                + 1

            State.cellFarm.status =
                "Chest loot wave "
                .. tostring(
                    State.cellFarm.rewardDropWaves
                )
                .. " detected | "
                .. tostring(currentCount)
                .. " drops"

            if F.updateCellFarmUI then
                F.updateCellFarmUI()
            end
        elseif currentCount > 0 then
            if not guardSince
                and os.clock() - stableSince
                    >= Config.CELL_REWARD_DROP_STABLE_WINDOW
            then
                guardSince =
                    os.clock()

                State.cellFarm.status =
                    "Loot quiet for "
                    .. tostring(
                        Config.CELL_REWARD_DROP_STABLE_WINDOW
                    )
                    .. "s; final delayed-wave guard running"

                if F.updateCellFarmUI then
                    F.updateCellFarmUI()
                end
            elseif guardSince
                and os.clock() - guardSince
                    >= Config.CELL_REWARD_DROP_FINAL_GUARD
            then
                return
                    true,
                    currentCount
            end
        else
            guardSince = nil
        end

        if os.clock() - lastNotice
            >= Config.CELL_REWARD_DROP_NOTICE
        then
            lastNotice =
                os.clock()

            if currentCount == 0 then
                F.recordCellFailure(
                    "All reward chests opened but no drops detected yet; still waiting and hop remains blocked"
                )
            else
                F.recordDiagnosticEvent(
                    "CellFarm",
                    "Still guarding for delayed reward-drop layers; no server hop."
                )
            end
        end
    end

    return
        false,
        lastCount
end

function F.processCellRewardChests(token, beforeChestSnapshot, beforeDropSnapshot)
    if not F.isCellFarmActive(token) then
        return false
    end

    F.stopCellRewardMovement()

    State.lockedMonster = nil
    State.cellFarm.rewardChestsFound = 0
    State.cellFarm.rewardChestsOpened = 0

    F.setCellFarmStage(
        "WAITING REWARD CHESTS",
        "Waiting for The Cell Of Life death animation"
    )

    local discovered = {}
    local discoveredOrder = {}
    local opened = {}

    local firstChestAt = nil
    local lastNewChestAt = os.clock()
    local lastNotice = os.clock()
    local lastNilScan = 0

    local function registerCandidate(object)
        if not object then
            return
        end

        local chest =
            F.getCellRewardChestRoot(
                object
            )

        if not chest
            or beforeChestSnapshot[chest]
            or discovered[chest]
            or not F.isCellRewardChestNearBoss(
                chest
            )
        then
            return
        end

        discovered[chest] = true
        table.insert(
            discoveredOrder,
            chest
        )

        firstChestAt =
            firstChestAt
            or os.clock()

        lastNewChestAt =
            os.clock()

        State.cellFarm.rewardChestsFound =
            #discoveredOrder

        State.cellFarm.status =
            "Reward chests found: "
            .. tostring(
                #discoveredOrder
            )
            .. "/"
            .. tostring(
                Config.CELL_REWARD_CHEST_EXPECTED
            )

        if F.updateCellFarmUI then
            F.updateCellFarmUI()
        end
    end

    for _, chest in ipairs(
        F.collectCellRewardChestCandidates(
            beforeChestSnapshot
        )
    ) do
        registerCandidate(
            chest
        )
    end

    local descendantConnection =
        workspace.DescendantAdded:Connect(
            function(object)
                task.defer(
                    registerCandidate,
                    object
                )
            end
        )

    local function disconnectWatcher()
        if descendantConnection then
            pcall(function()
                descendantConnection:Disconnect()
            end)

            descendantConnection = nil
        end
    end

    local function rescanRewardChests()
        if os.clock() - lastNilScan
            < Config.CELL_REWARD_CHEST_NIL_SCAN_INTERVAL
        then
            return
        end

        lastNilScan =
            os.clock()

        for _, chest in ipairs(
            F.collectCellRewardChestCandidates(
                beforeChestSnapshot
            )
        ) do
            registerCandidate(
                chest
            )
        end
    end

    -- Do not leave this server while the death/reward sequence has not
    -- produced either reward chests or actual new drops.
    while F.isCellFarmActive(token) do
        rescanRewardChests()

        local newDropCount =
            F.countCellRewardDrops(
                beforeDropSnapshot
            )

        if #discoveredOrder
            >= Config.CELL_REWARD_CHEST_EXPECTED
        then
            break
        end

        -- Do not continue on a partial batch. The Cell reward sequence is
        -- expected to produce five chests; wait until all five are observed.
        if newDropCount > 0
            and #discoveredOrder
                < Config.CELL_REWARD_CHEST_EXPECTED
        then
            State.cellFarm.status =
                "Loot appeared but only "
                .. tostring(#discoveredOrder)
                .. "/"
                .. tostring(
                    Config.CELL_REWARD_CHEST_EXPECTED
                )
                .. " reward chests confirmed - still waiting"
        end

        if os.clock() - lastNotice
            >= Config.CELL_REWARD_CHEST_RETRY_NOTICE
        then
            lastNotice = os.clock()

            F.recordCellFailure(
                "Still waiting for Cell reward chests; hop is blocked to protect loot"
            )

            State.cellFarm.status =
                "Waiting for reward chests - no hop"
        end

        task.wait(0.15)
    end

    if not F.isCellFarmActive(token) then
        disconnectWatcher()
        return false
    end

    local index = 1
    local noNewDeadline = nil

    while F.isCellFarmActive(token) do
        rescanRewardChests()

        local chest =
            discoveredOrder[index]

        if chest then
            if not opened[chest] then
                local success =
                    F.openCellRewardChest(
                        chest,
                        token,
                        beforeDropSnapshot
                    )

                if success then
                    opened[chest] = true

                    State.cellFarm.rewardChestsOpened =
                        State.cellFarm.rewardChestsOpened
                        + 1

                    if F.updateCellFarmUI then
                        F.updateCellFarmUI()
                    end
                else
                    -- Keep it in the queue and try it again. Never hop past
                    -- a known unopened reward chest.
                    task.wait(0.45)
                    continue
                end
            end

            index = index + 1

            if not F.cellFarmWait(
                token,
                Config.CELL_REWARD_CHEST_BETWEEN
            ) then
                disconnectWatcher()
                return false
            end

            noNewDeadline = nil
        else
            if State.cellFarm.rewardChestsOpened
                >= Config.CELL_REWARD_CHEST_EXPECTED
            then
                break
            end

            State.cellFarm.status =
                "Opened "
                .. tostring(
                    State.cellFarm.rewardChestsOpened
                )
                .. "/"
                .. tostring(
                    Config.CELL_REWARD_CHEST_EXPECTED
                )
                .. " reward chests - waiting for remaining chest(s)"

            if F.updateCellFarmUI then
                F.updateCellFarmUI()
            end

            noNewDeadline = nil

            task.wait(0.15)
        end
    end

    disconnectWatcher()

    if not F.isCellFarmActive(token) then
        return false
    end

    if State.cellFarm.rewardChestsOpened
        < Config.CELL_REWARD_CHEST_EXPECTED
    then
        F.setCellFarmStage(
            "REWARD CHESTS INCOMPLETE",
            "Fewer than five reward chests opened - hop blocked"
        )

        return false
    end

    State.cellFarm.status =
        "Reward chests complete: "
        .. tostring(
            State.cellFarm.rewardChestsOpened
        )
        .. "/"
        .. tostring(
            Config.CELL_REWARD_CHEST_EXPECTED
        )
        .. " | waiting for every loot wave"

    if F.updateCellFarmUI then
        F.updateCellFarmUI()
    end

    local stable,
        finalDropCount =
            F.waitForCellRewardDropsStable(
                token,
                beforeDropSnapshot
            )

    if stable then
        State.cellFarm.status =
            "Reward drops stable: "
            .. tostring(finalDropCount)
    end

    return stable
end

function F.collectCellBossLoot(token, beforeSnapshot)
    F.setCellFarmStage(
        "LOOT RESCAN",
        "Finding every post-chest drop before Bundle/Sell"
    )

    F.stopMovementFlight("MONSTER_LOCK")
    F.releaseMovement("MONSTER_LOCK")
    F.stopLootLock("CELL")

    task.wait(0.25)

    local collected = 0
    local quietSince = nil
    local failureCounts = {}

    while F.isCellFarmActive(token) do
        local candidates =
            F.collectCellLootCandidates(
                beforeSnapshot
            )

        table.sort(
            candidates,
            function(a, b)
                local root =
                    F.getCharacterRoot()

                if not root then
                    return tostring(a.Name)
                        < tostring(b.Name)
                end

                local aCf =
                    F.getDropCFrame(a)

                local bCf =
                    F.getDropCFrame(b)

                local aDistance =
                    aCf
                    and (
                        aCf.Position
                        - root.Position
                    ).Magnitude
                    or math.huge

                local bDistance =
                    bCf
                    and (
                        bCf.Position
                        - root.Position
                    ).Magnitude
                    or math.huge

                return
                    aDistance
                    < bDistance
            end
        )

        State.cellFarm.lootKnownRemaining =
            #candidates

        if #candidates == 0 then
            quietSince =
                quietSince
                or os.clock()

            local quietFor =
                os.clock()
                - quietSince

            F.setCellFarmStage(
                "LOOT RESCAN",
                "No remaining drops | quiet "
                    .. string.format(
                        "%.1f",
                        quietFor
                    )
                    .. "/"
                    .. string.format(
                        "%.1f",
                        Config.CELL_LOOT_EMPTY_STABLE
                    )
                    .. "s"
            )

            if quietFor
                >= Config.CELL_LOOT_EMPTY_STABLE
            then
                F.stopLootLock("CELL")
                F.stopMovementFlight("CELL")
                F.releaseMovement("CELL")

                State.cellFarm.lootMoveTarget =
                    "Complete"

                State.cellFarm.lootMoveDistance =
                    0

                State.cellFarm.lootKnownRemaining =
                    0

                F.markConfigDirty()

                return
                    collected,
                    true
            end

            task.wait(
                Config.CELL_LOOT_RESCAN_INTERVAL
            )

            continue
        end

        quietSince = nil

        if collected
            >= Config.CELL_MAX_LOOT_PER_RUN
        then
            F.setCellFarmStage(
                "LOOT LIMIT HOLD",
                "Loot limit reached while drops remain - hop blocked"
            )

            return
                collected,
                false
        end

        local drop =
            candidates[1]

        State.cellFarm.lootMoveTarget =
            tostring(drop.Name)

        local success =
            F.collectCellDropConfirmed(
                drop,
                token
            )

        if not F.isCellFarmActive(token) then
            return
                collected,
                false
        end

        if success then
            collected =
                collected + 1

            failureCounts[drop] = nil

            State.cellFarm.lootCollected =
                State.cellFarm.lootCollected + 1

            State.sessionStats.lootConfirmed =
                State.sessionStats.lootConfirmed + 1
        else
            failureCounts[drop] =
                (failureCounts[drop] or 0)
                + 1

            F.setCellFarmStage(
                "LOOT RETRY",
                tostring(drop.Name)
                    .. " still exists | retry cycle "
                    .. tostring(
                        failureCounts[drop]
                    )
                    .. " | hop blocked"
            )

            if not F.cellFarmWait(
                token,
                Config.CELL_LOOT_STUCK_RETRY_DELAY
            ) then
                return
                    collected,
                    false
            end
        end

        task.wait(
            Config.CELL_LOOT_RESCAN_INTERVAL
        )
    end

    F.stopLootLock("CELL")
    F.releaseMovement("CELL")

    return
        collected,
        false
end

function F.isBundleItem(item)
    return
        item
        and item.Parent
        and string.find(
            string.lower(
                tostring(item.Name)
            ),
            "bundle",
            1,
            true
        ) ~= nil
end

function F.countInventoryUnitsByName(itemName)
    local total = 0
    local wanted =
        string.lower(
            tostring(itemName or "")
        )

    for _, item in ipairs(
        F.collectInventoryItems()
    ) do
        if string.lower(
            tostring(item.Name)
        ) == wanted
        then
            local quantity =
                F.getNightCallItemQuantity(
                    item
                )

            total =
                total
                + (
                    quantity ~= nil
                    and quantity
                    or 1
                )
        end
    end

    return total
end

function F.waitForInventoryDecrease(itemName, unitsBefore, timeout)
    local deadline =
        os.clock()
        + math.max(
            0.1,
            tonumber(timeout)
                or Config.CELL_BUNDLE_CONFIRM_TIMEOUT
        )

    while os.clock() < deadline do
        if F.countInventoryUnitsByName(
            itemName
        ) < unitsBefore
        then
            return true
        end

        task.wait(0.08)
    end

    return false
end

function F.openCellBundles(token)
    if not ConsumableEvent
        or not ConsumableEvent.Parent
    then
        F.refreshCoreRemotes()
    end

    F.setCellFarmStage(
        "OPENING BUNDLES",
        "Processing inventory Bundles"
    )

    local previousWeapon =
        F.getEquippedWeaponTool()

    local opened = 0
    local emptyChecks = 0

    while F.isCellFarmActive(token)
        and opened
            < Config.CELL_BUNDLE_OPEN_LIMIT
    do
        local bundle = nil

        for _, item in ipairs(
            F.collectInventoryItems()
        ) do
            if F.isBundleItem(item) then
                bundle = item
                break
            end
        end

        if not bundle then
            emptyChecks =
                emptyChecks + 1

            F.setCellFarmStage(
                "BUNDLE LAYER CHECK",
                "No Bundle visible; checking for delayed/nested bundle layer "
                    .. tostring(emptyChecks)
                    .. "/"
                    .. tostring(
                        Config.CELL_BUNDLE_EMPTY_RECHECKS
                    )
            )

            F.waitForCellInventoryStable(
                token,
                Config.CELL_BUNDLE_EMPTY_STABLE_WINDOW,
                Config.CELL_BUNDLE_EMPTY_STABLE_WINDOW + 2
            )

            if emptyChecks
                >= Config.CELL_BUNDLE_EMPTY_RECHECKS
            then
                break
            end

            task.wait(0.20)
            continue
        end

        emptyChecks = 0

        local itemName =
            tostring(bundle.Name)

        local unitsBefore =
            F.countInventoryUnitsByName(
                itemName
            )

        local root =
            F.getCharacterRoot()

        local requested = false

        if ConsumableEvent
            and root
        then
            requested =
                pcall(function()
                    ConsumableEvent:FireServer(
                        itemName,
                        root.CFrame
                    )
                end)
        end

        local consumed =
            requested
            and F.waitForInventoryDecrease(
                itemName,
                unitsBefore,
                Config.CELL_BUNDLE_CONFIRM_TIMEOUT
            )

        if not consumed
            and bundle:IsA("Tool")
            and bundle.Parent
        then
            local humanoid =
                F.getHumanoid()

            if humanoid then
                pcall(function()
                    humanoid:EquipTool(
                        bundle
                    )
                end)

                task.wait(0.08)

                pcall(function()
                    bundle:Activate()
                end)

                consumed =
                    F.waitForInventoryDecrease(
                        itemName,
                        unitsBefore,
                        Config.CELL_BUNDLE_CONFIRM_TIMEOUT
                    )
            end
        end

        if consumed then
            opened = opened + 1
            State.cellFarm.bundlesOpened =
                State.cellFarm.bundlesOpened + 1
            task.wait(
                Config.CELL_BUNDLE_SETTLE
            )
        else
            F.recordCellFailure(
                "Bundle did not confirm: "
                    .. itemName
            )
            break
        end
    end

    if previousWeapon then
        F.restoreWeaponAfterNightCall(
            previousWeapon
        )
    else
        F.equipBestCellWeapon()
    end

    F.markConfigDirty()

    return opened
end

function F.isCellKeepItem(item)
    if not item
        or not item.Parent
    then
        return true
    end

    local nameKey =
        string.lower(
            tostring(item.Name)
        )

    local selectedWeaponKey =
        string.lower(
            F.trimText(
                State.cellFarm.selectedWeaponName
            )
        )

    if selectedWeaponKey ~= ""
        and nameKey == selectedWeaponKey
    then
        return true
    end

    if State.cellFarm.keepNames[
        nameKey
    ] == true
    then
        return true
    end

    local rarity =
        F.getInventoryItemRarity(
            item
        )

    if rarity.Key == "legendary"
        or rarity.Key == "mythic"
        or rarity.Key == "unknown"
    then
        return true
    end

    if item:GetAttribute(
        "Favorited"
    ) == true
    then
        return true
    end

    if item:FindFirstChild(
        "CannotBeDropped"
    ) then
        return true
    end

    local character =
        F.getPlayerCharacter()

    if character
        and item:IsDescendantOf(
            character
        )
    then
        return true
    end

    if tostring(item.Name) == "Bag" then
        return true
    end

    return false
end

function F.collectCellSellCandidates()
    local result = {}

    for _, item in ipairs(
        F.collectInventoryItems()
    ) do
        if item
            and item.Parent
            and not F.isCellKeepItem(
                item
            )
        then
            local rarity =
                F.getInventoryItemRarity(
                    item
                )

            if rarity.Key == "common"
                or rarity.Key == "uncommon"
                or rarity.Key == "rare"
                or rarity.Key == "elite"
            then
                table.insert(
                    result,
                    item
                )
            end
        end
    end

    return result
end

function F.getCellInventorySignature()
    local entries = {}

    for _, item in ipairs(
        F.collectInventoryItems()
    ) do
        if item and item.Parent then
            local quantity =
                F.getNightCallItemQuantity(
                    item
                )

            table.insert(
                entries,
                string.lower(
                    tostring(item.Name)
                )
                .. ":"
                .. tostring(
                    quantity ~= nil
                    and quantity
                    or 1
                )
            )
        end
    end

    table.sort(entries)

    return table.concat(
        entries,
        "|"
    )
end

function F.waitForCellInventoryStable(token, stableWindow, maxWait)
    local requiredStable =
        math.max(
            0.25,
            tonumber(stableWindow)
                or Config.CELL_INVENTORY_STABLE_WINDOW
        )

    local deadline =
        os.clock()
        + math.max(
            requiredStable,
            tonumber(maxWait) or 6
        )

    local signature =
        F.getCellInventorySignature()

    local stableSince =
        os.clock()

    while F.isCellFarmActive(token)
        and os.clock() < deadline
    do
        task.wait(0.12)

        local nextSignature =
            F.getCellInventorySignature()

        if nextSignature ~= signature then
            signature = nextSignature
            stableSince = os.clock()
        elseif os.clock() - stableSince
            >= requiredStable
        then
            return true
        end
    end

    return
        F.isCellFarmActive(token)
end

function F.sellCellInventory(token)
    F.setCellFarmStage(
        "SELLING",
        "Keeping Legendary/Mythic + whitelist"
    )

    for _ = 1, Config.CELL_SELL_RETRIES do
        if not F.isCellFarmActive(token) then
            return false
        end

        local candidates =
            F.collectCellSellCandidates()

        if #candidates == 0 then
            return true
        end

        local soldBefore =
            State.sessionStats.soldConfirmed

        local success =
            F.runAutoSell(
                true,
                {
                    candidates = candidates,
                    skipReturn = true,
                    allowTownReset = true,
                    cellMode = true,
                }
            )

        local soldDelta =
            math.max(
                0,
                State.sessionStats.soldConfirmed
                    - soldBefore
            )

        State.cellFarm.itemsSold =
            State.cellFarm.itemsSold
            + soldDelta

        F.markConfigDirty()

        if success then
            task.wait(0.35)
        else
            task.wait(1.0)
        end
    end

    return
        #F.collectCellSellCandidates()
        == 0
end

