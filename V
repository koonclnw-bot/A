        F.refreshCoreRemotes()
    end

    if not ConsumableEvent then
        return
    end

    local target =
        Config.STONE_ACCORD_FALLBACK_CFRAME

    local root =
        F.getCharacterRoot()

    if root then
        target = root.CFrame
    end

    State.movementTelemetry.lastRemote =
