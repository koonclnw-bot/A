function F.captureProfileSettings()
    local cellRestore =
        State.cellFarm
        and State.cellFarm.enabled
        and type(State.cellFarm.restore) == "table"
        and State.cellFarm.restore
        or nil

    local goalRestore =
        State.goalFarm
        and State.goalFarm.enabled
        and type(State.goalFarm.restore) == "table"
        and State.goalFarm.restore
        or nil

    local profileFarmEnabled = State.farmEnabled
    local profileFarmContainsMode = State.farmContainsMode
    local profileFarmTargetOrder = State.farmTargetOrder
    local profileFarmRaritySet = State.farmRaritySet
    local profileFarmStopAfterFirst = State.farmStopAfterFirst
    local profileFarmStrategy = State.farmStrategy
    local profileMonsterLockEnabled = State.monsterLockEnabled
    local profileSellEnabled = State.sellEnabled
    local profileNightCallEnabled = State.nightCallEnabled

    if cellRestore then
        profileFarmEnabled = cellRestore.farmEnabled == true
        profileMonsterLockEnabled = cellRestore.monsterLockEnabled == true
        profileSellEnabled = cellRestore.sellEnabled == true
        profileNightCallEnabled = cellRestore.nightCallEnabled == true
    elseif goalRestore then
        profileFarmEnabled = goalRestore.farmEnabled == true
        profileFarmContainsMode = goalRestore.farmContainsMode == true
        profileFarmTargetOrder = goalRestore.farmTargetOrder or {}
        profileFarmRaritySet = goalRestore.farmRaritySet or State.farmRaritySet
        profileFarmStopAfterFirst = goalRestore.farmStopAfterFirst == true
        profileFarmStrategy = goalRestore.farmStrategy or State.farmStrategy
        profileMonsterLockEnabled = goalRestore.monsterLockEnabled == true
    end

    return {
        Farm = {
            enabled = profileFarmEnabled,
            containsMode = profileFarmContainsMode,
            targets = F.deepCopySerializable(profileFarmTargetOrder),
            rarities = F.exportRaritySet(profileFarmRaritySet),
            autoHop = State.farmAutoHopEnabled,
            emptyWait = State.farmEmptyWait,
            stopAfterFirst = profileFarmStopAfterFirst,
            itemPriority = F.deepCopySerializable(State.itemPriority),
            strategy = profileFarmStrategy,
            flightSpeed = State.farmFlightSpeed,
        },
        Sell = {
            enabled = profileSellEnabled,
            rarities = F.exportRaritySet(State.sellRaritySet),
            neverSell = F.deepCopySerializable(State.neverSellOrder),
            beforeHop = State.sellBeforeHop,
        },
        Combat = {
            monsterLock = profileMonsterLockEnabled,
            height = monsterLockHeight,
            whitelist = F.deepCopySerializable(State.monsterWhitelist),
            blacklist = F.deepCopySerializable(State.monsterBlacklist),
            bossOnly = State.bossOnly,
        },
        Gacha = {enabled = State.gachaEnabled},
        Nightcall = {enabled = profileNightCallEnabled},
        ServerHop = {
            persistent = State.persistentHopEnabled,
            reloadUrl = State.hubReloadUrl,
        },
        UI = {
            lowGraphics = State.lowGraphicsEnabled,
            scale = State.userUiScale,
            reduceMotion = State.reduceMotion,
            backgroundDim = State.backgroundDimEnabled,
        },
        Movement = {
            preset = State.movementPreset,
            adaptive = State.adaptiveMovementEnabled,
            farmSpeed = State.farmFlightSpeed,
            monsterSpeed = State.movementSpeeds.Monster,
            merchantSpeed = State.movementSpeeds.Merchant,
            returnSpeed = State.movementSpeeds.Return,
            cellSpeed = State.movementSpeeds.Cell,
        },
        Navigation = {
            waypoints = F.exportWaypoints(),
            route = F.exportRoute(),
        },
        Goal = {
            kind = State.goalFarm.selectedKind,
            name = State.goalFarm.selectedName,
        },
        Cell = {
            keep = F.deepCopySerializable(State.cellFarm.keepOrder),
            weapon = State.cellFarm.selectedWeaponName,
            fightHeight = State.cellFarm.fightHeight,
            travelSpeed = State.cellFarm.travelSpeed,
        },
    }
end

function F.applyProfileSettings(profile)
    if type(profile) ~= "table" then
        return false
    end

    local farm = type(profile.Farm) == "table" and profile.Farm or {}
    local sell = type(profile.Sell) == "table" and profile.Sell or {}
    local combat = type(profile.Combat) == "table" and profile.Combat or {}
    local gacha = type(profile.Gacha) == "table" and profile.Gacha or {}
    local nightcall = type(profile.Nightcall) == "table" and profile.Nightcall or {}
    local serverHop = type(profile.ServerHop) == "table" and profile.ServerHop or {}
    local ui = type(profile.UI) == "table" and profile.UI or {}
    local movement = type(profile.Movement) == "table" and profile.Movement or {}
    local navigation = type(profile.Navigation) == "table" and profile.Navigation or {}
    local goal = type(profile.Goal) == "table" and profile.Goal or {}
    local cell = type(profile.Cell) == "table" and profile.Cell or {}

    if F.stopCellFarm and State.cellFarm.enabled then
        F.stopCellFarm(true, "Profile load")
    end

    if F.stopGoalFarm and State.goalFarm.enabled then
        F.stopGoalFarm(false)
    end

    State.goalFarm.selected = nil
    State.goalFarm.selectedKind = F.trimText(goal.kind)
    State.goalFarm.selectedName = F.trimText(goal.name)
    State.goalFarm.pendingKind = State.goalFarm.selectedKind
    State.goalFarm.pendingName = State.goalFarm.selectedName

    State.cellFarm.keepOrder =
        F.deepCopySerializable(
            type(cell.keep) == "table"
            and cell.keep
            or State.cellFarm.keepOrder
        )
    State.cellFarm.selectedWeaponName =
        F.trimText(
            cell.weapon
            or State.cellFarm.selectedWeaponName
        )

    State.cellFarm.keepNames = {}
    for _, itemName in ipairs(State.cellFarm.keepOrder) do
        local cleaned = F.trimText(itemName)
        if cleaned ~= "" then
            State.cellFarm.keepNames[string.lower(cleaned)] = true
        end
    end
    if next(State.cellFarm.keepNames) == nil then
        State.cellFarm.keepOrder = {"Shadowbeam Staff"}
        State.cellFarm.keepNames = {["shadowbeam staff"] = true}
    end
    State.cellFarm.fightHeight =
        math.clamp(
            tonumber(cell.fightHeight)
                or State.cellFarm.fightHeight,
            5,
            60
        )
    State.cellFarm.travelSpeed =
        math.clamp(
            tonumber(cell.travelSpeed)
                or State.cellFarm.travelSpeed,
            0.5,
            3.0
        )
    State.movementSpeeds.Cell = State.cellFarm.travelSpeed

    State.farmEnabled = farm.enabled == true
    State.farmContainsMode = farm.containsMode == true
    State.farmTargetOrder = F.deepCopySerializable(type(farm.targets) == "table" and farm.targets or {})
    State.farmTargetNames = {}
    for _, name in ipairs(State.farmTargetOrder) do
        State.farmTargetNames[string.lower(tostring(name))] = true
    end
    F.importRaritySet(State.farmRaritySet, farm.rarities)
    State.farmAutoHopEnabled = farm.autoHop == true
    State.farmEmptyWait = math.clamp(tonumber(farm.emptyWait) or 8, 3, 30)
    State.farmStopAfterFirst = farm.stopAfterFirst == true
    State.itemPriority = F.deepCopySerializable(type(farm.itemPriority) == "table" and farm.itemPriority or {})
    State.farmStrategy = F.normalizeFarmStrategy(farm.strategy)
    State.farmFlightSpeed =
        math.clamp(
            tonumber(farm.flightSpeed)
                or Config.LOOT_FLY_SPEED,
            0.5,
            3.0
        )

    State.sellEnabled = sell.enabled == true
    F.importRaritySet(State.sellRaritySet, sell.rarities)
    State.neverSellOrder = F.deepCopySerializable(type(sell.neverSell) == "table" and sell.neverSell or {})
    State.neverSellNames = {}
    for _, name in ipairs(State.neverSellOrder) do
        State.neverSellNames[string.lower(tostring(name))] = true
    end
    State.sellBeforeHop = sell.beforeHop ~= false

    State.monsterLockEnabled = combat.monsterLock == true
    monsterLockHeight = math.clamp(tonumber(combat.height) or monsterLockHeight, Config.MIN_MONSTER_HEIGHT, Config.MAX_MONSTER_HEIGHT)
    State.monsterWhitelist = F.deepCopySerializable(type(combat.whitelist) == "table" and combat.whitelist or {})
    State.monsterBlacklist = F.deepCopySerializable(type(combat.blacklist) == "table" and combat.blacklist or {})
    State.bossOnly = combat.bossOnly == true
    State.gachaEnabled = gacha.enabled == true
    State.nightCallEnabled = nightcall.enabled == true
    State.persistentHopEnabled = serverHop.persistent ~= false
    State.hubReloadUrl = F.trimText(serverHop.reloadUrl)
    State.lowGraphicsEnabled = ui.lowGraphics == true
    State.userUiScale = math.clamp(tonumber(ui.scale) or 1, 0.75, 1.25)
    State.reduceMotion = ui.reduceMotion == true
    State.backgroundDimEnabled = ui.backgroundDim == true

    if next(movement) ~= nil then
        State.movementPreset = tostring(movement.preset or "Custom")
        State.adaptiveMovementEnabled = movement.adaptive ~= false
        State.farmFlightSpeed = math.clamp(tonumber(movement.farmSpeed) or State.farmFlightSpeed, 0.5, 3.0)
        State.movementSpeeds.Monster = math.clamp(tonumber(movement.monsterSpeed) or State.movementSpeeds.Monster, 0.5, 3.0)
        State.movementSpeeds.Merchant = math.clamp(tonumber(movement.merchantSpeed) or State.movementSpeeds.Merchant, 0.5, 3.0)
        State.movementSpeeds.Return = math.clamp(tonumber(movement.returnSpeed) or State.movementSpeeds.Return, 0.5, 3.0)
        State.movementSpeeds.Cell = math.clamp(tonumber(movement.cellSpeed) or State.cellFarm.travelSpeed, 0.5, 3.0)
        State.cellFarm.travelSpeed = State.movementSpeeds.Cell
        F.resetAdaptiveMovement()
    end

    if next(navigation) ~= nil then
        F.importWaypoints(navigation.waypoints)
        F.importRoute(navigation.route)
    end

    F.applyFarmConfigToUI()
    F.refreshMovementControlUI()
    F.updateWaypointStatus()
    if F.refreshGoalIntelligence and State.gameDB.loaded then
        F.refreshGoalIntelligence(false, true)
    end
    F.setMonsterLock(State.monsterLockEnabled)
    F.applyResponsiveScale()
    F.markConfigDirty()
    return true
end

function F.saveProfile(name)
    name = F.trimText(name)
    if name == "" then
        name = "Default"
    end
    State.profiles[name] = F.deepCopySerializable(F.captureProfileSettings())
    State.currentProfile = name
    if State.profileStatusLabel then
        State.profileStatusLabel.Text = "Current Profile: " .. name .. " | SAVED"
    end
    F.markConfigDirty()
    F.updateProfileListUI()
    if State.profileNameBox then
        State.profileNameBox.Text = name
    end
    if F.saveFarmConfig then
        pcall(F.saveFarmConfig, true)
    end
    return true
end

function F.loadProfile(name)
    name = F.trimText(name)
    if name == "" then
        name = "Default"
    end
    local profile = State.profiles[name]
    if not profile then
        if State.profileStatusLabel then
            State.profileStatusLabel.Text = "Profile not found: " .. name
        end
        return false
    end
    State.currentProfile = name
    local applied = F.applyProfileSettings(F.deepCopySerializable(profile))
    if State.profileStatusLabel then
        State.profileStatusLabel.Text = "Current Profile: " .. name .. (applied and " | LOADED" or " | INVALID")
    end
    F.updateProfileListUI()
    if State.profileNameBox then
        State.profileNameBox.Text = name
    end
    if F.saveFarmConfig then
        pcall(F.saveFarmConfig, true)
    end
    return applied
end

function F.deleteProfile(name)
    name = F.trimText(name)
    if name == "" or name == "Default" then
        if State.profileStatusLabel then
            State.profileStatusLabel.Text = "Default profile cannot be deleted"
        end
        return false
    end
    State.profiles[name] = nil
    if State.currentProfile == name then
        State.currentProfile = "Default"
    end
    if State.profileStatusLabel then
        State.profileStatusLabel.Text = "Deleted: " .. name .. " | Current: " .. State.currentProfile
    end
    F.markConfigDirty()
    F.updateProfileListUI()
    if F.saveFarmConfig then
        pcall(F.saveFarmConfig, true)
    end
    return true
end

