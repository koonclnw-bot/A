function F.waitCellMenuCondition(token, predicate, timeout)
    local deadline =
        os.clock()
        + math.max(
            0.1,
            tonumber(timeout) or 1
        )

    repeat
        if not F.isCellFarmActive(token) then
            return false
        end

        local ok, result =
            pcall(
                predicate
            )

        if ok and result == true then
            return true
        end

        task.wait(0.05)
    until os.clock() >= deadline

    local ok, result =
        pcall(
            predicate
        )

    return ok and result == true
end

function F.hasExactGuiConnection(button, signalName, sourceNeedle)
    if not button
        or not button.Parent
        or type(getconnections) ~= "function"
    then
        return false
    end

    local signal =
        button[signalName]

    if not signal then
        return false
    end

    local ok, connections =
        pcall(
            getconnections,
            signal
        )

    if not ok
        or type(connections) ~= "table"
    then
        return false
    end

    local wanted =
        string.lower(
            tostring(
                sourceNeedle
                or ""
            )
        )

    for _, connection in ipairs(connections) do
        local fn = nil

        pcall(function()
            fn = connection.Function
        end)

        local source =
            string.lower(
                F.getGuiConnectionSource(
                    fn
                )
            )

        if wanted ~= ""
            and source ~= ""
            and string.find(
                source,
                wanted,
                1,
                true
            )
        then
            return true
        end
    end

    return false
end

function F.waitForExactGuiConnection(
    token,
    button,
    signalName,
    sourceNeedle,
    timeout
)
    local deadline =
        os.clock()
        + math.max(
            0.10,
            tonumber(timeout)
                or Config.CELL_MENU_CONNECTION_WAIT
        )

    while F.isCellFarmActive(token)
        and button
        and button.Parent
        and os.clock() < deadline
    do
        if F.hasExactGuiConnection(
            button,
            signalName,
            sourceNeedle
        ) then
            return true
        end

        task.wait(0.05)
    end

    return F.hasExactGuiConnection(
        button,
        signalName,
        sourceNeedle
    )
end

