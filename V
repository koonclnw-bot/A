    local counts = {}

    for _, rarityInfo in ipairs(
        Config.DROP_RARITIES
    ) do
        counts[rarityInfo.Key] = 0
    end

    for drop, button in pairs(
        State.dropButtons
    ) do
        if drop
            and drop.Parent
            and button
            and button.Parent
        then
            F.applyDropRarityToButton(
                drop,
                button
            )

            local rarityKey =
                button:GetAttribute(
                    "RarityKey"
                )
                or "unknown"

            counts[rarityKey] =
                (counts[rarityKey] or 0)
                + 1
        end
    end

    State.dropRarityCounts =
        counts

    for _, rarityInfo in ipairs(
        Config.DROP_RARITIES
    ) do
        local header =
            State.dropRarityHeaders[
                rarityInfo.Key
            ]

        local count =
            counts[rarityInfo.Key]
            or 0

        if header then
            header.Visible =
                count > 0
                and State.dropDisplayRaritySet[
                    rarityInfo.Key
                ]
                == true

            header.Text =
                rarityInfo.Name
                .. "  ("
                .. tostring(count)
                .. ")"
        end
    end
