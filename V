function F.activateGuiButton(button, verifyCallback)
    if not button
        or not button.Parent
        or not F.isGuiObjectActuallyVisible(
            button
        )
    then
        return false
    end

    local function verified()
        if type(verifyCallback) ~= "function" then
            return false
        end

        local ok, result =
            pcall(verifyCallback)

        return ok and result == true
    end

    local function waitVerified(timeout)
        local deadline =
            os.clock()
            + math.max(
                0,
                tonumber(timeout) or 0
            )

        repeat
            if verified() then
                return true
            end

            task.wait(0.04)
        until os.clock() >= deadline

        return verified()
    end

    -- Some executors expose firesignal but firing the GUI signal alone does
    -- not always run the game's input path. Try it first, but only accept it
    -- when the requested menu transition can actually be observed.
    if type(firesignal) == "function" then
        pcall(function()
            firesignal(
                button.MouseButton1Click
            )
        end)

        if waitVerified(0.28) then
            return true
        end

        pcall(function()
            firesignal(
                button.Activated
            )
        end)

        if waitVerified(0.28) then
            return true
        end
    end

    -- Real input fallback. This is resolution-independent because the
    -- current AbsolutePosition/AbsoluteSize of the discovered button is used.
    local inputSent = false

    pcall(function()
        local virtualInput =
            game:GetService(
                "VirtualInputManager"
            )

        local center =
            button.AbsolutePosition
            + button.AbsoluteSize / 2

        virtualInput:SendMouseMoveEvent(
            center.X,
            center.Y,
            game
        )

        task.wait(0.14)

        virtualInput:SendMouseButtonEvent(
            center.X,
            center.Y,
            0,
            true,
            game,
            0
        )

        task.wait(0.09)

        virtualInput:SendMouseButtonEvent(
            center.X,
            center.Y,
            0,
            false,
            game,
            0
        )

        inputSent = true
    end)

    if inputSent
        and (
            type(verifyCallback) ~= "function"
            or waitVerified(0.55)
        )
    then
        return true
    end

    -- Secondary executor-friendly mouse fallback.
    pcall(function()
        local virtualUser =
            game:GetService(
                "VirtualUser"
            )

        local center =
            button.AbsolutePosition
            + button.AbsoluteSize / 2

        virtualUser:CaptureController()
        virtualUser:ClickButton1(
            center
        )
        inputSent = true
    end)

    if type(verifyCallback) == "function" then
        return inputSent
            and waitVerified(0.55)
    end

    return inputSent
end

function F.clickGuiButtonPhysical(button, attempt)
    if not button
        or not button.Parent
        or not F.isGuiObjectActuallyVisible(button)
    then
        return false
    end

    local center =
        F.getCellMenuClickPoint(
            button,
            attempt
        )

    if not center then
        return false
    end

    local sent = false

    pcall(function()
        local virtualInput = game:GetService("VirtualInputManager")
        local userInput = game:GetService("UserInputService")
        local current = userInput:GetMouseLocation()

        for step = 1, 6 do
            local alpha = step / 6
            local x = current.X + (center.X - current.X) * alpha
            local y = current.Y + (center.Y - current.Y) * alpha

            virtualInput:SendMouseMoveEvent(x, y, game)
            task.wait(0.035)
        end

        task.wait(0.22)
        virtualInput:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
        task.wait(0.11)
        virtualInput:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
        sent = true
    end)

    return sent
end

function F.setCellMenuHubHidden(hidden)
    if not screenGui
        or not screenGui.Parent
    then
        return
    end

    if hidden then
        if State.cellFarm.menuHubPreviousEnabled == nil then
            State.cellFarm.menuHubPreviousEnabled =
                screenGui.Enabled
        end

        screenGui.Enabled = false
    else
        local previous =
            State.cellFarm.menuHubPreviousEnabled

        State.cellFarm.menuHubPreviousEnabled = nil

        if previous == nil then
            previous = true
        end

        if State.cellFarm.keepHubHidden then
            screenGui.Enabled =
                State.cellFarm.hubManuallyOpened
        else
            screenGui.Enabled =
                previous
        end
    end
end


function F.setCellFarmHubHidden(hidden)
