-- =========================================================
-- FLIGHT / SPECTATE
-- =========================================================

function F.flyToDrop(drop, pressInteract)
    if not F.isDropPresent(drop) then
        return false
    end

    if State.isSpectating then
        F.resetCamera()
    end

    task.spawn(function()
        local lockToken =
            F.startLootLock(
                drop,
                "MANUAL"
            )

        if not lockToken then
            F.notify(
                "Movement busy",
                tostring(
                    F.getMovementOwner()
                )
                    .. " currently owns movement.",
                "warning",
                2
            )
            return
        end

        local arrived =
            F.waitForLootFlightArrival(
                drop,
                "MANUAL",
                lockToken
            )

        if not arrived then
            if F.isDropPresent(drop) then
                F.notify(
                    "Loot Flight",
                    "Could not reach "
                        .. tostring(drop.Name),
                    "warning",
                    2.4
                )
            end

            F.stopLootLock(
                "MANUAL",
                lockToken
            )
            return
        end

        if pressInteract then
            for attempt = 1, Config.LOOT_RETRY_COUNT do
                if not State.loopRunning
                    or not F.isDropPresent(drop)
                    or not F.isLootLockActive(
                        drop,
                        "MANUAL",
                        lockToken
                    )
                then
                    break
                end

                local atDrop =
                    State.applyLootLockPosition()

                if not atDrop then
                    atDrop =
                        F.waitForLootFlightArrival(
                            drop,
                            "MANUAL",
                            lockToken
                        )
                end

                if not atDrop then
                    break
                end

                task.wait(
                    Config.LOOT_INTERACT_DELAY
                )

                local remoteRequested =
                    F.fireDirectDropPickup(
                        drop
                    )

                if remoteRequested then
                    local remoteDeadline =
                        os.clock()
                        + Config.LOOT_REMOTE_CONFIRM_TIMEOUT

                    while State.loopRunning
                        and os.clock() < remoteDeadline
                        and F.isDropPresent(drop)
                        and F.isLootLockActive(
                            drop,
                            "MANUAL",
                            lockToken
                        )
                    do
                        State.applyLootLockPosition()
                        task.wait(
                            Config.LOOT_CONFIRM_POLL
                        )
                    end
                end

                if not F.isDropPresent(drop) then
                    break
                end

                local atDropForPrompt =
                    State.applyLootLockPosition()

                if not atDropForPrompt then
                    atDropForPrompt =
                        F.waitForLootFlightArrival(
                            drop,
                            "MANUAL",
                            lockToken
                        )
                end

                if not atDropForPrompt then
                    break
                end

                F.pressLootInteractKey()

                local deadline =
                    os.clock()
                    + Config.LOOT_CONFIRM_TIMEOUT

                while State.loopRunning
                    and os.clock() < deadline
                    and F.isDropPresent(drop)
                    and F.isLootLockActive(
                        drop,
                        "MANUAL",
                        lockToken
                    )
                do
                    State.applyLootLockPosition()
                    task.wait(
                        Config.LOOT_CONFIRM_POLL
                    )
                end

                if not F.isDropPresent(drop) then
                    break
                end
            end
        else
            -- Manual item button uses gradual Fly-to-Item. Once arrived,
            -- hold briefly, restore collision, and return normal character control.
            task.wait(0.35)
        end

        F.stopLootLock(
            "MANUAL",
            lockToken
        )
    end)

    return true
end

function F.flyToSavedPoint(targetCFrame)
    if typeof(targetCFrame) ~= "CFrame" then
        return false
    end

    if State.monsterLockEnabled then
        F.suspendMonsterLock(1.0)
    end

    if State.isSpectating then
        F.resetCamera()
    end

    if State.lootLockEnabled
        and State.lootLockOwner == "MANUAL"
    then
        F.stopLootLock(
            "MANUAL",
            State.lootLockToken
        )
    end

    task.spawn(function()
        local reached =
            F.flyToCFrame(
                targetCFrame,
                "MANUAL",
                Config.RETURN_FLY_ARRIVAL_DISTANCE,
                Config.WORLD_FLY_MAX_TRAVEL_TIME,
                "Return"
            )

        if not reached and State.loopRunning then
            F.notify(
                "Return Flight",
                "Could not reach the saved position.",
                "warning",
                2.4
            )
        end
    end)

    return true
end

function F.spectateItem(drop)
    if not drop then
        return
    end

    if State.isSpectating
        and State.spectatingTarget == drop then

        F.resetCamera()
        return
    end

    local part =
        F.getSpectatePart(drop)

    local currentCamera = F.getCurrentCamera()

    if part and currentCamera then
        currentCamera.CameraSubject = part
        State.isSpectating = true
        State.spectatingTarget = drop
    end
end

-- =========================================================
-- DROP LIST
-- =========================================================

function F.addDrop(drop)
    if not drop
        or State.dropButtons[drop]
    then
        return
    end

    local rarityInfo =
        F.getDropRarity(
            drop
        )

    local button =
        F.createListButton(
            dropList,
            drop.Name,
            rarityInfo.Color
        )

    F.applyDropRarityToButton(
        drop,
        button
    )

    button.InputBegan:Connect(function(input)
        if not drop
            or not drop.Parent
        then
            return
        end

        if input.UserInputType
            == Enum.UserInputType.MouseButton1
        then
            F.flyToDrop(
                drop,
                true
            )

        elseif input.UserInputType
            == Enum.UserInputType.MouseButton2
        then
            F.spectateItem(
                drop
            )
        end
    end)

    State.dropButtons[drop] =
        button
end

function F.removeDrop(drop)
    local button =
        State.dropButtons[drop]

    State.farmFailedUntil[drop] = nil

    if State.lockedDrop == drop then
        F.stopLootLock(
            State.lootLockOwner,
            State.lootLockToken
        )
    end

    if button then
        button:Destroy()
        State.dropButtons[drop] = nil
    end

    if State.isSpectating
        and State.spectatingTarget == drop then

        F.resetCamera()
    end

    F.refreshDropRarityHeaders()
    F.updateDropStatus()
end

-- =========================================================
-- MONSTER LIST
-- =========================================================

function F.addMonster(monster)
    if not monster
        or State.monsterButtons[monster]
        or F.isIgnoredMonster(
            monster
        )
    then
        return
    end

    if not monster:IsA("Model") then
        return
    end

    if not F.getMonsterPart(monster) then
        return
    end

    local button =
        F.createListButton(
            monsterList,
            monster.Name,
            Config.THEME.Text
        )

    button.MouseButton1Click:Connect(function()
        if not monster
            or not monster.Parent then

            return
        end

        F.selectMonster(monster)
    end)

    State.monsterButtons[monster] = button
    State.updateMonsterButtons()
end

function F.removeMonster(monster)
    local button =
        State.monsterButtons[monster]

    if button then
        button:Destroy()
        State.monsterButtons[monster] = nil
    end

    if State.lockedMonster == monster then
        State.lockedMonster = nil
        State.monsterLockManualSelection = false
        State.monsterLockWaiting =
            State.monsterLockEnabled

        -- Never turn the toggle OFF here.
        -- Heartbeat immediately searches for the next nearest live Monster.
        local humanoid =
            F.getHumanoid()

        if humanoid then
            humanoid.AutoRotate = true
        end

        State.updateMonsterButtons()
        State.updateCombatStatus()
    end
end

-- =========================================================
-- EVENT-DRIVEN DROP / MONSTER CACHES
-- =========================================================

function F.disconnectConnections(connectionStore)
    for key, connection in pairs(connectionStore or {}) do
        pcall(function()
            connection:Disconnect()
        end)
        connectionStore[key] = nil
    end
end

function F.rebuildDropCache()
    State.dropCacheRebuildQueued = false
    local folder = State.dropsFolder
    if not folder or not folder.Parent then
        return false
    end

    local seen = {}
    for _, drop in ipairs(F.collectDropObjects(folder)) do
        seen[drop] = true
        local rarity = F.getDropRarity(drop)
        State.dropCache[drop] = {
            instance = drop,
            normalizedName = string.lower(tostring(drop.Name)),
            rarity = rarity,
            root = F.getSpectatePart(drop),
        }
        if not State.dropButtons[drop] then
            F.addDrop(drop)
        else
            F.applyDropRarityToButton(drop, State.dropButtons[drop])
        end
    end

    for drop in pairs(State.dropCache) do
        if not seen[drop] then
            State.dropCache[drop] = nil
            F.removeDrop(drop)
        end
    end

    F.refreshDropRarityHeaders()
    F.updateDropStatus()
    F.updateFarmStatus()
    return true
end

function F.queueDropCacheRebuild()
    if State.dropCacheRebuildQueued then
        return
    end
    State.dropCacheRebuildQueued = true
    task.defer(function()
        F.runBoundary("DropCache", F.rebuildDropCache)
    end)
end

function F.bindDropCache(folder)
    F.disconnectConnections(State.dropCacheConnections)
    State.dropsFolder = folder
    State.dropCacheBoundFolder = folder
    if not folder then
        return false
    end
    State.dropCacheConnections.added = folder.DescendantAdded:Connect(F.queueDropCacheRebuild)
    State.dropCacheConnections.removing = folder.DescendantRemoving:Connect(F.queueDropCacheRebuild)
    State.dropCacheConnections.ancestry = folder.AncestryChanged:Connect(function(_, parent)
        if not parent then
            State.dropsFolder = nil
            F.queueDropCacheRebuild()
        end
    end)
    return F.rebuildDropCache()
end

function F.getBossEvidence(monster)
    local value = nil
    pcall(function()
        value = monster:GetAttribute("IsBoss")
        if value == nil then
            value = monster:GetAttribute("Boss")
        end
    end)
    if type(value) == "boolean" then
        return value
    end
    local marker = monster:FindFirstChild("IsBoss") or monster:FindFirstChild("Boss")
    if marker and marker:IsA("BoolValue") then
        return marker.Value
    end
    return nil
end

function F.rebuildMonsterCache()
    State.monsterCacheRebuildQueued = false
    local folder = State.monstersFolder
    if not folder or not folder.Parent then
        return false
    end

    local seen = {}
    for _, monster in ipairs(F.collectMonsterModels(folder)) do
        if not F.isIgnoredMonster(monster) or string.lower(tostring(monster.Name)):gsub("[%s_%-]", "") ~= "trainingdummy" then
            seen[monster] = true
            local entry = State.monsterCache[monster]
            if not entry then
                entry = {
                    instance = monster,
                    normalizedName = string.lower(tostring(monster.Name)),
                    isBoss = F.getBossEvidence(monster),
                    part = F.getMonsterPart(monster),
                }
                State.monsterCache[monster] = entry
                local humanoid = F.findMonsterHumanoid and F.findMonsterHumanoid(monster) or nil
                if humanoid then
                    entry.healthConnection = humanoid.HealthChanged:Connect(function()
                        if State.finisherEnabled then
                            F.runBoundary("FinisherEvent", F.tryFinishMonster, monster)
                        end
                    end)
                end
            else
                entry.part = F.getMonsterPart(monster)
                entry.isBoss = F.getBossEvidence(monster)
            end
            if not State.monsterButtons[monster] and not F.isIgnoredMonster(monster) then
                F.addMonster(monster)
            end
        end
    end

    for monster, entry in pairs(State.monsterCache) do
        if not seen[monster] then
            if entry.healthConnection then
                pcall(function()
                    entry.healthConnection:Disconnect()
                end)
            end
            State.monsterCache[monster] = nil
            F.removeMonster(monster)
        end
    end
    return true
end

function F.queueMonsterCacheRebuild()
    if State.monsterCacheRebuildQueued then
        return
    end
    State.monsterCacheRebuildQueued = true
    task.defer(function()
        F.runBoundary("MonsterCache", F.rebuildMonsterCache)
    end)
end

function F.bindMonsterCache(folder)
    F.disconnectConnections(State.monsterCacheConnections)
    State.monstersFolder = folder
    State.monsterCacheBoundFolder = folder
    if not folder then
        return false
    end
    State.monsterCacheConnections.added = folder.DescendantAdded:Connect(F.queueMonsterCacheRebuild)
    State.monsterCacheConnections.removing = folder.DescendantRemoving:Connect(F.queueMonsterCacheRebuild)
    State.monsterCacheConnections.ancestry = folder.AncestryChanged:Connect(function(_, parent)
        if not parent then
            State.monstersFolder = nil
            F.queueMonsterCacheRebuild()
        end
    end)
    return F.rebuildMonsterCache()
end

