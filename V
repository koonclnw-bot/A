-- =========================================================
-- MONSTER LOCK
-- =========================================================

function F.shouldPauseMonsterLockForFarm()
    -- Normal Auto Farm keeps exclusive movement ownership just like previous
    -- versions. Goal Farm is the exception: while loot is idle the lock may hunt
    -- goal monsters; as soon as a matching loot flight starts, farmBusy pauses it.
    if State.farmBusy then
        return true
    end

    if State.farmEnabled
        and not (State.goalFarm and State.goalFarm.enabled)
    then
        return true
    end

    return false
end

State.applyMonsterLockPosition = function()
    if not State.monsterLockEnabled then
        F.stopMovementFlight("MONSTER_LOCK")
        F.releaseMovement("MONSTER_LOCK")
        return false
    end

    if F.shouldPauseMonsterLockForFarm()
        or State.sellBusy
        or F.isMonsterLockSuspended()
    then
        F.stopMovementFlight("MONSTER_LOCK")
        F.releaseMovement("MONSTER_LOCK")
        return false
    end

    if not State.lockedMonster
        or not State.lockedMonster.Parent
    then
        F.stopMovementFlight("MONSTER_LOCK")
        F.releaseMovement("MONSTER_LOCK")
        return false
    end

    if not F.acquireMovement("MONSTER_LOCK", 0.35) then
        F.stopMovementFlight("MONSTER_LOCK")
        return false
    end

    local monsterPart =
        F.getMonsterPart(
            State.lockedMonster
        )

    if not monsterPart then
        F.stopMovementFlight("MONSTER_LOCK")
        F.releaseMovement("MONSTER_LOCK")
        return false
    end

    local activeMonsterHeight =
        (
            State.cellFarm
            and State.cellFarm.enabled
            and State.lockedMonster
            and tostring(State.lockedMonster.Name) == "The Cell Of Life"
        )
        and State.cellFarm.fightHeight
        or monsterLockHeight

    local targetPosition =
        monsterPart.Position
        + Vector3.new(
            0,
            activeMonsterHeight,
            0
        )

    local targetCFrame

    if Config.LOOK_DOWN_ENABLED then
        local monsterLook =
            monsterPart.CFrame.LookVector

        local horizontal =
            Vector3.new(
                monsterLook.X,
                0,
                monsterLook.Z
            )

        if horizontal.Magnitude < 0.01 then
            horizontal =
                Vector3.new(
                    0,
                    0,
                    -1
                )
        else
            horizontal =
                horizontal.Unit
        end

        local angle =
            math.rad(
                Config.LOOK_DOWN_ANGLE
            )

        local direction =
            (
                horizontal
                * math.cos(angle)
            )
            +
            Vector3.new(
                0,
                -math.sin(angle),
                0
            )

        targetCFrame =
            CFrame.lookAt(
                targetPosition,
                targetPosition + direction
            )
    else
        targetCFrame =
            CFrame.new(
                targetPosition
            )
    end

    F.renewMovement(
        "MONSTER_LOCK",
        0.35
    )

    local arrived =
        F.updateMovementFlight(
            targetCFrame,
            "MONSTER_LOCK",
            Config.MONSTER_FLY_ARRIVAL_DISTANCE,
            "Monster"
        )

    return arrived == true
end

function F.suspendMonsterLock(seconds)
    if not State.monsterLockEnabled then
        return
    end

    local duration =
        math.max(
            0,
            tonumber(seconds) or 0
        )

    State.monsterLockSuspendUntil =
        math.max(
            State.monsterLockSuspendUntil
                or 0,
            os.clock() + duration
        )
end

function F.isMonsterLockSuspended()
    return
        State.monsterLockEnabled
        and os.clock()
            < (
                State.monsterLockSuspendUntil
                or 0
            )
end

function F.setMonsterLock(enabled)
    if enabled then
        State.monsterLockEnabled = true

        if not State.lockedMonster
            or not State.lockedMonster.Parent then

            if State.cellFarm
                and State.cellFarm.enabled
                and F.getCellBoss
            then
                State.lockedMonster =
                    F.getCellBoss()
            else
                State.lockedMonster =
                    F.getNearestMonster()
            end

            State.monsterLockManualSelection =
                State.cellFarm
                and State.cellFarm.enabled
                and State.lockedMonster ~= nil
                or false

            State.updateMonsterButtons()
        end

        if State.lockedMonster
            and State.lockedMonster.Parent
        then
            State.monsterLockWaiting =
                false

            if State.isSpectating then
                F.resetCamera()
            end

            State.applyMonsterLockPosition()
        else
            -- Keep the toggle ON. Heartbeat will automatically attach
            -- to the nearest Monster as soon as one becomes available.
            State.monsterLockWaiting =
                true

            F.stopMovementFlight("MONSTER_LOCK")
            F.releaseMovement("MONSTER_LOCK")

            local humanoid =
                F.getHumanoid()

            if humanoid then
                humanoid.AutoRotate = true
            end
        end
    else
        -- This branch is reached only when the user turns
        -- Monster Lock OFF (or the Hub is explicitly shutting down).
        State.monsterLockEnabled = false
        State.monsterLockWaiting = false
        State.monsterLockSuspendUntil = 0
        F.stopMovementFlight("MONSTER_LOCK")
        F.releaseMovement("MONSTER_LOCK")

        local humanoid =
            F.getHumanoid()

        if humanoid then
            humanoid.AutoRotate = true
        end
    end

    monsterLockToggle:SetSilent(
        State.monsterLockEnabled
    )

    State.updateCombatStatus()
end

function F.selectMonster(monster)
    if not monster
        or not monster.Parent
        or F.isIgnoredMonster(
            monster
        )
    then
        return
    end

    State.lockedMonster = monster
    State.monsterLockManualSelection = true
    State.monsterLockWaiting = false

    State.updateMonsterButtons()
    F.setMonsterLock(true)
    State.updateCombatStatus()
end

