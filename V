function F.queueCellTeleportBootstrap()
    local queueFunction = F.getQueueOnTeleport()

    if not queueFunction then
        return false, "queue_on_teleport unsupported"
    end

    if type(loadstring) ~= "function" then
        return false, "loadstring unsupported"
    end

    local canRead =
        type(readfile) == "function"

    if not canRead then
        return false,
            "readfile is required for cancellable Cell Farm resume"
    end

    local hasRuntime = true

    if type(isfile) == "function" then
        local ok, exists =
            pcall(
                isfile,
                Config.CELL_RUNTIME_FILE
            )

        hasRuntime =
            ok and exists == true
    end

    local fallbackUrl =
        F.trimText(
            State.hubReloadUrl
        )

    if not hasRuntime
        and not string.match(
            fallbackUrl,
            "^https://"
        )
    then
        return false,
            "Local v6.4 runtime file missing and no HTTPS reload URL is configured"
    end

    local codeLines = {
        "task.wait(1)",
        "local resume=false",
        "if type(readfile)=='function' then pcall(function() resume=(tostring(readfile("
            .. string.format("%q", Config.CELL_RESUME_FLAG_FILE)
            .. ")):match('^%s*1%s*$')~=nil) end) end",
        "if not resume then return end",
        "local g=_G",
        "pcall(function() if getgenv then g=getgenv() end end)",
        "g.__TheVeilHub_CellResume=true",
        "local src=nil",
        "if type(readfile)=='function' then pcall(function() src=readfile("
            .. string.format("%q", Config.CELL_RUNTIME_FILE)
            .. ") end) end",
    }

    if string.match(fallbackUrl, "^https://") then
        table.insert(
            codeLines,
            "if not src or src=='' then pcall(function() src=game:HttpGet("
                .. string.format("%q", fallbackUrl)
                .. ") end) end"
        )
    end

    table.insert(
        codeLines,
        "if src and src~='' and type(loadstring)=='function' then local fn=loadstring(src); if fn then fn() end end"
    )

    local queuedCode =
        table.concat(
            codeLines,
            "; "
        )

    local success, err =
        pcall(
            queueFunction,
            queuedCode
        )

    return success, err
end

function F.getExecutorRequest()
    local requestFunction = nil

    pcall(function()
        if type(request) == "function" then
            requestFunction = request
        end
    end)

    if requestFunction then
        return requestFunction
    end

    pcall(function()
        if type(http_request) == "function" then
            requestFunction = http_request
        end
    end)

    if requestFunction then
        return requestFunction
    end

    pcall(function()
        if syn
            and type(syn.request) == "function"
        then
            requestFunction = syn.request
        end
    end)

    if requestFunction then
        return requestFunction
    end

    pcall(function()
        if fluxus
            and type(fluxus.request) == "function"
        then
            requestFunction = fluxus.request
        end
    end)

    return requestFunction
end

function F.httpGetText(url)
    local success, body =
        pcall(function()
            return game:HttpGet(url)
        end)

    if success
        and type(body) == "string"
        and body ~= ""
    then
        return body
    end

    local requestFunction =
        F.getExecutorRequest()

    if not requestFunction then
        return nil,
            "HttpGet failed and executor request API is unavailable"
    end

    local requestOk, response =
        pcall(
            requestFunction,
            {
                Url = url,
                Method = "GET",
                Headers = {
                    ["Accept"] = "application/json"
                }
            }
        )

    if not requestOk
        or type(response) ~= "table"
    then
        return nil,
            "Executor HTTP request failed"
    end

    local statusCode =
        tonumber(
            response.StatusCode
            or response.Status
            or response.status_code
            or response.status
        )

    if statusCode and statusCode >= 400 then
        return nil,
            "HTTP request failed with status " .. tostring(statusCode)
    end

    local responseBody =
        response.Body
        or response.body
        or response.ResponseBody
        or response.responseBody

    if type(responseBody) ~= "string"
        or responseBody == ""
    then
        return nil,
            "Server list returned an empty response"
    end

    return responseBody
end

function F.httpGetJson(url)
    local body, requestError =
        F.httpGetText(url)

    if not body then
        return nil, requestError
    end

    local decodeOk, decoded =
        pcall(function()
            return HttpService:JSONDecode(body)
        end)

    if not decodeOk then
        return nil,
            "Server list JSON decode failed"
    end

    return decoded
end

function F.resetVisitedServersIfNeeded()
    local currentHour =
        os.date("!*t").hour

    if tonumber(State.visitedHour)
        ~= tonumber(currentHour)
    then
        State.visitedHour =
            currentHour

        State.visitedServers = {}
        State.serversVisitedCount = 0
        F.markConfigDirty()
    end
end

function F.findNextPublicServer()
    F.resetVisitedServersIfNeeded()

    local cursor = nil

    for _ = 1, Config.SERVER_HOP_MAX_PAGES do
        local url =
            "https://games.roblox.com/v1/games/"
            .. tostring(game.PlaceId)
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if cursor and cursor ~= "" then
            url =
                url
                .. "&cursor="
                .. HttpService:UrlEncode(
                    cursor
                )
        end

        local site, requestError =
            F.httpGetJson(url)

        if type(site) ~= "table"
            or type(site.data) ~= "table"
        then
            return nil,
                "Server list request failed: "
                .. tostring(
                    requestError
                    or "invalid response"
                )
        end

        table.sort(
            site.data,
            function(a, b)
                return
                    tonumber(a.playing or 0)
                    < tonumber(b.playing or 0)
            end
        )

        for _, server in ipairs(
            site.data
        ) do
            local serverId =
                tostring(
                    server.id or ""
                )

            local playing =
                tonumber(
                    server.playing
                ) or 0

            local maxPlayers =
                tonumber(
                    server.maxPlayers
                ) or 0

            if serverId ~= ""
                and serverId ~= tostring(game.JobId)
                and playing < maxPlayers
                and not State.visitedServers[
                    serverId
                ]
            then
                return serverId
            end
        end

        cursor =
            site.nextPageCursor

        if not cursor
            or cursor == ""
            or cursor == "null"
        then
            break
        end
    end

    return nil,
        "No unvisited public server found"
end

function F.updateServerHopStatus()
    local label =
        State.serverHopStatusLabel

    if not label
        or not label.Parent
    then
        return
    end

    local persistence = "OFF"

    if State.persistentHopEnabled then
        if F.trimText(
            State.hubReloadUrl
        ) == ""
        then
            persistence = "NO URL (HOP STILL WORKS)"
        elseif F.getQueueOnTeleport() then
            persistence = "READY"
        else
            persistence = "QUEUE UNSUPPORTED"
        end
    end

    label.Text =
        "Hop: "
        .. tostring(
            State.serverHopStatus
        )
        .. " | Servers visited: "
        .. tostring(
            State.serversVisitedCount
        )
        .. " | Persistence: "
        .. persistence
end

State.updateServerHopStatus =
    F.updateServerHopStatus

function F.finishServerHopFailure(statusText)
    State.serverHopBusy = false
    State.serverHopTargetId = nil
    State.serverHopStartedAt = 0
    State.serverHopStatus =
        statusText or "Teleport failed"

    F.updateServerHopStatus()
end

function F.serverHop(reason, options)
    options = type(options) == "table" and options or {}

    if State.serverHopBusy then
        return false
    end

    State.serverHopBusy = true
    State.sessionStats.serverHopAttempts =
        State.sessionStats.serverHopAttempts + 1
    State.serverHopTargetId = nil
    State.serverHopStartedAt = os.clock()
    State.serverHopStatus =
        "Searching server"

    F.updateServerHopStatus()

    local serverId, findError =
        F.findNextPublicServer()

    if not serverId then
        F.finishServerHopFailure(
            tostring(findError)
        )

        F.notify(
            "Server Hop",
            tostring(findError),
            "warning",
            3
        )

        return false
    end

    if not options.skipSell
        and State.sellEnabled
        and State.sellBeforeHop
    then
        State.serverHopStatus =
            "Selling before hop"

        F.updateServerHopStatus()

        F.runAutoSell(true)
    end

    F.saveFarmConfig(true)

    local queueOk, queueMessage

    if options.cellResume then
        queueOk, queueMessage =
            F.queueCellTeleportBootstrap()
    else
        queueOk, queueMessage =
            F.queueHubReload()
    end

    local persistenceRequired =
        options.requirePersistence == true

    local persistenceQueued =
        options.cellResume
        and queueOk
        or (
            not State.persistentHopEnabled
            or queueOk
        )

    if not queueOk
        and persistenceRequired
    then
        F.finishServerHopFailure(
            "Resume queue unavailable"
        )

        F.notify(
            "Cell Farm",
            "Server hop was stopped because automatic resume could not be queued: "
                .. tostring(queueMessage),
            "error",
            5
        )

        return false
    end

    if not options.cellResume
        and State.persistentHopEnabled
        and not queueOk
    then
        State.serverHopStatus =
            "Persistence skipped"

        F.updateServerHopStatus()

        F.notify(
            "Server Hop",
            "Hub reload could not be queued ("
                .. tostring(queueMessage)
                .. "). Hopping anyway.",
            "warning",
            4
        )
    end

    State.visitedServers[
        serverId
    ] = true

    State.serversVisitedCount =
        State.serversVisitedCount + 1

    State.serverHopTargetId = serverId
    State.serverHopStartedAt = os.clock()

    F.markConfigDirty()
    F.saveFarmConfig(true)

    State.serverHopStatus =
        persistenceQueued
        and "Teleporting"
        or "Teleporting (no persistence)"

    F.updateServerHopStatus()

    local originalJobId =
        tostring(game.JobId)

    local success, err =
        pcall(function()
            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                serverId,
                LocalPlayer
            )
        end)

    if not success then
        F.finishServerHopFailure(
            "Teleport call failed"
        )

        warn(
            "[The Veil Hub][ServerHop]",
            err
        )

        F.recordError("ServerHop", err)

        F.notify(
            "Server Hop",
            "Teleport call failed: "
                .. tostring(err),
            "error",
            4
        )

        return false
    end

    -- TeleportToPlaceInstance can return without throwing even if
    -- the teleport later fails. Prevent serverHopBusy from staying
    -- stuck forever by timing it out when we are still in the same JobId.
    task.delay(
        Config.SERVER_HOP_TELEPORT_TIMEOUT,
        function()
            if not State.loopRunning then
                return
            end

            if State.serverHopBusy
                and State.serverHopTargetId
                    == serverId
                and tostring(game.JobId)
                    == originalJobId
            then
                F.finishServerHopFailure(
                    "Teleport timeout - retrying"
                )

                F.notify(
                    "Server Hop",
                    "Teleport did not start. Auto Farm can retry with another server.",
                    "warning",
                    3
                )
            end
        end
    )

    return true
end

TeleportService.TeleportInitFailed:Connect(
    function(
        player,
        teleportResult,
        errorMessage
    )
        if player ~= LocalPlayer
            or not State.serverHopBusy
        then
            return
        end

        local message =
            tostring(
                errorMessage
                or teleportResult
                or "Unknown teleport error"
            )

        F.finishServerHopFailure(
            "Teleport failed: " .. message
        )

        F.recordError("TeleportInitFailed", message)

        F.notify(
            "Server Hop",
            "Teleport failed: " .. message,
            "warning",
            4
        )
    end
)


