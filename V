function F.runCellCradlePhysicalSpamSequence(
    token,
    bossWatcher,
    npcCradle,
    worldCradle
)
    if not F.isCellFarmActive(token) then
        return false
    end

    State.cellFarm.cradleESpamCount = 0
    State.cellFarm.cradleOneSpamCount = 0
    State.cellFarm.cradleSpamPhase = "E UNTIL DIALOG"

    State.cellFarm.npcInteractionMethod =
        "Physical E spam -> Physical 1 spam"

    State.cellFarm.npcInteractionSource =
        "pressVirtualKey physical input chain"

    F.setCellFarmStage(
        "CRADLE E SPAM",
        "Pressing E repeatedly until the exact The Cradle dialog appears"
    )

    local lastPositionRecheck =
        os.clock()

    while F.isCellFarmActive(token) do
        local alreadyBoss =
            F.getCellBoss()

        if alreadyBoss then
            State.cellFarm.bossSpawnConfirmed =
                true

            State.cellFarm.bossSpawnSource =
                "Already present during E spam"

            State.cellFarm.cradleSpamPhase =
                "COMPLETE"

            return true, alreadyBoss
        end

        local dialogVisible,
            releaseVisible,
            _releaseButton,
            dialogDetail =
                F.getCellCradleDialogueEvidence()

        local exactDialog =
            dialogVisible
            and releaseVisible
            and State.cellFarm.dialogTitleConfirmed
            and State.cellFarm.dialogBodyConfirmed
            and State.cellFarm.dialogOptionsConfirmed

        if exactDialog then
            State.cellFarm.dialogUiConfirmed =
                true

            State.cellFarm.dialogReleaseVisible =
                true

            State.cellFarm.dialogCheckpointConfirmed =
                true

            State.cellFarm.status =
                "CONFIRMED exact Cradle dialog after "
                .. tostring(
                    State.cellFarm.cradleESpamCount
                    or 0
                )
                .. " E presses"

            if F.updateCellFarmUI then
                F.updateCellFarmUI()
            end

            break
        end

        if os.clock() - lastPositionRecheck
            >= Config.CELL_CRADLE_SPAM_RECHECK_POSITION_EVERY
        then
            lastPositionRecheck =
                os.clock()

            pcall(function()
                F.refineCellCradleDialogPosition(
                    token,
                    npcCradle,
                    worldCradle
                )
            end)

            F.stopCellCradleTravelInput()
        end

        local inputOk =
            F.pressVirtualKey(
                Enum.KeyCode.E,
                0x45,
                Config.CELL_CRADLE_E_SPAM_HOLD,
                "Cradle E spam until dialog"
            )

        State.cellFarm.cradleESpamCount =
            (
                State.cellFarm.cradleESpamCount
                or 0
            )
            + 1

        State.cellFarm.cradleBackgroundMode =
            RobloxWindowFocused == false

        if RobloxWindowFocused == false then
            local now =
                os.clock()

            State.cellFarm._lastBackgroundStartAt =
                State.cellFarm._lastBackgroundStartAt
                or 0

            if now
                - State.cellFarm._lastBackgroundStartAt
                >= Config.CELL_CRADLE_BACKGROUND_REMOTE_INTERVAL
            then
                State.cellFarm._lastBackgroundStartAt =
                    now

                F.fireCellCradleBackgroundStart()
            end
        end

        State.cellFarm.status =
            "E spam "
            .. tostring(
                State.cellFarm.cradleESpamCount
            )
            .. " | "
            .. tostring(
                dialogDetail
                or "waiting for exact dialog"
            )
            .. (
                inputOk
                and ""
                or " | input send failed"
            )

        if F.updateCellFarmUI then
            F.updateCellFarmUI()
        end

        if not F.cellFarmWait(
            token,
            Config.CELL_CRADLE_E_SPAM_INTERVAL
        ) then
            return false
        end
    end

    if not F.isCellFarmActive(token) then
        return false
    end

    State.cellFarm.cradleSpamPhase =
        "1 UNTIL CELL SPAWNS"

    F.setCellFarmStage(
        "CRADLE 1 SPAM",
        "Dialog confirmed - pressing 1 repeatedly until The Cell Of Life spawns"
    )

    while F.isCellFarmActive(token) do
        local rawBoss =
            (
                bossWatcher
                and bossWatcher.model
            )
            or F.findCellBossModelRaw()

        if rawBoss
            and rawBoss.Parent
        then
            State.cellFarm.bossSpawnConfirmed =
                true

            State.cellFarm.bossSpawnSource =
                "Observed during physical 1 spam"

            State.cellFarm.dialogOptionSent =
                true

            State.cellFarm.dialogOptionConfirmed =
                true

            State.cellFarm.cradleSpamPhase =
                "BOSS OBSERVED"

            State.cellFarm.status =
                "Cell model appeared after "
                .. tostring(
                    State.cellFarm.cradleOneSpamCount
                    or 0
                )
                .. " key-1 presses; confirming alive"

            if F.updateCellFarmUI then
                F.updateCellFarmUI()
            end

            local confirmedBoss =
                F.waitForCellBossConfirmed(
                    token,
                    bossWatcher,
                    Config.CELL_CRADLE_BOSS_ALIVE_WAIT
                )

            if confirmedBoss then
                State.cellFarm.cradleSpamPhase =
                    "COMPLETE"

                State.cellFarm.status =
                    "CONFIRMED The Cell Of Life spawned and is alive"

                return true, confirmedBoss
            end

            F.setCellFarmStage(
                "WAITING CELL ALIVE",
                "Cell model observed but not alive-confirmed; same server, no hop"
            )

            if not F.cellFarmWait(
                token,
                0.50
            ) then
                return false
            end
        else
            F.pressVirtualKey(
                Enum.KeyCode.One,
                0x31,
                Config.CELL_CRADLE_ONE_SPAM_HOLD,
                "Cradle key 1 spam until Cell spawns"
            )

            State.cellFarm.cradleOneSpamCount =
                (
                    State.cellFarm.cradleOneSpamCount
                    or 0
                )
                + 1

            State.cellFarm.cradleBackgroundMode =
                RobloxWindowFocused == false

            if RobloxWindowFocused == false then
                local now =
                    os.clock()

                State.cellFarm._lastBackgroundOptionAt =
                    State.cellFarm._lastBackgroundOptionAt
                    or 0

                if now
                    - State.cellFarm._lastBackgroundOptionAt
                    >= Config.CELL_CRADLE_BACKGROUND_REMOTE_INTERVAL
                then
                    State.cellFarm._lastBackgroundOptionAt =
                        now

                    F.fireCellCradleBackgroundRelease()
                end
            end

            State.cellFarm.dialogOptionSent =
                true

            State.cellFarm.status =
                "1 spam "
                .. tostring(
                    State.cellFarm.cradleOneSpamCount
                )
                .. " | waiting for The Cell Of Life"

            if F.updateCellFarmUI then
                F.updateCellFarmUI()
            end

            if not F.cellFarmWait(
                token,
                Config.CELL_CRADLE_ONE_SPAM_INTERVAL
            ) then
                return false
            end
        end
    end

    return false
end

function F.summonCellBoss(token)
    if not F.isCellFarmActive(token) then
        return false
    end

    local existing =
        F.getCellBoss()

    if existing then
        State.cellFarm.bossSpawnConfirmed =
            true

        State.cellFarm.bossSpawnSource =
            "Already present"

        return true, existing
    end

    local remotes =
        F.getCellRemotes()

    if not remotes
        or not remotes.Dialog
    then
        F.recordCellFailure(
            "DialogEvent is unavailable"
        )
        return false
    end

    local npcCradle,
        worldCradle =
            F.waitForCellCradleDialogTargets(
                token,
                Config.CELL_CRADLE_TARGET_WAIT
            )

    if not npcCradle
        or not npcCradle.Parent
    then
        F.recordCellFailure(
            'workspace.NPCs["The Cradle"] is unavailable'
        )
        return false
    end

    if not worldCradle
        or not worldCradle.Parent
    then
        F.recordCellFailure(
            'workspace.Systems.CellOfLifeJunk["The Cradle"] is unavailable'
        )
        return false
    end

    -- Best-effort positioning only. The user manually verified that the
    -- exact Cobalt DialogEvent start can open the dialogue, so distance must
    -- never block that exact remote from being attempted.
    pcall(function()
        F.refineCellCradleDialogPosition(
            token,
            npcCradle,
            worldCradle
        )
    end)

    State.cellFarm.dialogStartSent = false
    State.cellFarm.cradleInteractPromptVisible = false
    State.cellFarm.cradleInteractPromptText = "None"
    State.cellFarm.cradleInteractPromptAttempts = 0
    State.cellFarm.dialogUiConfirmed = false
    State.cellFarm.dialogTitleConfirmed = false
    State.cellFarm.dialogBodyConfirmed = false
    State.cellFarm.dialogOptionsConfirmed = false
    State.cellFarm.dialogReleaseVisible = false
    State.cellFarm.dialogOptionSent = false
    State.cellFarm.dialogOptionConfirmed = false
    State.cellFarm.dialogCheckpointConfirmed = false
    State.cellFarm.dialogCheckpointHolding = false
    State.cellFarm.cradleRecorderStatus = "OFF"
    State.cellFarm.cradleRecorderArmed = false
    State.cellFarm.cradleRecorderManualE = 0
    State.cellFarm.cradleRecorderRemoteCalls = 0
    State.cellFarm.cradleRecorderConnectionCount = 0
    State.cellFarm.cradleRecorderCandidateScore = -1
    State.cellFarm.cradleRecorderCandidate = "None"
    State.cellFarm.cradleRecorderLastRemote = "None"
    State.cellFarm.cradleRecorderReportPath = "None"
    State.cellFarm.cradleRecorderResult = "None"
    State.cellFarm.cradleESpamCount = 0
    State.cellFarm.cradleOneSpamCount = 0
    State.cellFarm.cradleSpamPhase = "OFF"
    State.cellFarm.cradleBackgroundMode = false
    State.cellFarm.cradleBackgroundStartCalls = 0
    State.cellFarm.cradleBackgroundOptionCalls = 0
    State.cellFarm.cradleBackgroundLastAction = "None"
    State.cellFarm.dialogClientEvents = 0
    State.cellFarm.dialogLastClientEvent = "None"
    State.cellFarm.bossSpawnConfirmed = false
    State.cellFarm.bossSpawnSource = "None"
    State.cellFarm.bossSpawnRemoteEvents = 0
    State.cellFarm.bossLastSpawnEvent = "None"

    local dialogObserver =
        F.startCellDialogObserver(
            remotes.Dialog
        )

    local bossWatcher =
        F.startCellBossSpawnWatcher(
            remotes
        )

    local function cleanup()
        if dialogObserver then
            pcall(function()
                dialogObserver:Disconnect()
            end)

            dialogObserver = nil
        end

        F.stopCellBossSpawnWatcher(
            bossWatcher
        )
    end

    if Config.CELL_CRADLE_PHYSICAL_SPAM_MODE then
        if not F.settleCellAtCradle(
            token
        ) then
            cleanup()
            return false
        end

        pcall(function()
            F.refineCellCradleDialogPosition(
                token,
                npcCradle,
                worldCradle
            )
        end)

        local spamOk,
            spamBoss =
                F.runCellCradlePhysicalSpamSequence(
                    token,
                    bossWatcher,
                    npcCradle,
                    worldCradle
                )

        cleanup()

        if spamOk
            and spamBoss
        then
            return true, spamBoss
        end

        return false
    end

    if Config.CELL_CRADLE_RECORDER_ONLY then
        if not F.settleCellAtCradle(
            token
        ) then
            cleanup()
            return false
        end

        pcall(function()
            F.refineCellCradleDialogPosition(
                token,
                npcCradle,
                worldCradle
            )
        end)

        local recorderPassed,
            recorderDetail =
                F.runCradleManualERecorderCheckpoint(
                    token,
                    npcCradle
                )

        State.cellFarm.dialogCheckpointConfirmed =
            recorderPassed == true

        State.cellFarm.status =
            tostring(
                recorderDetail
                or State.cellFarm.status
            )

        cleanup()

        return false
    end

    for attempt = 1,
        Config.CELL_CRADLE_DIALOG_ATTEMPTS
    do
        if not F.isCellFarmActive(token) then
            cleanup()
            return false
        end

        local bossNow =
            F.getCellBoss()

        if bossNow then
            State.cellFarm.bossSpawnConfirmed =
                true

            State.cellFarm.bossSpawnSource =
                "Detected before dialogue attempt"

            cleanup()
            return true, bossNow
        end

        local refreshedNpc,
            refreshedWorld =
                F.getCellCradleDialogTargets()

        if refreshedNpc
            and refreshedNpc.Parent
        then
            npcCradle =
                refreshedNpc
        end

        if refreshedWorld
            and refreshedWorld.Parent
        then
            worldCradle =
                refreshedWorld
        end

        if not npcCradle
            or not npcCradle.Parent
            or not worldCradle
            or not worldCradle.Parent
        then
            cleanup()

            F.recordCellFailure(
                "Cradle dialogue target disappeared"
            )

            return false
        end

        if not F.settleCellAtCradle(
            token
        ) then
            cleanup()
            return false
        end

        State.cellFarm.dialogStartSent =
            false
        State.cellFarm.cradleInteractPromptVisible =
            false
        State.cellFarm.cradleInteractPromptText =
            "None"
        State.cellFarm.cradleInteractPromptAttempts =
            0
        State.cellFarm.dialogUiConfirmed =
            false
        State.cellFarm.dialogTitleConfirmed =
            false
        State.cellFarm.dialogBodyConfirmed =
            false
        State.cellFarm.dialogOptionsConfirmed =
            false
        State.cellFarm.dialogReleaseVisible =
            false
        State.cellFarm.dialogOptionSent =
            false
        State.cellFarm.dialogOptionConfirmed =
            false

        -- Re-check/approach if possible, but never prevent the exact Cobalt
        -- start from firing solely because the measured DialogPart distance
        -- did not satisfy our helper.
        pcall(function()
            F.refineCellCradleDialogPosition(
                token,
                npcCradle,
                worldCradle
            )
        end)

        local dialogueConfirmed = false
        local releaseVisible = false
        local releaseButton = nil
        local dialogueDetail = "Waiting for Cradle dialogue"

        State.cellFarm.cradleInteractPromptAttempts =
            (
                State.cellFarm.cradleInteractPromptAttempts
                or 0
            )
            + 1

        F.setCellFarmStage(
            "WAITING FOR CRADLE PROMPT",
            "Waiting for visible Interact (E) before exact Cobalt start "
                .. tostring(attempt)
                .. "/"
                .. tostring(
                    Config.CELL_CRADLE_DIALOG_ATTEMPTS
                )
        )

        local promptReady,
            promptText =
                F.waitForCellCradleInteractPrompt(
                    token,
                    Config.CELL_CRADLE_PROMPT_WAIT
                )

        State.cellFarm.cradleInteractPromptVisible =
            promptReady == true

        State.cellFarm.cradleInteractPromptText =
            promptText
            or "None"

        -- IMPORTANT: do not press E here. The user confirmed physical E did
        -- not open the dialogue reliably. The visible Interact(E) prompt is
        -- used only as proof that the game's NPC controller is in a ready
        -- proximity/input state before the exact, manually-proven Cobalt
        -- DialogEvent start is fired.
        State.cellFarm.npcInteractionFunctionFound =
            false

        State.cellFarm.npcInteractionCallOk =
            false

        State.cellFarm.npcInteractionMethod =
            promptReady
            and "Prompt-ready exact Cobalt start"
            or "Prompt-timeout exact Cobalt start"

        State.cellFarm.npcInteractionSource =
            'DialogEvent:FireServer("start", workspace.NPCs["The Cradle"], 10)'

        if promptReady then
            F.setCellFarmStage(
                "CRADLE PROMPT CONFIRMED",
                "Interact (E) is stable; firing exact Cobalt start now"
            )
        else
            F.setCellFarmStage(
                "CRADLE PROMPT TIMEOUT",
                "Prompt not confirmed; still trying exact Cobalt start once"
            )
        end

        -- Exact Cobalt snippet supplied by the user and manually verified:
        local startOk =
            pcall(function()
                local Event =
                    game:GetService(
                        "ReplicatedStorage"
                    ).Remotes.DialogEvent

                Event:FireServer(
                    "start",
                    workspace.NPCs["The Cradle"],
                    10
                )
            end)

        State.cellFarm.dialogStartSent =
            startOk == true

        if startOk then
            State.movementTelemetry.lastRemote =
                'DialogEvent("start", workspace.NPCs["The Cradle"], 10)'

            State.cellFarm.status =
                promptReady
                and "Exact Cobalt start sent after confirmed Interact (E) readiness"
                or "Exact Cobalt start sent after prompt timeout"
        else
            F.recordCellFailure(
                "Exact Cobalt DialogEvent start failed"
            )

            State.cellFarm.status =
                "Exact Cobalt start pcall failed"
        end

        if F.updateCellFarmUI then
            F.updateCellFarmUI()
        end

        dialogueConfirmed,
            releaseVisible,
            releaseButton,
            dialogueDetail =
                F.waitForCellCradleDialogue(
                    token,
                    Config.CELL_CRADLE_DIALOG_VISIBLE_WAIT,
                    true
                )

        State.cellFarm.dialogUiConfirmed =
            dialogueConfirmed == true

        State.cellFarm.dialogReleaseVisible =
            releaseVisible == true

        State.cellFarm.status =
            dialogueConfirmed
            and (
                "CONFIRMED: exact Cradle Release dialogue rendered"
                .. (
                    releaseButton
                    and (
                        " | "
                        .. releaseButton:GetFullName()
                    )
                    or ""
                )
            )
            or (
                "NOT CONFIRMED after exact Cobalt start: "
                .. tostring(
                    dialogueDetail
                )
            )

        if F.updateCellFarmUI then
            F.updateCellFarmUI()
        end

        if not dialogueConfirmed
            or not releaseVisible
        then
            F.setCellFarmStage(
                "DIALOG NOT CONFIRMED",
                promptReady
                    and "Prompt was ready but exact Cobalt start did not produce Release UI"
                    or "Prompt was not ready and exact Cobalt start did not produce Release UI"
            )

            if attempt
                < Config.CELL_CRADLE_DIALOG_ATTEMPTS
            then
                if not F.cellFarmWait(
                    token,
                    Config.CELL_CRADLE_RETRY_DELAY
                ) then
                    cleanup()
                    return false
                end

                continue
            end

            cleanup()
            return false
        end

        State.cellFarm.dialogCheckpointConfirmed =
            true

        if Config.CELL_DIALOG_CHECKPOINT_ONLY then
            State.cellFarm.dialogCheckpointHolding =
                true

            F.setCellFarmStage(
                "DIALOG CHECKPOINT PASSED",
                "CONFIRMED exact The Cradle dialogue. Holding here; Release is intentionally disabled in this test build."
            )

            State.cellFarm.status =
                "CHECKPOINT 1 PASS: The Cradle dialog is confirmed. Do not press Release yet."

            if F.updateCellFarmUI then
                F.updateCellFarmUI()
            end

            local lastHeartbeat =
                os.clock()

            while F.isCellFarmActive(token)
                and Config.CELL_DIALOG_CHECKPOINT_ONLY
            do
                if os.clock() - lastHeartbeat
                    >= Config.CELL_DIALOG_CHECKPOINT_HEARTBEAT
                then
                    lastHeartbeat =
                        os.clock()

                    local stillVisible,
                        stillReleaseVisible,
                        _button,
                        detail =
                            F.getCellCradleDialogueEvidence()

                    State.cellFarm.dialogUiConfirmed =
                        stillVisible == true

                    State.cellFarm.dialogReleaseVisible =
                        stillReleaseVisible == true

                    State.cellFarm.status =
                        stillVisible
                        and "CHECKPOINT 1 PASS: Dialog still visible - waiting for user confirmation"
                        or (
                            "CHECKPOINT 1 LOST: "
                            .. tostring(detail)
                        )

                    if F.updateCellFarmUI then
                        F.updateCellFarmUI()
                    end
                end

                task.wait(0.10)
            end

            State.cellFarm.dialogCheckpointHolding =
                false

            cleanup()

            return false
        end

        -- The screenshot confirms option 1 is "(Release)". Once the exact
        -- panel is proven, use the same visible player action first.
        if not F.cellFarmWait(
            token,
            Config.CELL_CRADLE_RELEASE_SETTLE
        ) then
            cleanup()
            return false
        end

        local optionConfirmed = false

        F.setCellFarmStage(
            "PRESSING RELEASE",
            "Exact Cradle panel confirmed - pressing option 1 (Release)"
        )

        F.pressVirtualKey(
            Enum.KeyCode.One,
            0x31,
            Config.CELL_CRADLE_RELEASE_KEY_HOLD,
            "Cradle option 1 - Release"
        )

        local keyConfirmDeadline =
            os.clock()
            + Config.CELL_CRADLE_RELEASE_KEY_CONFIRM

        while F.isCellFarmActive(token)
            and os.clock() < keyConfirmDeadline
        do
            local rawBoss =
                (
                    bossWatcher
                    and bossWatcher.model
                )
                or F.findCellBossModelRaw()

            local dialogVisible,
                releaseStillVisible =
                    F.getCellCradleDialogueEvidence()

            if rawBoss
                and rawBoss.Parent
            then
                optionConfirmed = true
                State.cellFarm.dialogOptionSent = true
                State.cellFarm.dialogOptionConfirmed = true
                State.cellFarm.status =
                    "CONFIRMED: Release accepted; boss model appeared"
                break
            end

            if not dialogVisible
                or not releaseStillVisible
            then
                optionConfirmed = true
                State.cellFarm.dialogOptionSent = true
                State.cellFarm.dialogOptionConfirmed = true
                State.cellFarm.status =
                    "CONFIRMED: Release option closed after key 1"
                break
            end

            task.wait(0.05)
        end

        -- If the visible key 1 path does not transition, use the exact option
        -- Cobalt remote supplied earlier as a fallback.
        for optionAttempt = 1,
            Config.CELL_CRADLE_OPTION_RETRIES
        do
            if optionConfirmed then
                break
            end
            if not F.isCellFarmActive(token) then
                cleanup()
                return false
            end

            local _,
                latestWorld =
                    F.getCellCradleDialogTargets()

            if latestWorld
                and latestWorld.Parent
            then
                worldCradle =
                    latestWorld
            end

            if not worldCradle
                or not worldCradle.Parent
            then
                cleanup()

                F.recordCellFailure(
                    "Cradle option target disappeared"
                )

                return false
            end

            F.setCellFarmStage(
                "RELEASE CONFIRMED",
                "Key 1 did not transition; sending exact Cobalt option fallback "
                    .. tostring(optionAttempt)
                    .. "/"
                    .. tostring(
                        Config.CELL_CRADLE_OPTION_RETRIES
                    )
            )

            -- Exact full Cobalt option command supplied earlier:
            --
            -- local Event = game:GetService("ReplicatedStorage").Remotes.DialogEvent
            -- Event:FireServer(
            --     "option",
            --     workspace.Systems.CellOfLifeJunk["The Cradle"],
            --     5
            -- )
            local optionOk =
                pcall(function()
                    local Event =
                        game:GetService(
                            "ReplicatedStorage"
                        ).Remotes.DialogEvent

                    Event:FireServer(
                        "option",
                        workspace.Systems.CellOfLifeJunk["The Cradle"],
                        5
                    )
                end)

            State.cellFarm.dialogOptionSent =
                optionOk == true

            if optionOk then
                State.movementTelemetry.lastRemote =
                    'DialogEvent("option", workspace.Systems.CellOfLifeJunk["The Cradle"], 5)'
            else
                F.recordCellFailure(
                    "Exact Cobalt Cradle option failed"
                )
            end

            if F.updateCellFarmUI then
                F.updateCellFarmUI()
            end

            local confirmDeadline =
                os.clock()
                + Config.CELL_CRADLE_RELEASE_CONFIRM_WAIT

            while F.isCellFarmActive(token)
                and os.clock()
                    < confirmDeadline
            do
                local rawBoss =
                    (
                        bossWatcher
                        and bossWatcher.model
                    )
                    or F.findCellBossModelRaw()

                local _dialogVisible,
                    releaseStillVisible =
                        F.getCellCradleDialogueEvidence()

                if rawBoss
                    and rawBoss.Parent
                then
                    optionConfirmed = true

                    State.cellFarm.dialogOptionConfirmed =
                        true

                    State.cellFarm.status =
                        "CONFIRMED: boss model appeared after Release"

                    break
                end

                if not releaseStillVisible then
                    optionConfirmed = true

                    State.cellFarm.dialogOptionConfirmed =
                        true

                    State.cellFarm.status =
                        "CONFIRMED: Release option left DialogueGui"

                    break
                end

                task.wait(0.05)
            end

            if optionConfirmed then
                break
            end
        end

        if not optionConfirmed then
            F.setCellFarmStage(
                "RELEASE NOT CONFIRMED",
                "Option remote sent but Release UI remained and no boss appeared"
            )

            if attempt
                < Config.CELL_CRADLE_DIALOG_ATTEMPTS
            then
                if not F.cellFarmWait(
                    token,
                    Config.CELL_CRADLE_RETRY_DELAY
                ) then
                    cleanup()
                    return false
                end

                continue
            end

            cleanup()
            return false
        end

        F.setCellFarmStage(
            "WAITING TO FIGHT BOSS",
            "Dialogue complete - waiting for The Cell Of Life; server hop blocked"
        )

        local lastBossWaitNotice =
            os.clock()

        while F.isCellFarmActive(token) do
            local boss =
                F.waitForCellBossConfirmed(
                    token,
                    bossWatcher,
                    Config.CELL_CRADLE_BOSS_MODEL_WAIT
                )

            if boss then
                State.cellFarm.bossSpawnConfirmed =
                    true

                State.cellFarm.status =
                    "CONFIRMED: The Cell Of Life spawned and is alive - starting fight"

                if F.updateCellFarmUI then
                    F.updateCellFarmUI()
                end

                cleanup()
                return true, boss
            end

            -- A slow boss spawn is not a reason to abandon the server.
            F.setCellFarmStage(
                "WAITING TO FIGHT BOSS",
                "Dialogue is finished; still waiting for The Cell Of Life - NO HOP"
            )

            if os.clock() - lastBossWaitNotice
                >= Config.CELL_CRADLE_BOSS_WAIT_NOTICE
            then
                lastBossWaitNotice =
                    os.clock()

                F.recordDiagnosticEvent(
                    "CellFarm",
                    "Dialogue complete; still waiting for The Cell Of Life. Server hop remains blocked."
                )
            end

            if not F.cellFarmWait(
                token,
                0.75
            ) then
                cleanup()
                return false
            end
        end

        cleanup()
        return false
    end

    cleanup()

    return false
end

function F.isGuiObjectActuallyVisible(object)
    if not object
        or not object.Parent
    then
        return false
    end

    local current = object

    while current
        and current ~= game
    do
        if current:IsA("GuiObject")
            and not current.Visible
        then
            return false
        end

        if current:IsA("ScreenGui")
            and not current.Enabled
        then
            return false
        end

        current = current.Parent
    end

    return true
end

function F.getGuiObjectText(object)
    if not object then
        return ""
    end

    if object:IsA("TextLabel")
        or object:IsA("TextButton")
        or object:IsA("TextBox")
    then
        return F.trimText(object.Text)
    end

    return ""
end

function F.getGuiButtonFromTextObject(object)
    local current = object

    for _ = 1, 7 do
        if not current then
            break
        end

        if current:IsA("GuiButton") then
            return current
        end

        current = current.Parent
    end

    return nil
end

function F.findVisibleGuiTextObject(expectedText)
    local playerGui =
        LocalPlayer:FindFirstChildOfClass(
            "PlayerGui"
        )

    if not playerGui then
        return nil
    end

    local wanted =
        string.lower(
            F.trimText(expectedText)
        )

    for _, object in ipairs(
        playerGui:GetDescendants()
    ) do
        local textValue =
            F.getGuiObjectText(
                object
            )

        if textValue ~= ""
            and string.lower(textValue) == wanted
            and F.isGuiObjectActuallyVisible(object)
        then
            return object
        end
    end

    return nil
end

function F.findVisibleGuiButtonByText(expectedText)
    local textObject =
        F.findVisibleGuiTextObject(
            expectedText
        )

    if not textObject then
        return nil
    end

    return
        F.getGuiButtonFromTextObject(
            textObject
        )
end

