-- =========================================================
-- DROP HELPERS
-- =========================================================

function F.getDropCFrame(drop)
    if not drop or not drop.Parent then
        return nil
    end

    if drop:IsA("Model") then
        local success, pivot = pcall(function()
            return drop:GetPivot()
        end)

        if success then
            return pivot
        end
    elseif drop:IsA("BasePart") then
        return drop.CFrame
    elseif drop:IsA("Tool") then
        local handle = drop:FindFirstChild("Handle")

        if handle and handle:IsA("BasePart") then
            return handle.CFrame
        end
    end

    local part =
        drop:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if part then
        return part.CFrame
    end

    return nil
end

function F.getPartWorldHalfExtents(part)
    if not part or not part:IsA("BasePart") then
        return 0, 0, 0
    end

    local half = part.Size * 0.5
    local cf = part.CFrame

    local xHalf =
        math.abs(cf.RightVector.X) * half.X
        + math.abs(cf.UpVector.X) * half.Y
        + math.abs(cf.LookVector.X) * half.Z

    local yHalf =
        math.abs(cf.RightVector.Y) * half.X
        + math.abs(cf.UpVector.Y) * half.Y
        + math.abs(cf.LookVector.Y) * half.Z

    local zHalf =
        math.abs(cf.RightVector.Z) * half.X
        + math.abs(cf.UpVector.Z) * half.Y
        + math.abs(cf.LookVector.Z) * half.Z

    return xHalf, yHalf, zHalf
end

function F.getDropWorldBounds(drop)
    if not drop or not drop.Parent then
        return nil, nil
    end

    local minX = math.huge
    local maxX = -math.huge
    local minZ = math.huge
    local maxZ = -math.huge
    local topY = -math.huge
    local foundPart = false

    local function includePart(part)
        if not part or not part:IsA("BasePart") then
            return
        end

        local xHalf, yHalf, zHalf =
            F.getPartWorldHalfExtents(part)

        minX = math.min(minX, part.Position.X - xHalf)
        maxX = math.max(maxX, part.Position.X + xHalf)
        minZ = math.min(minZ, part.Position.Z - zHalf)
        maxZ = math.max(maxZ, part.Position.Z + zHalf)
        topY = math.max(topY, part.Position.Y + yHalf)
        foundPart = true
    end

    if drop:IsA("BasePart") then
        includePart(drop)
    else
        for _, object in ipairs(drop:GetDescendants()) do
            if object:IsA("BasePart") then
                includePart(object)
            end
        end
    end

    if not foundPart then
        local fallback = F.getDropCFrame(drop)
        if fallback then
            return fallback.Position, fallback.Position.Y
        end
        return nil, nil
    end

    return Vector3.new(
        (minX + maxX) * 0.5,
        topY,
        (minZ + maxZ) * 0.5
    ), topY
end

function F.getPlayerRootToFeetHeight()
    local character = F.getPlayerCharacter()
    local root = F.getCharacterRoot()

    if not character or not root then
        return 3
    end

    local feetBottomTotal = 0
    local feetCount = 0

    for _, partName in ipairs({
        "LeftFoot",
        "RightFoot",
        "Left Leg",
        "Right Leg",
    }) do
        local part = character:FindFirstChild(partName)

        if part and part:IsA("BasePart") then
            local _, yHalf = F.getPartWorldHalfExtents(part)
            feetBottomTotal =
                feetBottomTotal
                + (part.Position.Y - yHalf)
            feetCount = feetCount + 1
        end
    end

    if feetCount > 0 then
        local feetY = feetBottomTotal / feetCount
        return math.clamp(
            root.Position.Y - feetY,
            0.5,
            15
        )
    end

    local humanoid = F.getHumanoid()
    local fallback = root.Size.Y * 0.5

    if humanoid then
        fallback = fallback + humanoid.HipHeight
    else
        fallback = fallback + 2
    end

    return math.clamp(fallback, 0.5, 15)
end

function F.getDropStandCFrame(drop)
    local root = F.getCharacterRoot()
    if not root then
        return nil
    end

    local center, topY =
        F.getDropWorldBounds(drop)

    if not center or not topY then
        return nil
    end

    local standHeight =
        F.getPlayerRootToFeetHeight()

    local targetPosition = Vector3.new(
        center.X,
        topY + standHeight + 0.04,
        center.Z
    )

    local look = root.CFrame.LookVector
    local flatLook = Vector3.new(
        look.X,
        0,
        look.Z
    )

    if flatLook.Magnitude < 0.01 then
        flatLook = Vector3.new(0, 0, -1)
    else
        flatLook = flatLook.Unit
    end

    return CFrame.lookAt(
        targetPosition,
        targetPosition + flatLook
    )
end

function F.pressVirtualKey(keyCode, fallbackVirtualKey, holdSeconds, actionName)
    if actionName then
        State.movementTelemetry.lastAction =
            tostring(actionName)
    end

    local hold =
        math.max(
            0.025,
            tonumber(holdSeconds) or 0.06
        )

    local virtualInput = nil

    pcall(function()
        virtualInput =
            game:GetService(
                "VirtualInputManager"
            )
    end)

    if virtualInput then
        local success =
            pcall(function()
                virtualInput:SendKeyEvent(
                    true,
                    keyCode,
                    false,
                    game
                )

                task.wait(hold)

                virtualInput:SendKeyEvent(
                    false,
                    keyCode,
                    false,
                    game
                )
            end)

        if success then
            return true
        end
    end

    if type(keypress) == "function"
        and type(keyrelease) == "function"
        and fallbackVirtualKey ~= nil
    then
        local success =
            pcall(function()
                keypress(
                    fallbackVirtualKey
                )

                task.wait(hold)

                keyrelease(
                    fallbackVirtualKey
                )
            end)

        if success then
            return true
        end
    end

    return false
end

function F.cellFarmWait(token, seconds)
    local deadline =
        os.clock()
        + math.max(
            0,
            tonumber(seconds) or 0
        )

    while os.clock() < deadline do
        if not F.isCellFarmActive(token) then
            return false
        end

        task.wait(
            math.min(
                0.05,
                math.max(
                    0.01,
                    deadline - os.clock()
                )
            )
        )
    end

    return F.isCellFarmActive(token)
end

