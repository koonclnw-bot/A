function F.scoreTryStartNPCInteraction(fn, npcCradle)
    if type(fn) ~= "function" then
        return -1, "not a function"
    end

    local score = 0

    local name =
        string.lower(
            F.getCellFunctionDebugName(
                fn
            )
        )

    local source =
        string.lower(
            F.getCellFunctionDebugSource(
                fn
            )
        )

    if name ==
        "trystartnpcinteraction"
    then
        score = score + 12
    elseif string.find(
        name,
        "npcinteraction",
        1,
        true
    ) then
        score = score + 4
    end

    if string.find(
        source,
        "npcinputhandler",
        1,
        true
    ) then
        score = score + 10
    end

    -- getfenv(script) gives another strong source check on many executors.
    if type(getfenv) == "function" then
        pcall(function()
            local env =
                getfenv(
                    fn
                )

            local scriptObject =
                env
                and env.script

            if scriptObject
                and tostring(
                    scriptObject.Name
                ) == "NPCInputHandler"
            then
                score = score + 8
            end
        end)
    end

    -- Confirm constants from the Function Info supplied by the user when
    -- the executor exposes getconstants.
    if type(getconstants) == "function" then
        pcall(function()
            local constants =
                getconstants(
                    fn
                )

            local wanted = {
                RegisterNPCInteraction = false,
                DialogPart = false,
                start = false,
            }

            for _, value in ipairs(
                constants
            ) do
                if type(value) == "string"
                    and wanted[value] ~= nil
                then
                    wanted[value] = true
                end
            end

            if wanted.RegisterNPCInteraction then
                score = score + 4
            end

            if wanted.DialogPart then
                score = score + 2
            end

            if wanted.start then
                score = score + 1
            end
        end)
    end

    -- The supplied trace showed workspace.NPCs["The Cradle"] among the
    -- upvalues. Use that only as confirmation, never as a hard requirement.
    if npcCradle
        and type(getupvalues) == "function"
    then
        pcall(function()
            local upvalues =
                getupvalues(
                    fn
                )

            for _, value in pairs(
                upvalues
            ) do
                if value == npcCradle then
                    score = score + 8
                    break
                end
            end
        end)
    end

    return
        score,
        (
            F.getCellFunctionDebugName(fn)
            .. " | "
            .. F.getCellFunctionDebugSource(fn)
        )
end

function F.findTryStartNPCInteraction(npcCradle)
    if type(getgc) ~= "function" then
        return nil, "getgc unavailable", -1
    end

    local ok,
        objects =
            pcall(
                getgc,
                true
            )

    if not ok
        or type(objects) ~= "table"
    then
        return nil, "getgc scan failed", -1
    end

    local bestFn = nil
    local bestDetail = "No candidate"
    local bestScore = -1

    for _, object in ipairs(
        objects
    ) do
        if type(object) == "function" then
            local score,
                detail =
                    F.scoreTryStartNPCInteraction(
                        object,
                        npcCradle
                    )

            if score > bestScore then
                bestScore = score
                bestFn = object
                bestDetail = detail
            end
        end
    end

    -- Require strong evidence. Exact function name + source already scores
    -- 22, while weak unrelated functions remain below this threshold.
    if bestFn
        and bestScore >= 18
    then
        return
            bestFn,
            bestDetail,
            bestScore
    end

    return
        nil,
        bestDetail,
        bestScore
end

function F.callNativeCradleInteraction(
    token,
    npcCradle
)
    if not F.isCellFarmActive(token) then
        return false, "farm stopped"
    end

    local deadline =
        os.clock()
        + Config.CELL_CRADLE_NATIVE_SCAN_WAIT

    local fn = nil
    local detail = "Not found"
    local score = -1

    repeat
        fn,
        detail,
        score =
            F.findTryStartNPCInteraction(
                npcCradle
            )

        if fn then
            break
        end

        task.wait(
            Config.CELL_CRADLE_NATIVE_RETRY_DELAY
        )
    until os.clock() >= deadline
        or not F.isCellFarmActive(token)

    State.cellFarm.npcInteractionFunctionFound =
        fn ~= nil

    State.cellFarm.npcInteractionSource =
        tostring(detail)
        .. " | score="
        .. tostring(score)

    if not fn then
        State.cellFarm.npcInteractionCallOk =
            false

        State.cellFarm.npcInteractionMethod =
            "Direct DialogEvent fallback"

        return
            false,
            "tryStartNPCInteraction not found"
    end

    State.cellFarm.npcInteractionMethod =
        "NPCInputHandler.tryStartNPCInteraction"

    -- The user's captured Function Info reports these exact invocation
    -- arguments. Extra arguments are harmless in Luau if this build ignores
    -- some of them.
    local ok,
        result =
            pcall(
                fn,
                "start",
                npcCradle,
                10
            )

    State.cellFarm.npcInteractionCallOk =
        ok == true

    if ok then
        State.movementTelemetry.lastAction =
            "Called native tryStartNPCInteraction"

        return
            true,
            tostring(result)
    end

    return
        false,
        tostring(result)
end



function F.describeCradleRecorderValue(value)
    local valueType =
        typeof(value)

    if valueType == "Instance" then
        local fullName =
            tostring(value)

        pcall(function()
            fullName =
                value:GetFullName()
        end)

        return
            "Instance<"
            .. tostring(value.ClassName)
            .. ">:"
            .. fullName
    end

    if valueType == "function" then
        return
            "function:"
            .. F.getCellFunctionDebugName(
                value
            )
            .. " @ "
            .. F.getCellFunctionDebugSource(
                value
            )
    end

    if valueType == "table" then
        local keys = {}
        local total = 0

        for key, _ in pairs(value) do
            total = total + 1

            if #keys < 8 then
                table.insert(
                    keys,
                    tostring(key)
                )
            end
        end

        return
            "table("
            .. tostring(total)
            .. ")["
            .. table.concat(
                keys,
                ","
            )
            .. "]"
    end

    local text =
        tostring(value)

    if #text > 160 then
        text =
            string.sub(
                text,
                1,
                157
            )
            .. "..."
    end

    return
        valueType
        .. ":"
        .. text
end

function F.captureCradleFunctionSnapshot(fn, label)
    local snapshot = {
        label = tostring(label or "SNAPSHOT"),
        lines = {},
        upvalues = {},
    }

    if type(fn) ~= "function" then
        table.insert(
            snapshot.lines,
            snapshot.label
                .. ": no function candidate"
        )

        return snapshot
    end

    table.insert(
        snapshot.lines,
        snapshot.label
            .. " function: "
            .. F.getCellFunctionDebugName(fn)
            .. " | "
            .. F.getCellFunctionDebugSource(fn)
    )

    local constantsFn =
        type(getconstants) == "function"
        and getconstants
        or (
            debug
            and type(debug.getconstants) == "function"
            and debug.getconstants
            or nil
        )

    if constantsFn then
        local ok,
            constants =
                pcall(
                    constantsFn,
                    fn
                )

        if ok
            and type(constants) == "table"
        then
            local values = {}

            for index, value in ipairs(
                constants
            ) do
                if #values >= 40 then
                    break
                end

                if type(value) == "string"
                    or type(value) == "number"
                    or type(value) == "boolean"
                then
                    table.insert(
                        values,
                        tostring(index)
                            .. "="
                            .. F.describeCradleRecorderValue(
                                value
                            )
                    )
                end
            end

            table.insert(
                snapshot.lines,
                "Constants: "
                    .. (
                        #values > 0
                        and table.concat(
                            values,
                            " | "
                        )
                        or "(none captured)"
                    )
            )
        end
    end

    local upvaluesFn =
        type(getupvalues) == "function"
        and getupvalues
        or (
            debug
            and type(debug.getupvalues) == "function"
            and debug.getupvalues
            or nil
        )

    if upvaluesFn then
        local ok,
            upvalues =
                pcall(
                    upvaluesFn,
                    fn
                )

        if ok
            and type(upvalues) == "table"
        then
            for key, value in pairs(
                upvalues
            ) do
                snapshot.upvalues[
                    tostring(key)
                ] =
                    F.describeCradleRecorderValue(
                        value
                    )
            end

            local keys = {}

            for key in pairs(
                snapshot.upvalues
            ) do
                table.insert(
                    keys,
                    key
                )
            end

            table.sort(keys)

            for _, key in ipairs(keys) do
                table.insert(
                    snapshot.lines,
                    "Upvalue["
                        .. key
                        .. "] = "
                        .. snapshot.upvalues[key]
                )
            end
        end
    end

    return snapshot
end

function F.captureCradleConnectionSummary()
    local result = {
        lines = {},
        count = 0,
    }

    if type(getconnections) ~= "function" then
        table.insert(
            result.lines,
            "getconnections unavailable"
        )

        return result
    end

    local function addSignal(name, signal)
        if not signal then
            return
        end

        local ok,
            connections =
                pcall(
                    getconnections,
                    signal
                )

        if not ok
            or type(connections) ~= "table"
        then
            return
        end

        table.insert(
            result.lines,
            name
                .. " connections="
                .. tostring(
                    #connections
                )
        )

        result.count =
            result.count
            + #connections

        for index, connection in ipairs(
            connections
        ) do
            if index > 12 then
                table.insert(
                    result.lines,
                    "  ... "
                        .. tostring(
                            #connections - 12
                        )
                        .. " more"
                )

                break
            end

            local fn = nil

            pcall(function()
                fn =
                    connection.Function
            end)

            table.insert(
                result.lines,
                "  ["
                    .. tostring(index)
                    .. "] "
                    .. F.getCellFunctionDebugName(
                        fn
                    )
                    .. " | "
                    .. F.getCellFunctionDebugSource(
                        fn
                    )
            )
        end
    end

    addSignal(
        "UserInputService.InputBegan",
        UserInputService.InputBegan
    )

    addSignal(
        "UserInputService.InputEnded",
        UserInputService.InputEnded
    )

    local playerGui =
        LocalPlayer:FindFirstChildOfClass(
            "PlayerGui"
        )

    local promptGui =
        playerGui
        and playerGui:FindFirstChild(
            "InteractPromptBillboard_NPC"
        )

    if promptGui then
        for _, object in ipairs(
            promptGui:GetDescendants()
        ) do
            if object:IsA("GuiObject") then
                addSignal(
                    object:GetFullName()
                        .. ".InputBegan",
                    object.InputBegan
                )
            end

            if object:IsA("GuiButton") then
                addSignal(
                    object:GetFullName()
                        .. ".Activated",
                    object.Activated
                )

                addSignal(
                    object:GetFullName()
                        .. ".MouseButton1Click",
                    object.MouseButton1Click
                )
            end
        end
    end

    pcall(function()
        local actions =
            game:GetService(
                "ContextActionService"
            ):GetAllBoundActionInfo()

        for actionName, info in pairs(actions) do
            local inputText =
                tostring(
                    info
                    and info.inputTypes
                    or ""
                )

            if string.find(
                string.upper(inputText),
                "KEYCODE.E",
                1,
                true
            )
            then
                table.insert(
                    result.lines,
                    "ContextAction E: "
                        .. tostring(actionName)
                        .. " | "
                        .. inputText
                )
            end
        end
    end)

    return result
end

function F.buildCradleRecorderReport(recorder, result, detail)
    local lines = {}

    table.insert(lines, "============================================================")
    table.insert(lines, "THE VEIL HUB - CRADLE MANUAL-E INTERACTION RECORDER")
    table.insert(lines, "Version: " .. tostring(Config.HUB_VERSION))
    table.insert(lines, "Result: " .. tostring(result or "UNKNOWN"))
    table.insert(lines, "Detail: " .. tostring(detail or "None"))

    table.insert(
        lines,
        "Prompt visible: "
            .. tostring(
                State.cellFarm.cradleInteractPromptVisible
                == true
            )
            .. " | "
            .. tostring(
                State.cellFarm.cradleInteractPromptText
                or "None"
            )
    )

    table.insert(
        lines,
        "Manual E count: "
            .. tostring(
                recorder
                and recorder.manualECount
                or 0
            )
            .. " | first E at "
            .. tostring(
                recorder
                and recorder.manualEAt
                or -1
            )
            .. "s"
    )

    table.insert(
        lines,
        "Dialog exact flags: ui="
            .. tostring(State.cellFarm.dialogUiConfirmed == true)
            .. " title="
            .. tostring(State.cellFarm.dialogTitleConfirmed == true)
            .. " body="
            .. tostring(State.cellFarm.dialogBodyConfirmed == true)
            .. " options="
            .. tostring(State.cellFarm.dialogOptionsConfirmed == true)
            .. " release="
            .. tostring(State.cellFarm.dialogReleaseVisible == true)
    )

    table.insert(
        lines,
        "DialogEvent OnClientEvent RX: "
            .. tostring(State.cellFarm.dialogClientEvents or 0)
            .. " | "
            .. tostring(State.cellFarm.dialogLastClientEvent or "None")
    )

    table.insert(lines, "------------------------------------------------------------")
    table.insert(lines, "CONNECTION SNAPSHOT")

    if recorder
        and recorder.connections
    then
        for _, line in ipairs(
            recorder.connections.lines
            or {}
        ) do
            table.insert(lines, line)
        end
    end

    table.insert(lines, "------------------------------------------------------------")
    table.insert(lines, "TRY START NPC INTERACTION CANDIDATE")

    table.insert(
        lines,
        "Candidate: "
            .. tostring(
                recorder
                and recorder.candidateDetail
                or "None"
            )
            .. " | score="
            .. tostring(
                recorder
                and recorder.candidateScore
                or -1
            )
    )

    if recorder
        and recorder.beforeSnapshot
    then
        for _, line in ipairs(
            recorder.beforeSnapshot.lines
            or {}
        ) do
            table.insert(lines, line)
        end
    end

    if recorder
        and recorder.afterSnapshot
    then
        for _, line in ipairs(
            recorder.afterSnapshot.lines
            or {}
        ) do
            table.insert(lines, line)
        end
    end

    if recorder
        and recorder.beforeSnapshot
        and recorder.afterSnapshot
    then
        table.insert(lines, "UPVALUE CHANGES:")

        local keys = {}

        for key in pairs(
            recorder.beforeSnapshot.upvalues
            or {}
        ) do
            keys[key] = true
        end

        for key in pairs(
            recorder.afterSnapshot.upvalues
            or {}
        ) do
            keys[key] = true
        end

        local ordered = {}

        for key in pairs(keys) do
            table.insert(ordered, key)
        end

        table.sort(ordered)

        local changed = 0

        for _, key in ipairs(ordered) do
            local before =
                recorder.beforeSnapshot.upvalues[key]

            local after =
                recorder.afterSnapshot.upvalues[key]

            if before ~= after then
                changed = changed + 1

                table.insert(
                    lines,
                    "  ["
                        .. key
                        .. "] "
                        .. tostring(before)
                        .. " -> "
                        .. tostring(after)
                )
            end
        end

        if changed == 0 then
            table.insert(
                lines,
                "  (no textual upvalue changes captured)"
            )
        end
    end

    table.insert(lines, "------------------------------------------------------------")
    table.insert(lines, "REMOTE NAMECALL TRACE")

    local traceState =
        globalEnv.__TheVeilHub_CradleTraceState

    local calls =
        traceState
        and traceState.Calls
        or {}

    if type(calls) == "table"
        and #calls > 0
    then
        for index, record in ipairs(calls) do
            table.insert(
                lines,
                string.format(
                    "%03d | +%.3fs | %s | %s | %s",
                    index,
                    tonumber(record.t) or -1,
                    tostring(record.method),
                    tostring(record.remote),
                    tostring(record.args)
                )
            )
        end
    else
        table.insert(
            lines,
            "(no RemoteEvent/RemoteFunction namecalls captured)"
        )
    end

    table.insert(lines, "============================================================")

    return table.concat(lines, "\n")
end

function F.beginCradleInteractionRecorder(token, npcCradle)
    if not F.isCellFarmActive(token) then
        return nil
    end

    local traceState =
        globalEnv.__TheVeilHub_CradleTraceState

    traceState.Enabled = false
    traceState.Armed = false
    traceState.StartedAt = os.clock()
    traceState.Calls = {}
    traceState.ManualECount = 0
    traceState.ManualEAt = -1
    traceState.LastRemote = "None"
    traceState.MaxCalls =
        Config.CELL_CRADLE_RECORDER_MAX_REMOTE_CALLS

    local traceSupported =
        F.installCradleTraceHook()

    local candidateFn,
        candidateDetail,
        candidateScore =
            F.findTryStartNPCInteraction(
                npcCradle
            )

    local recorder = {
        traceSupported = traceSupported,
        candidateFn = candidateFn,
        candidateDetail = candidateDetail,
        candidateScore = candidateScore,
        connections =
            F.captureCradleConnectionSummary(),
        beforeSnapshot =
            F.captureCradleFunctionSnapshot(
                candidateFn,
                "BEFORE MANUAL E"
            ),
        inputConnection = nil,
        manualECount = 0,
        manualEAt = -1,
    }

    State.cellFarm.cradleRecorderCandidateScore =
        tonumber(candidateScore)
        or -1

    State.cellFarm.cradleRecorderCandidate =
        tostring(candidateDetail or "None")

    State.cellFarm.cradleRecorderConnectionCount =
        tonumber(
            recorder.connections
            and recorder.connections.count
        )
        or 0

    State.cellFarm.cradleRecorderRemoteCalls = 0
    State.cellFarm.cradleRecorderLastRemote = "None"

    State.cellFarm.cradleRecorderStatus =
        traceSupported
        and "TRACE READY"
        or "TRACE PARTIAL (namecall hook unavailable)"

    recorder.inputConnection =
        UserInputService.InputBegan:Connect(
            function(input, gameProcessed)
                if not F.isCellFarmActive(token)
                    or not traceState.Enabled
                    or not traceState.Armed
                then
                    return
                end

                if input.KeyCode
                    == Enum.KeyCode.E
                then
                    recorder.manualECount =
                        recorder.manualECount + 1

                    traceState.ManualECount =
                        recorder.manualECount

                    if recorder.manualEAt < 0 then
                        recorder.manualEAt =
                            os.clock()
                            - traceState.StartedAt

                        traceState.ManualEAt =
                            recorder.manualEAt
                    end

                    State.cellFarm.cradleRecorderManualE =
                        recorder.manualECount

                    State.cellFarm.cradleRecorderStatus =
                        "MANUAL E CAPTURED"
                            .. (
                                gameProcessed
                                and " (gameProcessed)"
                                or ""
                            )

                    if F.updateCellFarmUI then
                        F.updateCellFarmUI()
                    end
                end
            end
        )

    traceState.Enabled = true

    return recorder
end

function F.finishCradleInteractionRecorder(
    recorder,
    result,
    detail
)
    local traceState =
        globalEnv.__TheVeilHub_CradleTraceState

    if traceState then
        traceState.Enabled = false
        traceState.Armed = false
    end

    if recorder
        and recorder.inputConnection
    then
        pcall(function()
            recorder.inputConnection:Disconnect()
        end)

        recorder.inputConnection = nil
    end

    if recorder then
        recorder.afterSnapshot =
            F.captureCradleFunctionSnapshot(
                recorder.candidateFn,
                "AFTER MANUAL E"
            )
    end

    local report =
        F.buildCradleRecorderReport(
            recorder,
            result,
            detail
        )

    globalEnv.__TheVeilHub_LastCradleReport =
        report

    local reportPath =
        "Console only"

    if type(writefile) == "function" then
        local ok =
            pcall(
                writefile,
                Config.CELL_CRADLE_RECORDER_REPORT_FILE,
                report
            )

        if ok then
            reportPath =
                Config.CELL_CRADLE_RECORDER_REPORT_FILE
        end
    end

    State.cellFarm.cradleRecorderReportPath =
        reportPath

    State.cellFarm.cradleRecorderResult =
        tostring(result or "UNKNOWN")

    State.cellFarm.cradleRecorderStatus =
        "COMPLETE: "
        .. tostring(result or "UNKNOWN")

    State.cellFarm.cradleRecorderRemoteCalls =
        traceState
        and type(traceState.Calls) == "table"
        and #traceState.Calls
        or 0

    State.cellFarm.cradleRecorderLastRemote =
        traceState
        and tostring(
            traceState.LastRemote
            or "None"
        )
        or "None"

    print(report)

    if F.updateCellFarmUI then
        F.updateCellFarmUI()
    end

    return report
end

function F.runCradleManualERecorderCheckpoint(
    token,
    npcCradle
)
    local recorder =
        F.beginCradleInteractionRecorder(
            token,
            npcCradle
        )

    if not recorder then
        return false, "Recorder could not start"
    end

    State.cellFarm.cradleRecorderStatus =
        "WAITING FOR INTERACT (E) PROMPT"

    F.setCellFarmStage(
        "RECORDER: WAIT PROMPT",
        "Read-only recorder active. Waiting for The Cradle Interact (E) prompt."
    )

    local promptReady,
        promptText =
            F.waitForCellCradleInteractPrompt(
                token,
                Config.CELL_CRADLE_PROMPT_WAIT
            )

    State.cellFarm.cradleInteractPromptVisible =
        promptReady == true

    State.cellFarm.cradleInteractPromptText =
        promptText
        or "None"

    if not F.isCellFarmActive(token) then
        F.finishCradleInteractionRecorder(
            recorder,
            "STOPPED",
            "Farm stopped before manual E"
        )

        return false, "Stopped"
    end

    if not promptReady then
        F.finishCradleInteractionRecorder(
            recorder,
            "PROMPT_NOT_CONFIRMED",
            tostring(promptText)
        )

        F.setCellFarmStage(
            "RECORDER HOLD",
            "Interact (E) prompt was not confirmed. Report captured; no automatic interaction was sent."
        )

        while F.isCellFarmActive(token)
            and Config.CELL_CRADLE_RECORDER_ONLY
        do
            task.wait(0.20)
        end

        return false, "Prompt not confirmed"
    end

    local traceState =
        globalEnv.__TheVeilHub_CradleTraceState

    traceState.Armed = true

    State.cellFarm.cradleRecorderArmed =
        true

    State.cellFarm.cradleRecorderStatus =
        "ARMED - PRESS E MANUALLY ONCE"

    State.cellFarm.npcInteractionMethod =
        "Manual E Recorder"

    State.cellFarm.npcInteractionSource =
        "UserInputService + namecall/getconnections/getgc trace"

    F.setCellFarmStage(
        "RECORDER ARMED",
        "Interact (E) is ready. PRESS E MANUALLY ONCE. Auto start/Release are disabled."
    )

    F.notify(
        "Cradle Recorder",
        "Interact (E) ready. Press E manually once. Recorder will stop when the exact dialog appears.",
        "info",
        5.0
    )

    local armedAt =
        os.clock()

    local firstEAt = nil
    local result = "TIMEOUT"
    local detail = "No exact Cradle dialogue detected"

    while F.isCellFarmActive(token) do
        local visible,
            releaseVisible,
            _releaseButton,
            evidenceDetail =
                F.getCellCradleDialogueEvidence()

        State.cellFarm.dialogUiConfirmed =
            visible == true

        State.cellFarm.dialogReleaseVisible =
            releaseVisible == true

        local exactDialog =
            visible
            and releaseVisible
            and State.cellFarm.dialogTitleConfirmed
            and State.cellFarm.dialogBodyConfirmed
            and State.cellFarm.dialogOptionsConfirmed

        if exactDialog then
            result = "PASS_EXACT_DIALOG"

            detail =
                tostring(
                    evidenceDetail
                    or "Exact Cradle dialog confirmed"
                )

            State.cellFarm.dialogCheckpointConfirmed =
                true

            break
        end

        if recorder.manualECount > 0
            and not firstEAt
        then
            firstEAt = os.clock()
        end

        if firstEAt
            and os.clock() - firstEAt
                >= Config.CELL_CRADLE_RECORDER_POST_E_WAIT
        then
            result =
                "E_CAPTURED_NO_EXACT_DIALOG"

            detail =
                tostring(
                    evidenceDetail
                    or "Manual E captured but exact dialog did not appear"
                )

            break
        end

        if os.clock() - armedAt
            >= Config.CELL_CRADLE_RECORDER_MANUAL_WAIT
        then
            result =
                recorder.manualECount > 0
                and "E_CAPTURED_TIMEOUT"
                or "NO_MANUAL_E_TIMEOUT"

            detail =
                tostring(
                    evidenceDetail
                    or "Recorder manual-E window expired"
                )

            break
        end

        State.cellFarm.cradleRecorderRemoteCalls =
            traceState
            and type(traceState.Calls) == "table"
            and #traceState.Calls
            or 0

        State.cellFarm.cradleRecorderLastRemote =
            traceState
            and tostring(
                traceState.LastRemote
                or "None"
            )
            or "None"

        task.wait(
            Config.CELL_CRADLE_RECORDER_POLL
        )
    end

    State.cellFarm.cradleRecorderArmed =
        false

    F.finishCradleInteractionRecorder(
        recorder,
        result,
        detail
    )

    State.cellFarm.dialogCheckpointHolding =
        true

    if result == "PASS_EXACT_DIALOG" then
        F.setCellFarmStage(
            "RECORDER PASS - HOLD",
            "Exact Cradle dialog confirmed from MANUAL E. Report saved. Release/boss remain disabled."
        )
    else
        F.setCellFarmStage(
            "RECORDER RESULT - HOLD",
            tostring(result)
                .. " | report saved; no automatic interaction will run."
        )
    end

    while F.isCellFarmActive(token)
        and Config.CELL_CRADLE_RECORDER_ONLY
    do
        task.wait(0.20)
    end

    State.cellFarm.dialogCheckpointHolding =
        false

    return
        result == "PASS_EXACT_DIALOG",
        detail
end

function F.getCellCradleInteractPromptEvidence()
    local playerGui =
        LocalPlayer:FindFirstChildOfClass(
            "PlayerGui"
        )

    if not playerGui then
        return false, "PlayerGui missing"
    end

    local promptGui =
        playerGui:FindFirstChild(
            "InteractPromptBillboard_NPC"
        )

    if not promptGui then
        return false, "InteractPromptBillboard_NPC missing"
    end

    local texts = {}

    for _, object in ipairs(
        promptGui:GetDescendants()
    ) do
        if (
            object:IsA("TextLabel")
            or object:IsA("TextButton")
            or object:IsA("TextBox")
        )
            and F.isGuiObjectActuallyVisible(
                object
            )
        then
            local text =
                F.trimText(
                    object.Text
                )

            if text ~= "" then
                table.insert(
                    texts,
                    text
                )
            end
        end
    end

    local combined =
        table.concat(
            texts,
            " "
        )

    if combined == "" then
        return false, "Interact prompt GUI has no visible text"
    end

    local lowered =
        string.lower(
            combined
        )

    local interactVisible =
        string.find(
            lowered,
            "interact",
            1,
            true
        ) ~= nil

    local eVisible =
        string.find(
            lowered,
            "(e)",
            1,
            true
        ) ~= nil
        or string.find(
            lowered,
            "[e]",
            1,
            true
        ) ~= nil
        or string.find(
            lowered,
            " e",
            1,
            true
        ) ~= nil

    if interactVisible
        and eVisible
    then
        return true, combined
    end

    return false, combined
end


function F.waitForCellCradleInteractPrompt(token, timeout)
    local deadline =
        os.clock()
        + math.max(
            0.5,
            tonumber(timeout)
                or Config.CELL_CRADLE_PROMPT_WAIT
        )

    local stableSince = nil
    local lastNudge =
        os.clock()

    local lastText =
        "Waiting for Interact (E)"

    while F.isCellFarmActive(token)
        and os.clock() < deadline
    do
        local visible,
            text =
                F.getCellCradleInteractPromptEvidence()

        lastText =
            text
            or lastText

        State.cellFarm.cradleInteractPromptVisible =
            visible == true

        State.cellFarm.cradleInteractPromptText =
            lastText

        if visible then
            stableSince =
                stableSince
                or os.clock()

            if os.clock() - stableSince
                >= Config.CELL_CRADLE_PROMPT_STABLE
            then
                State.cellFarm.status =
                    "CONFIRMED Interact (E) prompt stable - Cradle is ready"

                if F.updateCellFarmUI then
                    F.updateCellFarmUI()
                end

                return true, lastText
            end
        else
            stableSince = nil
        end

        -- A very small ordinary movement pulse can help the game's NPC
        -- proximity/input controller refresh its prompt. It is only used
        -- while waiting for the prompt, never after the prompt is confirmed.
        if os.clock() - lastNudge
            >= Config.CELL_CRADLE_PROMPT_NUDGE_INTERVAL
        then
            lastNudge =
                os.clock()

            F.pressVirtualKey(
                Enum.KeyCode.W,
                0x57,
                Config.CELL_CRADLE_PROMPT_NUDGE_HOLD,
                "Cradle prompt readiness nudge"
            )

            F.stopCellCradleTravelInput()
        end

        task.wait(
            Config.CELL_CRADLE_PROMPT_RECHECK
        )
    end

    State.cellFarm.cradleInteractPromptVisible =
        false

    State.cellFarm.status =
        "Interact (E) prompt not confirmed before timeout"

    if F.updateCellFarmUI then
        F.updateCellFarmUI()
    end

    return false, lastText
end

function F.getCellCradleDialogueEvidence()
    local playerGui =
        LocalPlayer:FindFirstChildOfClass(
            "PlayerGui"
        )

    if not playerGui then
        return false, false, nil, "PlayerGui missing"
    end

    local dialogueGui =
        playerGui:FindFirstChild(
            "DialogueGui"
        )

    if not dialogueGui then
        return false, false, nil, "DialogueGui missing"
    end

    if dialogueGui:IsA("ScreenGui")
        and not dialogueGui.Enabled
    then
        return false, false, nil, "DialogueGui disabled"
    end

    local mainFrame =
        dialogueGui:FindFirstChild(
            "MainFrame"
        )

    if mainFrame
        and mainFrame:IsA("GuiObject")
        and not F.isGuiObjectActuallyVisible(
            mainFrame
        )
    then
        return false, false, nil, "Dialogue MainFrame hidden"
    end

    local visibleTexts = {}
    local releaseButton = nil

    local function findButtonAncestor(object)
        local current = object

        for _ = 1, 7 do
            if not current
                or current == dialogueGui
            then
                break
            end

            if current:IsA("GuiButton") then
                return current
            end

            current = current.Parent
        end

        return nil
    end

    for _, object in ipairs(
        dialogueGui:GetDescendants()
    ) do
        if (
            object:IsA("TextLabel")
            or object:IsA("TextButton")
        )
            and F.isGuiObjectActuallyVisible(
                object
            )
        then
            local rawText =
                F.trimText(
                    object.Text
                )

            if rawText ~= "" then
                table.insert(
                    visibleTexts,
                    rawText
                )

                local lower =
                    string.lower(
                        rawText
                    )

                if string.find(
                    lower,
                    "release",
                    1,
                    true
                ) then
                    releaseButton =
                        releaseButton
                        or findButtonAncestor(
                            object
                        )
                end
            end
        end
    end

    local combined =
        string.lower(
            table.concat(
                visibleTexts,
                "\n"
            )
        )

    local titleConfirmed =
        string.find(
            combined,
            "the cradle",
            1,
            true
        ) ~= nil

    local bodyConfirmed =
        (
            string.find(
                combined,
                "ancient obsidian crystal",
                1,
                true
            ) ~= nil
            and string.find(
                combined,
                "primordial energy",
                1,
                true
            ) ~= nil
        )
        or (
            string.find(
                combined,
                "release it from its cage",
                1,
                true
            ) ~= nil
        )

    local releaseConfirmed =
        string.find(
            combined,
            "release",
            1,
            true
        ) ~= nil

    local goBackConfirmed =
        string.find(
            combined,
            "go back up",
            1,
            true
        ) ~= nil

    local endConfirmed =
        string.find(
            combined,
            "end dialogue",
            1,
            true
        ) ~= nil

    local optionsConfirmed =
        releaseConfirmed
        and goBackConfirmed
        and endConfirmed

    local exactPanelConfirmed =
        titleConfirmed
        and bodyConfirmed
        and optionsConfirmed

    State.cellFarm.dialogTitleConfirmed =
        titleConfirmed

    State.cellFarm.dialogBodyConfirmed =
        bodyConfirmed

    State.cellFarm.dialogOptionsConfirmed =
        optionsConfirmed

    if exactPanelConfirmed then
        return
            true,
            true,
            releaseButton,
            "EXACT Cradle dialog confirmed: title + body + Release/Go Back Up/End Dialogue"
    end

    if titleConfirmed
        or releaseConfirmed
        or #visibleTexts > 0
    then
        return
            true,
            releaseConfirmed,
            releaseButton,
            "Dialogue visible but exact Cradle panel incomplete"
                .. " | title="
                .. tostring(titleConfirmed)
                .. " body="
                .. tostring(bodyConfirmed)
                .. " options="
                .. tostring(optionsConfirmed)
    end

    return
        false,
        false,
        nil,
        "DialogueGui exists but no visible Cradle dialogue text"
end

function F.isCellCradleDialogueVisible()
    local visible =
        F.getCellCradleDialogueEvidence()

    return visible == true
end

function F.findCellCradleReleaseButton()
    local _,
        releaseVisible,
        releaseButton =
            F.getCellCradleDialogueEvidence()

    if releaseVisible then
        return releaseButton
    end

    return nil
end

function F.waitForCellCradleDialogue(
    token,
    timeout,
    requireRelease
)
    local deadline =
        os.clock()
        + math.max(
            0.1,
            tonumber(timeout)
                or Config.CELL_CRADLE_DIALOG_VISIBLE_WAIT
        )

    local lastDetail =
        "Waiting"

    while F.isCellFarmActive(token)
        and os.clock() < deadline
    do
        local visible,
            releaseVisible,
            releaseButton,
            detail =
                F.getCellCradleDialogueEvidence()

        lastDetail =
            detail
            or lastDetail

        if visible
            and (
                requireRelease ~= true
                or releaseVisible
            )
        then
            return
                true,
                releaseVisible,
                releaseButton,
                lastDetail
        end

        task.wait(0.05)
    end

    return
        false,
        false,
        nil,
        lastDetail
end

function F.describeCellEventArgs(...)
    local args = {...}
    local parts = {}

    for index = 1,
        math.min(
            #args,
            5
        )
    do
        local value =
            args[index]

        local description = nil

        if typeof(value) == "Instance" then
            description =
                value.ClassName
                .. ":"
                .. value:GetFullName()
        else
            description =
                tostring(value)
        end

        if #description > 80 then
            description =
                string.sub(
                    description,
                    1,
                    77
                )
                .. "..."
        end

        table.insert(
            parts,
            tostring(index)
                .. "="
                .. description
        )
    end

    return
        #parts > 0
        and table.concat(
            parts,
            " | "
        )
        or "(no args)"
end

function F.startCellDialogObserver(dialogRemote)
    if not dialogRemote
        or not dialogRemote:IsA("RemoteEvent")
    then
        return nil
    end

    local connection = nil

    local ok =
        pcall(function()
            connection =
                dialogRemote.OnClientEvent:Connect(
                    function(...)
                        State.cellFarm.dialogClientEvents =
                            (
                                State.cellFarm.dialogClientEvents
                                or 0
                            )
                            + 1

                        State.cellFarm.dialogLastClientEvent =
                            F.describeCellEventArgs(
                                ...
                            )

                        if F.updateCellFarmUI then
                            F.updateCellFarmUI()
                        end
                    end
                )
        end)

    if not ok then
        return nil
    end

    return connection
end

function F.findCellBossModelRaw()
    local monsters =
        F.findMonstersFolder
        and F.findMonstersFolder()
        or workspace:FindFirstChild(
            "Monsters"
        )

    if not monsters then
        return nil
    end

    local direct =
        monsters:FindFirstChild(
            "The Cell Of Life"
        )

    if direct
        and direct:IsA("Model")
    then
        return direct
    end

    for _, object in ipairs(
        monsters:GetChildren()
    ) do
        if object:IsA("Model")
            and tostring(
                object.Name
            ) == "The Cell Of Life"
        then
            return object
        end
    end

    return nil
end

function F.startCellBossSpawnWatcher(remotes)
    local watcher = {
        model = nil,
        source = "None",
        childConnection = nil,
        remoteConnection = nil,
    }

    local monsters =
        F.findMonstersFolder
        and F.findMonstersFolder()
        or workspace:FindFirstChild(
            "Monsters"
        )

    local existing =
        F.findCellBossModelRaw()

    if existing then
        watcher.model = existing
        watcher.source = "Existing model"
    end

    if monsters then
        pcall(function()
            watcher.childConnection =
                monsters.ChildAdded:Connect(
                    function(object)
                        if object:IsA("Model")
                            and tostring(
                                object.Name
                            ) == "The Cell Of Life"
                        then
                            watcher.model =
                                object

                            watcher.source =
                                "workspace.Monsters.ChildAdded"

                            State.cellFarm.bossSpawnConfirmed =
                                true

                            State.cellFarm.bossSpawnSource =
                                watcher.source

                            if F.updateCellFarmUI then
                                F.updateCellFarmUI()
                            end
                        end
                    end
                )
        end)
    end

    local bossSpawnRemote =
        remotes
        and remotes.BossSpawnLabel

    if bossSpawnRemote
        and bossSpawnRemote:IsA(
            "RemoteEvent"
        )
    then
        pcall(function()
            watcher.remoteConnection =
                bossSpawnRemote.OnClientEvent:Connect(
                    function(...)
                        State.cellFarm.bossSpawnRemoteEvents =
                            (
                                State.cellFarm.bossSpawnRemoteEvents
                                or 0
                            )
                            + 1

                        State.cellFarm.bossLastSpawnEvent =
                            F.describeCellEventArgs(
                                ...
                            )

                        if F.updateCellFarmUI then
                            F.updateCellFarmUI()
                        end
                    end
                )
        end)
    end

    return watcher
end

function F.stopCellBossSpawnWatcher(watcher)
    if not watcher then
        return
    end

    for _, key in ipairs({
        "childConnection",
        "remoteConnection",
    }) do
        local connection =
            watcher[key]

        if connection then
            pcall(function()
                connection:Disconnect()
            end)

            watcher[key] = nil
        end
    end
end

function F.waitForCellBossConfirmed(
    token,
    watcher,
    timeout
)
    local deadline =
        os.clock()
        + math.max(
            1,
            tonumber(timeout)
                or Config.CELL_CRADLE_BOSS_MODEL_WAIT
        )

    local rawModel = nil

    while F.isCellFarmActive(token)
        and os.clock() < deadline
    do
        rawModel =
            (
                watcher
                and watcher.model
            )
            or F.findCellBossModelRaw()

        if rawModel
            and rawModel.Parent
        then
            if State.cellFarm.bossSpawnSource
                == "None"
            then
                State.cellFarm.bossSpawnSource =
                    watcher
                    and watcher.source
                    or "Polling"
            end

            State.cellFarm.bossSpawnConfirmed =
                true

            break
        end

        task.wait(0.05)
    end

    if not rawModel
        or not rawModel.Parent
    then
        return nil
    end

    F.setCellFarmStage(
        "BOSS MODEL CONFIRMED",
        "The Cell Of Life model exists; waiting for alive state"
    )

    local aliveDeadline =
        os.clock()
        + Config.CELL_CRADLE_BOSS_ALIVE_WAIT

    while F.isCellFarmActive(token)
        and os.clock() < aliveDeadline
    do
        local boss =
            F.getCellBoss()

        if boss then
            local hp,
                maxHp =
                    F.getCellBossHealth(
                        boss
                    )

            if maxHp > 0
                and hp > 0
            then
                State.cellFarm.bossSpawnConfirmed =
                    true

                State.cellFarm.bossSpawnSource =
                    (
                        State.cellFarm.bossSpawnSource
                        ~= "None"
                    )
                    and State.cellFarm.bossSpawnSource
                    or "Alive polling"

                State.cellFarm.status =
                    "Boss confirmed alive: "
                    .. string.format(
                        "%.0f / %.0f HP",
                        hp,
                        maxHp
                    )

                if F.updateCellFarmUI then
                    F.updateCellFarmUI()
                end

                return boss
            end
        end

        task.wait(0.08)
    end

    return nil
end

function F.waitForCellBossSpawn(token, timeout)
    local watcher =
        F.startCellBossSpawnWatcher(
            F.getCellRemotes()
        )

    local boss =
        F.waitForCellBossConfirmed(
            token,
            watcher,
            timeout
        )

    F.stopCellBossSpawnWatcher(
        watcher
    )

    return boss
end


function F.getCellCradleDialogTargets()
    local npcCradle = nil
    local worldCradle = nil

    local npcs =
        workspace:FindFirstChild(
            "NPCs"
        )

    if npcs then
        npcCradle =
            npcs:FindFirstChild(
                "The Cradle"
            )
    end

    local systems =
        workspace:FindFirstChild(
            "Systems"
        )

    local junk =
        systems
        and systems:FindFirstChild(
            "CellOfLifeJunk"
        )

    if junk then
        worldCradle =
            junk:FindFirstChild(
                "The Cradle"
            )
    end

    return npcCradle, worldCradle
end

function F.waitForCellCradleDialogTargets(token, timeout)
    local deadline =
        os.clock()
        + math.max(
            0.25,
            tonumber(timeout)
                or Config.CELL_CRADLE_TARGET_WAIT
        )

    repeat
        if not F.isCellFarmActive(token) then
            return nil, nil
        end

        local npcCradle,
            worldCradle =
                F.getCellCradleDialogTargets()

        if npcCradle
            and npcCradle.Parent
            and worldCradle
            and worldCradle.Parent
        then
            return npcCradle, worldCradle
        end

        F.requestCellCradleStreaming()
        task.wait(0.10)
    until os.clock() >= deadline

    return F.getCellCradleDialogTargets()
end

function F.refineCellCradleDialogPosition(token, npcCradle, worldCradle)
    if not F.isCellFarmActive(token) then
        return false
    end

    local root =
        F.getCharacterRoot()

    if not root then
        return false
    end

    -- The captured NPCInputHandler function explicitly contains:
    -- NPCs -> DialogPart -> Position -> Magnitude.
    -- Therefore the authoritative interaction-distance target is the NPC's
    -- DialogPart, not the CellOfLifeJunk copy used by the option remote.
    local dialogPart =
        npcCradle
        and npcCradle.Parent
        and npcCradle:FindFirstChild(
            "DialogPart",
            true
        )

    if not dialogPart
        or not dialogPart:IsA("BasePart")
    then
        dialogPart =
            F.getCellCradlePart(
                npcCradle
            )
    end

    if not dialogPart
        or not dialogPart.Parent
    then
        State.cellFarm.cradleDialogPartDistance =
            -1

        State.cellFarm.cradleDialogPartPath =
            "DialogPart unavailable"

        F.recordCellFailure(
            'NPC Cradle DialogPart is unavailable'
        )

        return false
    end

    State.cellFarm.cradleDialogPartPath =
        dialogPart:GetFullName()

    local function readDistance()
        local currentRoot =
            F.getCharacterRoot()

        if not currentRoot
            or not dialogPart
            or not dialogPart.Parent
        then
            return math.huge
        end

        local distance =
            (
                currentRoot.Position
                - dialogPart.Position
            ).Magnitude

        State.cellFarm.cradleDialogPartDistance =
            distance

        State.cellFarm.status =
            "NPC DialogPart distance: "
            .. string.format(
                "%.2f",
                distance
            )
            .. " studs"

        if F.updateCellFarmUI then
            F.updateCellFarmUI()
        end

        return distance
    end

    local distance =
        readDistance()

    if distance
        <= Config.CELL_CRADLE_DIALOGPART_REQUIRED_DISTANCE
    then
        return true
    end

    F.setCellFarmStage(
        "CRADLE CLOSE RANGE",
        "Moving directly to NPC DialogPart"
    )

    for attempt = 1,
        Config.CELL_CRADLE_DIALOGPART_POSITION_RETRIES
    do
        if not F.isCellFarmActive(token) then
            return false
        end

        if not dialogPart
            or not dialogPart.Parent
        then
            return false
        end

        local currentRoot =
            F.getCharacterRoot()

        if not currentRoot then
            return false
        end

        -- Approach from whichever horizontal side we are already on. This is
        -- more robust than assuming the DialogPart's LookVector faces the
        -- player. The final RootPart-to-DialogPart distance is ~1.25 studs.
        local offset =
            currentRoot.Position
            - dialogPart.Position

        local horizontal =
            Vector3.new(
                offset.X,
                0,
                offset.Z
            )

        local direction = nil

        if horizontal.Magnitude > 0.05 then
            direction =
                horizontal.Unit
        else
            direction =
                -dialogPart.CFrame.LookVector
        end

        local targetPosition =
            dialogPart.Position
            + direction
                * Config.CELL_CRADLE_DIALOGPART_TARGET_DISTANCE

        local target =
            CFrame.lookAt(
                targetPosition,
                dialogPart.Position
            )

        local reached =
            F.flyCellToCFrameWithWASD(
                token,
                target,
                Config.CELL_CRADLE_DIALOGPART_ARRIVAL_DISTANCE,
                20
            )

        F.stopCellCradleTravelInput()

        if not reached then
            State.cellFarm.status =
                "Close-range flight did not report arrival"
        end

        -- Give the root position one frame to settle before measuring the
        -- exact Magnitude that NPCInputHandler is expected to care about.
        task.wait(0.12)

        distance =
            readDistance()

        if distance
            <= Config.CELL_CRADLE_DIALOGPART_REQUIRED_DISTANCE
        then
            State.cellFarm.status =
                "CONFIRMED close to NPC DialogPart: "
                .. string.format(
                    "%.2f",
                    distance
                )
                .. " studs"

            if F.updateCellFarmUI then
                F.updateCellFarmUI()
            end

            return true
        end
    end

    F.recordCellFailure(
        "Could not get close enough to NPC Cradle DialogPart; distance="
            .. string.format(
                "%.2f",
                distance < math.huge
                and distance
                or -1
            )
    )

    return false
end

function F.settleCellAtCradle(token)
    if not F.isCellFarmActive(token) then
        return false
    end

    F.stopCellCradleTravelInput()

    F.setCellFarmStage(
        "CRADLE SETTLE",
        "WASD stopped; standing still at The Cradle for 2 seconds"
    )

    -- Release every movement owner before the dialogue sequence.
    F.stopMovementFlight(
        "CELL"
    )

    if F.stopLootFlight then
        F.stopLootFlight(
            "CELL"
        )
    end

    F.stopMovementFlight(
        "MONSTER_LOCK"
    )

    F.releaseMovement(
        "CELL"
    )

    F.releaseMovement(
        "MONSTER_LOCK"
    )

    local deadline =
        os.clock()
        + Config.CELL_CRADLE_STILL_BEFORE_START

    -- Hold the character still for the entire settle period. A one-shot
    -- velocity clear was not enough in the live game because residual
    -- Humanoid/controller movement can immediately resume.
    while F.isCellFarmActive(token)
        and os.clock() < deadline
    do
        local root =
            F.getCharacterRoot()

        if root then
            pcall(function()
                root.AssemblyLinearVelocity =
                    Vector3.zero

                root.AssemblyAngularVelocity =
                    Vector3.zero
            end)
        end

        local humanoid =
            F.getHumanoid()

        if humanoid then
            pcall(function()
                humanoid:Move(
                    Vector3.zero,
                    false
                )
            end)
        end

        task.wait(0.05)
    end

    if not F.isCellFarmActive(token) then
        return false
    end

    -- Small final quiet frame before firing DialogEvent("start").
    task.wait(0.10)

    return true
end



