function F.getGuiConnectionSource(fn)
    if type(fn) ~= "function" then
        return ""
    end

    local source = ""

    pcall(function()
        if debug and type(debug.info) == "function" then
            source =
                tostring(
                    debug.info(
                        fn,
                        "s"
                    )
                    or ""
                )
        elseif debug
            and type(debug.getinfo) == "function"
        then
            local info =
                debug.getinfo(
                    fn
                )

            source =
                tostring(
                    info
                    and (
                        info.source
                        or info.short_src
                    )
                    or ""
                )
        end
    end)

    return source
end

function F.fireExactGuiConnection(button, signalName, sourceNeedle)
    if not button
        or not button.Parent
        or type(getconnections) ~= "function"
    then
        return false, "getconnections unavailable"
    end

    local signal =
        button[signalName]

    if not signal then
        return false, "signal unavailable"
    end

    local ok, connections =
        pcall(
            getconnections,
            signal
        )

    if not ok
        or type(connections) ~= "table"
    then
        return false, "connection scan failed"
    end

    local wanted =
        string.lower(
            tostring(
                sourceNeedle
                or ""
            )
        )

    local fallback = nil
    local fallbackSource = ""

    for _, connection in ipairs(connections) do
        local fn = nil

        pcall(function()
            fn = connection.Function
        end)

        local source =
            F.getGuiConnectionSource(
                fn
            )

        local lowered =
            string.lower(source)

        if source ~= ""
            and not string.find(
                lowered,
                "hoverhandler",
                1,
                true
            )
            and string.sub(
                source,
                1,
                1
            ) ~= ":"
        then
            fallback =
                fallback
                or connection
            fallbackSource =
                fallbackSource ~= ""
                and fallbackSource
                or source
        end

        if wanted ~= ""
            and source ~= ""
            and string.find(
                lowered,
                wanted,
                1,
                true
            )
        then
            local fired = false

            if type(fn) == "function" then
                local okCall =
                    pcall(
                        fn
                    )

                fired = okCall
            end

            if not fired then
                pcall(function()
                    if type(connection.Fire) == "function" then
                        connection:Fire()
                        fired = true
                    end
                end)
            end

            if fired then
                State.cellFarm.menuCallbackAttempts =
                    (State.cellFarm.menuCallbackAttempts or 0)
                    + 1

                State.cellFarm.menuLastCallback =
                    signalName
                    .. " -> "
                    .. source

                State.movementTelemetry.lastAction =
                    "Menu callback: "
                    .. State.cellFarm.menuLastCallback

                return true, source
            end
        end
    end

    if fallback then
        local fn = nil
        pcall(function()
            fn = fallback.Function
        end)

        local fired = false

        if type(fn) == "function" then
            local okCall =
                pcall(
                    fn
                )

            fired = okCall
        end

        if not fired then
            pcall(function()
                if type(fallback.Fire) == "function" then
                    fallback:Fire()
                    fired = true
                end
            end)
        end

        if fired then
            State.cellFarm.menuCallbackAttempts =
                (State.cellFarm.menuCallbackAttempts or 0)
                + 1

            State.cellFarm.menuLastCallback =
                signalName
                .. " -> fallback "
                .. tostring(fallbackSource)

            return true, fallbackSource
        end
    end

    return false, "matching game callback not found"
end

