function F.saveFarmConfig(force)
    if not force
        and not State.configDirty
    then
        return true
    end

    if type(writefile) ~= "function" then
        return false, "writefile unsupported"
    end

    local success, encoded =
        pcall(function()
            return HttpService:JSONEncode(
                F.getConfigData()
            )
        end)

    if not success then
        return false
    end

    local wrote =
        pcall(function()
            writefile(
                Config.FARM_CONFIG_FILE,
                encoded
            )
        end)

    if wrote then
        State.configDirty = false
    end

    return wrote
end

function F.loadFarmConfig()
    if type(readfile) ~= "function" then
        State.configLoaded = true
        return false, "readfile unsupported"
    end

    local success, decoded =
        pcall(function()
            local raw =
                readfile(
                    Config.FARM_CONFIG_FILE
                )

            return HttpService:JSONDecode(
                raw
            )
        end)

    if not success
        or type(decoded) ~= "table"
    then
        State.configLoaded = true
        F.recordError("Config", "Config missing, corrupt, or unreadable; defaults loaded")
        return false
    end

    if tonumber(decoded.schemaVersion) and tonumber(decoded.schemaVersion) >= 4 then
        local farm = type(decoded.Farm) == "table" and decoded.Farm or {}
        local sell = type(decoded.Sell) == "table" and decoded.Sell or {}
        local combat = type(decoded.Combat) == "table" and decoded.Combat or {}
        local gacha = type(decoded.Gacha) == "table" and decoded.Gacha or {}
        local nightcall = type(decoded.Nightcall) == "table" and decoded.Nightcall or {}
        local serverHop = type(decoded.ServerHop) == "table" and decoded.ServerHop or {}
        local ui = type(decoded.UI) == "table" and decoded.UI or {}
        local movement = type(decoded.Movement) == "table" and decoded.Movement or {}
        local navigation = type(decoded.Navigation) == "table" and decoded.Navigation or {}
        local goal = type(decoded.Goal) == "table" and decoded.Goal or {}
        local cell = type(decoded.Cell) == "table" and decoded.Cell or {}
        local cellSession = type(decoded.CellSession) == "table" and decoded.CellSession or {}
        decoded.goalKind = goal.kind
        decoded.goalName = goal.name
        decoded.cellKeep = cell.keep
        decoded.cellWeapon = cell.weapon
        decoded.cellFightHeight = cell.fightHeight
        decoded.cellTravelSpeed = cell.travelSpeed
        decoded.cellSession = cellSession
        decoded.farmEnabled = farm.enabled
        decoded.farmContainsMode = farm.containsMode
        decoded.farmTargets = farm.targets
        decoded.farmRarities = farm.rarities
        decoded.farmAutoHopEnabled = farm.autoHop
        decoded.farmEmptyWait = farm.emptyWait
        decoded.farmStopAfterFirst = farm.stopAfterFirst
        decoded.farmStrategy = farm.strategy
        decoded.farmFlightSpeed = farm.flightSpeed
        decoded.sellEnabled = sell.enabled
        decoded.sellRarities = sell.rarities
        decoded.neverSell = sell.neverSell
        decoded.sellBeforeHop = sell.beforeHop
        decoded.monsterLockEnabled = combat.monsterLock
        decoded.monsterLockHeight = combat.height
        decoded.gachaEnabled = gacha.enabled
        decoded.nightCallEnabled = nightcall.enabled
        decoded.persistentHopEnabled = serverHop.persistent
        decoded.hubReloadUrl = serverHop.reloadUrl
        decoded.lowGraphicsEnabled = ui.lowGraphics
        decoded.movementPreset = movement.preset
        decoded.adaptiveMovementEnabled = movement.adaptive
        decoded.monsterFlightSpeed = movement.monsterSpeed
        decoded.merchantFlightSpeed = movement.merchantSpeed
        decoded.returnFlightSpeed = movement.returnSpeed
        decoded.cellMovementSpeed = movement.cellSpeed
        decoded.waypoints = navigation.waypoints
        decoded.route = navigation.route
        State.itemPriority = type(farm.itemPriority) == "table" and farm.itemPriority or {}
        State.monsterWhitelist = type(combat.whitelist) == "table" and combat.whitelist or {}
        State.monsterBlacklist = type(combat.blacklist) == "table" and combat.blacklist or {}
        State.bossOnly = combat.bossOnly == true
        State.profiles = type(decoded.Profiles) == "table" and decoded.Profiles or State.profiles
        State.currentProfile = tostring(decoded.currentProfile or "Default")
    else
        -- v1-v3 flat config migration. Existing fields below are loaded unchanged;
        -- the next successful save writes the grouped v7 schema.
        State.configDirty = true
    end

    if tostring(decoded.lastJobId or "") ~= ""
        and tostring(decoded.lastJobId) ~= tostring(game.JobId)
    then
        State.sessionStats.successfulServerChanges =
            State.sessionStats.successfulServerChanges + 1
    end

    if type(decoded.itemNameCatalog) == "table" then
        for key, displayName in pairs(
            decoded.itemNameCatalog
        ) do
            local cleaned =
                F.trimText(displayName)

            if cleaned ~= "" then
                State.itemNameCatalog[
                    string.lower(
                        tostring(key)
                    )
                ] = cleaned
            end
        end
    end

    if type(decoded.itemRarityCatalog) == "table" then
        for key, rarityKey in pairs(
            decoded.itemRarityCatalog
        ) do
            rarityKey =
                string.lower(
                    tostring(rarityKey)
                )

            if Config.DROP_RARITY_BY_KEY[
                rarityKey
            ] then
                State.itemRarityCatalog[
                    string.lower(
                        tostring(key)
                    )
                ] = rarityKey
            end
        end
    end

    F.importRaritySet(
        State.dropDisplayRaritySet,
        decoded.displayRarities
    )

    State.goalFarm.selected = nil
    State.goalFarm.selectedKind = F.trimText(decoded.goalKind)
    State.goalFarm.selectedName = F.trimText(decoded.goalName)
    State.goalFarm.pendingKind = State.goalFarm.selectedKind
    State.goalFarm.pendingName = State.goalFarm.selectedName

    if type(decoded.cellKeep) == "table" then
        State.cellFarm.keepOrder = {}
        State.cellFarm.keepNames = {}

        for _, itemName in ipairs(decoded.cellKeep) do
            local cleaned = F.trimText(itemName)
            if cleaned ~= "" then
                local key = string.lower(cleaned)
                if not State.cellFarm.keepNames[key] then
                    State.cellFarm.keepNames[key] = true
                    table.insert(State.cellFarm.keepOrder, cleaned)
                end
            end
        end
    end

    if next(State.cellFarm.keepNames) == nil then
        State.cellFarm.keepOrder = {"Shadowbeam Staff"}
        State.cellFarm.keepNames = {["shadowbeam staff"] = true}
    end

    State.cellFarm.selectedWeaponName =
        F.trimText(
            decoded.cellWeapon
            or State.cellFarm.selectedWeaponName
        )

    State.cellFarm.weaponStatus =
        State.cellFarm.selectedWeaponName ~= ""
        and ("Selected: " .. State.cellFarm.selectedWeaponName)
        or "AUTO / not selected"

    State.cellFarm.fightHeight =
        math.clamp(
            tonumber(decoded.cellFightHeight)
                or Config.CELL_DEFAULT_FIGHT_HEIGHT,
            5,
            60
        )

    State.cellFarm.travelSpeed =
        math.clamp(
            tonumber(decoded.cellTravelSpeed)
                or Config.CELL_DEFAULT_TRAVEL_SPEED,
            0.5,
            3.0
        )
    State.movementSpeeds.Cell = State.cellFarm.travelSpeed

    if type(decoded.cellSession) == "table" then
        State.cellFarm.runs = math.max(0, math.floor(tonumber(decoded.cellSession.runs) or 0))
        State.cellFarm.kills = math.max(0, math.floor(tonumber(decoded.cellSession.kills) or 0))
        State.cellFarm.lootCollected = math.max(0, math.floor(tonumber(decoded.cellSession.lootCollected) or 0))
        State.cellFarm.bundlesOpened = math.max(0, math.floor(tonumber(decoded.cellSession.bundlesOpened) or 0))
        State.cellFarm.itemsSold = math.max(0, math.floor(tonumber(decoded.cellSession.itemsSold) or 0))
        State.cellFarm.hops = math.max(0, math.floor(tonumber(decoded.cellSession.hops) or 0))
        State.cellFarm.failures = math.max(0, math.floor(tonumber(decoded.cellSession.failures) or 0))
        State.cellFarm.lastFailure = tostring(decoded.cellSession.lastFailure or "None")
    end

    State.farmEnabled =
        decoded.farmEnabled == true

    State.farmContainsMode =
        decoded.farmContainsMode == true

    State.farmStrategy =
        F.normalizeFarmStrategy(
            decoded.farmStrategy
        )

    State.farmFlightSpeed =
        math.clamp(
            tonumber(decoded.farmFlightSpeed)
                or Config.LOOT_FLY_SPEED,
            0.5,
            3.0
        )

    State.movementPreset = tostring(decoded.movementPreset or "Custom")
    State.adaptiveMovementEnabled = decoded.adaptiveMovementEnabled ~= false
