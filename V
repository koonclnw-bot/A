function F.getSpectatePart(drop)
    if not drop then
        return nil
    end

    if drop:IsA("BasePart") then
        return drop
    end

    if drop:IsA("Model")
        and drop.PrimaryPart
    then
        return drop.PrimaryPart
    end

    if drop:IsA("Tool") then
        local handle =
            drop:FindFirstChild(
                "Handle"
            )

        if handle
            and handle:IsA(
                "BasePart"
            )
        then
            return handle
        end
    end

    return drop:FindFirstChildWhichIsA(
