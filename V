local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
local ConsumableEvent = Remotes and Remotes:FindFirstChild("ConsumableEvent") or nil
local UpdateInsanity = Remotes and Remotes:FindFirstChild("UpdateInsanity") or nil

function F.refreshCoreRemotes()
    Remotes = ReplicatedStorage:FindFirstChild("Remotes")

    if Remotes then
        ConsumableEvent = Remotes:FindFirstChild("ConsumableEvent")
        UpdateInsanity = Remotes:FindFirstChild("UpdateInsanity")
    else
        ConsumableEvent = nil
        UpdateInsanity = nil
    end

    return Remotes
end

