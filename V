    indicator.BackgroundTransparency = 1
    indicator.BorderSizePixel = 0
    indicator.ZIndex = 9
    indicator.Parent = button
    F.createCorner(indicator, 2)

    button.MouseEnter:Connect(function()
        if State.currentPageName ~= pageName then
            F.tweenObject(button, 0.14, {BackgroundColor3 = Config.THEME.Hover})
            F.tweenObject(stroke, 0.14, {Transparency = 0.12})
        end
    end)

    button.MouseLeave:Connect(function()
        if State.currentPageName ~= pageName then
            F.tweenObject(button, 0.14, {BackgroundColor3 = Config.THEME.SidebarButton})
            F.tweenObject(stroke, 0.14, {Transparency = 0.32})
        end
    end)

    State.pageButtons[pageName] = button
    pageIndicators[pageName] = indicator
    pageFullText[pageName] = text
    pageIconText[pageName] = icon or string.sub(text, 1, 1)

    -- v6.3 generic router: every registered sidebar tab uses the same page
    -- switch path. This prevents newly added pages from rendering as dead tabs.
    button.MouseButton1Click:Connect(function()
        if F.selectPage then
            F.selectPage(pageName)
        end
    end)

    return button
end

