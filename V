State.lockConnection =
    RunService.Heartbeat:Connect(function()

        if not State.loopRunning
            or not State.monsterLockEnabled then

            return
        end

        -- Other Hub systems may need temporary movement control.
        -- This pauses POSITIONING only; it never changes the Lock toggle.
        -- Auto Farm owns player positioning for the entire time it is enabled.
        -- Pausing Monster Lock only while farmBusy is true leaves a Heartbeat-sized
        -- gap between loot attempts, which can snap the player back to the monster.
        -- Keep the lock toggle/state intact, but suspend POSITIONING until Auto Farm
        -- is turned off.
        if F.shouldPauseMonsterLockForFarm()
            or State.sellBusy
            or F.isMonsterLockSuspended()
        then
            F.stopMovementFlight("MONSTER_LOCK")
            F.releaseMovement("MONSTER_LOCK")
            return
        end

        local targetInvalid =
            not State.lockedMonster
            or not State.lockedMonster.Parent
            or (
                State.lockedMonster
                and F.isIgnoredMonster(
                    State.lockedMonster
                )
            )

        if not targetInvalid
            and F.isMonsterAlive
        then
            targetInvalid =
                not F.isMonsterAlive(
                    State.lockedMonster
                )
        end

        if targetInvalid then
            State.lockedMonster = nil
            State.monsterLockManualSelection = false

            -- Cell Farm never falls through to unrelated monsters while its
            -- megaboss fight is active. Normal Monster Lock keeps old behavior.
            if State.cellFarm
                and State.cellFarm.enabled
                and (
                    State.cellFarm.stage == "FIGHTING"
                    or State.cellFarm.stage == "WAITING FOR BOSS"
                )
            then
                State.lockedMonster =
                    F.getCellBoss
                    and F.getCellBoss()
                    or nil
            else
                State.lockedMonster =
                    F.getNearestMonster()
            end

            if not State.lockedMonster then
                State.monsterLockWaiting = true
                F.stopMovementFlight("MONSTER_LOCK")
                F.releaseMovement("MONSTER_LOCK")

                local humanoid =
                    F.getHumanoid()

                if humanoid then
                    humanoid.AutoRotate = true
                end

                task.defer(function()
                    State.updateMonsterButtons()
                    State.updateCombatStatus()
                end)

                return
            end

            State.monsterLockWaiting = false

            -- Begin following the reacquired target immediately.
            State.applyMonsterLockPosition()

            task.defer(function()
                State.updateMonsterButtons()
                State.updateCombatStatus()
            end)

            return
        end

        State.applyMonsterLockPosition()
    end)

