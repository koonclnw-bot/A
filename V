    end

    for _, record in ipairs(records or {}) do
        local detail = ""

        if record.Kind == "Monster" then
            detail = tostring((record.Config or {}).Tier or "Unknown")
        else
            detail = tostring(#((record.ItemRecord or {}).Sources or {})) .. " source(s)"
        end

        local button = F.createListButton(
            State.goalResultsList,
            "[" .. tostring(record.Kind) .. "] "
                .. tostring(record.Name)
                .. "  |  "
                .. detail,
            record.Kind == "Monster"
                and Config.THEME.AccentLight
                or Config.THEME.Text
        )

        button:SetAttribute(
            "GoalKey",
            tostring(record.Key or (record.Kind .. "|" .. record.Name))
        )

        table.insert(State.goalResultButtons, button)

        button.MouseButton1Click:Connect(function()
            F.selectGoalRecord(record)
        end)
    end
end

function F.searchGoalIntelligence(query)
    local goal = State.goalFarm
    query = string.lower(F.trimText(query))
    goal.lastQuery = query

    if not goal.loaded and not goal.loading then
        F.refreshGoalIntelligence(false, false)
    end

    local results = {}

    for name, config in pairs(State.gameDB.monsters or {}) do
        local displayName = tostring((type(config) == "table" and config.Name) or name)
        local haystack =
            string.lower(
                displayName
                .. " "
                .. tostring(type(config) == "table" and config.Tier or "")
                .. " "
                .. tostring(type(config) == "table" and config.Description or "")
            )

        if query == "" or string.find(haystack, query, 1, true) then
            table.insert(results, {
                Kind = "Monster",
                Name = displayName,
                Config = type(config) == "table" and config or {},
                Key = "Monster|" .. string.lower(displayName),
            })
        end
    end

    for itemKey, itemRecord in pairs(goal.dropIndex or {}) do
        local haystack = string.lower(tostring(itemRecord.Name or itemKey))
        local sourceText = {}

        for _, source in ipairs(itemRecord.Sources or {}) do
            table.insert(sourceText, tostring(source.Monster or ""))
        end

        haystack = haystack .. " " .. string.lower(table.concat(sourceText, " "))

        if query == "" or string.find(haystack, query, 1, true) then
            table.insert(results, {
                Kind = "Item",
                Name = tostring(itemRecord.Name or itemKey),
                ItemRecord = itemRecord,
                Key = "Item|" .. itemKey,
            })
        end
    end

    table.sort(results, function(a, b)
        if a.Kind ~= b.Kind then
            return a.Kind == "Item"
        end
        return tostring(a.Name) < tostring(b.Name)
    end)

    while #results > Config.GOAL_SEARCH_MAX_RESULTS do
        table.remove(results)
    end

    goal.resultRecords = results
    goal.lastSearchText =
        "Results: " .. tostring(#results)
        .. " / max " .. tostring(Config.GOAL_SEARCH_MAX_RESULTS)
        .. (query ~= "" and (" | Query: " .. query) or " | Showing live items + Bestiary monsters")

    F.renderGoalResults(results)

    if #results > 0 then
        local keep = nil
        for _, record in ipairs(results) do
            if goal.selected
                and record.Kind == goal.selected.Kind
                and string.lower(tostring(record.Name))
                    == string.lower(tostring(goal.selected.Name))
            then
                keep = record
                break
            end
        end

        if not keep and goal.pendingName ~= "" then
            for _, record in ipairs(results) do
                if string.lower(tostring(record.Kind))
                        == string.lower(tostring(goal.pendingKind))
                    and string.lower(tostring(record.Name))
                        == string.lower(tostring(goal.pendingName))
                then
                    keep = record
                    break
                end
            end
        end

        if keep then
            F.selectGoalRecord(keep)
        elseif query ~= "" then
            F.selectGoalRecord(results[1])
        else
            F.selectGoalRecord(nil)
        end
    else
        F.selectGoalRecord(nil)
    end

    F.updateGoalUI()
    return results
end

function F.refreshGoalIntelligence(force, fromGameDB)
    local goal = State.goalFarm

    if goal.loading then
        return false
    end

    if not fromGameDB
        and (force or not State.gameDB.loaded)
    then
        return F.refreshGameDB(force == true)
    end

    goal.loading = true
    goal.status = "Scanning live monster drop tables"
    F.updateGoalUI()

    local ok, err = xpcall(function()
        F.buildGoalDropIndex()
    end, function(message)
        return debug.traceback(tostring(message), 2)
    end)

    if not ok then
        goal.loading = false
        goal.status = "Error"
        F.recordError("GoalFarm", err)
        F.updateGoalUI()
        return false
    end

    goal.loaded = true
    goal.loading = false
    goal.lastRefreshAt = os.time()
    goal.status = "Ready"

    F.recordDiagnosticEvent(
        "GoalFarm",
        "Indexed " .. tostring(F.getGameDBCount(goal.dropIndex))
            .. " live drop items across "
            .. tostring(goal.lastSourceCount)
            .. " monster->item sources"
    )

    F.searchGoalIntelligence(goal.lastQuery or "")

    if goal.enabled and goal.selected then
        goal.monsterTargets =
            F.buildGoalMonsterTargets(
                goal.selected
            )

        if Config.GOAL_AUTO_MONSTER_LOCK
            and next(goal.monsterTargets) ~= nil
            and not State.monsterLockEnabled
        then
            F.setMonsterLock(true)
        end
    end

    F.updateGoalUI()
    return true
end

function F.updateGoalUI()
    if State.goalStatusLabel and State.goalStatusLabel.Parent then
        local searchText = State.goalFarm.lastSearchText
        State.goalStatusLabel.Text =
            F.getGoalSummary()
            .. (searchText ~= "" and ("\n" .. searchText) or "")
    end

    if State.goalDetailsLabel and State.goalDetailsLabel.Parent then
        State.goalDetailsLabel.Text =
            F.formatGoalRecord(State.goalFarm.selected)
    end
end

function F.buildGoalMonsterTargets(record)
    local targets = {}

    if type(record) ~= "table" then
        return targets
    end

    if record.Kind == "Monster" then
        targets[string.lower(tostring(record.Name))] = true
        return targets
    end

    if record.Kind == "Item" then
        for _, source in ipairs((record.ItemRecord or {}).Sources or {}) do
            local name = string.lower(F.trimText(source.Monster))
            if name ~= "" then
                targets[name] = true
            end
        end
    end

    return targets
end

function F.captureGoalRestoreState()
    if State.goalFarm.restore then
        return
    end

    State.goalFarm.restore = {
        farmEnabled = State.farmEnabled,
        farmContainsMode = State.farmContainsMode,
        farmTargetOrder = F.deepCopySerializable(State.farmTargetOrder),
        farmTargetNames = F.deepCopySerializable(State.farmTargetNames),
        farmRaritySet = F.deepCopySerializable(State.farmRaritySet),
        farmStopAfterFirst = State.farmStopAfterFirst,
        farmStrategy = State.farmStrategy,
        monsterLockEnabled = State.monsterLockEnabled,
        lockedMonster = State.lockedMonster,
        monsterLockManualSelection = State.monsterLockManualSelection,
    }
end

function F.restoreGoalFarmState()
    local restore = State.goalFarm.restore
    State.goalFarm.restore = nil

    if type(restore) ~= "table" then
        return
    end

    State.farmEnabled = restore.farmEnabled == true
    State.farmContainsMode = restore.farmContainsMode == true
    State.farmTargetOrder =
        F.deepCopySerializable(restore.farmTargetOrder or {})
    State.farmTargetNames =
        F.deepCopySerializable(restore.farmTargetNames or {})
    F.importRaritySet(
        State.farmRaritySet,
        restore.farmRaritySet
    )
    State.farmStopAfterFirst = restore.farmStopAfterFirst == true
    State.farmStrategy = F.normalizeFarmStrategy(restore.farmStrategy)

    State.monsterLockEnabled = restore.monsterLockEnabled == true
    State.lockedMonster =
        restore.lockedMonster
        and restore.lockedMonster.Parent
        and restore.lockedMonster
        or nil
    State.monsterLockManualSelection =
        restore.monsterLockManualSelection == true

    F.applyFarmConfigToUI()
    F.setMonsterLock(State.monsterLockEnabled)
    F.updateFarmStatus()
end

function F.startGoalFarm()
    local goal = State.goalFarm
    local record = goal.selected

    if type(record) ~= "table" then
        F.notify("Goal Farm", "Select an item or monster first.", "warning", 2.0)
        return false
    end

    if goal.enabled then
        F.stopGoalFarm(true)
    end

    F.captureGoalRestoreState()

    goal.enabled = true
    goal.status = "Running"
    goal.monsterTargets = F.buildGoalMonsterTargets(record)
    goal.selectedKind = tostring(record.Kind or "")
    goal.selectedName = tostring(record.Name or "")

    if record.Kind == "Item" and Config.GOAL_AUTO_COLLECT then
        local itemName = F.trimText(record.Name)
        local key = string.lower(itemName)

        State.farmEnabled = true
        State.farmBusy = false
        State.farmContainsMode = false
        State.farmTargetOrder = {itemName}
        State.farmTargetNames = {[key] = true}
        State.farmStopAfterFirst = false
        State.farmStrategy = "Smart"
        State.farmNoMatchSince = nil

        for rarityKey in pairs(Config.DROP_RARITY_BY_KEY) do
            State.farmRaritySet[rarityKey] = true
        end

        State.farmStatus = "Goal: " .. itemName
        F.applyFarmConfigToUI()
    end

    if Config.GOAL_AUTO_MONSTER_LOCK
        and next(goal.monsterTargets) ~= nil
    then
        State.lockedMonster = nil
        State.monsterLockManualSelection = false
        F.setMonsterLock(true)
    end

    F.recordDiagnosticEvent(
        "GoalFarm",
        "Started " .. tostring(record.Kind)
            .. " goal: " .. tostring(record.Name)
            .. " | monster targets "
            .. tostring(F.getGameDBCount(goal.monsterTargets))
    )

    State.movementTelemetry.lastAction =
        "Goal Farm start -> " .. tostring(record.Name)

    F.updateGoalUI()
    F.updateFarmStatus()
    F.markConfigDirty()
    F.notify(
        "Goal Farm",
        "Started " .. tostring(record.Kind)
            .. " goal: " .. tostring(record.Name),
        "success",
        2.3
    )
    return true
end

function F.stopGoalFarm(restorePrevious)
    local goal = State.goalFarm

    if not goal.enabled and not goal.restore then
        return true
    end

    goal.enabled = false
    goal.monsterTargets = {}
    goal.status = "Ready"

    F.stopLootLock("FARM")
    State.farmBusy = false
    State.farmNoMatchSince = nil
    F.stopMovementFlight("MONSTER_LOCK")
    F.releaseMovement("MONSTER_LOCK")

    if restorePrevious ~= false then
        F.restoreGoalFarmState()
    else
        goal.restore = nil
    end

    F.recordDiagnosticEvent("GoalFarm", "Stopped goal farm")
    State.movementTelemetry.lastAction = "Goal Farm stopped"
    F.updateGoalUI()
    F.markConfigDirty()
    return true
end

function F.copyGoalSummary()
    local textToCopy =
        F.getGoalSummary()
        .. "\n\n=== Selected ===\n"
        .. F.formatGoalRecord(State.goalFarm.selected)

    local clipboard = nil
    if type(setclipboard) == "function" then
        clipboard = setclipboard
    elseif type(toclipboard) == "function" then
        clipboard = toclipboard
    end

    if clipboard and pcall(clipboard, textToCopy) then
        F.notify("Goal Farm", "Goal intelligence summary copied.", "success", 2.0)
        return true
    end

    print(textToCopy)
    F.notify("Goal Farm", "Clipboard unavailable; summary printed to console.", "info", 2.5)
    return false
end

