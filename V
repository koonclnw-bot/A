-- =========================================================
-- WORLD / MAP READINESS
--
-- Auto Farm and Auto Sell are held until Roblox has finished
-- its initial load, the local character/remotes exist, and
-- Workspace has had a short settling window.
--
-- A StreamingEnabled experience can still stream distant
-- regions later; Merchant selling therefore has its own
-- wait/retry pass as well.
-- =========================================================

function F.waitForWorldReady()
    if State.worldReady then
        return true
    end

    if State.worldReadinessRunning then
        local deadline =
            os.clock()
            + Config.WORLD_READY_TIMEOUT

        while State.loopRunning
            and not State.worldReady
            and os.clock() < deadline
        do
            task.wait(0.10)
        end

        return State.worldReady
    end

    State.worldReadinessRunning = true
    State.worldReadyStartedAt = os.clock()
    State.worldReadyStatus = "Waiting for game"

    local deadline =
        os.clock()
        + Config.WORLD_READY_TIMEOUT

    while State.loopRunning
        and not game:IsLoaded()
        and os.clock() < deadline
    do
        task.wait(0.10)
    end

    State.worldReadyStatus =
        "Waiting for character"

    while State.loopRunning
        and os.clock() < deadline
        and not F.getCharacterRoot()
    do
        task.wait(0.10)
    end

    State.worldReadyStatus =
        "Waiting for remotes"

    while State.loopRunning
        and os.clock() < deadline
    do
        if F.refreshCoreRemotes() then
            break
        end

        task.wait(0.10)
    end

    if not game:IsLoaded()
        or not F.getCharacterRoot()
        or not Remotes
    then
        State.worldReadinessRunning = false
        State.worldReady = false
        State.worldReadyStatus =
            "Load incomplete - retrying"

        if State.farmEnabled then
            State.farmNoMatchSince = nil
            State.farmStatus =
                State.worldReadyStatus
        end

        if State.sellEnabled then
            State.sellStatus =
                State.worldReadyStatus
        end

        if State.updateFarmStatus then
            State.updateFarmStatus()
        end

        if State.updateSellStatus then
            State.updateSellStatus()
        end

        task.delay(1, function()
            if State.loopRunning
                and not State.worldReady
                and not State.worldReadinessRunning
            then
                F.waitForWorldReady()
            end
        end)

        return false
    end

    State.worldReadyStatus =
        "Settling map"

    local lastWorkspaceChange =
        os.clock()

    local addedConnection =
        workspace.DescendantAdded:Connect(
            function()
                lastWorkspaceChange =
                    os.clock()
            end
        )

    local removingConnection =
        workspace.DescendantRemoving:Connect(
            function()
                lastWorkspaceChange =
                    os.clock()
            end
        )

    local settleDeadline =
        math.min(
            deadline,
            os.clock()
            + Config.WORLD_SETTLE_MAX
        )

    while State.loopRunning
        and os.clock() < settleDeadline
    do
        if os.clock()
            - lastWorkspaceChange
            >= Config.WORLD_SETTLE_MIN
        then
            break
        end

        task.wait(0.10)
    end

    pcall(function()
        addedConnection:Disconnect()
    end)

    pcall(function()
        removingConnection:Disconnect()
    end)

    State.dropsFolder =
        F.findDropsFolder
        and F.findDropsFolder()
        or State.dropsFolder

    State.monstersFolder =
        F.findMonstersFolder
        and F.findMonstersFolder()
        or State.monstersFolder

    State.worldReady = true
    State.worldReadinessRunning = false
    State.worldReadyCompletedAt = os.clock()
    State.worldReadyStatus = "Ready"
    State.farmNoMatchSince = nil

    if State.farmEnabled then
        State.farmStatus = "Scanning"
    end

    if State.sellEnabled then
        State.sellStatus = "Monitoring"
    end

    if State.updateDropStatus then
        State.updateDropStatus()
    end

    if State.updateFarmStatus then
        State.updateFarmStatus()
    end

    if State.updateSellStatus then
        State.updateSellStatus()
    end

    F.notify(
        "World ready",
        "Initial game/map load finished. Auto Farm and Auto Sell may start.",
        "success",
        2.5
    )

    return true
end

function F.ensureWorldReady(timeout)
    if State.worldReady then
        return true
    end

    if not State.worldReadinessRunning then
        task.spawn(
            F.waitForWorldReady
        )
    end

    local deadline =
        os.clock()
        + (
            tonumber(timeout)
            or Config.WORLD_READY_TIMEOUT
        )

    while State.loopRunning
        and not State.worldReady
        and os.clock() < deadline
    do
        task.wait(0.10)
    end

    return State.worldReady
end

function F.isFarmWorldReady()
    if not State.worldReady then
        return false,
            State.worldReadyStatus
            or "Loading world"
    end

    if not F.getCharacterRoot() then
        return false,
            "Waiting for character"
    end

    if not Remotes or not Remotes.Parent then
        F.refreshCoreRemotes()

        if not Remotes then
            return false,
                "Waiting for remotes"
        end
    end

    if not State.dropsFolder
        or not State.dropsFolder.Parent
    then
        State.dropsFolder =
            F.findDropsFolder()
    end

    if not State.dropsFolder then
        return false,
            "Waiting for Drops folder"
    end

    return true, "Ready"
end

