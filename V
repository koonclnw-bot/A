function F.normalizeHealthName(name)
    return string.lower(
        tostring(name)
    ):gsub(
        "[%s_%-]",
        ""
    )
end

F.currentHealthLookup = {}
F.maxHealthLookup = {}

for _, name in ipairs(Config.CURRENT_HEALTH_NAMES) do
    F.currentHealthLookup[
        F.normalizeHealthName(name)
    ] = true
end

for _, name in ipairs(Config.MAX_HEALTH_NAMES) do
    F.maxHealthLookup[
        F.normalizeHealthName(name)
    ] = true
end

function F.findMonsterHumanoid(monster)
    if not monster then
        return nil
    end

    local direct =
        monster:FindFirstChildOfClass(
            "Humanoid"
        )

    if direct then
        return direct
    end

    return monster:FindFirstChildWhichIsA(
        "Humanoid",
        true
    )
end

function F.findHealthValues(monster)
    local currentValue = nil
    local maxValue = nil

    for _, object in ipairs(
        monster:GetDescendants()
    ) do
        if object:IsA("NumberValue")
            or object:IsA("IntValue") then

            local normalized =
                F.normalizeHealthName(
                    object.Name
                )

            if not currentValue
                and F.currentHealthLookup[
                    normalized
                ] then

                currentValue = object
            end

            if not maxValue
                and F.maxHealthLookup[
                    normalized
                ] then

                maxValue = object
            end

            if currentValue
                and maxValue then

                break
            end
        end
    end

    return currentValue, maxValue
end

function F.findHealthAttributes(monster)
    local objects = {monster}

    for _, object in ipairs(
        monster:GetDescendants()
    ) do
        if object:IsA("Folder")
            or object:IsA("Model")
            or object:IsA("Configuration") then

            table.insert(
                objects,
                object
            )
        end
    end

    local currentHolder = nil
    local currentName = nil
    local maxHolder = nil
    local maxName = nil

    for _, object in ipairs(objects) do
        local attributes =
            object:GetAttributes()

        for name, value in pairs(
            attributes
        ) do
            if type(value) == "number" then
                local normalized =
                    F.normalizeHealthName(name)

                if not currentHolder
                    and F.currentHealthLookup[
                        normalized
                    ] then

                    currentHolder = object
                    currentName = name
                end

                if not maxHolder
                    and F.maxHealthLookup[
                        normalized
                    ] then

                    maxHolder = object
                    maxName = name
                end
            end
        end

        if currentHolder
            and maxHolder then

            break
        end
    end

    return
        currentHolder,
        currentName,
        maxHolder,
        maxName
end

function F.getMonsterHealthInfo(monster)
    local humanoid =
        F.findMonsterHumanoid(
            monster
        )

    if humanoid
        and humanoid.MaxHealth > 0 then

        return {
            Type = "Humanoid",
            Current = humanoid.Health,
            Maximum = humanoid.MaxHealth,
            Humanoid = humanoid
        }
    end

    local currentValue, maxValue =
        F.findHealthValues(monster)

    if currentValue
        and maxValue
        and maxValue.Value > 0 then

        return {
            Type = "Value",
            Current = currentValue.Value,
            Maximum = maxValue.Value,
            CurrentValue = currentValue,
            MaxValue = maxValue
        }
    end

    local currentHolder,
          currentName,
          maxHolder,
          maxName =
        F.findHealthAttributes(monster)

    if currentHolder
        and currentName
        and maxHolder
        and maxName then

        local current =
            currentHolder:GetAttribute(
                currentName
            )

        local maximum =
            maxHolder:GetAttribute(
                maxName
            )

        if type(current) == "number"
            and type(maximum) == "number"
            and maximum > 0 then

            return {
                Type = "Attribute",
                Current = current,
                Maximum = maximum,
                CurrentHolder = currentHolder,
                CurrentName = currentName,
                MaxHolder = maxHolder,
                MaxName = maxName
            }
        end
    end

    return nil
end

function F.isMonsterAlive(monster)
    if not monster
        or not monster.Parent
    then
        return false
    end

    local healthInfo =
        F.getMonsterHealthInfo(
            monster
        )

    if healthInfo then
        local current =
            tonumber(
                healthInfo.Current
            )

        return
            current ~= nil
            and current > 0
    end

    -- Unsupported/custom monsters remain valid until removed.
    return true
end

function F.forceHumanoidDeath(monster, humanoid)
    if not humanoid then
        return
    end

    pcall(function()
        humanoid:TakeDamage(math.huge)
    end)

    pcall(function()
        humanoid.Health = 0
    end)

    pcall(function()
        humanoid:ChangeState(
            Enum.HumanoidStateType.Dead
        )
    end)

    pcall(function()
        humanoid.MaxHealth = 0
    end)

    pcall(function()
        monster:BreakJoints()
    end)
end

function F.forceCustomHealthDeath(monster, healthInfo)
    if healthInfo.Type == "Value" then
        pcall(function()
            healthInfo.CurrentValue.Value = 0
        end)

        pcall(function()
            healthInfo.MaxValue.Value = 0
        end)

    elseif healthInfo.Type == "Attribute" then
        pcall(function()
            healthInfo.CurrentHolder:SetAttribute(
                healthInfo.CurrentName,
                0
            )
        end)

        pcall(function()
            healthInfo.MaxHolder:SetAttribute(
                healthInfo.MaxName,
                0
            )
        end)
    end

    local humanoid =
        F.findMonsterHumanoid(monster)

    if humanoid then
        F.forceHumanoidDeath(
            monster,
            humanoid
        )
    else
        pcall(function()
            monster:BreakJoints()
        end)
    end
end

function F.tryFinishMonster(monster)
    if not monster
        or not monster.Parent
        or not monster:IsA("Model") then

        return
    end

    local character =
        F.getPlayerCharacter()

    if character then
        if monster == character
            or monster:IsDescendantOf(character)
            or character:IsDescendantOf(monster) then

            return
        end
    end

    if monster.Name == LocalPlayer.Name then
        return
    end

    local healthInfo =
        F.getMonsterHealthInfo(monster)

    if not healthInfo then
        return
    end

    if healthInfo.Maximum <= 0
        or healthInfo.Current <= 0 then

        return
    end

    local healthPercent =
        (
            healthInfo.Current
            / healthInfo.Maximum
        ) * 100

    if healthPercent
        > State.finisherHealthPercent then

        return
    end

    State.sessionStats.finisherLocalAttempts =
        State.sessionStats.finisherLocalAttempts + 1

    if healthInfo.Type == "Humanoid" then
        F.forceHumanoidDeath(
            monster,
            healthInfo.Humanoid
        )
    else
        F.forceCustomHealthDeath(
            monster,
            healthInfo
        )
    end
end

function F.getAllFinisherMonsters(folder)
    local result = {}
    local seen = {}

    if not folder then
        return result
    end

    for _, child in ipairs(
        folder:GetChildren()
    ) do
        if child:IsA("Model")
            and not seen[child] then

            seen[child] = true
            table.insert(
                result,
                child
            )
        end
    end

    for _, object in ipairs(
        folder:GetDescendants()
    ) do
        if object:IsA("Humanoid") then
            local model =
                object:FindFirstAncestorOfClass(
                    "Model"
                )

            if model
                and model:IsDescendantOf(folder)
                and not seen[model] then

                seen[model] = true
                table.insert(
                    result,
                    model
                )
            end
        end
    end

    return result
end

