task.spawn(function()
    while State.loopRunning do
        if State.routeRecording then
            local root = F.getCharacterRoot()
            if root then
                local position = root.Position
                local shouldRecord =
                    State.routeLastRecordedPosition == nil
                    or (
                        position
                        - State.routeLastRecordedPosition
                    ).Magnitude >= Config.ROUTE_RECORD_MIN_DISTANCE

                if shouldRecord
                    and #State.routePoints < Config.ROUTE_MAX_POINTS
                then
                    table.insert(State.routePoints, root.CFrame)
                    State.routeLastRecordedPosition = position
                    State.routeStatus =
                        "Recording " .. tostring(#State.routePoints) .. " points"
                    F.updateWaypointStatus()
                elseif #State.routePoints >= Config.ROUTE_MAX_POINTS then
                    State.routeRecording = false
                    State.routeStatus = "Recorder stopped at max points"
                    if State.routeRecordingToggle then
                        State.routeRecordingToggle:SetSilent(false)
                    end
                    F.updateWaypointStatus()
                    F.markConfigDirty()
                end
            end
        end

        task.wait(Config.ROUTE_RECORD_INTERVAL)
    end
end)

