function F.getPassiveRemoteStatus(name)
    if not Remotes or not Remotes.Parent then
        return "WAITING"
    end
    return Remotes:FindFirstChild(name) and "FOUND" or "MISSING"
end

function F.buildDiagnosticsReport()
    local character = F.getPlayerCharacter()
    local root = F.getCharacterRoot()
    local merchant = F.findMerchant and F.findMerchant() or nil
    local owner = F.getMovementOwner() or "NONE"
    local lease = math.max(0, State.movement.leaseUntil - os.clock())
    local activeChannel = tostring(State.movementTelemetry.channel or "None")
    local activeBase = activeChannel ~= "None" and F.getMovementBaseScale(activeChannel) or 0
    local activeEffective = activeChannel ~= "None" and F.getEffectiveMovementScale(activeChannel) or 0
    local lockedDrop = State.lockedDrop and State.lockedDrop.Parent and tostring(State.lockedDrop.Name) or "None"
    local lockedMonster = State.lockedMonster and State.lockedMonster.Parent and tostring(State.lockedMonster.Name) or "None"

    local eventLines = {}
    local firstEvent = math.max(1, #State.diagnosticsEvents - 3)
    for index = firstEvent, #State.diagnosticsEvents do
        local event = State.diagnosticsEvents[index]
        table.insert(
            eventLines,
            os.date("%H:%M:%S", event.Time)
                .. " " .. event.Source
                .. ": " .. event.Message
        )
    end

    return table.concat({
        "=== The Veil Hub Diagnostics ===",
        "Version: " .. Config.HUB_VERSION .. " | JobId: " .. tostring(game.JobId),
        "World: " .. (State.worldReady and "FOUND" or "WAITING") .. " | Game Loaded: " .. (game:IsLoaded() and "FOUND" or "WAITING"),
        "Character: " .. (character and "FOUND" or "MISSING") .. " | Root: " .. (root and "FOUND" or "MISSING"),
        "Drops: " .. (State.dropsFolder and State.dropsFolder.Parent and "FOUND" or "MISSING") .. " | Monsters: " .. (State.monstersFolder and State.monstersFolder.Parent and "FOUND" or "MISSING") .. " | Merchant: " .. (merchant and "FOUND" or "WAITING"),
        "Movement Owner: " .. owner .. " | Lease: " .. string.format("%.2fs", lease) .. " | Channel: " .. activeChannel,
        "Movement Base/Effective: " .. string.format("%.1f/%.1fx", activeBase, activeEffective)
            .. " | Distance: " .. string.format("%.1f", tonumber(State.movementTelemetry.distance) or 0)
            .. " | Velocity: " .. string.format("%.1f", tonumber(State.movementTelemetry.velocity) or 0)
            .. " | ETA: " .. string.format("%.2fs", tonumber(State.movementTelemetry.eta) or 0),
        "Adaptive: " .. (State.adaptiveMovementEnabled and "ON" or "OFF")
            .. " | Server Corrections: " .. tostring(State.movementTelemetry.serverCorrections)
            .. " | Last: " .. tostring(State.movementTelemetry.lastCorrection),
        "Farm State: " .. tostring(State.farmMachine.state)
            .. " | Busy: " .. tostring(State.farmBusy)
            .. " | Strategy: " .. tostring(State.farmStrategy),
        "Planner: " .. tostring(State.plannerLastChoice)
            .. " | Score: " .. string.format("%.2f", tonumber(State.plannerLastScore) or 0)
            .. " | Distance: " .. string.format("%.1f", tonumber(State.plannerLastDistance) or 0)
            .. " | ETA: " .. string.format("%.2fs", tonumber(State.plannerLastETA) or 0),
        "Locked Item: " .. lockedDrop .. " | Loot Distance: " .. string.format("%.1f", tonumber(State.lootFlightDistance) or 0),
        "Monster Lock: " .. (State.monsterLockEnabled and "ON" or "OFF") .. " | Target: " .. lockedMonster,
        "Last Remote: " .. tostring(State.movementTelemetry.lastRemote),
        "Last Action: " .. tostring(State.movementTelemetry.lastAction),
        "GameDB: " .. tostring(State.gameDB.status)
            .. " | Game " .. tostring(State.gameDB.gameVersion)
            .. " [" .. tostring(State.gameDB.gameStage) .. "]"
            .. " | Guard: " .. (State.gameDB.versionMismatch and "MISMATCH" or "OK"),
        "GameDB Counts: Monsters " .. tostring((State.gameDB.counts or {}).Monsters or 0)
            .. " | NPCs " .. tostring((State.gameDB.counts or {}).NotableNPCs or 0)
            .. " | Status " .. tostring((State.gameDB.counts or {}).StatusEffects or 0)
            .. " | Dialogues " .. tostring((State.gameDB.counts or {}).Dialogues or 0)
            .. " | Events " .. tostring((State.gameDB.counts or {}).DialogueEvents or 0),
        "NPC Intel: " .. tostring(State.npcIntel.status)
            .. " | Dialogue NPCs " .. tostring(#(State.npcIntel.npcOrder or {}))
            .. " | Interactables " .. tostring(#(State.npcIntel.interactions or {}))
            .. " | Selected " .. tostring(State.npcIntel.selected and State.npcIntel.selected.Name or "None"),
        "Goal Farm: " .. (State.goalFarm.enabled and "ON" or "OFF")
            .. " | " .. tostring(State.goalFarm.selectedKind ~= "" and State.goalFarm.selectedKind or "None")
            .. ": " .. tostring(State.goalFarm.selectedName ~= "" and State.goalFarm.selectedName or "None")
            .. " | Targets " .. tostring(F.getGameDBCount(State.goalFarm.monsterTargets or {}))
            .. " | Live Items " .. tostring(F.getGameDBCount(State.goalFarm.dropIndex or {})),
        "Cell Farm: " .. (State.cellFarm.enabled and "ON" or "OFF")
            .. " | Stage " .. tostring(State.cellFarm.stage)
            .. " | Boss HP " .. tostring(math.floor(tonumber(State.cellFarm.lastBossHealth) or 0))
            .. "/" .. tostring(math.floor(tonumber(State.cellFarm.lastBossMaxHealth) or 0))
            .. " (" .. string.format("%.1f", tonumber(State.cellFarm.lastBossHealthPercent) or 0) .. "%)"
