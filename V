    and type(globalEnv.__TheVeilHub_Runtime.Stop) == "function" then

    pcall(globalEnv.__TheVeilHub_Runtime.Stop)
end

globalEnv.__TheVeilHub_Runtime = {
    Active = true
}

State.runtime = globalEnv.__TheVeilHub_Runtime

if not globalEnv.__TheVeilHub_InsanityBlockState then
    globalEnv.__TheVeilHub_InsanityBlockState = {
        Enabled = false,
        Remote = UpdateInsanity
    }
end

local insanityBlockState =
    globalEnv.__TheVeilHub_InsanityBlockState

insanityBlockState.Enabled = false
insanityBlockState.Remote = UpdateInsanity

function F.refreshUpdateInsanityRemote()
    if not Remotes or not Remotes.Parent then
        F.refreshCoreRemotes()
    end

    if not Remotes then
        UpdateInsanity = nil
        insanityBlockState.Remote = nil
        return nil
    end

    local remote =
        Remotes:FindFirstChild("UpdateInsanity")

    UpdateInsanity = remote
    insanityBlockState.Remote = remote

    return remote
end

function F.installInsanityBlockHook()
    -- The hook itself is permanent for the current client session, but its
    -- behavior is gated by __TheVeilHub_InsanityBlockState.Enabled.
    -- Keeping the state in getgenv/_G lets a re-executed Hub reuse the same
    -- hook instead of stacking multiple __namecall hooks.
    if globalEnv.__TheVeilHub_InsanityHookInstalled then
        return globalEnv.__TheVeilHub_InsanityHookSupported == true
    end

    if type(hookmetamethod) ~= "function"
        or type(getnamecallmethod) ~= "function" then

        globalEnv.__TheVeilHub_InsanityHookSupported = false
        return false
    end

    local oldNamecall

    local function interceptNamecall(self, ...)
        local method = nil
        pcall(function()
            method = getnamecallmethod()
        end)

        local blockState =
            globalEnv.__TheVeilHub_InsanityBlockState

        if method == "FireServer"
            and blockState
            and blockState.Enabled
            and blockState.Remote
            and self == blockState.Remote then

            -- Swallow UpdateInsanity:FireServer(...) before it reaches
            -- the server. Other remotes continue through oldNamecall.
            return nil
        end

        return oldNamecall(self, ...)
    end

    local wrapped = interceptNamecall
    if type(newcclosure) == "function" then
        wrapped = newcclosure(interceptNamecall)
    end

    local success, previous = pcall(function()
        return hookmetamethod(game, "__namecall", wrapped)
    end)

    if not success or type(previous) ~= "function" then
        globalEnv.__TheVeilHub_InsanityHookInstalled = false
        globalEnv.__TheVeilHub_InsanityHookSupported = false
        return false
    end

    oldNamecall = previous
    globalEnv.__TheVeilHub_InsanityHookInstalled = true
    globalEnv.__TheVeilHub_InsanityHookSupported = true
    return true
end

-- SafeBoot: install the executor hook only when Block UpdateInsanity is enabled.
