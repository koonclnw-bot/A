function F.getMovementBaseScale(channel)
    channel = tostring(channel or "Return")

    if channel == "Farm" then
        return math.clamp(
            tonumber(State.farmFlightSpeed)
                or Config.LOOT_FLY_SPEED,
            0.5,
            3.0
        )
    end

    return math.clamp(
        tonumber(State.movementSpeeds[channel])
            or Config.WORLD_FLY_SPEED,
        0.5,
        3.0
    )
end

function F.getAdaptiveChannel(channel)
    channel = tostring(channel or "Return")

    local data = State.adaptiveMovement[channel]
    if not data then
        data = {
            effective = F.getMovementBaseScale(channel),
            corrections = 0,
            lastDistance = nil,
            lastPosition = nil,
            lastSampleAt = 0,
            stableSince = os.clock(),
        }
        State.adaptiveMovement[channel] = data
    end

    return data
end

function F.resetAdaptiveMovement(channel)
    if channel then
        State.adaptiveMovement[tostring(channel)] = nil
        return
    end

    State.adaptiveMovement = {}
end

function F.getEffectiveMovementScale(channel)
    local base = F.getMovementBaseScale(channel)

    if not State.adaptiveMovementEnabled then
        return base
    end

    local data = F.getAdaptiveChannel(channel)
    data.effective = math.clamp(
        tonumber(data.effective) or base,
        Config.ADAPTIVE_MIN_SCALE,
        base
    )

    return data.effective
end

function F.updateAdaptiveMovement(channel, distance, root, commandedSpeed, desiredDirection)
    if not State.adaptiveMovementEnabled
        or not root
        or distance == math.huge
    then
        return F.getMovementBaseScale(channel)
    end

    local data = F.getAdaptiveChannel(channel)
    local now = os.clock()

    if data.lastSampleAt <= 0 then
        data.lastSampleAt = now
        data.lastDistance = distance
        data.lastPosition = root.Position
        data.stableSince = now
        return data.effective
    end

    local dt = now - data.lastSampleAt
    if dt < Config.ADAPTIVE_SAMPLE_INTERVAL then
        return data.effective
    end

    local previousDistance =
        tonumber(data.lastDistance) or distance

    local backwards =
        distance - previousDistance

    local correctionThreshold =
        math.max(
            Config.ADAPTIVE_CORRECTION_DISTANCE,
            (tonumber(commandedSpeed) or 0)
                * dt
                * 0.10
        )

    local backwardTravel = 0
    if data.lastPosition
        and typeof(desiredDirection) == "Vector3"
        and desiredDirection.Magnitude > 0.01
    then
        local displacement =
            root.Position - data.lastPosition

        local forwardTravel =
            displacement:Dot(
                desiredDirection.Unit
            )

        backwardTravel =
            math.max(0, -forwardTravel)
    end

    local correctionDetected =
        backwardTravel
            >= math.max(
                2.0,
                (tonumber(commandedSpeed) or 0)
                    * dt
                    * 0.05
            )
        or (
            channel ~= "Monster"
            and backwards >= correctionThreshold
        )

    if correctionDetected then
        local oldEffective = data.effective
        data.effective =
            math.max(
                Config.ADAPTIVE_MIN_SCALE,
                data.effective
                    - Config.ADAPTIVE_DROP_STEP
            )

        data.corrections = data.corrections + 1
        data.stableSince = now
        State.movementTelemetry.serverCorrections =
            State.movementTelemetry.serverCorrections + 1
        State.movementTelemetry.lastCorrection =
            tostring(channel)
            .. " -"
            .. string.format("%.1f", oldEffective - data.effective)
            .. "x @ "
            .. os.date("%H:%M:%S")

        F.recordDiagnosticEvent(
            "AdaptiveSpeed",
            tostring(channel)
                .. " correction detected; "
                .. string.format("%.1fx -> %.1fx", oldEffective, data.effective)
        )
    elseif previousDistance - distance
        >= Config.ADAPTIVE_PROGRESS_EPSILON
    then
        local base = F.getMovementBaseScale(channel)
        if now - (data.stableSince or now)
            >= Config.ADAPTIVE_STABLE_SECONDS
            and data.effective < base
        then
            data.effective =
                math.min(
                    base,
                    data.effective
                        + Config.ADAPTIVE_RECOVERY_STEP
                )
            data.stableSince = now
        end
    end

    data.lastSampleAt = now
    data.lastDistance = distance
    data.lastPosition = root.Position

    return data.effective
end

function F.setMovementSpeed(channel, value, markDirty)
    channel = tostring(channel or "Farm")
    value = math.clamp(tonumber(value) or 2.0, 0.5, 3.0)

    if channel == "Farm" then
        State.farmFlightSpeed = value
        if State.farmFlightSpeedSlider then
            State.farmFlightSpeedSlider:SetSilent(value)
        end
    else
        State.movementSpeeds[channel] = value

        if channel == "Cell" and State.cellFarm then
            State.cellFarm.travelSpeed = value
            if State.cellTravelSpeedSlider then
                State.cellTravelSpeedSlider:SetSilent(value)
            end
        end
    end

    local slider = State.movementSpeedSliders[channel]
    if slider then
        slider:SetSilent(value)
    end

    F.resetAdaptiveMovement(channel)

    if markDirty ~= false then
        State.movementPreset = "Custom"
        if State.movementPresetButton then
            State.movementPresetButton.Text = "Custom"
        end
        F.markConfigDirty()
    end

    if State.updateFarmStatus then
        State.updateFarmStatus()
    end
end

function F.refreshMovementControlUI()
    if State.movementPresetButton then
        State.movementPresetButton.Text =
            tostring(State.movementPreset or "Custom")
    end

    if State.adaptiveMovementToggle then
        State.adaptiveMovementToggle:SetSilent(
            State.adaptiveMovementEnabled
        )
    end

    for _, channel in ipairs({"Farm", "Monster", "Merchant", "Return", "Cell"}) do
        local slider = State.movementSpeedSliders[channel]
        if slider then
            slider:SetSilent(
                F.getMovementBaseScale(channel)
            )
        end
    end

    if State.farmFlightSpeedSlider then
        State.farmFlightSpeedSlider:SetSilent(
            State.farmFlightSpeed
        )
    end

    F.updateWaypointStatus()
    F.updateProfileListUI()
end

function F.applyMovementPreset(name)
    name = tostring(name or "Normal")
    local preset = Config.MOVEMENT_PRESETS[name]

    if type(preset) ~= "table" then
        return false
    end

    State.movementPreset = name
    F.setMovementSpeed("Farm", preset.Farm, false)
    F.setMovementSpeed("Monster", preset.Monster, false)
    F.setMovementSpeed("Merchant", preset.Merchant, false)
    F.setMovementSpeed("Return", preset.Return, false)
    F.setMovementSpeed("Cell", preset.Cell or preset.Return, false)
    State.cellFarm.travelSpeed = State.movementSpeeds.Cell
    if State.cellTravelSpeedSlider then
        State.cellTravelSpeedSlider:SetSilent(State.cellFarm.travelSpeed)
    end
    F.resetAdaptiveMovement()
    F.refreshMovementControlUI()
    F.markConfigDirty()
    return true
end

function F.cycleMovementPreset()
    local order = {"Safe", "Normal", "Fast", "Turbo"}
    local index = 1

    for i, name in ipairs(order) do
        if name == State.movementPreset then
            index = i
            break
        end
    end

    index = (index % #order) + 1
    F.applyMovementPreset(order[index])
end

function F.updateMovementStatus()
    if not State.movementStatusLabel
        or not State.movementStatusLabel.Parent
    then
        return
    end

    local channel = tostring(State.movementTelemetry.channel or "None")
    local base = channel ~= "None"
        and F.getMovementBaseScale(channel)
        or 0
    local effective = channel ~= "None"
        and F.getEffectiveMovementScale(channel)
        or 0

    State.movementStatusLabel.Text =
        "Preset: " .. tostring(State.movementPreset)
        .. " | Adaptive: " .. (State.adaptiveMovementEnabled and "ON" or "OFF")
        .. "\nFarm " .. string.format("%.1fx", F.getMovementBaseScale("Farm"))
        .. " | Monster " .. string.format("%.1fx", F.getMovementBaseScale("Monster"))
        .. " | Merchant " .. string.format("%.1fx", F.getMovementBaseScale("Merchant"))
        .. " | Return " .. string.format("%.1fx", F.getMovementBaseScale("Return"))
        .. " | Cell " .. string.format("%.1fx", F.getMovementBaseScale("Cell"))
        .. "\nActive: " .. channel
        .. " | Base/Effective: " .. string.format("%.1f/%.1fx", base, effective)
        .. " | Distance: " .. string.format("%.1f", tonumber(State.movementTelemetry.distance) or 0)
        .. " | Velocity: " .. string.format("%.1f", tonumber(State.movementTelemetry.velocity) or 0)
end

function F.serializeCFrame(value)
    if typeof(value) ~= "CFrame" then
        return nil
    end

    return {value:GetComponents()}
end

function F.deserializeCFrame(value)
    if type(value) ~= "table" or #value < 12 then
        return nil
    end

    local components = {}
    for index = 1, 12 do
        local numberValue = tonumber(value[index])
        if not numberValue then
            return nil
        end
        components[index] = numberValue
    end

    return CFrame.new(table.unpack(components, 1, 12))
end

function F.exportWaypoints()
    local output = {}
    for _, name in ipairs(State.waypointOrder) do
        local cf = State.waypoints[name]
        local serialized = F.serializeCFrame(cf)
        if serialized then
            table.insert(output, {Name = name, CFrame = serialized})
        end
    end
    return output
end

function F.importWaypoints(entries)
    State.waypoints = {}
    State.waypointOrder = {}

    if type(entries) ~= "table" then
        return
    end

    for _, entry in ipairs(entries) do
        if type(entry) == "table" then
            local name = F.trimText(entry.Name)
            local cf = F.deserializeCFrame(entry.CFrame)
            if name ~= "" and cf then
                name = string.sub(name, 1, Config.WAYPOINT_NAME_MAX)
                State.waypoints[name] = cf
                table.insert(State.waypointOrder, name)
            end
        end
    end
end

function F.exportRoute()
    local output = {}
    for _, cf in ipairs(State.routePoints) do
        local serialized = F.serializeCFrame(cf)
        if serialized then
            table.insert(output, serialized)
        end
    end
    return output
end

function F.importRoute(entries)
    State.routePoints = {}
    if type(entries) ~= "table" then
        return
    end

    for _, entry in ipairs(entries) do
        local cf = F.deserializeCFrame(entry)
        if cf then
            table.insert(State.routePoints, cf)
            if #State.routePoints >= Config.ROUTE_MAX_POINTS then
                break
            end
        end
    end
end

function F.updateWaypointStatus()
    if State.waypointStatusLabel
        and State.waypointStatusLabel.Parent
    then
        local names = {}
        for index, name in ipairs(State.waypointOrder) do
            if index > 8 then
                table.insert(names, "+" .. tostring(#State.waypointOrder - 8) .. " more")
                break
            end
            table.insert(names, name)
        end

        State.waypointStatusLabel.Text =
            "Waypoints (" .. tostring(#State.waypointOrder) .. "): "
            .. (#names > 0 and table.concat(names, ", ") or "none")
    end

    if State.routeStatusLabel
        and State.routeStatusLabel.Parent
    then
        State.routeStatusLabel.Text =
            "Route: " .. tostring(#State.routePoints)
            .. " points | " .. tostring(State.routeStatus)
    end
end

function F.saveWaypoint(name)
    name = string.sub(F.trimText(name), 1, Config.WAYPOINT_NAME_MAX)
    if name == "" then
        F.notify("Waypoint", "Enter a waypoint name first.", "warning", 2.0)
        return false
    end

    local root = F.getCharacterRoot()
    if not root then
        return false
    end

    if not State.waypoints[name] then
        table.insert(State.waypointOrder, name)
    end

    State.waypoints[name] = root.CFrame
    F.updateWaypointStatus()
    F.markConfigDirty()
    F.notify("Waypoint", "Saved: " .. name, "success", 1.8)
    return true
end

function F.deleteWaypoint(name)
    name = F.trimText(name)
    if name == "" or not State.waypoints[name] then
        F.notify("Waypoint", "Waypoint not found.", "warning", 1.8)
        return false
    end

    State.waypoints[name] = nil
    for index = #State.waypointOrder, 1, -1 do
        if State.waypointOrder[index] == name then
            table.remove(State.waypointOrder, index)
        end
    end

    F.updateWaypointStatus()
    F.markConfigDirty()
    return true
end

function F.flyToWaypoint(name)
    name = F.trimText(name)
    local target = State.waypoints[name]
    if typeof(target) ~= "CFrame" then
        F.notify("Waypoint", "Waypoint not found: " .. tostring(name), "warning", 2.0)
        return false
    end

    task.spawn(function()
        State.routeStatus = "Flying to " .. name
        F.updateWaypointStatus()
        local reached = F.flyToCFrame(
            target,
            "MANUAL",
            Config.RETURN_FLY_ARRIVAL_DISTANCE,
            Config.WORLD_FLY_MAX_TRAVEL_TIME,
            "Return"
        )
        State.routeStatus = reached and ("Reached " .. name) or ("Could not reach " .. name)
        F.updateWaypointStatus()
    end)

    return true
end

function F.startRouteRecording()
    State.routeRecording = true
    if State.routeRecordingToggle then
        State.routeRecordingToggle:SetSilent(true)
    end
    State.routeStatus = "Recording"
    State.routeLastRecordedPosition = nil
    F.updateWaypointStatus()
end

function F.stopRouteRecording()
    State.routeRecording = false
    if State.routeRecordingToggle then
        State.routeRecordingToggle:SetSilent(false)
    end
    State.routeStatus = "Recorded " .. tostring(#State.routePoints) .. " points"
    F.updateWaypointStatus()
    F.markConfigDirty()
end

function F.clearRecordedRoute()
    F.stopRecordedRoute("Idle")
    State.routePoints = {}
    State.routeLastRecordedPosition = nil
    State.routeStatus = "Cleared"
    if State.routeRecordingToggle then
        State.routeRecordingToggle:SetSilent(false)
    end
    State.routeRecording = false
    F.updateWaypointStatus()
    F.markConfigDirty()
end

function F.stopRecordedRoute(reason)
    State.routeRunToken = State.routeRunToken + 1
    State.routeRunning = false
    State.routeStatus = tostring(reason or "Stopped")
    State.manualMovementToken = (State.manualMovementToken or 0) + 1
    F.stopMovementFlight("MANUAL")
    F.releaseMovement("MANUAL")
    F.updateWaypointStatus()
end

function F.runRecordedRoute()
    if State.routeRunning then
        return false
    end

    if #State.routePoints == 0 then
        F.notify("Route", "No recorded route points.", "warning", 2.0)
        return false
    end

    State.routeRunToken = State.routeRunToken + 1
    local token = State.routeRunToken
    State.routeRunning = true

    task.spawn(function()
        local completed = true

        for index, target in ipairs(State.routePoints) do
            if not State.loopRunning
                or token ~= State.routeRunToken
            then
                completed = false
                break
            end

            State.routeStatus =
                "Running " .. tostring(index)
                .. "/" .. tostring(#State.routePoints)
            F.updateWaypointStatus()

            local reached = F.flyToCFrame(
                target,
                "MANUAL",
                Config.RETURN_FLY_ARRIVAL_DISTANCE,
                Config.WORLD_FLY_MAX_TRAVEL_TIME,
                "Return"
            )

            if not reached then
                completed = false
                break
            end
        end

        if token == State.routeRunToken then
            State.routeRunning = false
            State.routeStatus = completed and "Complete" or "Interrupted"
            F.updateWaypointStatus()
        end
    end)

    return true
end

-- =========================================================
-- SHARED FLIGHT / NOCLIP + LOOT / ITEM LOCK
-- =========================================================

function F.restoreMovementNoclip()
    local originals =
        State.movementFlightNoclipOriginals

    if originals then
        for part, originalCanCollide in pairs(originals) do
            if part and part.Parent then
                pcall(function()
                    part.CanCollide =
                        originalCanCollide
                end)
            end
        end
    end

    State.movementFlightNoclipOriginals =
        setmetatable({}, {__mode = "k"})
end

function F.applyMovementNoclip()
    if not State.movementFlightActive then
        return false
    end

    local character =
        F.getPlayerCharacter()

    if not character then
        return false
    end

    local originals =
        State.movementFlightNoclipOriginals

    if not originals then
        originals =
            setmetatable({}, {__mode = "k"})

        State.movementFlightNoclipOriginals =
            originals
    end

    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("BasePart") then
            if originals[object] == nil then
                originals[object] =
                    object.CanCollide
            end

            if object.CanCollide then
                object.CanCollide = false
            end
        end
    end

    return true
end

function F.stopMovementFlight(owner)
    if owner
        and State.movementFlightOwner
        and State.movementFlightOwner ~= owner
    then
        return false
    end

    local velocity =
        State.movementFlightVelocity

    local orientation =
        State.movementFlightOrientation

    local attachment =
        State.movementFlightAttachment

    local humanoid =
        State.movementFlightHumanoid

    if velocity then
        pcall(function()
            velocity.VectorVelocity =
                Vector3.zero
        end)

        pcall(function()
            velocity:Destroy()
        end)
    end

    if orientation then
        pcall(function()
            orientation:Destroy()
        end)
    end

    if attachment then
        pcall(function()
            attachment:Destroy()
        end)
    end

    F.restoreMovementNoclip()

    if humanoid and humanoid.Parent then
        if State.movementFlightOriginalPlatformStand ~= nil then
            pcall(function()
                humanoid.PlatformStand =
                    State.movementFlightOriginalPlatformStand
            end)
        end

        if State.movementFlightOriginalAutoRotate ~= nil then
            pcall(function()
                humanoid.AutoRotate =
                    State.movementFlightOriginalAutoRotate
            end)
        end
    end

    State.movementFlightActive = false
    State.movementFlightOwner = nil
    State.movementFlightChannel = nil
    State.movementFlightRoot = nil
    State.movementFlightHumanoid = nil
    State.movementFlightAttachment = nil
    State.movementFlightVelocity = nil
    State.movementFlightOrientation = nil
    State.movementFlightDistance = math.huge
    State.movementFlightArrived = false
    State.movementFlightOriginalAutoRotate = nil
    State.movementFlightOriginalPlatformStand = nil

    if not State.lootFlightActive then
        State.movementTelemetry.channel = "None"
        State.movementTelemetry.distance = 0
        State.movementTelemetry.velocity = 0
        State.movementTelemetry.eta = 0
        State.movementTelemetry.target = "None"
    end

    return true
end

function F.startMovementFlight(owner, speedChannel)
    local root =
        F.getCharacterRoot()

    local humanoid =
        F.getHumanoid()

    if not root or not humanoid then
        return false
    end

    if State.movementFlightActive
        and State.movementFlightRoot == root
        and State.movementFlightOwner == owner
        and State.movementFlightChannel == tostring(speedChannel or "Return")
        and State.movementFlightVelocity
        and State.movementFlightVelocity.Parent
    then
        return true
    end

    -- A newly starting controller always clears stale physics from the other
    -- flight family first. The movement coordinator still decides ownership.
    if F.stopLootFlight then
        F.stopLootFlight()
    end

    F.stopMovementFlight()

    local attachment =
        Instance.new("Attachment")

    attachment.Name =
        "TheVeilHub_MovementFlightAttachment"

    attachment.Parent = root

    local velocity =
        Instance.new("LinearVelocity")

    velocity.Name =
        "TheVeilHub_MovementFlightVelocity"

    velocity.Attachment0 = attachment
    velocity.RelativeTo =
        Enum.ActuatorRelativeTo.World

    velocity.VelocityConstraintMode =
        Enum.VelocityConstraintMode.Vector

    velocity.VectorVelocity =
        Vector3.zero

    velocity.MaxForce = 1000000000

    pcall(function()
        velocity.ForceLimitsEnabled = false
    end)

    velocity.Parent = root

    local orientation =
        Instance.new("AlignOrientation")

    orientation.Name =
        "TheVeilHub_MovementFlightOrientation"

    orientation.Attachment0 = attachment
    orientation.Mode =
        Enum.OrientationAlignmentMode.OneAttachment

    orientation.MaxTorque = 1000000000
    orientation.Responsiveness =
        Config.WORLD_FLY_RESPONSIVENESS

    orientation.RigidityEnabled = false
    orientation.CFrame =
        root.CFrame - root.Position

    orientation.Parent = root

    State.movementFlightOriginalAutoRotate =
        humanoid.AutoRotate

    State.movementFlightOriginalPlatformStand =
        humanoid.PlatformStand

    humanoid.AutoRotate = false
    humanoid.PlatformStand = true

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    State.movementFlightActive = true
    State.movementFlightOwner = owner
    State.movementFlightChannel = tostring(speedChannel or "Return")
    State.movementFlightRoot = root
    State.movementFlightHumanoid = humanoid
    State.movementFlightAttachment = attachment
    State.movementFlightVelocity = velocity
    State.movementFlightOrientation = orientation
    State.movementFlightDistance = math.huge
    State.movementFlightArrived = false

    F.applyMovementNoclip()

    return true
end

function F.updateMovementFlight(targetCFrame, owner, arrivalDistance, speedChannel)
    if typeof(targetCFrame) ~= "CFrame" then
        return false, math.huge
    end

    if F.getMovementOwner() ~= owner then
        F.stopMovementFlight(owner)
        return false, math.huge
    end

    if owner == "MANUAL"
        and State.monsterLockEnabled
    then
        -- Long manual flights must keep Monster Lock suspended for the entire
        -- trip, not only for the first couple of seconds.
        F.suspendMonsterLock(0.8)
    end

    local root =
        F.getCharacterRoot()

    if not root then
        return false, math.huge
    end

    speedChannel = tostring(speedChannel or State.movementFlightChannel or "Return")

    if not State.movementFlightActive
        or State.movementFlightRoot ~= root
        or State.movementFlightOwner ~= owner
        or State.movementFlightChannel ~= speedChannel
        or not State.movementFlightVelocity
        or not State.movementFlightVelocity.Parent
    then
        if not F.startMovementFlight(owner, speedChannel) then
            return false, math.huge
        end

        root = F.getCharacterRoot()
        if not root then
            return false, math.huge
        end
    end

    F.applyMovementNoclip()

    local offset =
        targetCFrame.Position - root.Position

    local distance =
        offset.Magnitude

    State.movementFlightDistance =
        distance

    local arrival =
        math.max(
            0.5,
            tonumber(arrivalDistance)
                or Config.WORLD_FLY_ARRIVAL_DISTANCE
        )

    local arrived =
        distance <= arrival

    State.movementFlightArrived =
        arrived

    local velocity =
        State.movementFlightVelocity

    local orientation =
        State.movementFlightOrientation

    local desiredRotation =
        targetCFrame - targetCFrame.Position

    if arrived then
        velocity.VectorVelocity =
            Vector3.zero

        root.AssemblyAngularVelocity =
            Vector3.zero

        if orientation then
            orientation.CFrame =
                desiredRotation
        end

        State.movementTelemetry.channel = speedChannel
        State.movementTelemetry.distance = distance
        State.movementTelemetry.velocity = root.AssemblyLinearVelocity.Magnitude
        State.movementTelemetry.eta = 0
        State.movementTelemetry.target = "World Flight"

        return true, distance
    end

    local scale =
        F.getEffectiveMovementScale(speedChannel)

    local maxSpeed =
        scale * Config.WORLD_FLY_SPEED_SCALE

    local brakeDistance =
        math.max(
            0,
            distance - arrival
        )

    local speed = maxSpeed

    if brakeDistance < Config.WORLD_FLY_BRAKE_RADIUS then
        speed =
            math.clamp(
                Config.WORLD_FLY_MIN_SPEED
                    + brakeDistance
                    * Config.WORLD_FLY_BRAKE_GAIN,
                Config.WORLD_FLY_MIN_SPEED,
                maxSpeed
            )
    end

    velocity.VectorVelocity =
        offset.Unit * speed

    F.updateAdaptiveMovement(
        speedChannel,
        distance,
        root,
        speed,
        offset.Unit
    )

    State.movementTelemetry.channel = speedChannel
    State.movementTelemetry.distance = distance
    State.movementTelemetry.velocity = root.AssemblyLinearVelocity.Magnitude
    State.movementTelemetry.eta = distance / math.max(1, speed)
    State.movementTelemetry.target = "World Flight"

    if orientation then
        local flatDirection =
            Vector3.new(
                offset.X,
                0,
                offset.Z
            )

        if flatDirection.Magnitude > 0.05 then
            orientation.CFrame =
                CFrame.lookAt(
                    Vector3.zero,
                    flatDirection.Unit
                )
        else
            orientation.CFrame =
                desiredRotation
        end
    end

    return false, distance
end

function F.flyToCFrame(targetCFrame, owner, arrivalDistance, maxTravelTime, speedChannel)
    if typeof(targetCFrame) ~= "CFrame" then
        return false
    end

    owner = tostring(owner or "MANUAL")

    if not Config.MOVEMENT_PRIORITIES[owner] then
        return false
    end

    local manualToken = nil
    local cellToken = nil

    if owner == "MANUAL" then
        State.manualMovementToken =
            (State.manualMovementToken or 0) + 1

        manualToken =
            State.manualMovementToken
    elseif owner == "CELL" and State.cellFarm then
        cellToken = State.cellFarm.token
    end

    local root =
        F.getCharacterRoot()

    if not root then
        return false
    end

    speedChannel = tostring(
        speedChannel
        or (owner == "MONSTER_LOCK" and "Monster")
        or (owner == "SELL" and "Merchant")
        or "Return"
    )

    local maxSpeed =
        math.max(
            1,
            F.getEffectiveMovementScale(speedChannel)
                * Config.WORLD_FLY_SPEED_SCALE
        )

    local initialDistance =
        (targetCFrame.Position - root.Position).Magnitude

    local timeout =
        math.clamp(
            (initialDistance / maxSpeed) * 2.4 + 3,
            4,
            tonumber(maxTravelTime)
                or Config.WORLD_FLY_MAX_TRAVEL_TIME
        )

    local deadline =
        os.clock() + timeout

    local stableFrames = 0
    local reached = false

    while State.loopRunning
        and os.clock() < deadline
    do
        if manualToken
            and State.manualMovementToken ~= manualToken
        then
            break
        end

        if cellToken
            and (
                not State.cellFarm.enabled
                or State.cellFarm.token ~= cellToken
            )
        then
            break
        end

        if not F.acquireMovement(owner, 1.0) then
            break
        end

        local arrived =
            F.updateMovementFlight(
                targetCFrame,
                owner,
                arrivalDistance,
                speedChannel
            )

        local currentRoot =
            F.getCharacterRoot()

        local linearSpeed =
            currentRoot
            and currentRoot.AssemblyLinearVelocity.Magnitude
            or math.huge

        if arrived
            and linearSpeed
                <= Config.WORLD_FLY_SETTLE_MAX_VELOCITY
        then
            stableFrames = stableFrames + 1

            if stableFrames
                >= Config.WORLD_FLY_SETTLE_FRAMES
            then
                reached = true
                break
            end
        else
            stableFrames = 0
        end

        task.wait(
            Config.WORLD_FLY_POLL
        )
    end

    F.stopMovementFlight(owner)
    F.releaseMovement(owner)

    return reached
end

function F.isLootLockActive(drop, owner, token)
    if not State.lootLockEnabled then
        return false
    end

    if drop and State.lockedDrop ~= drop then
        return false
    end

    if owner and State.lootLockOwner ~= owner then
        return false
    end

    if token and State.lootLockToken ~= token then
        return false
    end

    return true
end

function F.restoreLootNoclip()
    local originals =
        State.lootFlightNoclipOriginals

    if originals then
        for part, originalCanCollide in pairs(originals) do
            if part and part.Parent then
                pcall(function()
                    part.CanCollide =
                        originalCanCollide
                end)
            end
        end
    end

    State.lootFlightNoclipOriginals =
        setmetatable({}, {__mode = "k"})
end

function F.applyLootNoclip()
    if not State.lootFlightActive then
        return false
    end

    local character =
        F.getPlayerCharacter()

    if not character then
        return false
    end

    local originals =
        State.lootFlightNoclipOriginals

    if not originals then
        originals =
            setmetatable({}, {__mode = "k"})

        State.lootFlightNoclipOriginals =
            originals
    end

    for _, object in ipairs(
        character:GetDescendants()
    ) do
        if object:IsA("BasePart") then
            if originals[object] == nil then
                originals[object] =
                    object.CanCollide
            end

            if object.CanCollide then
                object.CanCollide = false
            end
        end
    end

    return true
end

function F.stopLootFlight(owner, token)
    if owner
        and State.lootFlightOwner
        and State.lootFlightOwner ~= owner
    then
        return false
    end

    if token
        and State.lootFlightToken ~= token
    then
        return false
    end

    local velocity =
        State.lootFlightVelocity

    local orientation =
        State.lootFlightOrientation

    local attachment =
        State.lootFlightAttachment

    local humanoid =
        State.lootFlightHumanoid

    if velocity then
        pcall(function()
            velocity.VectorVelocity =
                Vector3.zero
        end)

        pcall(function()
            velocity:Destroy()
        end)
    end

    if orientation then
        pcall(function()
            orientation:Destroy()
        end)
    end

    if attachment then
        pcall(function()
            attachment:Destroy()
        end)
    end

    F.restoreLootNoclip()

    if humanoid and humanoid.Parent then
        if State.lootFlightOriginalPlatformStand ~= nil then
            pcall(function()
                humanoid.PlatformStand =
                    State.lootFlightOriginalPlatformStand
            end)
        end

        if State.lootFlightOriginalAutoRotate ~= nil then
            pcall(function()
                humanoid.AutoRotate =
                    State.lootFlightOriginalAutoRotate
            end)
        end
    end

    State.lootFlightActive = false
    State.lootFlightOwner = nil
    State.lootFlightToken = 0
    State.lootFlightRoot = nil
    State.lootFlightHumanoid = nil
    State.lootFlightAttachment = nil
    State.lootFlightVelocity = nil
    State.lootFlightOrientation = nil
    State.lootFlightArrived = false
    State.lootFlightDistance = math.huge
    State.lootFlightArrivalDistance =
        Config.LOOT_FLY_ARRIVAL_DISTANCE
    State.lootFlightStartedAt = 0
    State.lootFlightOriginalAutoRotate = nil
    State.lootFlightOriginalPlatformStand = nil

    if not State.movementFlightActive then
        State.movementTelemetry.channel = "None"
        State.movementTelemetry.distance = 0
        State.movementTelemetry.velocity = 0
        State.movementTelemetry.eta = 0
        State.movementTelemetry.target = "None"
    end

    return true
end

function F.getLootArrivalDistance(drop)
    local arrival =
        Config.LOOT_FLY_ARRIVAL_DISTANCE

    if not drop or not drop.Parent then
        return arrival
    end

    local prompt =
        drop:FindFirstChildWhichIsA(
            "ProximityPrompt",
            true
        )

    if prompt and prompt.Enabled then
        local promptDistance =
            tonumber(
                prompt.MaxActivationDistance
            ) or 0

        if promptDistance > arrival then
            arrival =
                math.clamp(
                    promptDistance
                        - Config.LOOT_FLY_PROMPT_MARGIN,
                    Config.LOOT_FLY_ARRIVAL_DISTANCE,
                    Config.LOOT_FLY_MAX_INTERACT_DISTANCE
                )
        end
    end

    return arrival
end


function F.startLootFlight(drop, owner, token)
    if not F.isLootLockActive(
        drop,
        owner,
        token
    ) then
        return false
    end

    local root =
        F.getCharacterRoot()

    local humanoid =
        F.getHumanoid()

    if not root or not humanoid then
        return false
    end

    if State.lootFlightActive
        and State.lootFlightRoot == root
        and State.lootFlightOwner == owner
        and State.lootFlightToken == token
        and State.lootFlightVelocity
        and State.lootFlightVelocity.Parent
    then
        return true
    end

    -- Remove stale flight objects/state before creating a new controller.
    -- A higher-priority Loot owner may have preempted Monster/Merchant flight.
    if F.stopMovementFlight then
        F.stopMovementFlight()
    end

    F.stopLootFlight()

    local attachment =
        Instance.new("Attachment")

    attachment.Name =
        "TheVeilHub_LootFlightAttachment"

    attachment.Parent = root

    local velocity =
        Instance.new("LinearVelocity")

    velocity.Name =
        "TheVeilHub_LootFlightVelocity"

    velocity.Attachment0 = attachment
    velocity.RelativeTo =
        Enum.ActuatorRelativeTo.World

    velocity.VelocityConstraintMode =
        Enum.VelocityConstraintMode.Vector

    velocity.VectorVelocity =
        Vector3.zero

    velocity.MaxForce = 1000000000

    pcall(function()
        velocity.ForceLimitsEnabled = false
    end)

    velocity.Parent = root

    local orientation =
        Instance.new("AlignOrientation")

    orientation.Name =
        "TheVeilHub_LootFlightOrientation"

    orientation.Attachment0 = attachment
    orientation.Mode =
        Enum.OrientationAlignmentMode.OneAttachment

    orientation.MaxTorque = 1000000000
    orientation.Responsiveness =
        Config.LOOT_FLY_RESPONSIVENESS

    orientation.RigidityEnabled = false
    orientation.CFrame =
        root.CFrame - root.Position

    orientation.Parent = root

    State.lootFlightOriginalAutoRotate =
        humanoid.AutoRotate

    State.lootFlightOriginalPlatformStand =
        humanoid.PlatformStand

    humanoid.AutoRotate = false
    humanoid.PlatformStand = true

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    State.lootFlightActive = true
    State.lootFlightOwner = owner
    State.lootFlightToken = token
    State.lootFlightRoot = root
    State.lootFlightHumanoid = humanoid
    State.lootFlightAttachment = attachment
    State.lootFlightVelocity = velocity
    State.lootFlightOrientation = orientation
    State.lootFlightArrived = false
    State.lootFlightDistance = math.huge
    State.lootFlightArrivalDistance =
        F.getLootArrivalDistance(drop)
    State.lootFlightStartedAt = os.clock()

    F.applyLootNoclip()

    return true
end

function F.getLootFlightSpeedScale(owner)
    if owner == "FARM" then
        return F.getEffectiveMovementScale("Farm")
    end

    if owner == "CELL" then
        return F.getEffectiveMovementScale("Cell")
    end

    return Config.LOOT_FLY_SPEED
end

function F.updateLootFlight(drop, owner, token)
    if not F.isLootLockActive(
        drop,
        owner,
        token
    ) then
        return false, math.huge
    end

    -- Never let a live physics controller bypass the movement coordinator.
    if F.getMovementOwner() ~= owner then
        F.stopLootFlight(
            owner,
            token
        )
        return false, math.huge
    end

    if owner == "MANUAL"
        and State.monsterLockEnabled
    then
        -- Keep Monster Lock from reclaiming movement during long manual flights.
        F.suspendMonsterLock(0.8)
    end

    local root =
        F.getCharacterRoot()

    local target =
        F.getDropStandCFrame(
            drop
        )

    if not root or not target then
        return false, math.huge
    end

    if not State.lootFlightActive
        or State.lootFlightRoot ~= root
        or State.lootFlightOwner ~= owner
        or State.lootFlightToken ~= token
        or not State.lootFlightVelocity
        or not State.lootFlightVelocity.Parent
    then
        if not F.startLootFlight(
            drop,
            owner,
            token
        ) then
            return false, math.huge
        end
    end

    F.applyLootNoclip()

    local offset =
        target.Position - root.Position

    local distance =
        offset.Magnitude

    State.lootFlightDistance =
        distance

    local arrivalDistance =
        tonumber(
            State.lootFlightArrivalDistance
        )
        or F.getLootArrivalDistance(
            drop
        )

    local arrived =
        distance <= arrivalDistance

    State.lootFlightArrived =
        arrived

    local velocity =
        State.lootFlightVelocity

    if arrived then
        velocity.VectorVelocity =
            Vector3.zero

        root.AssemblyAngularVelocity =
            Vector3.zero

        State.movementTelemetry.channel = owner == "FARM" and "Farm" or "Return"
        State.movementTelemetry.distance = distance
        State.movementTelemetry.velocity = root.AssemblyLinearVelocity.Magnitude
        State.movementTelemetry.eta = 0
        State.movementTelemetry.target = tostring(drop.Name)

        return true, distance
    end

    local maxSpeed =
        F.getLootFlightSpeedScale(owner)
        * Config.LOOT_FLY_SPEED_SCALE

    -- v5.1 smart brake: hold full speed until the final approach, then
    -- decelerate based on distance remaining outside the usable pickup radius.
    local brakeDistance =
        math.max(
            0,
            distance - arrivalDistance
        )

    local speed =
        maxSpeed

    if brakeDistance < Config.LOOT_FLY_BRAKE_RADIUS then
        speed =
            math.clamp(
                Config.LOOT_FLY_MIN_SPEED
                    + brakeDistance
                    * Config.LOOT_FLY_BRAKE_GAIN,
                Config.LOOT_FLY_MIN_SPEED,
                maxSpeed
            )
    end

    velocity.VectorVelocity =
        offset.Unit * speed

    if owner == "FARM" then
        F.updateAdaptiveMovement(
            "Farm",
            distance,
            root,
            speed,
            offset.Unit
        )
    elseif owner == "CELL" then
        F.updateAdaptiveMovement(
            "Cell",
            distance,
            root,
            speed,
            offset.Unit
        )
    end

    State.movementTelemetry.channel =
        owner == "FARM" and "Farm"
        or owner == "CELL" and "Cell"
        or "Return"
    State.movementTelemetry.distance = distance
    State.movementTelemetry.velocity = root.AssemblyLinearVelocity.Magnitude
    State.movementTelemetry.eta = distance / math.max(1, speed)
    State.movementTelemetry.target = tostring(drop.Name)

    local flatDirection =
        Vector3.new(
            offset.X,
            0,
            offset.Z
        )

    if flatDirection.Magnitude > 0.05
        and State.lootFlightOrientation
    then
        State.lootFlightOrientation.CFrame =
            CFrame.lookAt(
                Vector3.zero,
                flatDirection.Unit
            )
    end

    return false, distance
end

function F.waitForLootStablePosition(drop, owner, token)
    local deadline =
        os.clock()
        + Config.LOOT_SETTLE_MAX_TIME

    local stableFrames = 0

    while State.loopRunning
        and F.isDropPresent(drop)
        and F.isLootLockActive(
            drop,
            owner,
            token
        )
        and os.clock() < deadline
    do
        local arrived =
            F.updateLootFlight(
                drop,
                owner,
                token
            )

        local root =
            F.getCharacterRoot()

        local linearSpeed =
            root
            and root.AssemblyLinearVelocity.Magnitude
            or math.huge

        if arrived
            and linearSpeed
                <= Config.LOOT_SETTLE_MAX_VELOCITY
        then
            stableFrames =
                stableFrames + 1

            if stableFrames
                >= Config.LOOT_SETTLE_FRAMES
            then
                return true
            end
        else
            stableFrames = 0
        end

        task.wait(
            Config.LOOT_CONFIRM_POLL
        )
    end

    -- Timeout is only a fallback. If we are still inside the valid interaction
    -- radius, proceed rather than paying another fixed settle delay.
    local arrived =
        F.updateLootFlight(
            drop,
            owner,
            token
        )

    return arrived == true
end

function F.waitForLootFlightArrival(drop, owner, token)
    local root =
        F.getCharacterRoot()

    local target =
        F.getDropStandCFrame(
            drop
        )

    if not root or not target then
        return false
    end

    local initialDistance =
        (target.Position - root.Position).Magnitude

    local maxSpeed =
        math.max(
            1,
            F.getLootFlightSpeedScale(owner)
                * Config.LOOT_FLY_SPEED_SCALE
        )

    -- Allow extra time for server corrections while keeping a hard cap so a bad
    -- target cannot trap the farm forever. Faster v5.1 travel needs less padding.
    local travelTimeout =
        math.clamp(
            (initialDistance / maxSpeed) * 2.4 + 3,
            4,
            Config.LOOT_FLY_MAX_TRAVEL_TIME
        )

    local deadline =
        os.clock() + travelTimeout

    while State.loopRunning
        and F.isDropPresent(drop)
        and F.isLootLockActive(
            drop,
            owner,
            token
        )
        and os.clock() < deadline
    do
        if owner == "FARM"
            and not State.farmEnabled
        then
            return false
        end

        local ownsMovement =
            F.acquireMovement(
                owner,
                1.0
            )

        if not ownsMovement then
            F.stopLootFlight(
                owner,
                token
            )

            task.wait(
                Config.LOOT_CONFIRM_POLL
            )
        else
            local arrived =
                F.updateLootFlight(
                    drop,
                    owner,
                    token
                )

            if arrived then
                return F.waitForLootStablePosition(
                    drop,
                    owner,
                    token
                )
            end

            task.wait(
                Config.LOOT_CONFIRM_POLL
            )
        end
    end

    return false
end

function F.stopLootLock(owner, token)
    if owner
        and State.lootLockOwner
        and State.lootLockOwner ~= owner
    then
        return false
    end

    if token
        and State.lootLockToken ~= token
    then
        return false
    end

    local previousOwner =
        State.lootLockOwner

    -- Owner/token were already validated above, so force-stop the active flight.
    -- This also guarantees Close Hub / respawn cleanup cannot leave stale
    -- constraints behind if flight state and lock state ever drift apart.
    F.stopLootFlight()

    State.lootLockEnabled = false
    State.lockedDrop = nil
    State.lootLockOwner = nil
    State.lootLockToken =
        (State.lootLockToken or 0) + 1

    if previousOwner then
        F.releaseMovement(
            previousOwner
        )
    end

    return true
end

State.applyLootLockPosition = function()
    if not State.lootLockEnabled then
        return false
    end

    local drop =
        State.lockedDrop

    local owner =
        State.lootLockOwner

    local token =
        State.lootLockToken

    if not drop
        or not owner
        or not F.isDropPresent(drop)
    then
        F.stopLootLock(
            owner,
            token
        )
        return false
    end

    if not F.acquireMovement(
        owner,
        0.45
    ) then
        -- A higher-priority system (Sell/Recovery) owns movement. Stop the
        -- physics controller completely so it cannot fight that system. The
        -- Item Lock remains valid and Heartbeat can restart flight later.
        F.stopLootFlight(
            owner,
            token
        )
        return false
    end

    local arrived =
        F.updateLootFlight(
            drop,
            owner,
            token
        )

    return arrived
end

function F.startLootLock(drop, owner)
    owner = tostring(owner or "")

    if owner ~= "FARM"
        and owner ~= "MANUAL"
        and owner ~= "CELL"
    then
        return nil
    end

    if owner == "MANUAL" then
        State.manualMovementToken =
            (State.manualMovementToken or 0) + 1

        F.stopMovementFlight("MANUAL")
    end

    if not F.isDropPresent(drop) then
        return nil
    end

    if not F.acquireMovement(
        owner,
        4
    ) then
        return nil
    end

    -- Stop any stale controller first. Token invalidation below prevents an
    -- older task from stopping the newly selected Drop.
    F.stopLootFlight()

    State.lootLockToken =
        (State.lootLockToken or 0) + 1

    local token =
        State.lootLockToken

    State.lockedDrop = drop
    State.lootLockOwner = owner
    State.lootLockEnabled = true

    if not F.startLootFlight(
        drop,
        owner,
        token
    ) then
        State.lootLockEnabled = false
        State.lockedDrop = nil
        State.lootLockOwner = nil
        State.lootLockToken =
            State.lootLockToken + 1

        F.releaseMovement(owner)
        return nil
    end

    return token
end

function F.collectDropConfirmed(drop)
    if not F.isDropPresent(drop) then
        State.farmPickupFailureCount = 0
        State.farmFailureHistory[drop] = nil
        return true
    end

    if State.isSpectating then
        F.resetCamera()
    end

    if not F.acquireMovement("FARM", 4) then
        F.setFarmState(
            "BACKOFF",
            "Movement busy: "
                .. tostring(
                    F.getMovementOwner()
                )
        )
        return false
    end

    local lockToken =
        F.startLootLock(
            drop,
            "FARM"
        )

    if not lockToken then
        F.releaseMovement("FARM")
        F.setFarmState(
            "BACKOFF",
            "Could not lock "
                .. tostring(drop.Name)
        )
        return false
    end

    F.setFarmState(
        "MOVING_TO_LOOT",
        "Flying to item: "
            .. tostring(drop.Name)
    )

    local arrived =
        F.waitForLootFlightArrival(
            drop,
            "FARM",
            lockToken
        )

    if not arrived then
        F.stopLootLock(
            "FARM",
            lockToken
        )

        if State.farmEnabled
            and State.loopRunning
            and F.isDropPresent(drop)
        then
            State.farmFailureHistory[drop] =
                (State.farmFailureHistory[drop] or 0) + 1

            State.farmFailedUntil[drop] =
                os.clock()
                + Config.LOOT_STUCK_COOLDOWN

            F.setFarmState(
                "BACKOFF",
                "Could not fly to "
                    .. tostring(drop.Name)
            )
        end

        return false
    end

    F.setFarmState(
        "CONFIRM_PICKUP",
        "Arrived at "
            .. tostring(drop.Name)
    )

    for attempt = 1, Config.LOOT_RETRY_COUNT do
        if not State.loopRunning
            or not State.farmEnabled
        then
            F.stopLootLock(
                "FARM",
                lockToken
            )
            return false
        end

        State.sessionStats.pickupAttempts =
            State.sessionStats.pickupAttempts + 1

        if not F.isDropPresent(drop) then
            State.farmPickupFailureCount = 0
            State.farmFailureHistory[drop] = nil
            F.stopLootLock(
                "FARM",
                lockToken
            )
            return true
        end

        if not F.isLootLockActive(
            drop,
            "FARM",
            lockToken
        ) then
            -- The Drop still exists but the lock was interrupted. Re-lock the
            -- same object instead of selecting another item mid-attempt.
            lockToken =
                F.startLootLock(
                    drop,
                    "FARM"
                )

            if not lockToken then
                break
            end

            local relockArrived =
                F.waitForLootFlightArrival(
                    drop,
                    "FARM",
                    lockToken
                )

            if not relockArrived then
                break
            end
        end

        local atDrop =
            State.applyLootLockPosition()

        if not atDrop then
            atDrop =
                F.waitForLootFlightArrival(
                    drop,
                    "FARM",
                    lockToken
                )
        end

        if not atDrop then
            break
        end

        task.wait(
            Config.LOOT_INTERACT_DELAY
        )

        local remoteRequested =
            F.fireDirectDropPickup(
                drop
            )

        if remoteRequested then
            F.setFarmState(
                "PICKUP_REQUEST",
                "Locked pickup attempt "
                    .. tostring(attempt)
            )

            local remoteDeadline =
                os.clock()
                + Config.LOOT_REMOTE_CONFIRM_TIMEOUT

            while State.loopRunning
                and State.farmEnabled
                and os.clock() < remoteDeadline
                and F.isDropPresent(drop)
            do
                if F.isLootLockActive(
                    drop,
                    "FARM",
                    lockToken
                ) then
                    State.applyLootLockPosition()
                end

                task.wait(
                    Config.LOOT_CONFIRM_POLL
                )
            end

            if not F.isDropPresent(drop) then
                State.farmPickupFailureCount = 0
                State.farmFailureHistory[drop] = nil
                F.stopLootLock(
                    "FARM",
                    lockToken
                )
                return true
            end

            if not State.loopRunning
                or not State.farmEnabled
            then
                F.stopLootLock(
                    "FARM",
                    lockToken
                )
                return false
            end
        end

        F.setFarmState(
            "PROMPT_FALLBACK",
            "Locked E attempt "
                .. tostring(attempt)
        )

        local atDropForPrompt =
            State.applyLootLockPosition()

        if not atDropForPrompt then
            atDropForPrompt =
                F.waitForLootFlightArrival(
                    drop,
                    "FARM",
                    lockToken
                )
        end

        if not atDropForPrompt then
            break
        end

        F.pressLootInteractKey()

        local deadline =
            os.clock()
            + Config.LOOT_CONFIRM_TIMEOUT

        while State.loopRunning
            and State.farmEnabled
            and os.clock() < deadline
            and F.isDropPresent(drop)
        do
            if F.isLootLockActive(
                drop,
                "FARM",
                lockToken
            ) then
                State.applyLootLockPosition()
            end

            task.wait(
                Config.LOOT_CONFIRM_POLL
            )
        end

        if not F.isDropPresent(drop) then
            State.farmPickupFailureCount = 0
            State.farmFailureHistory[drop] = nil
            F.stopLootLock(
                "FARM",
                lockToken
            )
            return true
        end

        task.wait(
            Config.LOOT_STABILIZE_DELAY
        )
    end

    F.stopLootLock(
        "FARM",
        lockToken
    )

    State.farmPickupFailureCount =
        State.farmPickupFailureCount + 1

    State.farmFailureHistory[drop] =
        (State.farmFailureHistory[drop] or 0) + 1

    State.farmFailedUntil[drop] =
        os.clock()
        + Config.LOOT_STUCK_COOLDOWN

    State.sessionStats.pickupFailures =
        State.sessionStats.pickupFailures + 1

    F.requestRecovery(
        "Drop",
        "Locked pickup confirmation failed"
    )

    return false
end

function F.stopAutoFarm(reason)
    State.farmEnabled = false
    State.farmBusy = false
    State.farmNoMatchSince = nil
    State.farmStatus =
        reason or "Stopped"
    F.setFarmState("IDLE", State.farmStatus)
    F.stopLootLock("FARM")
    F.releaseMovement("FARM")

    if State.farmToggle then
        State.farmToggle:SetSilent(false)
    end

    F.markConfigDirty()
    F.updateFarmStatus()
end

function F.runAutoFarmStep()
    if not State.farmEnabled
        or State.farmBusy
        or State.sellBusy
        or State.serverHopBusy
    then
        return
    end

    local farmWorldReady,
        farmWorldReason =
            F.isFarmWorldReady()

    if not farmWorldReady then
        State.farmNoMatchSince = nil
        F.setFarmState("WORLD_WAIT", tostring(farmWorldReason))
        F.requestRecovery("World", farmWorldReason)

        F.updateFarmStatus()
        return
    end

    F.setFarmState("INVENTORY_CHECK", "Checking inventory")

    local isFull,
        capacityCurrent,
        capacityMax =
            F.isInventoryFull()

    if isFull then
        if State.sellEnabled then
            F.setFarmState(
                "SELLING",
                "Inventory full - flying to Merchant"
            )

            F.tryAutoSellForFarm(
                "Inventory full "
                .. tostring(capacityCurrent)
                .. "/"
                .. tostring(capacityMax)
                .. " - selling"
            )
        else
            F.setFarmState(
                "INVENTORY_FULL",
                "Inventory full "
                    .. tostring(capacityCurrent)
                    .. "/"
                    .. tostring(capacityMax)
                    .. " | Auto Sell OFF"
            )
        end

        F.updateFarmStatus()
        return
    end

    local drop =
        F.getBestFarmDrop()

    if drop then
        State.farmNoMatchSince = nil
        State.farmBusy = true
        State.farmMachine.lastDrop = tostring(drop.Name)
        F.setFarmState("MOVING_TO_LOOT", "Looting " .. tostring(drop.Name))

        F.updateFarmStatus()

        local success =
            F.collectDropConfirmed(
                drop
            )

        -- The toggle may be turned off while a locked pickup is in progress.
        -- Treat that as cancellation, not as a pickup failure/recovery event.
        if not State.farmEnabled
            or not State.loopRunning
        then
            State.farmBusy = false
            F.stopLootLock("FARM")
            F.updateFarmStatus()
            return
        end

        if success then
            State.farmLootedCount =
                State.farmLootedCount + 1

            State.sessionStats.lootConfirmed =
                State.sessionStats.lootConfirmed + 1

            F.setFarmState("SEARCHING", "Collected " .. tostring(drop.Name))

            if State.farmStopAfterFirst then
                State.farmBusy = false
                F.stopAutoFarm(
                    "Stopped after target"
                )
                return
            end
        else
            local fullNow,
                currentNow,
                maxNow =
                    F.isInventoryFull()

            local pickupBlocked =
                (State.farmPickupFailureCount or 0) > 0

            if (
                fullNow
                or pickupBlocked
            )
                and State.sellEnabled
            then
                F.setFarmState(
                    "SELLING",
                    fullNow
                    and (
                        "Inventory full "
                        .. tostring(currentNow)
                        .. "/"
                        .. tostring(maxNow)
                        .. " - flying to Merchant"
                    )
                    or "Pickup could not be confirmed - flying to Merchant"
                )

                F.updateFarmStatus()

                F.tryAutoSellForFarm(
                    fullNow
                    and "Inventory full - selling"
                    or "Pickup blocked after all retries - selling for space"
                )
            elseif fullNow then
                F.setFarmState(
                    "INVENTORY_FULL",
                    "Inventory full "
                        .. tostring(currentNow)
                        .. "/"
                        .. tostring(maxNow)
                        .. " | Auto Sell OFF"
                )

                F.updateFarmStatus()
            elseif pickupBlocked then
                F.setFarmState(
                    "PICKUP_BLOCKED",
                    "Pickup blocked after all retries | Auto Sell OFF"
                )

                F.updateFarmStatus()
            else
                -- Flight/path interruption is not proof that inventory is
                -- blocked. Retry farming without wasting a Merchant trip.
                F.setFarmState(
                    "RECOVERING",
                    "Movement/route failed - retrying without selling"
                )

                F.updateFarmStatus()
            end
        end

        State.farmBusy = false
        F.updateFarmStatus()
        return
    end

    if not State.farmNoMatchSince then
        State.farmNoMatchSince =
            os.clock()
    end

    local elapsed =
        os.clock()
        - State.farmNoMatchSince

    F.setFarmState(
        "EMPTY_WAIT",
        "Waiting "
        .. string.format(
            "%.0fs",
            math.max(
                0,
                State.farmEmptyWait
                - elapsed
            )
        )
    )

    if State.farmAutoHopEnabled
        and elapsed >= State.farmEmptyWait
    then
        State.farmNoMatchSince =
            os.clock()

        F.setFarmState("HOPPING", "Server hop triggered")

        F.updateFarmStatus()

        task.spawn(function()
            local hopped =
                F.serverHop(
                    "Auto Farm empty"
                )

            if not hopped
                and State.farmEnabled
            then
                State.farmStatus =
                    "Hop failed - waiting to retry"

                F.updateFarmStatus()
            end
        end)
    else
        F.updateFarmStatus()
    end
end

function F.getInventoryRoots()
    local roots = {}
    local seen = {}

    local function add(root)
        if root
            and root.Parent
            and not seen[root]
        then
            seen[root] = true
            table.insert(roots, root)
        end
    end

    add(
        LocalPlayer:FindFirstChildOfClass(
            "Backpack"
        )
    )

    for _, child in ipairs(
        LocalPlayer:GetChildren()
    ) do
        local lowered =
            string.lower(child.Name)

        if lowered == "inventory"
            or lowered == "items"
            or lowered == "storage"
            or lowered == "bag"
        then
            add(child)
        end
    end

    return roots
end

function F.getInventoryItemRarity(item)
    local rarityInfo =
        F.getDropRarity(item)

    if rarityInfo.Key ~= "unknown" then
        F.learnItemName(
            item.Name,
            rarityInfo
        )

        return rarityInfo
    end

    local knownKey =
        State.itemRarityCatalog[
            string.lower(
                tostring(item.Name)
            )
        ]

    return
        Config.DROP_RARITY_BY_KEY[
            knownKey or "unknown"
        ]
        or Config.DROP_RARITY_BY_KEY.unknown
end

function F.collectInventoryItems()
    local result = {}
    local seen = {}

    local function walk(container)
        for _, child in ipairs(
            container:GetChildren()
        ) do
            if child:IsA("Tool") then
                if not seen[child] then
                    seen[child] = true
                    table.insert(
                        result,
                        child
                    )
                end
            else
                local rarityInfo =
                    F.getInventoryItemRarity(
                        child
                    )

                local knownByName =
                    State.itemRarityCatalog[
                        string.lower(
                            child.Name
                        )
                    ] ~= nil

                if rarityInfo.Key ~= "unknown"
                    or knownByName
                then
                    if (
                        child:IsA("Model")
                        or child:IsA("Folder")
                        or child:IsA("Configuration")
                    )
                    and not seen[child]
                    then
                        seen[child] = true
                        table.insert(
                            result,
                            child
                        )
                    end
                elseif #child:GetChildren() > 0 then
                    walk(child)
                end
            end
        end
    end

    for _, root in ipairs(
        F.getInventoryRoots()
    ) do
        walk(root)
    end

    return result
end

function F.findInventoryCapacityLabel()
    local cached =
        State.inventoryCapacityLabel

    if cached and cached.Parent then
        local ok, cachedText =
            pcall(function()
                return tostring(cached.Text)
            end)

        if ok then
            local lowered =
                string.lower(cachedText)

            if string.find(
                lowered,
                "capacity",
                1,
                true
            )
                and string.match(
                    lowered,
                    "(%d+)%s*/%s*(%d+)"
                )
            then
                return cached
            end
        end
    end

    State.inventoryCapacityLabel = nil

    local playerGui =
        LocalPlayer:FindFirstChildOfClass(
            "PlayerGui"
        )

    if not playerGui then
        return nil
    end

    for _, object in ipairs(
        playerGui:GetDescendants()
    ) do
        if object:IsA("TextLabel")
            or object:IsA("TextButton")
            or object:IsA("TextBox")
        then
            local textValue =
                tostring(object.Text or "")

            local lowered =
                string.lower(textValue)

            if string.find(
                lowered,
                "capacity",
                1,
                true
            )
                and string.match(
                    lowered,
                    "(%d+)%s*/%s*(%d+)"
                )
            then
                State.inventoryCapacityLabel =
                    object

                return object
            end
        end
    end

    return nil
end

function F.getInventoryCapacity()
    local current = nil
    local maximum = nil
    local source = "fallback"

    local capacityLabel =
        F.findInventoryCapacityLabel()

    if capacityLabel then
        local ok, textValue =
            pcall(function()
                return tostring(
                    capacityLabel.Text
                )
            end)

        if ok then
            local currentText,
                maximumText =
                    string.match(
                        string.lower(
                            textValue
                        ),
                        "(%d+)%s*/%s*(%d+)"
                    )

            current =
                tonumber(currentText)

            maximum =
                tonumber(maximumText)

            if current and maximum then
                source = "UI"
            end
        end
    end

    if not current or not maximum then
        current =
            #F.collectInventoryItems()

        maximum =
            Config.INVENTORY_MAX_CAPACITY

        source = "scan"
    end

    current =
        math.max(
            0,
            math.floor(current)
        )

    maximum =
        math.max(
            1,
            math.floor(maximum)
        )

    State.inventoryCapacityCurrent =
        current

    State.inventoryCapacityMax =
        maximum

    State.inventoryCapacitySource =
        source

    return current, maximum, source
end

function F.isInventoryFull()
    local current, maximum =
        F.getInventoryCapacity()

    return
        current >= maximum,
        current,
        maximum
end

function F.isFarmTargetProtected(item)
    if not item
        or #State.farmTargetOrder == 0
    then
        return false
    end

    local itemName =
        string.lower(
            tostring(item.Name)
        )

    if State.farmTargetNames[
        itemName
    ] == true
    then
        return true
    end

    if State.farmContainsMode then
        for _, targetName in ipairs(
            State.farmTargetOrder
        ) do
            local query =
                string.lower(
                    tostring(targetName)
                )

            if query ~= ""
                and string.find(
                    itemName,
                    query,
                    1,
                    true
                )
            then
                return true
            end
        end
    end

    return false
end

function F.isNeverSellItem(item)
    if not item then
        return true
    end

    local loweredName =
        string.lower(
            tostring(item.Name)
        )

    if State.neverSellNames[
        loweredName
    ] == true
    then
        return true
    end

    return
        F.isFarmTargetProtected(
            item
        )
end

function F.collectSellCandidates()
    local result = {}

    for _, item in ipairs(
        F.collectInventoryItems()
    ) do
        if item
            and item.Parent
            and not F.isNeverSellItem(item)
        then
            local rarityInfo =
                F.getInventoryItemRarity(
                    item
                )

            if State.sellRaritySet[
                rarityInfo.Key
            ] == true
            then
                table.insert(
                    result,
                    item
                )
            end
        end
    end

    return result
end

function F.updateSellStatus()
    local label =
        State.sellStatusLabel

    if not label
        or not label.Parent
    then
        return
    end

    local candidateCount =
        #F.collectSellCandidates()

    local capacityCurrent,
        capacityMax =
            F.getInventoryCapacity()

    State.sellStatusLabel.Text =
        "Sell: "
        .. (
            State.sellEnabled
            and State.sellStatus
            or "OFF"
        )
        .. " | Matching inventory: "
        .. tostring(candidateCount)
        .. " | Capacity: "
        .. tostring(capacityCurrent)
        .. "/"
        .. tostring(capacityMax)
        .. " | Mode: FULL/BLOCKED ONLY"
        .. " | Sold confirmed: "
        .. tostring(State.soldCount)
end

State.updateSellStatus =
    F.updateSellStatus

function F.findMerchant()
    local playerRoot =
        F.getCharacterRoot()

    local candidates = {}
    local seen = {}

    local function consider(instance)
        if not instance
            or seen[instance]
            or not instance:IsA("Model")
        then
            return
        end

        local lowered =
            string.lower(
                tostring(instance.Name)
            )

        -- Matches exact live NPC Models such as:
        -- workspace.NPCs["Clement, Merchant"]
        -- workspace.NPCs["David, Merchant"]
        -- and any other NPC whose Model name contains Merchant.
        if not string.find(
            lowered,
            "merchant",
            1,
            true
        ) then
            return
        end

        local part =
            F.getMerchantPart(instance)

        if not part then
            return
        end

        seen[instance] = true

        local distance = math.huge

        if playerRoot then
            distance =
                (
                    part.Position
                    - playerRoot.Position
                ).Magnitude
        end

        table.insert(
            candidates,
            {
                Merchant = instance,
                Distance = distance,
            }
        )
    end

    local npcs =
        workspace:FindFirstChild(
            "NPCs"
        )

    if npcs then
        -- Merchant NPCs are direct children such as workspace.NPCs["Clement, Merchant"].
        -- Scan direct children first so DialogEvent gets the exact live NPC Model.
        for _, instance in ipairs(
            npcs:GetChildren()
        ) do
            consider(instance)
        end

        -- Fallback in case a future map nests NPC Models.
        if #candidates == 0 then
            for _, instance in ipairs(
                npcs:GetDescendants()
            ) do
                consider(instance)
            end
        end
    end

    -- Last-resort fallback for Streaming/layout changes.
    -- ReplicatedStorage templates are intentionally ignored.
    if #candidates == 0 then
        for _, instance in ipairs(
            workspace:GetDescendants()
        ) do
            consider(instance)
        end
    end

    if #candidates == 0 then
        return nil
    end

    table.sort(
        candidates,
        function(a, b)
            if a.Distance == b.Distance then
                return
                    tostring(
                        a.Merchant.Name
                    )
                    < tostring(
                        b.Merchant.Name
                    )
            end

            return
                a.Distance
                < b.Distance
        end
    )

    return candidates[1].Merchant
end

function F.waitForMerchant(timeout)
    local deadline =
        os.clock()
        + (
            tonumber(timeout)
            or Config.MERCHANT_WAIT_TIMEOUT
        )

    local lastStatusUpdate = 0

    while State.loopRunning
        and os.clock() < deadline
    do
        local merchant =
            F.findMerchant()

        if merchant then
            return merchant
        end

        if os.clock()
            - lastStatusUpdate
            >= 1
        then
            lastStatusUpdate =
                os.clock()

            State.sellStatus =
                "Waiting for Merchant"

            if State.updateSellStatus then
                State.updateSellStatus()
            end
        end

        task.wait(
            Config.MERCHANT_RETRY_INTERVAL
        )
    end

    return nil
end

function F.waitForCharacterReady(timeout)
    local deadline =
        os.clock()
        + (
            tonumber(timeout)
            or Config.RESPAWN_TIMEOUT
        )

    while State.loopRunning
        and os.clock() < deadline
    do
        local character =
            LocalPlayer.Character

        if character and character.Parent then
            local humanoid =
                character:FindFirstChildOfClass(
                    "Humanoid"
                )

            local root =
                character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if humanoid
                and root
                and root:IsA("BasePart")
                and humanoid.Health > 0
            then
                return character, root
            end
        end

        task.wait(0.15)
    end

    return nil, nil
end

function F.resetCharacterToTown()
    if State.merchantResetInProgress then
        return false, "Reset already running"
    end

    if os.clock()
        < State.merchantResetCooldownUntil
    then
        return false, "Reset cooldown"
    end

    State.merchantResetInProgress = true
    State.merchantResetCooldownUntil =
        os.clock()
        + Config.TOWN_RESET_COOLDOWN

    State.sellStatus =
        "Merchant missing - resetting to town"

    F.updateSellStatus()

    local oldCharacter =
        LocalPlayer.Character

    local resetRequested =
        pcall(function()
            local humanoid =
                oldCharacter
                and oldCharacter:FindFirstChildOfClass(
                    "Humanoid"
                )

            if humanoid then
                pcall(function()
                    humanoid:ChangeState(
                        Enum.HumanoidStateType.Dead
                    )
                end)

                humanoid.Health = 0
            end

            if oldCharacter
                and oldCharacter.Parent
            then
                oldCharacter:BreakJoints()
            end
        end)

    if not resetRequested then
        State.merchantResetInProgress = false
        return false, "Reset request failed"
    end

    local deadline =
        os.clock()
        + Config.RESPAWN_TIMEOUT

    local newCharacter = nil
    local newRoot = nil

    while State.loopRunning
        and os.clock() < deadline
    do
        local character =
            LocalPlayer.Character

        if character
            and character ~= oldCharacter
            and character.Parent
        then
            local humanoid =
                character:FindFirstChildOfClass(
                    "Humanoid"
                )

            local root =
                character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if humanoid
                and humanoid.Health > 0
                and root
                and root:IsA("BasePart")
            then
                newCharacter = character
                newRoot = root
                break
            end
        end

        task.wait(0.15)
    end

    if not newCharacter then
        State.merchantResetInProgress = false
        return false, "Respawn timeout"
    end

    -- Ask StreamingEnabled games to prioritize the new town/spawn area.
    pcall(function()
        LocalPlayer:RequestStreamAroundAsync(
            newRoot.Position,
            5
        )
    end)

    task.wait(1.5)

    State.merchantResetInProgress = false
    return true, "Respawned"
end

function F.getMerchantPart(merchant)
    if not merchant then
        return nil
    end

    local root =
        merchant:FindFirstChild(
            "HumanoidRootPart",
            true
        )

    if root
        and root:IsA("BasePart")
    then
        return root
    end

    if merchant:IsA("Model")
        and merchant.PrimaryPart
    then
        return merchant.PrimaryPart
    end

    return merchant:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end

function F.flyNearMerchant(merchant)
    local merchantPart =
        F.getMerchantPart(
            merchant
        )

    if not merchantPart then
        return false
    end

    local targetPosition =
        merchantPart.Position
        + merchantPart.CFrame.LookVector
        * 4

    local target =
        CFrame.lookAt(
            targetPosition,
            merchantPart.Position
        )

    return F.flyToCFrame(
        target,
        "SELL",
        Config.MERCHANT_FLY_ARRIVAL_DISTANCE,
        Config.WORLD_FLY_MAX_TRAVEL_TIME,
        "Merchant"
    )
end

function F.getMerchantRemotes()
    if not Remotes or not Remotes.Parent then
        F.refreshCoreRemotes()
    end

    if not Remotes then
        return nil, nil, nil
    end

    return
        Remotes:FindFirstChild(
            "DialogEvent"
        ),
        Remotes:FindFirstChild(
            "RegisterNPCInteraction"
        ),
        Remotes:FindFirstChild(
            "SellItemsEvent"
        )
end

function F.runAutoSell(forceSell, options)
    options = type(options) == "table" and options or {}

    if State.sellBusy
        or (
            State.farmBusy
            and not forceSell
        )
        or (
            State.serverHopBusy
            and not forceSell
        )
    then
        return false
    end

    if not State.worldReady then
        State.sellStatus =
            State.worldReadyStatus
            or "Waiting for world"

        F.updateSellStatus()

        if not F.ensureWorldReady(
            Config.WORLD_READY_TIMEOUT
        ) then
            State.sellStatus =
                "World load timeout"

            F.updateSellStatus()
            return false
        end
    end

    local candidates =
        type(options.candidates) == "table"
        and options.candidates
        or F.collectSellCandidates()

    if #candidates == 0 then
        State.sellStatus =
            "No matching items"

        F.updateSellStatus()
        return true
    end

    -- No item-count threshold. If this function is called, sell the
    -- currently eligible items. Automatic callers only invoke it when the
    -- inventory is full or a confirmed pickup is blocked.
    -- Lock Auto Farm while we search/reset/sell so the character
    -- cannot be moved away by another automation step.
    State.sellBusy = true
    State.sellStatus =
        "Finding Merchant"

    F.updateSellStatus()

    local allowTownReset =
        options.allowTownReset == true
        or (
            forceSell
            and State.farmEnabled
        )

    local initialWait =
        allowTownReset
        and Config.MERCHANT_INITIAL_WAIT
        or Config.MERCHANT_WAIT_TIMEOUT

    local merchant =
        F.waitForMerchant(
            initialWait
        )

    if not merchant
        and allowTownReset
    then
        local resetOk,
            resetReason =
                F.resetCharacterToTown()

        if resetOk then
            State.sellStatus =
                "Town respawned - loading Merchant"

            F.updateSellStatus()

            merchant =
                F.waitForMerchant(
                    Config.MERCHANT_POST_RESET_WAIT
                )
        else
            State.sellStatus =
                "Town reset unavailable: "
                .. tostring(resetReason)

            F.updateSellStatus()
        end
    end

    if not merchant then
        State.sellBusy = false
        State.sellStatus =
            "Merchant not loaded"

        F.updateSellStatus()

        F.notify(
            "Auto Sell",
            "Merchant was not available. Auto Farm will retry later; reset-to-town is rate-limited to prevent a death loop.",
            "warning",
            3.5
        )

        F.requestRecovery("Merchant", "Merchant unavailable or not streamed")

        return false
    end

    if options.cellMode then
        candidates =
            F.collectCellSellCandidates()

        if #candidates == 0 then
            State.sellBusy = false
            State.sellStatus =
                "Cell inventory already clean"
            F.updateSellStatus()
            return true
        end
    end

    local dialogEvent,
        registerEvent,
        sellEvent =
            F.getMerchantRemotes()

    if not dialogEvent
        or not registerEvent
        or not sellEvent
    then
        State.sellBusy = false
        State.sellStatus =
            "Merchant remotes missing"

        F.updateSellStatus()
        F.recordError("AutoSell", "Merchant remotes missing")
        F.requestRecovery("Remote", "Merchant remote contract missing")
        return false
    end

    local root =
        F.getCharacterRoot()

    local returnCFrame =
        (not options.skipReturn)
        and root
        and root.CFrame
        or nil

    State.sellStatus =
        "Opening "
        .. tostring(merchant.Name)

    F.updateSellStatus()

    -- Keep Monster Lock ON. Auto Sell temporarily owns movement while
    -- the shared flight controller carries the player to/from the Merchant.
    if not F.flyNearMerchant(
        merchant
    ) then
        State.sellBusy = false
        State.sellStatus =
            "Flight failed"

        F.updateSellStatus()
        return false
    end

    task.wait(
        Config.MERCHANT_INTERACT_DELAY
    )

    State.movementTelemetry.lastRemote =
        "Merchant Dialog/Register/Sell pipeline"
    State.movementTelemetry.lastAction =
        "Selling " .. tostring(#candidates) .. " items"

    local success, err =
        pcall(function()
            dialogEvent:FireServer(
                "start",
                merchant,
                1
            )

            task.wait(
                Config.MERCHANT_INTERACT_DELAY
            )

            dialogEvent:FireServer(
                "option",
                merchant,
                2
            )

            task.wait(
                Config.MERCHANT_INTERACT_DELAY
            )

            registerEvent:FireServer(
                merchant.Name
            )

            task.wait(
                Config.MERCHANT_INTERACT_DELAY
            )

            sellEvent:FireServer(
                candidates
            )
        end)

    task.wait(0.45)

    local confirmed = 0

    for _, item in ipairs(candidates) do
        if not item.Parent then
            confirmed =
                confirmed + 1
        end
    end

    State.soldCount =
        State.soldCount
        + confirmed

    State.sessionStats.sellRuns = State.sessionStats.sellRuns + 1
    State.sessionStats.soldConfirmed = State.sessionStats.soldConfirmed + confirmed

    if success then
        State.sellStatus =
            "Merchant "
            .. tostring(merchant.Name)
            .. " | requested "
            .. tostring(#candidates)
            .. " | confirmed "
            .. tostring(confirmed)
    else
        State.sellStatus =
            "Sell request failed"

        warn(
            "[The Veil Hub][AutoSell]",
            err
        )
        F.recordError("AutoSell", err)
        F.requestRecovery("Sell", "Sell request failed")
    end

    if returnCFrame then
        State.sellStatus =
            "Returning by flight"

        F.updateSellStatus()

        F.flyToCFrame(
            returnCFrame,
            "SELL",
            Config.RETURN_FLY_ARRIVAL_DISTANCE,
            Config.WORLD_FLY_MAX_TRAVEL_TIME,
            "Return"
        )
    end

    State.sellBusy = false
    F.stopMovementFlight("SELL")
    F.releaseMovement("SELL")
    F.updateSellStatus()

    return success
end

function F.tryAutoSellForFarm(reason)
    if not State.farmEnabled
        or State.sellBusy
        or State.serverHopBusy
    then
        return false
    end

    if os.clock()
        < State.farmFullSellRetryAt
    then
        return false
    end

    State.farmFullSellRetryAt =
        os.clock()
        + Config.FARM_FULL_SELL_RETRY_DELAY

    local capacityCurrent,
        capacityMax =
            F.getInventoryCapacity()

    local candidates =
        F.collectSellCandidates()

    if #candidates == 0 then
        State.farmStatus =
            "Inventory "
            .. tostring(capacityCurrent)
            .. "/"
            .. tostring(capacityMax)
            .. " - no sellable items"

        State.sellStatus =
            "No sellable items | Targets protected"

        F.updateFarmStatus()
        F.updateSellStatus()

        F.notify(
            "Auto Farm",
            "Inventory needs space, but no items match Sell Rarity. Farm Item Names and Never Sell items are protected.",
            "warning",
            3.5
        )

        return false
    end

    State.farmStatus =
        reason
        or (
            "Inventory "
            .. tostring(capacityCurrent)
            .. "/"
            .. tostring(capacityMax)
            .. " - selling"
        )

    F.updateFarmStatus()

    local success =
        F.runAutoSell(true)

    local afterCurrent,
        afterMax =
            F.getInventoryCapacity()

    if success then
        State.farmPickupFailureCount = 0

        State.farmStatus =
            "Sold for space "
            .. tostring(afterCurrent)
            .. "/"
            .. tostring(afterMax)
    else
        State.farmStatus =
            "Auto Sell failed - retrying"
    end

    F.updateFarmStatus()
    return success
end

function F.exportRaritySet(selectionSet)
    local result = {}

    for _, rarityInfo in ipairs(
        Config.DROP_RARITIES
    ) do
        if rarityInfo.Key ~= "unknown"
            and selectionSet[
                rarityInfo.Key
            ] == true
        then
            table.insert(
                result,
                rarityInfo.Key
            )
        end
    end

    return result
end

function F.importRaritySet(
    targetSet,
    values
)
    if type(values) ~= "table" then
        return
    end

    for _, rarityInfo in ipairs(
        Config.DROP_RARITIES
    ) do
        if rarityInfo.Key ~= "unknown" then
            targetSet[
                rarityInfo.Key
            ] = false
        end
    end

    for _, key in ipairs(values) do
        key =
            string.lower(
                tostring(key)
            )

        if Config.DROP_RARITY_BY_KEY[key]
            and key ~= "unknown"
        then
            targetSet[key] = true
        end
    end
end



-- =========================================================
-- AUTO NIGHT CALL
--
-- Inventory aliases:
--   Nightcall Potion (confirmed UI name)
--   Night Call / Nightcall / Night-Call / Night_Call (legacy aliases)
--
-- The exact Night Call Cobalt use call has not been captured yet.
-- First attempt uses the game's observed ConsumableEvent(name, CFrame)
-- contract; Tool:Activate() is used as a fallback when applicable.
--
-- Auto mode consumes at most ONE confirmed Night Call per server.
-- This avoids accidentally burning a whole stack while the effect
-- duration is unknown. USE NOW can force another attempt.
-- =========================================================

function F.normalizeNightCallName(name)
    return string.lower(
        tostring(name or "")
    ):gsub(
        "[^%w]",
        ""
    )
end

function F.isNightCallName(name)
    local normalized =
        F.normalizeNightCallName(
            name
        )

    return
        normalized == "nightcall"
        or normalized == "nightcallpotion"
end

function F.getNightCallItemQuantity(item)
    if not item then
        return nil
    end

    local aliases = {
        amount = true,
        count = true,
        quantity = true,
        stack = true,
        stacks = true,
    }

    for key, value in pairs(
        item:GetAttributes()
    ) do
        local normalized =
            string.lower(
                tostring(key)
            ):gsub(
                "[^%w]",
                ""
            )

        if aliases[normalized] then
            local numberValue =
                tonumber(value)

            if numberValue then
                return
                    math.max(
                        0,
                        numberValue
                    )
            end
        end
    end

    for _, child in ipairs(
        item:GetChildren()
    ) do
        if child:IsA("IntValue")
            or child:IsA("NumberValue")
        then
            local normalized =
                string.lower(
                    tostring(child.Name)
                ):gsub(
                    "[^%w]",
                    ""
                )

            if aliases[normalized] then
                return
                    math.max(
                        0,
                        tonumber(
                            child.Value
                        ) or 0
                    )
            end
        end
    end

    return nil
end

function F.collectNightCallItems()
    local result = {}
    local seen = {}

    local function addCandidate(object)
        if not object
            or not object.Parent
            or seen[object]
            or not F.isNightCallName(
                object.Name
            )
        then
            return
        end

        seen[object] = true
        table.insert(
            result,
            object
        )
    end

    local function scan(root)
        if not root
            or not root.Parent
        then
            return
        end

        addCandidate(root)

        for _, object in ipairs(
            root:GetDescendants()
        ) do
            addCandidate(object)
        end
    end

    for _, root in ipairs(
        F.getInventoryRoots()
    ) do
        scan(root)
    end

    -- Equipped Tool support.
    scan(
        LocalPlayer.Character
    )

    table.sort(
        result,
        function(a, b)
            local aTool =
                a:IsA("Tool")
            local bTool =
                b:IsA("Tool")

            if aTool ~= bTool then
                return aTool
            end

            return
                tostring(a.Name)
                < tostring(b.Name)
        end
    )

    State.nightCallInventoryCount =
        #result

    return result
end

function F.getNightCallTotalUnits()
    local units = 0

    for _, item in ipairs(
        F.collectNightCallItems()
    ) do
        local quantity =
            F.getNightCallItemQuantity(
                item
            )

        if quantity ~= nil then
            units =
                units + quantity
        else
            units =
                units + 1
        end
    end

    return units
end

function F.getNightCallJobId()
    local jobId =
        tostring(
            game.JobId or ""
        )

    if jobId ~= "" then
        return jobId
    end

    return
        "place:"
        .. tostring(
            game.PlaceId
        )
end

function F.updateNightCallStatus()
    local label =
        State.nightCallStatusLabel

    local items =
        F.collectNightCallItems()

    local count =
        #items

    if not label
        or not label.Parent
    then
        return
    end

    local usedThisServer =
        State.nightCallUsedJobId
        == F.getNightCallJobId()

    local modeText = "OFF"

    if State.nightCallEnabled then
        modeText = "ON"

        if usedThisServer then
            modeText =
                "ON / USED THIS SERVER"
        elseif State.nightCallBusy then
            modeText =
                "ON / USING"
        end
    end

    label.Text =
        "Nightcall Potion: "
        .. modeText
        .. " | Inventory: "
        .. tostring(count)
        .. " | "
        .. tostring(
            State.nightCallStatus
        )
end

State.updateNightCallStatus =
    F.updateNightCallStatus

function F.confirmNightCallConsumed(
    item,
    unitsBefore
)
    local started =
        os.clock()

    while
        os.clock() - started
        < Config.NIGHTCALL_CONFIRM_TIMEOUT
    do
        if not item
            or not item.Parent
        then
            return true
        end

        local unitsNow =
            F.getNightCallTotalUnits()

        if unitsNow < unitsBefore then
            return true
        end

        task.wait(
            Config.NIGHTCALL_CONFIRM_POLL
        )
    end

    return false
end

function F.restoreWeaponAfterNightCall(previousWeapon)
    if not previousWeapon
        or not previousWeapon.Parent
        or F.isNightCallName(
            previousWeapon.Name
        )
    then
        return false
    end

    local character =
        F.getPlayerCharacter()

    if character
        and previousWeapon.Parent
            == character
    then
        State.currentWeaponTool =
            previousWeapon

        return true
    end

    local humanoid =
        F.getHumanoid()

    if not humanoid then
        return false
    end

    -- Give the potion a short moment to finish its own equip/use state.
    task.wait(0.08)

    local ok =
        pcall(function()
            humanoid:EquipTool(
                previousWeapon
            )
        end)

    if not ok then
        return false
    end

    task.wait(0.06)

    if character
        and previousWeapon.Parent
            == character
    then
        State.currentWeaponTool =
            previousWeapon

        return true
    end

    return false
end

function F.useNightCall(forceUse)
    if State.nightCallBusy then
        return false
    end

    if not forceUse
        and not State.nightCallEnabled
    then
        return false
    end

    if not forceUse
        and State.nightCallUsedJobId
            == F.getNightCallJobId()
    then
        State.nightCallStatus =
            "Already used in this server"

        F.updateNightCallStatus()
        return true
    end

    if not forceUse
        and os.clock()
            < State.nightCallNextRetryAt
    then
        return false
    end

    local items =
        F.collectNightCallItems()

    local item =
        items[1]

    if not item then
        State.nightCallStatus =
            "Waiting for Nightcall Potion"

        F.updateNightCallStatus()
        return false
    end

    local previousWeapon =
        F.getEquippedWeaponTool()

    if previousWeapon
        and F.isNightCallName(
            previousWeapon.Name
        )
    then
        previousWeapon = nil
    end

    State.nightCallBusy = true
    State.nightCallStatus =
        "Using "
        .. tostring(
            item.Name
        )

    F.updateNightCallStatus()

    local unitsBefore =
        F.getNightCallTotalUnits()

    if not ConsumableEvent
        or not ConsumableEvent.Parent
    then
        F.refreshCoreRemotes()
    end

    local remoteSent = false

    if ConsumableEvent then
        local root =
            F.getCharacterRoot()

        local target =
            root
            and root.CFrame
            or CFrame.new()

        remoteSent =
            pcall(function()
                ConsumableEvent:FireServer(
                    item.Name,
                    target
                )
            end)
    end

    local confirmed =
        false

    if remoteSent then
        confirmed =
            F.confirmNightCallConsumed(
                item,
                unitsBefore
            )
    end

    if not confirmed
        and item
        and item.Parent
        and item:IsA("Tool")
    then
        local humanoid =
            F.getHumanoid()

        if humanoid
            and item.Parent
                ~= LocalPlayer.Character
        then
            pcall(function()
                humanoid:EquipTool(
                    item
                )
            end)

            task.wait(0.10)
        end

        pcall(function()
            item:Activate()
        end)

        confirmed =
            F.confirmNightCallConsumed(
                item,
                unitsBefore
            )
    end

    if confirmed then
        State.nightCallUsedJobId =
            F.getNightCallJobId()

        State.nightCallLastUseAtUnix =
            os.time()

        State.nightCallUseCount =
            State.nightCallUseCount + 1

        State.sessionStats.nightCallConfirmedUses =
            State.sessionStats.nightCallConfirmedUses + 1

        State.nightCallStatus =
            "Used successfully"

        State.nightCallNextRetryAt = 0
        F.markConfigDirty()
    else
        State.nightCallStatus =
            "Use not confirmed - retrying"

        State.nightCallNextRetryAt =
            os.clock()
            + Config.NIGHTCALL_RETRY_SECONDS
    end

    local weaponRestored =
        F.restoreWeaponAfterNightCall(
            previousWeapon
        )

    if confirmed
        and previousWeapon
        and previousWeapon.Parent
    then
        State.nightCallStatus =
            weaponRestored
            and "Used successfully | Weapon restored"
            or "Used successfully | Restore weapon failed"
    end

    State.nightCallBusy = false
    F.updateNightCallStatus()

    return confirmed
end

function F.runAutoNightCallStep()
    if not State.nightCallEnabled
        or State.nightCallBusy
    then
        return
    end

    if State.nightCallUsedJobId
        == F.getNightCallJobId()
    then
        F.updateNightCallStatus()
        return
    end

    F.useNightCall(false)
end

-- =========================================================
-- AUTO SILVER GACHA
--
-- Contract captured from Cobalt:
-- GemGachaEvent:FireServer("Silver", nil)
--
-- The server only exposes the generic cooldown card to the client.
-- Therefore:
--   1. New/unknown cooldown -> probe every 30s.
--   2. If no cooldown card arrives during the response window,
--      treat the request as accepted and schedule the next one at +20m.
--   3. If a late cooldown card arrives, it corrects the schedule.
-- =========================================================

function F.formatGachaTime(seconds)
    seconds =
        math.max(
            0,
            math.floor(
                tonumber(seconds) or 0
            )
        )

    local minutes =
        math.floor(
            seconds / 60
        )

    local secs =
        seconds % 60

    return string.format(
        "%02d:%02d",
        minutes,
        secs
    )
end

function F.updateGachaStatus()
    local label =
        State.gachaStatusLabel

    if not label
        or not label.Parent
    then
        return
    end

    if not State.gachaEnabled then
        label.Text =
            "Silver Gacha: OFF | BUY NOW is still available"

        return
    end

    local now =
        os.time()

    local remaining =
        math.max(
            0,
            (tonumber(
                State.gachaNextBuyAtUnix
            ) or 0)
            - now
        )

    local nextText = "READY"

    if State.gachaRequestInFlight then
        nextText = "REQUESTING"
    elseif remaining > 0 then
        nextText =
            F.formatGachaTime(
                remaining
            )
    end

    label.Text =
        "Silver Gacha: ON | "
        .. tostring(
            State.gachaStatus
        )
        .. " | Next: "
        .. nextText
        .. " | Cycles: "
        .. tostring(
            State.gachaPurchaseCycles
        )
end

State.updateGachaStatus =
    F.updateGachaStatus

function F.refreshGachaRemotes()
    if not Remotes
        or not Remotes.Parent
    then
        F.refreshCoreRemotes()
    end

    if not Remotes then
        return nil, nil
    end

    local gachaEvent =
        Remotes:FindFirstChild(
            "GemGachaEvent"
        )

    local notifyEvent =
        Remotes:FindFirstChild(
            "NotifyCardEvent"
        )

    return gachaEvent, notifyEvent
end

function F.isGemGachaCooldownCard(
    title,
    message,
    cardId
)
    if tostring(cardId)
        == "gemgacha-cooldown"
    then
        return true
    end

    local titleText =
        string.lower(
            tostring(title or "")
        )

    local messageText =
        string.lower(
            tostring(message or "")
        )

    return
        string.find(
            titleText,
            "gem gacha",
            1,
            true
        ) ~= nil
        and string.find(
            messageText,
            "20 minutes",
            1,
            true
        ) ~= nil
end

function F.bindGachaCooldownListener()
    local _, notifyEvent =
        F.refreshGachaRemotes()

    if State.gachaNotifyRemote
        == notifyEvent
        and State.gachaNotifyConnection
    then
        return true
    end

    if State.gachaNotifyConnection then
        pcall(function()
            State.gachaNotifyConnection:
                Disconnect()
        end)

        State.gachaNotifyConnection =
            nil
    end

    State.gachaNotifyRemote =
        notifyEvent

    if not notifyEvent
        or not notifyEvent:IsA(
            "RemoteEvent"
        )
    then
        return false
    end

    State.gachaNotifyConnection =
        notifyEvent.OnClientEvent:
            Connect(function(
                title,
                message,
                _cardType,
                _payload,
                cardId
            )
                if not F.isGemGachaCooldownCard(
                    title,
                    message,
                    cardId
                ) then
                    return
                end

                -- No exact remaining duration is exposed by this event.
                -- Probe quietly instead of waiting another full 20 minutes.
                State.gachaCooldownDetected =
                    true

                State.gachaAwaitingResult =
                    false

                State.gachaNextBuyAtUnix =
                    os.time()
                    + Config.GACHA_UNKNOWN_COOLDOWN_RETRY

                State.gachaStatus =
                    "Server cooldown - auto retry"

                F.markConfigDirty()
                F.updateGachaStatus()
            end)

    return true
end

function F.requestSilverGacha(forceRequest)
    if State.gachaRequestInFlight then
        return false
    end

    if not forceRequest
        and not State.gachaEnabled
    then
        return false
    end

    F.bindGachaCooldownListener()

    local gachaEvent =
        select(
            1,
            F.refreshGachaRemotes()
        )

    if not gachaEvent
        or not gachaEvent:IsA(
            "RemoteEvent"
        )
    then
        State.gachaStatus =
            "Waiting for GemGachaEvent"

        State.gachaNextBuyAtUnix =
            os.time()
            + Config.GACHA_REMOTE_RETRY

        F.updateGachaStatus()
        return false
    end

    State.gachaRequestInFlight =
        true

    State.sessionStats.gachaAttempts =
        State.sessionStats.gachaAttempts + 1

    State.gachaAwaitingResult =
        true

    State.gachaCooldownDetected =
        false

    State.gachaAttemptToken =
        State.gachaAttemptToken + 1

    local attemptToken =
        State.gachaAttemptToken

    State.gachaLastAttemptAtUnix =
        os.time()

    State.gachaStatus =
        "REQUEST SENT"

    F.updateGachaStatus()

    State.movementTelemetry.lastRemote =
        "GemGachaEvent:Silver"
    State.movementTelemetry.lastAction =
        "Silver gacha request"

    local success, err =
        pcall(function()
            gachaEvent:FireServer(
                "Silver",
                nil
            )
        end)

    if not success then
        State.gachaRequestInFlight =
            false

        State.gachaAwaitingResult =
            false

        State.gachaStatus =
            "Request failed - retrying"

        State.gachaNextBuyAtUnix =
            os.time()
            + Config.GACHA_REMOTE_RETRY

        F.markConfigDirty()
        F.updateGachaStatus()

        warn(
            "[The Veil Hub][GemGacha]",
            err
        )

        return false
    end

    task.wait(
        Config.GACHA_RESPONSE_WINDOW
    )

    if attemptToken
        ~= State.gachaAttemptToken
    then
        State.gachaRequestInFlight =
            false

        return false
    end

    if State.gachaCooldownDetected then
        State.gachaStatus =
            "Server cooldown - auto retry"

        if State.gachaNextBuyAtUnix
            <= os.time()
        then
            State.gachaNextBuyAtUnix =
                os.time()
                + Config.GACHA_UNKNOWN_COOLDOWN_RETRY
        end
    else
        -- The observed game contract has no separate success event.
        -- If no cooldown rejection arrives, treat the request as accepted.
        State.gachaNextBuyAtUnix =
            os.time()
            + Config.GACHA_CYCLE_SECONDS

        State.gachaPurchaseCycles =
            State.gachaPurchaseCycles + 1

        State.gachaStatus =
            "ASSUMED ACCEPTED | Cycle active"
    end

    State.gachaAwaitingResult =
        false

    State.gachaRequestInFlight =
        false

    F.markConfigDirty()
    F.updateGachaStatus()

    return
        not State.gachaCooldownDetected
end

function F.runAutoSilverGachaStep()
    if not State.gachaEnabled
        or State.gachaRequestInFlight
    then
        return
    end

    F.bindGachaCooldownListener()

    local now =
        os.time()

    local nextAt =
        tonumber(
            State.gachaNextBuyAtUnix
        ) or 0

    if nextAt <= now then
        F.requestSilverGacha(false)
    else
        F.updateGachaStatus()
    end
end

