function F.classifyInteractionArgument(argument, targetName)
    local value = string.lower(F.trimText(argument))
    local name = string.lower(F.trimText(targetName))

    if value == "pickupdrop" then
        return "Loot"
    elseif value == "opencest" or value == "openchest"
        or string.find(value, "chest", 1, true)
        or string.find(name, "chest", 1, true)
    then
        return "Chest"
    elseif value == "bountyboard"
        or string.find(value, "bounty", 1, true)
    then
        return "Bounty"
    elseif value == "battlefieldpylon"
        or string.find(value, "pylon", 1, true)
    then
        return "Pylon"
    elseif value == "uptweendoor"
        or string.find(value, "door", 1, true)
    then
        return "Door"
    elseif string.find(value, "waypoint", 1, true) then
        return "Waypoint"
    elseif string.find(value, "shop", 1, true)
        or string.find(value, "buy", 1, true)
        or string.find(name, "merchant", 1, true)
    then
        return "Shop"
    elseif string.find(value, "boss", 1, true)
        or string.find(value, "crystal", 1, true)
        or string.find(value, "summon", 1, true)
    then
        return "Boss/Event"
    end

    return "Interactable"
end

function F.classifyNPCService(eventName, argument, npcName, hasOpenShop)
    local eventText = string.lower(F.trimText(eventName))
    local argumentText = string.lower(F.trimText(argument))
    local nameText = string.lower(F.trimText(npcName))

    if hasOpenShop == true
        or eventText == "buyitem"
        or string.find(eventText, "shop", 1, true)
        or string.find(nameText, "merchant", 1, true)
    then
        return "Shop"
    elseif string.find(eventText, "sidequest", 1, true)
        or string.find(eventText, "quest", 1, true)
    then
        return "Quest"
    elseif string.find(eventText, "waypoint", 1, true) then
        return "Waypoint"
    elseif string.find(eventText, "enhance", 1, true)
        or string.find(nameText, "blacksmith", 1, true)
    then
        return "Enhancement"
    elseif string.find(eventText, "bounty", 1, true) then
        return "Bounty"
    elseif string.find(eventText, "dye", 1, true)
        or string.find(nameText, "stylist", 1, true)
    then
        return "Style"
    elseif string.find(eventText, "race", 1, true) then
        return "Race"
    elseif string.find(eventText, "celloflife", 1, true)
        or string.find(eventText, "cradle", 1, true)
        or string.find(eventText, "summon", 1, true)
        or string.find(argumentText, "summonboss", 1, true)
    then
        return "Boss/Event"
    elseif string.find(nameText, "potion", 1, true) then
        return "Potion"
    end

    return eventText ~= "" and "Event" or "Dialogue"
end

function F.addNPCServiceRecord(record, serviceName, eventName, argument, detail)
    if type(record) ~= "table" then
        return
    end

    serviceName = F.trimText(serviceName)
    eventName = F.trimText(eventName)
    argument = F.trimText(argument)
    detail = F.trimText(detail)

    if serviceName == "" then
        serviceName = "Dialogue"
    end

    record.ServiceSet = record.ServiceSet or {}
    record.Services = record.Services or {}
    record.Events = record.Events or {}
    record.EventKeys = record.EventKeys or {}

    if not record.ServiceSet[serviceName] then
        record.ServiceSet[serviceName] = true
        table.insert(record.Services, serviceName)
    end

    local eventKey = eventName .. "|" .. argument .. "|" .. detail
    if eventName ~= "" and not record.EventKeys[eventKey] then
        record.EventKeys[eventKey] = true
        table.insert(record.Events, {
            Event = eventName,
            Argument = argument,
            Detail = detail,
            Service = serviceName,
        })
    end
end

function F.extractNPCServiceHints(value, record, seen, depth)
    if type(value) ~= "table" or type(record) ~= "table" then
        return
    end

    seen = seen or {}
    depth = tonumber(depth) or 0
    if depth > Config.NPC_INTEL_DIALOGUE_MAX_DEPTH or seen[value] then
        return
    end
    seen[value] = true

    if rawget(value, "openShop") == true then
        F.addNPCServiceRecord(record, "Shop", "OpenShop", "", "dialogue option")
    end

    local eventValue = rawget(value, "event")
    if eventValue ~= nil then
        local eventName = ""
        local argument = ""

        if type(eventValue) == "string" then
            eventName = eventValue
        elseif type(eventValue) == "table" then
            eventName = eventValue.name or eventValue.Name or ""
            argument = eventValue.argument or eventValue.Argument or ""
        end

        eventName = tostring(eventName or "")
        argument = tostring(argument or "")

        if eventName ~= "" then
            F.addNPCServiceRecord(
                record,
                F.classifyNPCService(eventName, argument, record.Name, false),
                eventName,
                argument,
                "dialogue event"
            )
        end
    end

    for _, child in pairs(value) do
        if type(child) == "table" then
            F.extractNPCServiceHints(child, record, seen, depth + 1)
        end
    end
end

function F.getIntelTargetCFrame(target)
    if not target or not target.Parent then
        return nil, nil
    end

    if target:IsA("BasePart") then
        return target.CFrame, target
    end

    if target:IsA("Tool") then
        local handle = target:FindFirstChild("Handle")
        if handle and handle:IsA("BasePart") then
            return handle.CFrame, handle
        end
    end

    local dialogPart = target:FindFirstChild("DialogPart", true)
    if dialogPart and dialogPart:IsA("BasePart") then
        return dialogPart.CFrame, dialogPart
    end

    local humanoidRoot = target:FindFirstChild("HumanoidRootPart", true)
    if humanoidRoot and humanoidRoot:IsA("BasePart") then
        return humanoidRoot.CFrame, humanoidRoot
    end

    if target:IsA("Model") then
        if target.PrimaryPart then
            return target.PrimaryPart.CFrame, target.PrimaryPart
        end

        local ok, pivot = pcall(function()
            return target:GetPivot()
        end)
        if ok and typeof(pivot) == "CFrame" then
            return pivot, nil
        end
    end

    local part = target:FindFirstChildWhichIsA("BasePart", true)
    if part then
        return part.CFrame, part
    end

    return nil, nil
end

function F.getNPCIntelDistance(record)
    if type(record) ~= "table" then
        return math.huge
    end

    local root = F.getCharacterRoot()
    local targetCFrame = F.getIntelTargetCFrame(record.Instance)
    if not root or typeof(targetCFrame) ~= "CFrame" then
        return math.huge
    end

    return (targetCFrame.Position - root.Position).Magnitude
end

function F.scanUniversalInteractions()
    local intel = State.npcIntel
    intel.interactions = {}
    intel.interactionCounts = {}

    local descendants = Workspace:GetDescendants()
    local seenTargets = {}

    for index, descendant in ipairs(descendants) do
        if descendant:IsA("StringValue")
            and descendant.Name == "Argument"
            and descendant.Parent
        then
            local target = descendant.Parent
            local argument = tostring(descendant.Value or "")
            local fullName = target:GetFullName()
            local marker = target:FindFirstChild("IsInteractable")
            local qualifies =
                marker ~= nil
                or argument == "PickupDrop"
                or string.find(fullName, "Workspace.Systems.Interactables", 1, true) ~= nil

            if qualifies and argument ~= "" and not seenTargets[target] then
                seenTargets[target] = true

                local category = F.classifyInteractionArgument(argument, target.Name)
                intel.interactionCounts[category] = (intel.interactionCounts[category] or 0) + 1

                table.insert(intel.interactions, {
                    Kind = "Interaction",
                    Name = tostring(target.Name),
                    Path = fullName,
                    Instance = target,
                    Argument = argument,
                    Category = category,
                    HasMarker = marker ~= nil,
                })
            end
        end

        if index % Config.INTERACTION_SCAN_YIELD_EVERY == 0 then
            task.wait()
        end
    end

    table.sort(intel.interactions, function(a, b)
        local ac = tostring(a.Category or "")
        local bc = tostring(b.Category or "")
        if ac ~= bc then
            return ac < bc
        end
        return tostring(a.Name or "") < tostring(b.Name or "")
    end)

    return intel.interactions
end

function F.buildNPCServiceDirectory()
    local intel = State.npcIntel
    local db = State.gameDB

    intel.npcs = {}
    intel.npcOrder = {}
    intel.services = {}
    intel.serviceCounts = {}

    for _, dialogue in pairs(db.dialogueByNPC or {}) do
        if type(dialogue) == "table" then
            local npcName = tostring(dialogue.Name or "Unknown")
            local key = tostring(dialogue.Path or npcName)
            local record = {
                Kind = "NPC",
                Key = key,
                Name = npcName,
                Path = tostring(dialogue.Path or ""),
                Instance = dialogue.Instance,
                Module = dialogue.Module,
                Data = dialogue.Data,
                Services = {},
                ServiceSet = {},
                Events = {},
                EventKeys = {},
            }

            F.extractNPCServiceHints(dialogue.Data, record, nil, 0)

            local lowerName = string.lower(npcName)
            if string.find(lowerName, "blacksmith", 1, true) then
                F.addNPCServiceRecord(record, "Enhancement", "", "", "name hint")
            elseif string.find(lowerName, "merchant", 1, true) then
                F.addNPCServiceRecord(record, "Shop", "", "", "name hint")
            elseif string.find(lowerName, "potion", 1, true) then
                F.addNPCServiceRecord(record, "Potion", "", "", "name hint")
            elseif string.find(lowerName, "stylist", 1, true) then
                F.addNPCServiceRecord(record, "Style", "", "", "name hint")
            end

            if #record.Services == 0 then
                F.addNPCServiceRecord(record, "Dialogue", "", "", "dialogue only")
            end

            table.sort(record.Services)
            intel.npcs[key] = record
            table.insert(intel.npcOrder, record)

            for _, service in ipairs(record.Services) do
                intel.serviceCounts[service] = (intel.serviceCounts[service] or 0) + 1
                intel.services[service] = intel.services[service] or {}
                table.insert(intel.services[service], record)
            end
        end
    end

    table.sort(intel.npcOrder, function(a, b)
        local aUseful = (#(a.Events or {}) > 0 or not (a.ServiceSet or {}).Dialogue) and 1 or 0
        local bUseful = (#(b.Events or {}) > 0 or not (b.ServiceSet or {}).Dialogue) and 1 or 0
        if aUseful ~= bUseful then
            return aUseful > bUseful
        end
        return tostring(a.Name or "") < tostring(b.Name or "")
    end)

    return intel.npcOrder
end

function F.getNPCIntelligenceSummary()
    local intel = State.npcIntel

    local serviceParts = {}
    for name, count in pairs(intel.serviceCounts or {}) do
        table.insert(serviceParts, tostring(name) .. " " .. tostring(count))
    end
    table.sort(serviceParts)

    local interactionParts = {}
    for name, count in pairs(intel.interactionCounts or {}) do
        table.insert(interactionParts, tostring(name) .. " " .. tostring(count))
    end
    table.sort(interactionParts)

    return table.concat({
        "=== The Veil Hub NPC / Interaction Intelligence ===",
        "Status: " .. tostring(intel.status)
            .. " | Loaded: " .. tostring(intel.loaded)
            .. " | Loading: " .. tostring(intel.loading),
        "NPC Dialogue Records: " .. tostring(#(intel.npcOrder or {}))
            .. " | Universal Interactables: " .. tostring(#(intel.interactions or {})),
        "Services: " .. (#serviceParts > 0 and table.concat(serviceParts, " | ") or "None"),
        "Interactions: " .. (#interactionParts > 0 and table.concat(interactionParts, " | ") or "None"),
        "Protocol: metadata Argument/IsInteractable only; no guessed remote names",
    }, "\n")
end

function F.formatNPCIntelRecord(record)
    if type(record) ~= "table" then
        return "No target selected."
    end

    local distance = F.getNPCIntelDistance(record)
    local distanceText = distance < math.huge and string.format("%.1f studs", distance) or "Unknown"

    if record.Kind == "NPC" then
        local eventLines = {}
        for index, event in ipairs(record.Events or {}) do
            if index > 8 then
                table.insert(eventLines, "... +" .. tostring(#record.Events - 8) .. " more")
                break
            end
            local text = tostring(event.Event or "")
            if tostring(event.Argument or "") ~= "" then
                text = text .. "(" .. tostring(event.Argument) .. ")"
            end
            table.insert(eventLines, text)
        end

        return table.concat({
            "[NPC] " .. tostring(record.Name),
            "Services: " .. table.concat(record.Services or {}, ", "),
            "Distance: " .. distanceText,
            "Events: " .. (#eventLines > 0 and table.concat(eventLines, " | ") or "Dialogue only"),
            "Path: " .. tostring(record.Path or ""),
        }, "\n")
    end

    return table.concat({
        "[" .. tostring(record.Category or "Interactable") .. "] " .. tostring(record.Name),
        "Argument: " .. tostring(record.Argument or ""),
        "Distance: " .. distanceText,
        "IsInteractable marker: " .. tostring(record.HasMarker == true),
        "Path: " .. tostring(record.Path or ""),
    }, "\n")
end

