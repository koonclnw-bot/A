    then
        globalEnv.__TheVeilHub_CradleTraceHookSupported =
            false

        return false
    end

    local oldNamecall = nil

    local function describeTraceArg(value)
        local valueType =
            typeof(value)

        if valueType == "Instance" then
            local fullName =
                tostring(value)

            pcall(function()
                fullName =
                    value:GetFullName()
            end)

            return
                "Instance<"
                .. tostring(value.ClassName)
                .. ">:"
                .. fullName
        end

        if valueType == "string" then
            local text =
                tostring(value)

            if #text > 120 then
                text =
                    string.sub(
                        text,
                        1,
                        117
                    )
                    .. "..."
            end

            return
                string.format(
                    "%q",
                    text
                )
        end

        if valueType == "table" then
            local count = 0

            for _ in pairs(value) do
                count = count + 1

                if count >= 20 then
                    break
                end
            end

            return
                "table(~"
                .. tostring(count)
                .. ")"
        end

        return
            valueType
            .. ":"
            .. tostring(value)
    end

    local function interceptNamecall(self, ...)
        local method = nil

        pcall(function()
            method =
                getnamecallmethod()
        end)

        local traceState =
            globalEnv.__TheVeilHub_CradleTraceState

        if traceState
            and traceState.Enabled
            and (
                method == "FireServer"
                or method == "InvokeServer"
            )
            and typeof(self) == "Instance"
            and (
                self:IsA("RemoteEvent")
                or self:IsA("RemoteFunction")
            )
        then
            local include = false

            pcall(function()
                include =
                    self:IsDescendantOf(
                        game:GetService(
                            "ReplicatedStorage"
                        )
                    )
            end)

            if include then
                local calls =
                    traceState.Calls

                if type(calls) ~= "table" then
                    calls = {}
                    traceState.Calls = calls
                end

                local maxCalls =
                    tonumber(
                        traceState.MaxCalls
                    )
                    or 120

                if #calls < maxCalls then
                    local argCount =
                        select(
                            "#",
                            ...
                        )

                    local parts = {}

                    for index = 1,
                        math.min(
                            argCount,
                            8
                        )
                    do
                        table.insert(
                            parts,
                            describeTraceArg(
                                select(
                                    index,
                                    ...
                                )
                            )
                        )
                    end

                    local remoteName =
                        tostring(self)

                    pcall(function()
                        remoteName =
                            self:GetFullName()
                    end)

                    local elapsed =
                        os.clock()
                        - (
                            tonumber(
                                traceState.StartedAt
                            )
                            or os.clock()
                        )

                    local record = {
                        t = elapsed,
                        method = tostring(method),
                        remote = remoteName,
                        args =
                            table.concat(
                                parts,
                                ", "
                            ),
                    }

                    table.insert(
                        calls,
                        record
                    )

                    traceState.LastRemote =
                        tostring(method)
                        .. " "
                        .. remoteName
                        .. "("
                        .. record.args
                        .. ")"
                end
            end
        end

        return oldNamecall(
            self,
            ...
        )
    end

    local wrapped =
        interceptNamecall

    if type(newcclosure) == "function" then
        wrapped =
            newcclosure(
                interceptNamecall
            )
    end

    local ok,
        previous =
            pcall(function()
                return hookmetamethod(
                    game,
                    "__namecall",
                    wrapped
                )
            end)

    if not ok
        or type(previous) ~= "function"
    then
        globalEnv.__TheVeilHub_CradleTraceHookInstalled =
            false

        globalEnv.__TheVeilHub_CradleTraceHookSupported =
            false

        return false
    end

    oldNamecall =
        previous

    globalEnv.__TheVeilHub_CradleTraceHookInstalled =
        true

    globalEnv.__TheVeilHub_CradleTraceHookSupported =
        true

    return true
end

