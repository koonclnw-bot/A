function F.normalizeDropRarity(value)
    local normalized =
        string.lower(
            tostring(value or "")
        ):gsub(
            "[%s_%-]",
            ""
        )

    return Config.DROP_RARITY_BY_KEY[normalized]
        or Config.DROP_RARITY_BY_KEY.unknown
end

function F.getDropNameOrder(name)
    local total = 0
    local value = tostring(name or "")

    for index = 1, #value do
        total =
            (
                total
                + (string.byte(value, index) or 0) * index
            )
            % 9000
    end

    return total
end

function F.tweenObject(object, duration, properties, easingStyle, easingDirection)
    if State.reduceMotion or duration <= 0 then
        for property, value in pairs(properties) do
            object[property] = value
        end
        return nil
    end

    local tween = TweenService:Create(
        object,
        TweenInfo.new(
            duration,
            easingStyle or Enum.EasingStyle.Quad,
            easingDirection or Enum.EasingDirection.Out
        ),
        properties
    )

    tween:Play()
    return tween
end

function F.createCorner(object, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = object
    return corner
end

function F.createStroke(object, color, transparency, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Config.THEME.Stroke
    stroke.Transparency = transparency or 0
    stroke.Thickness = thickness or 1
    stroke.Parent = object
    return stroke
end

function F.createPadding(object, left, right, top, bottom)
    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, left or 0)
    padding.PaddingRight = UDim.new(0, right or 0)
    padding.PaddingTop = UDim.new(0, top or 0)
    padding.PaddingBottom = UDim.new(0, bottom or 0)
    padding.Parent = object
    return padding
end

function F.createTextLabel(parent, text, size, position, font, textSize, color, alignment)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Text = text or ""
    label.Size = size or UDim2.new(1, 0, 0, 20)
    label.Position = position or UDim2.new(0, 0, 0, 0)
    label.Font = font or Enum.Font.Gotham
    label.TextSize = textSize or 14
    label.TextColor3 = color or Config.THEME.Text
    label.TextXAlignment = alignment or Enum.TextXAlignment.Left
    label.Parent = parent
    return label
end

function F.createButton(parent, text, size, position, backgroundColor, textColor, font, textSize)
    local button = Instance.new("TextButton")
    button.BackgroundColor3 = backgroundColor or Config.THEME.Card2
    button.BorderSizePixel = 0
    button.Text = text or "Button"
    button.Size = size or UDim2.new(0, 120, 0, 36)
    button.Position = position or UDim2.new(0, 0, 0, 0)
    button.TextColor3 = textColor or Config.THEME.Text
    button.Font = font or Enum.Font.GothamSemibold
    button.TextSize = math.max(textSize or 15, 13)
    button.AutoButtonColor = false
    button.Parent = parent

    F.createCorner(button, 10)
    local stroke = F.createStroke(button, Config.THEME.Stroke, 0.15, 1)

    local scale = Instance.new("UIScale")
    scale.Scale = 1
    scale.Parent = button

    button.MouseEnter:Connect(function()
        F.tweenObject(button, 0.14, {BackgroundColor3 = Config.THEME.Hover})
        F.tweenObject(stroke, 0.14, {Color = Config.THEME.Accent, Transparency = 0.35})
    end)

    button.MouseLeave:Connect(function()
        F.tweenObject(button, 0.14, {BackgroundColor3 = backgroundColor or Config.THEME.Card2})
        F.tweenObject(stroke, 0.14, {Color = Config.THEME.Stroke, Transparency = 0.15})
        F.tweenObject(scale, 0.10, {Scale = 1})
    end)

    button.MouseButton1Down:Connect(function()
        F.tweenObject(scale, 0.08, {Scale = 0.975})
    end)

    button.MouseButton1Up:Connect(function()
        F.tweenObject(scale, 0.10, {Scale = 1})
    end)

    return button
end

function F.createCard(parent, height)
