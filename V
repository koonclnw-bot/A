function F.searchNPCIntelligence(query)
    local intel = State.npcIntel
    query = string.lower(F.trimText(query))
    intel.lastQuery = query

    if not intel.loaded and not intel.loading then
        F.refreshNPCIntelligence(false, false)
    end

    local results = {}

    local function matches(value)
        if query == "" then
            return true
        end
        return string.find(string.lower(tostring(value or "")), query, 1, true) ~= nil
    end

    local function canAdd()
        return #results < Config.NPC_INTEL_SEARCH_MAX_RESULTS
    end

    for _, record in ipairs(intel.npcOrder or {}) do
        if not canAdd() then break end
        local matched = matches(record.Name) or matches(record.Path)

        if not matched then
            for _, service in ipairs(record.Services or {}) do
                if matches(service) then
                    matched = true
                    break
                end
            end
        end

        if not matched then
            for _, event in ipairs(record.Events or {}) do
                if matches(event.Event) or matches(event.Argument) then
                    matched = true
                    break
                end
            end
        end

        if matched then
            table.insert(results, record)
        end
    end

    for _, record in ipairs(intel.interactions or {}) do
        if not canAdd() then break end
        if matches(record.Name)
            or matches(record.Argument)
            or matches(record.Category)
            or matches(record.Path)
        then
            table.insert(results, record)
        end
    end

    intel.lastResults = results
    intel.lastSearchText = "Results: " .. tostring(#results)
        .. " / max " .. tostring(Config.NPC_INTEL_SEARCH_MAX_RESULTS)
        .. (query ~= "" and (" | Query: " .. query) or " | Showing useful live records")

    F.renderNPCIntelResults(results)

    if #results > 0 then
        local selectedStillVisible = false
        for _, record in ipairs(results) do
            if record == intel.selected then
                selectedStillVisible = true
                break
            end
        end
        if not selectedStillVisible then
            F.selectNPCIntelRecord(results[1])
        else
            F.selectNPCIntelRecord(intel.selected)
        end
    else
        F.selectNPCIntelRecord(nil)
        if State.npcIntelDetailsLabel and State.npcIntelDetailsLabel.Parent then
            State.npcIntelDetailsLabel.Text = "No NPC / interaction matches for: " .. tostring(query)
        end
    end

    F.updateNPCIntelUI()
    return results
end

function F.refreshNPCIntelligence(force, fromGameDB)
    local intel = State.npcIntel

    if intel.loading then
        return false
    end

    if not fromGameDB then
        if force or not State.gameDB.loaded then
            -- GameDB owns module loading. Its successful tail calls us again with
            -- fromGameDB=true, preventing a refresh recursion loop.
            return F.refreshGameDB(force == true)
        end
    end

    intel.loading = true
    intel.status = "Building NPC service directory"
    F.updateNPCIntelUI()

    local ok, err = xpcall(function()
        F.buildNPCServiceDirectory()

        intel.status = "Scanning universal interactables"
        F.updateNPCIntelUI()
        F.scanUniversalInteractions()
    end, function(message)
        return debug.traceback(tostring(message), 2)
    end)

    if not ok then
        intel.loading = false
        intel.status = "Error"
        F.recordError("NPCIntel", err)
        F.updateNPCIntelUI()
        return false
    end

    intel.loaded = true
    intel.loading = false
    intel.lastRefreshAt = os.time()
    intel.status = "Ready"

    F.recordDiagnosticEvent(
        "NPCIntel",
        "Indexed " .. tostring(#intel.npcOrder)
            .. " NPC dialogue records and " .. tostring(#intel.interactions)
            .. " universal interactables"
    )

    F.searchNPCIntelligence(intel.lastQuery or "")
    F.updateNPCIntelUI()
    return true
end

function F.tryLocalInteractionTrigger(target)
    if not target or not target.Parent then
        return false, "missing target"
    end

    local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and type(fireproximityprompt) == "function" then
        local ok = pcall(fireproximityprompt, prompt)
        if ok then
            return true, "ProximityPrompt"
        end
    end

    local click = target:FindFirstChildWhichIsA("ClickDetector", true)
    if click and type(fireclickdetector) == "function" then
        local ok = pcall(fireclickdetector, click)
        if ok then
            return true, "ClickDetector"
        end
    end

    if type(firetouchinterest) == "function" then
        local touch = target:FindFirstChildWhichIsA("TouchTransmitter", true)
        local touchPart = touch and touch.Parent
        local root = F.getCharacterRoot()

        if root and touchPart and touchPart:IsA("BasePart") then
            local ok = pcall(function()
                firetouchinterest(root, touchPart, 0)
                task.wait(0.03)
                firetouchinterest(root, touchPart, 1)
            end)
            if ok then
                return true, "TouchInterest"
            end
        end
    end

    return false, "no executor trigger"
end

function F.fireUniversalInteractionProtocol(record)
    if type(record) ~= "table"
        or record.Kind ~= "Interaction"
        or not record.Instance
        or not record.Instance.Parent
        or F.trimText(record.Argument) == ""
        or Config.INTERACTION_DIRECT_PROTOCOL ~= true
    then
        return false
    end

    local argumentValue = record.Instance:FindFirstChild("Argument")
    local marker = record.Instance:FindFirstChild("IsInteractable")
    local isPickup = tostring(record.Argument) == "PickupDrop"

    if not argumentValue
        or not argumentValue:IsA("StringValue")
        or tostring(argumentValue.Value) ~= tostring(record.Argument)
        or (not marker and not isPickup)
    then
        return false
    end

    local remote = F.getInteractPromptEvent()
    if not remote then
        return false
    end

    State.movementTelemetry.lastRemote =
        "InteractPromptEvent:" .. tostring(record.Argument)
            .. " -> " .. tostring(record.Name)

    local ok = pcall(function()
        remote:FireServer(record.Argument, record.Instance)
    end)

    return ok
end

function F.flyToNPCIntelSelection()
    local record = State.npcIntel.selected
    if type(record) ~= "table" or not record.Instance or not record.Instance.Parent then
        F.notify("NPC Intel", "Selected target is no longer available.", "warning", 2.0)
        return false
    end

    if record.Kind == "Interaction"
        and tostring(record.Argument) == "PickupDrop"
        and F.isDropPresent(record.Instance)
    then
        return F.flyToDrop(record.Instance, false)
    end

    local targetCFrame = F.getIntelTargetCFrame(record.Instance)
    if typeof(targetCFrame) ~= "CFrame" then
        F.notify("NPC Intel", "No usable world position for this target.", "warning", 2.0)
        return false
    end

    State.movementTelemetry.target = tostring(record.Name or "Intel Target")
    State.movementTelemetry.lastAction = "NPC Intel Fly -> " .. tostring(record.Name or "Unknown")

    local arrival = record.Kind == "NPC"
        and Config.NPC_INTEL_FLY_ARRIVAL_DISTANCE
        or Config.INTERACTION_FLY_ARRIVAL_DISTANCE

    local reached = F.flyToCFrame(
        targetCFrame,
        "MANUAL",
        arrival,
        Config.WORLD_FLY_MAX_TRAVEL_TIME,
        "Return"
    )

    if not reached then
        F.notify("NPC Intel", "Could not reach " .. tostring(record.Name), "warning", 2.2)
    end

    return reached
end

function F.interactNPCIntelSelection()
    local record = State.npcIntel.selected
    if type(record) ~= "table" or not record.Instance or not record.Instance.Parent then
        F.notify("NPC Intel", "Selected target is no longer available.", "warning", 2.0)
        return false
    end

    if record.Kind == "Interaction"
        and tostring(record.Argument) == "PickupDrop"
        and F.isDropPresent(record.Instance)
    then
        State.movementTelemetry.lastAction = "NPC Intel pickup -> " .. tostring(record.Name)
        return F.flyToDrop(record.Instance, true)
    end

    if not F.flyToNPCIntelSelection() then
        return false
    end

    task.wait(Config.INTERACTION_POST_ARRIVAL_DELAY)

    local triggered, triggerKind = F.tryLocalInteractionTrigger(record.Instance)

    if not triggered and record.Kind == "Interaction" then
        triggered = F.fireUniversalInteractionProtocol(record)
        if triggered then
            triggerKind = "InteractPromptEvent"
        end
    end

    if not triggered then
        triggered = F.pressLootInteractKey()
        if triggered then
            triggerKind = "E key fallback"
        end
    end

    State.movementTelemetry.lastAction =
        "NPC Intel interact " .. tostring(triggerKind or "failed")
            .. " -> " .. tostring(record.Name)

    F.recordDiagnosticEvent(
        "NPCIntel",
        tostring(record.Name) .. " interaction: "
            .. tostring(triggerKind or "failed")
    )

    if not triggered then
        F.notify("NPC Intel", "No supported interaction trigger was available.", "warning", 2.2)
    end

    return triggered
end

function F.copyNPCIntelligenceSummary()
