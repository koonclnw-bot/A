function F.setCellFarmStage(stage, status)
    State.cellFarm.stage =
        tostring(stage or "IDLE")

    if status ~= nil then
        State.cellFarm.status =
            tostring(status)
    end

    State.movementTelemetry.lastAction =
        "Cell Farm: "
        .. State.cellFarm.stage
        .. " | "
        .. tostring(State.cellFarm.status)

    if F.updateCellFarmUI then
        F.updateCellFarmUI()
    end
end

function F.recordCellFailure(reason)
