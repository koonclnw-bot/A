    F.createStroke(toast, Config.THEME.Stroke, 0.05, 1)

    local accentBar = Instance.new("Frame")
    accentBar.Size = UDim2.new(0, 3, 1, -16)
    accentBar.Position = UDim2.new(0, 8, 0, 8)
    accentBar.BackgroundColor3 = accent
    accentBar.BorderSizePixel = 0
    accentBar.ZIndex = 202
    accentBar.Parent = toast
    F.createCorner(accentBar, 2)

    local titleLabel = F.createTextLabel(
        toast,
        title or "Notice",
        UDim2.new(1, -54, 0, 20),
        UDim2.new(0, 20, 0, 10),
        Enum.Font.GothamSemibold,
        14,
        Config.THEME.Text,
        Enum.TextXAlignment.Left
    )
    titleLabel.ZIndex = 202

    local messageLabel = F.createTextLabel(
        toast,
        message or "",
        UDim2.new(1, -54, 0, 34),
        UDim2.new(0, 20, 0, 31),
        Enum.Font.Gotham,
        12,
        Config.THEME.SubText,
        Enum.TextXAlignment.Left
    )
    messageLabel.TextWrapped = true
    messageLabel.TextYAlignment = Enum.TextYAlignment.Top
    messageLabel.ZIndex = 202

    local close = Instance.new("TextButton")
    close.Size = UDim2.new(0, 28, 0, 28)
    close.Position = UDim2.new(1, -36, 0, 8)
    close.BackgroundTransparency = 1
    close.Text = "X"
    close.TextColor3 = Config.THEME.SubText
    close.Font = Enum.Font.GothamBold
    close.TextSize = 16
    close.ZIndex = 203
    close.Parent = toast

    local scale = Instance.new("UIScale")
    scale.Scale = State.reduceMotion and 1 or 0.96
    scale.Parent = toast
    toast.BackgroundTransparency = State.reduceMotion and 0.02 or 1

    if not State.reduceMotion then
        F.tweenObject(scale, 0.20, {Scale = 1}, Enum.EasingStyle.Quart)
        F.tweenObject(toast, 0.20, {BackgroundTransparency = 0.02}, Enum.EasingStyle.Quart)
    end

    local closed = false
    local function dismiss()
        if closed or not toast.Parent then
            return
        end
        closed = true

        if State.reduceMotion then
            toast:Destroy()
        else
            F.tweenObject(scale, 0.16, {Scale = 0.96})
            local tween = F.tweenObject(toast, 0.16, {BackgroundTransparency = 1})
            if tween then
                tween.Completed:Connect(function()
                    if toast.Parent then
                        toast:Destroy()
                    end
                end)
            end
        end
    end

    close.MouseButton1Click:Connect(dismiss)
    task.delay(duration or 3.2, dismiss)
end

